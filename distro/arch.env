# The Arch family's package names for spark-shell (pacman).
PM=pacman
PKG_SHELL=bash tmux ncurses diffutils starship
PKG_CLI=bat eza fzf zoxide fd jq btop
# curl and ssh-keygen: the dialog, fetched for a release tag whose signature is checked
# swayidle and swaylock: the display off and the lock when idle; grim, slurp and
# wl-clipboard: screen capture, to a file and the clipboard
# brightnessctl and ddcutil: the brightness, a laptop's backlight or a screen's DDC/CI
# librsvg is rsvg-convert too: a drawing drawn again in another palette, a picture's colors read (Arch's gdk-pixbuf2 has no thumbnailer)
# otf-monaspace: Monaspace Neon, the terminal's font (spark-shell on fetches it where the family has no package)
# mako: the notifications, and libnotify is notify-send; udisks2: a drive
# plugged in, mounted when asked
# poppler is pdftoppm, pdfinfo and pdftotext: a PDF's page in a preview (#120)
PKG_DESKTOP=sway swaybg foot foot-terminfo ttf-dejavu curl openssh swayidle swaylock grim slurp wl-clipboard brightnessctl ddcutil librsvg poppler otf-monaspace mako libnotify udisks2 xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk gsettings-desktop-schemas bluez bluez-utils python-dbus python-gobject
# the sound with the desktop: PipeWire, WirePlumber, its PulseAudio server
# and ALSA programs through it (Bluetooth sound comes with them)
PKG_SOUND=pipewire wireplumber pipewire-pulse pipewire-alsa
# kbd is setvtrgb and setfont, the console palette and font
PKG_CONSOLE=kbd
# the login screen (spark-shell on login): greetd, swayidle to turn the display
# off when idle, and the account greetd's package makes for it
PKG_LOGIN=greetd swayidle
LOGIN_ACCOUNT=greeter
