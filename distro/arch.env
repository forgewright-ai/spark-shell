# The Arch family's package names for spark-shell (pacman).
PM=pacman
PKG_SHELL=bash tmux ncurses diffutils starship
PKG_CLI=bat eza fzf zoxide fd jq btop
# curl and ssh-keygen: the dialog, fetched for a release tag whose signature is checked
PKG_DESKTOP=sway swaybg foot foot-terminfo ttf-dejavu curl openssh
# kbd is setvtrgb and setfont, the console palette and font
PKG_CONSOLE=kbd
