# The Debian family's package names for spark-shell (apt).
PM=apt
PKG_SHELL=bash tmux ncurses-bin
PKG_CLI=bat eza fzf zoxide fd-find jq btop
# curl and ssh-keygen: the dialog, fetched for a release tag whose signature is checked
# swayidle and swaylock: the display off and the lock when idle; grim, slurp and
# wl-clipboard: screen capture, to a file and the clipboard
# brightnessctl and ddcutil: the brightness, a laptop's backlight or a screen's DDC/CI
# librsvg2-bin is rsvg-convert, and libgdk-pixbuf2.0-bin its thumbnailer: a drawing drawn again in another palette, a picture's colors read
# no package of Monaspace Neon, the terminal's font, here: spark-shell on fetches the release's zip, its sha256 pinned
# mako-notifier is mako, the notifications, and libnotify-bin is notify-send;
# dbus-user-session: the session bus a program reaches mako through; udisks2: a
# drive plugged in, mounted when asked
PKG_DESKTOP=sway foot fonts-dejavu-core curl openssh-client swayidle swaylock grim slurp wl-clipboard brightnessctl brightness-udev ddcutil librsvg2-bin librsvg2-common libgdk-pixbuf2.0-bin mako-notifier libnotify-bin udisks2 dbus-user-session xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk gsettings-desktop-schemas
# the sound with the desktop: PipeWire, WirePlumber, its PulseAudio server,
# ALSA programs through it, and Bluetooth sound
PKG_SOUND=pipewire wireplumber pipewire-pulse pipewire-alsa libspa-0.2-bluetooth
# kbd is setvtrgb and setfont, the console palette and font
PKG_CONSOLE=kbd
# the login screen (spark-shell on login): greetd, swayidle to turn the display
# off when idle, and the account greetd's package makes for it
PKG_LOGIN=greetd swayidle
LOGIN_ACCOUNT=_greetd
