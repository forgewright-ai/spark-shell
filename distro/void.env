# The Void family's package names for spark-shell (xbps, glibc). Void
# has no logind: the desktop's seatd lets sway take the screen.
PM=xbps
PKG_SHELL=bash tmux ncurses ncurses-term diffutils starship
PKG_CLI=bat eza fzf zoxide fd jq btop
# curl and ssh-keygen: the dialog, fetched for a release tag whose signature is checked
# swayidle and swaylock: the display off and the lock when idle; grim, slurp and
# wl-clipboard: screen capture, to a file and the clipboard
# brightnessctl and ddcutil: the brightness, a laptop's backlight or a screen's DDC/CI
# librsvg-utils is rsvg-convert, and gdk-pixbuf its thumbnailer: a drawing drawn again in another palette, a picture's colors read
# no package of Monaspace Neon, the terminal's font, here: spark-shell on fetches the release's zip, its sha256 pinned
# mako: the notifications, libnotify is notify-send, and dbus the session bus
# the desktop starts in (no logind makes one); udisks2: a drive plugged in,
# mounted when asked (polkit comes with it)
PKG_DESKTOP=sway swaybg foot foot-terminfo dejavu-fonts-ttf mesa-dri seatd curl openssh swayidle swaylock grim slurp wl-clipboard brightnessctl ddcutil i2c-tools librsvg librsvg-utils mako libnotify udisks2 dbus xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk gsettings-desktop-schemas
# the sound with the desktop: PipeWire (its PulseAudio server inside), WirePlumber,
# ALSA programs through it, and Bluetooth sound
PKG_SOUND=pipewire wireplumber alsa-pipewire libspa-bluetooth
# kbd is setvtrgb and setfont, the console palette and font
PKG_CONSOLE=kbd
# the login screen (spark-shell on login): greetd, swayidle to turn the display
# off when idle, and the account greetd's package makes for it
PKG_LOGIN=greetd swayidle
LOGIN_ACCOUNT=_greeter
