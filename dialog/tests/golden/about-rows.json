{"title":"about","rows":[{"id":"about:key:0","sign":"blank","text":"opens a terminal window.","tool":null,"more":[],"columns":["Super+Return"],"children":null,"group":"keys 1"},{"id":"about:key:1","sign":"blank","text":"opens the dialog: pick an option, or say what you would like.","tool":null,"more":[],"columns":["Super+d"],"children":null,"group":"keys 1"},{"id":"about:key:2","sign":"blank","text":"opens the dialog in spark chat, and Ctrl-D closes it.","tool":null,"more":[],"columns":["Super+s"],"children":null,"group":"keys 1"},{"id":"about:key:3","sign":"blank","text":"closes the window.","tool":null,"more":[],"columns":["Super+Shift+q"],"children":null,"group":"keys 2"},{"id":"about:key:4","sign":"blank","text":"reloads sway after spark-shell on.","tool":null,"more":[],"columns":["Super+Shift+c"],"children":null,"group":"keys 2"},{"id":"about:key:5","sign":"blank","text":"leaves the desktop.","tool":null,"more":[],"columns":["Super+Shift+e"],"children":null,"group":"keys 2"},{"id":"about:key:6","sign":"blank","text":"moves the focus, as h, j, k, l do; Shift moves the window.","tool":null,"more":[],"columns":["Super+arrow"],"children":null,"group":"keys 3"},{"id":"about:key:7","sign":"blank","text":"makes a window fill the screen.","tool":null,"more":[],"columns":["Super+f"],"children":null,"group":"keys 3"},{"id":"about:key:8","sign":"blank","text":"resizes the window, until Enter.","tool":null,"more":[],"columns":["Super+r"],"children":null,"group":"keys 3"},{"id":"about:key:9","sign":"blank","text":"makes tabs, Super+Shift+s a stack, Super+e side by side again.","tool":null,"more":[],"columns":["Super+w"],"children":null,"group":"keys 3"},{"id":"about:key:10","sign":"blank","text":"puts the next window beside this one, and Super+v below it.","tool":null,"more":[],"columns":["Super+b"],"children":null,"group":"keys 3"},{"id":"about:key:11","sign":"blank","text":"go to workspaces 1 to 10; with Shift the window goes there.","tool":null,"more":[],"columns":["Supe