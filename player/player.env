# The wallpaper player's builds, a sha256 each: the release workflow
# builds player/ at the tag in a pinned Debian 12 image and refuses to
# publish a binary whose sha256 is not the line here, and `spark-shell on
# desktop` installs only the file that has it. CI's player job checks the
# line too: the first build of a new player prints the sha256 to pin.
PLAYER_SHA256_X86_64_LINUX_GNU=
