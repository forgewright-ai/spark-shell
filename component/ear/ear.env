# The ear's builds, a sha256 each: the release workflow builds component/ear/ at the
# tag in the pinned Debian 12 image the player builds in, and refuses to
# publish a binary whose sha256 is not the line here; `spark-shell on
# desktop` installs only the file that has it. CI's ear job checks the line
# too: the first build of a new one prints the sha256 to pin.
EAR_SHA256_X86_64_LINUX_GNU=ffba60b778b700c569e8e0906631595caedf2c1af9438579f9b0415553d4e457
