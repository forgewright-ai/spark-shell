# The dialog's builds, a sha256 each: the release workflow builds
# component/dialog/ at the tag, refuses to publish a binary whose sha256 is not the
# line here, and `spark-shell on` installs only the file that has it.
# The build is reproducible (rust-toolchain.toml, Cargo.lock, the pinned
# Debian 12 image the bar builds in, paths remapped), so CI's dialog-build
# job checks the line too: the first build of a new one prints the sha256 to pin.
DIALOG_SHA256_X86_64_LINUX_GNU=2a01b1d4b08808e2b2a642ebc31c884ff9fecbdddfabbfdbd744ff1a14891ff4
