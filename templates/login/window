#!/bin/sh
# rendered by spark-shell from templates/login/window -- spark-shell off login removes it
# The login screen's window. When it closes (a login, or the window
# gone), sway ends, and greetd starts the session or the screen again.
# The window opens on the main screen, the one at 0 0 (screens.conf sets
# the others beside it): sway opens a window where the focus is.
main=$(swaymsg -t get_outputs 2>/dev/null | jq -r '[.[] | select(.active != false and .rect.x == 0 and .rect.y == 0)] | first | .name // empty' 2>/dev/null || :)
[ -z "$main" ] || swaymsg focus output "$main" >/dev/null 2>&1 || :
foot -c /@LOGIN_ETC@/foot.ini -a spark-login /@LOGIN_ETC@/run
swaymsg exit
