#!/bin/sh
# rendered by spark-shell from templates/login/session -- spark-shell off login removes it
# The login screen's session, run by greetd on tty1 as @LOGIN_ACCOUNT@: sway
# with one window. With no login manager to make a runtime dir (Void),
# it makes its own, never one another account owns.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR=/tmp/$(id -u)-runtime-dir
    mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
    [ -O "$XDG_RUNTIME_DIR" ] || { echo "spark-shell login: $XDG_RUNTIME_DIR belongs to another account" >&2; exit 1; }
    export XDG_RUNTIME_DIR
fi
exec sway -c /@LOGIN_ETC@/sway.conf
