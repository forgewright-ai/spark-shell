# rendered by spark-shell from templates/.config/sway/config -- edit the template, then spark-shell apply
# sway, bare: it tiles windows, tmux tiles panes and draws the bar line,
# so no bar, no titlebars, no xwayland. A new window is foot running the
# login shell. The borders and the background take the palette's hex,
# or the picture from spark-shell desktop wallpaper PATH (then gaps).
# Super+Return a window, Super+s spark's own prompt in a small window
# (Ctrl-D closes it), Super+d a desk from your words (a small prompt;
# spark-shell desktop "WORDS"), Super+Shift+q close it, Super+Shift+c reload,
# Super+Shift+e back to the console. Started by hand: spark-shell desktop.
# The desktop opens with one terminal and ends with it: `exit` in that
# first foot is the console again (an empty sway is a black screen with
# nothing to type into).

set $mod Mod4
set $term foot

xwayland disable
output * bg @WALL_BG@
gaps inner @GAPS_INNER@
gaps outer @GAPS_OUTER@
default_border pixel 2
default_floating_border pixel 2
floating_modifier $mod normal

# border  background  text  indicator  child_border
client.focused          #@HEX_ACCENT@ #@HEX_ACCENT@ #@HEX_BG@ #@HEX_ACCENT@ #@HEX_ACCENT@
client.focused_inactive #@HEX_MUTED@ #@HEX_MUTED@ #@HEX_BG@ #@HEX_MUTED@ #@HEX_MUTED@
client.unfocused        #@HEX_BG@ #@HEX_BG@ #@HEX_MUTED@ #@HEX_BG@ #@HEX_BG@
client.urgent           #@HEX_ANSI_1@ #@HEX_ANSI_1@ #@HEX_BG@ #@HEX_ANSI_1@ #@HEX_ANSI_1@

# key: Super+Return opens a window, foot running your login shell.
bindsym $mod+Return exec $term
# key: Super+d asks for a desk from your words at a small prompt.
bindsym $mod+d exec $term --app-id spark-desk -e @REPO@/spark-shell desktop --ask
for_window [app_id="spark-desk"] floating enable, resize set width 60 ppt height 40 ppt
# key: Super+s opens spark's own prompt in a small window; Ctrl-D closes it.
bindsym $mod+s exec $term --app-id spark-chat -e @REPO@/spark-shell desktop --chat
for_window [app_id="spark-chat"] floating enable, resize set width 60 ppt height 40 ppt
# key: Super+Shift+q closes the window.
bindsym $mod+Shift+q kill
# key: Super+Shift+c reloads sway after spark-shell apply.
bindsym $mod+Shift+c reload
# key: Super+Shift+e leaves the desktop for the console or the login box.
bindsym $mod+Shift+e exit

# key: Super and h, j, k, l or the arrows move the focus; with Shift, the window.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# key: Super+f fills the screen with a window; Super+r resizes, Return ends it.
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen
bindsym $mod+Shift+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# key: Super+1 to 0 go to a workspace; with Shift they send the window there.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

exec @REPO@/spark-shell desktop --pending
# key: exit in the first window leaves the desktop too.
exec sh -c '$term -e @REPO@/spark-shell desktop --first; swaymsg exit'
