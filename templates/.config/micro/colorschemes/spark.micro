# spark.micro -- rendered by spark-shell from templates/.config/micro/colorschemes/spark.micro
# `spark theme NAME`, then `spark-shell apply`, re-renders it;
# ~/.config/micro/settings.json says "colorscheme": "spark".
#
# One plain look: micro's sixteen colour words, the palette slots the
# console draws (no hex, no MICRO_TRUECOLOR). The page is the terminal's
# own fg on bg (`default`); the rest maps as before:
#   comments, line numbers, guides   the muted slot
#   keywords (statement)             brightred      (slot 9)
#   types                            brightyellow   (slot 11)
#   identifiers                      brightblue     (slot 12)
#   constants, numbers               brightmagenta  (slot 13)
#   strings                          brightgreen    (slot 10)
#   symbols                          brightcyan     (slot 14)
#   preproc, special, todo           the accent slot
#   errors                           brightred, bold
#   status line, tab bar             black on white (slots 0 on 7: inverted)
#   cursor line, colour column       brightblack (slot 8: a ground the
#                                    console can tell from its own, slot 0)
#   diff gutter                      green / yellow / red (slots 2 3 1)
color-link default "default,default"
color-link comment "@MUTED_NAME@"
color-link identifier "brightblue"
color-link constant "brightmagenta"
color-link constant.number "brightmagenta"
color-link constant.string "brightgreen"
color-link statement "brightred"
color-link symbol "brightcyan"
color-link symbol.brackets "default"
color-link preproc "@ACCENT_NAME@"
color-link type "brightyellow"
color-link special "@ACCENT_NAME@"
color-link underlined "brightblue"
color-link error "bold brightred"
color-link todo "bold @ACCENT_NAME@"
color-link statusline "black,white"
color-link tabbar "black,white"
color-link indent-char "@MUTED_NAME@"
color-link line-number "@MUTED_NAME@,default"
color-link current-line-number "default,default"
color-link gutter-error "red"
color-link gutter-warning "yellow"
color-link cursor-line "brightblack"
color-link color-column "brightblack"
color-link diff-added "green"
color-link diff-modified "yellow"
color-link diff-deleted "red"
