# rendered by spark-shell from templates/.config/mako/config -- edit the template, then spark-shell on
# The notifications (#71): mako draws them in the top right corner, under
# the bar, as a small surface of the desktop like the dialog: the dialog's
# ground, the palette's text, the bar's face, no frame and no icon. The
# first line opens with spark's angle, the heavy angle of the prompt in
# the accent, then the app's name muted; the summary is bold under it,
# and before it a glyph tells the kind where the app names one (its
# category): an envelope for mail, a check or a cross for a transfer
# done or failed, a square for a drive, a clock face for a reminder, a
# warning sign in red on a critical one; the words follow. The glyphs
# are the dialog's, the small triangle before what a click opens among
# them. The edge lines up with the windows' content (gaps outer plus the
# clear border, 16 and 4), and the cards stand 8 apart. The newest is on
# top, three at most, and under them one line says how many more wait.
# Those from one app stand together, the app's line counting them. Each
# is gone after six seconds into the history (the last ten: spark-shell
# desktop notifications, or the dialog's Notifications). A low one is
# muted through, its angle too, and gone after four. A critical one
# stays until it is dismissed and shows over a full-screen window too. A
# click does what its app offers, a right click dismisses it, a middle
# click dismisses them all. With do not disturb on they stay out of
# sight, but a critical one still shows.
font=@BAR_FONT@
background-color=#@PANEL_BG@
text-color=#@HEX_FG@
border-size=0
border-radius=0
progress-color=over #@HEX_ACCENT@40
padding=@NOTIFY_PAD@
margin=8
outer-margin=12
width=@NOTIFY_WIDTH@
height=@NOTIFY_HEIGHT@
anchor=top-right
icons=0
max-visible=3
max-history=10
default-timeout=6000
group-by=app-name
on-button-middle=dismiss-all
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a</span>\n<b>%s</b>\n%b

[grouped]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a &#183; %g</span>\n<b>%s</b>\n%b

[hidden]
format=<span foreground="#@PANEL_MUTED@">&#x25B8; and %h more</span>

[urgency=low]
text-color=#@PANEL_MUTED@
default-timeout=4000
format=<span foreground="#@PANEL_MUTED@">&#x276F; %a</span>\n<b>%s</b>\n%b

# the kind's glyph, where the app names one: mail, a transfer, a drive
[category=email.arrived]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a</span>\n&#x2709; <b>%s</b>\n%b
[category=email]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a</span>\n&#x2709; <b>%s</b>\n%b
[grouped category=email.arrived]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a &#183; %g</span>\n&#x2709; <b>%s</b>\n%b
[grouped category=email]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a &#183; %g</span>\n&#x2709; <b>%s</b>\n%b
[category=transfer.complete]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a</span>\n&#x2713; <b>%s</b>\n%b
[category=transfer.error]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a</span>\n&#x2717; <b>%s</b>\n%b
[category=device.added]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a</span>\n&#x25A3; <b>%s</b>\n%b

# spark-shell's own: the first line says what it is and, after the
# triangle, what a click opens: a reminder in the dialog's Reminders, a
# drive plugged in the dialog's Storage, where it mounts
[app-name=spark-shell category=x-spark-shell.reminder]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">reminder &#x25B8; a click opens it</span>\n&#x25F7; <b>%s</b>\n%b
on-button-left=exec makoctl dismiss -n "$id"; foot --config @HOME@/.config/foot/dialog.ini --app-id spark-dialog -e @REPO@/spark-shell dialog reminders
[app-name=spark-shell category=device.added]
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">drive &#x25B8; a click opens Storage</span>\n&#x25A3; <b>%s</b>\n%b
on-button-left=exec makoctl dismiss -n "$id"; foot --config @HOME@/.config/foot/dialog.ini --app-id spark-dialog -e @REPO@/spark-shell dialog storage

[urgency=critical]
default-timeout=0
layer=overlay
format=<span foreground="#@HEX_ACCENT@">&#x276F;</span> <span foreground="#@PANEL_MUTED@">%a</span>\n<span foreground="#@HEX_ANSI_1@">&#x26A0;</span> <b>%s</b>\n%b

[mode=do-not-disturb]
invisible=1
[mode=do-not-disturb urgency=critical]
invisible=0
