# rendered by spark-shell from templates/.config/starship.toml.minimal -- edit the template, then spark-shell on
# The blank line above the prompt is where spark prints its hint; keep it.
# One plain look: ASCII and the 16 palette slots by their colour words,
# no hex; the console palette `spark theme NAME` programs draws them.
add_newline = true
format = "$directory$git_branch$git_status$character"

[directory]
style = "bold @ACCENT_STAR@"
truncation_length = 3
truncate_to_repo = true
truncation_symbol = ".../"
read_only = " ro"

[git_branch]
format = "[$branch]($style) "
style = "purple"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "yellow"
ahead = ">"
behind = "<"
diverged = "<>"
renamed = "r"
deleted = "x"

[character]
success_symbol = "[>](green)"
error_symbol = "[>](red)"
