# rendered by spark-shell from templates/.config/starship.toml.full -- edit the template, then spark-shell apply
# The blank line above the prompt is where spark prints its hint; keep it.
# One plain look: ASCII and the 16 palette slots by their colour words,
# no hex; the console palette `spark theme NAME` programs draws them.
add_newline = true
format = "$username$hostname$directory$git_branch$git_status$python$nodejs$rust$golang$cmd_duration$line_break$time${custom.spark}${custom.spark_down}$character"

[username]
format = "[$user]($style)@"
style_user = "@MUTED_STAR@"
show_always = true

[hostname]
format = "[$hostname]($style) "
style = "@MUTED_STAR@"
ssh_only = false

[directory]
style = "bold @ACCENT_STAR@"
truncation_length = 4
truncate_to_repo = true
truncation_symbol = ".../"
read_only = " ro"

[git_branch]
format = "[$branch]($style) "
style = "purple"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "yellow"
ahead = ">"
behind = "<"
diverged = "<>"
renamed = "r"
deleted = "x"

[python]
format = "[py $version]($style) "
style = "cyan"

[nodejs]
format = "[node $version]($style) "
style = "cyan"

[rust]
format = "[rs $version]($style) "
style = "cyan"

[golang]
format = "[go $version]($style) "
style = "cyan"

[cmd_duration]
min_time = 2000
format = "[$duration]($style) "
style = "yellow"

[time]
disabled = false
format = "[$time]($style) "
style = "@MUTED_STAR@"
time_format = "%H:%M"

[custom.spark]
# spark's own state, from the one file it writes (~/.local/state/spark/prompt,
# KEY=value): `spark MODEL` while it answers, nothing without the file.
# sh builtins only -- no python on a prompt. The group in the format
# draws its space only when there is an output.
command = '''f=${XDG_STATE_HOME:-$HOME/.local/state}/spark/prompt; [ -r "$f" ] || exit 0
m=- a=; while IFS== read -r k v; do case $k in MODEL) m=$v;; AI) a=$v;; esac; done < "$f"
case $a in up) [ "$m" != - ] && printf 'spark %s' "$m";; esac'''
when = true
shell = ["sh"]
format = "([$output]($style) )"
style = "@ACCENT_STAR@"

[custom.spark_down]
# the same file when spark stopped: `spark down`, in red
command = '''f=${XDG_STATE_HOME:-$HOME/.local/state}/spark/prompt; [ -r "$f" ] || exit 0
a=; while IFS== read -r k v; do case $k in AI) a=$v;; esac; done < "$f"
case $a in down) printf 'spark down';; esac'''
when = true
shell = ["sh"]
format = "([$output]($style) )"
style = "red"

[character]
success_symbol = "[>](green)"
error_symbol = "[>](red)"
