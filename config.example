# spark-shell config -- copied to ~/.config/spark-shell/config.
#
# Plain KEY=value, one per line. Every key is optional. A missing key
# uses the default shown here.

# The prompt: starship, or plain (the shell's own). Debian has no
# starship package, so there the prompt is always the shell's own.
PROMPT=starship

# The starship prompt: minimal (one short line) or full.
PROMPT_STYLE=minimal

# The desktop (Linux): none or sway. With sway, sway and foot are
# installed, and a login on tty1 starts the desktop. spark-shell on
# desktop sets this to sway, and spark-shell off desktop sets it to none.
DESKTOP=none

# The font in foot, the desktop's terminal, in foot's own form (the
# font name, then :size=N).
FONT=DejaVu Sans Mono:size=12

# The picture behind the desktop's windows: default (the wallpaper that
# comes with spark-shell), none (the palette's background colour) or the
# full path to a picture. With a picture, sway leaves gaps between the
# windows and foot is a little see-through. spark-shell desktop
# wallpaper sets this.
WALLPAPER=default

# How solid foot is over a picture: 0 to 1, where 1 is solid. 0.85 suits
# a dark picture. A bright one needs more.
ALPHA=0.85

# The colour palette: none (the terminal's own colours) or a name that
# spark-shell theme list shows. spark-shell theme NAME sets this.
THEME=none

# The console font on Linux, or the Terminal.app font on a Mac: the name
# and the size (Terminus 16x32, or Menlo-Regular 13). Empty keeps the
# console's own font. spark-shell font sets this.
CONSOLE_FONT=

# Linux only. yes hides the distro's notice and the kernel line before
# the login prompt. spark-shell quiet login on|off sets this.
QUIET_LOGIN=no

# Linux only. yes hides the boot menu and the boot messages.
# spark-shell quiet boot on|off sets this.
QUIET_BOOT=no
