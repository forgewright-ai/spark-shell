# spark-shell config -- copied to ~/.config/spark-shell/config.
#
# Plain KEY=value, one per line. Every key is optional, and a missing
# key takes the default shown.

# The prompt: starship (rendered from the palette) or plain (the
# shell's own). The README's Installing section says where starship
# comes from and where there is none.
PROMPT=starship

# starship's shape: minimal (a compact single line) or full.
PROMPT_STYLE=minimal

# The desktop (Linux): none, or sway. With sway, sway and foot are
# installed and rendered from the palette, and a login on tty1 starts
# the desktop. spark-shell on desktop writes this line and does the
# rest, and spark-shell off desktop writes none.
DESKTOP=none

# The font foot draws with, in foot's own spec (the family, then
# :size=N).
FONT=DejaVu Sans Mono:size=12

# The wallpaper: default (the forge wallpaper shipped here as
# wallpapers/forge-1920x1080.jpg), none (the palette's background,
# edge to edge) or an absolute path to a picture. With a picture sway
# keeps gaps around the windows and foot is a little translucent, so
# it shows. spark-shell desktop wallpaper PATH|default|none writes
# this line and applies it.
WALLPAPER=default

# foot over a picture: 0 to 1, 1 opaque. A dark picture reads well at
# 0.85, and a bright one wants more.
ALPHA=0.85

# The palette: none (the terminal's own colours) or a name from
# themes/ (spark-shell theme list shows them). spark-shell theme NAME
# writes this line and applies it.
THEME=none

# The console font on Linux, or the Terminal.app profile's on a Mac:
# the face and the size (Terminus 16x32, or Menlo-Regular 13). Empty
# leaves the console's own. spark-shell font writes this line.
CONSOLE_FONT=

# Linux only. no or yes: the distro's notice and the kernel's line off
# before the greeting. spark-shell quiet login on|off writes this line.
QUIET_LOGIN=no

# Linux only. no or yes: a silent boot, the boot menu hidden. spark-shell
# quiet boot on|off writes this line.
QUIET_BOOT=no
