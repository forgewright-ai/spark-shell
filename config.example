# spark-shell config -- copied to ~/.config/spark-shell/config.
#
# Plain KEY=value, one per line. Every key is optional. A missing key
# uses the default shown here.

# The prompt: starship, or plain (the shell's own). Debian, Ubuntu and
# Fedora have no starship package, so there the prompt is the shell's own.
PROMPT=starship

# The starship prompt: minimal (one short line) or full.
PROMPT_STYLE=minimal

# The desktop (Linux): none or sway. With sway, sway and foot are
# installed, and a login on tty1 starts the desktop. spark-shell on
# desktop sets this to sway, and spark-shell off desktop sets it to none.
DESKTOP=none

# The font in foot, the desktop's terminal, in foot's own form (the
# font name, then :size=N). The size is the text size everywhere: the
# bar, the dialog, the login, the lock and the idle screen take it, and
# the pointer grows with it. spark-shell theme text N sets the size.
# Monaspace Neon is the type of spark's page; spark-shell on installs it,
# and until it is in, foot draws DejaVu Sans Mono at the same size.
FONT=Monaspace Neon:size=11

# The wallpaper: default is the ground, the palette's background a shade
# darker than the windows, following the palette; or a picture's full
# path, or a color as #rrggbb (none, the word before v0.89, is the
# ground). Over every one the windows stand apart, as transparent as
# ALPHA says. A shipped drawing's name follows the palette: a palette
# with a drawing of its own brings it, any other has the drawing drawn
# again in its colors. spark-shell theme wallpaper sets this, and it
# saves a color's name as its #rrggbb.
WALLPAPER=default

# The pointer: empty for the spark pointer, white on a dark palette and
# black on a light one; or a cursor theme's name and, after a space, its
# size in pixels (24 when left out): spark-black 32, Adwaita.
POINTER=

# How solid foot is over the wallpaper: 0 to 1, where 1 is solid.
# 0.85 suits a dark picture. A bright one needs more. spark-shell theme
# transparency N says it as a percent: 0.85 is 15% transparency, and
# the open windows take it at once.
ALPHA=0.85

# How new windows sit on a workspace: split (side by side), tabs or
# stacked. The panel's window section sets this, and the keys change
# the workspace you are on.
WINDOWS=split

# The login screen on tty1: yes or no. With yes, greetd shows a login
# screen in your palette, over your wallpaper, from the next boot; tty2
# keeps the console login. spark-shell on login and off login set this.
LOGIN=no

# The display: idle minutes before the idle screen (the wallpaper dimmed,
# the time at the lower left), and before the screen locks and the
# display turns off (0: never). spark-shell desktop display idle|lock N
# sets these.
DISPLAY_IDLE=10
DISPLAY_LOCK=15

# The keyboard's layouts on the desktop, by their xkb names, a space
# between, a variant after a plus (us us+intl); the first is the one in
# use at start, and Super+Ctrl+space goes to the next. Empty keeps
# sway's own. spark-shell desktop keyboard sets this.
KEYBOARD=

# The bar at the top of the desktop's screen: yes or no. It shows the
# workspaces, then lan, wifi, bluetooth, sound out and mic, battery, and
# the date and time, each only when this machine has it. spark-shell bar
# on|off --desktop sets this.
DESKTOP_BAR=yes

# The theme: none (the terminal's own colors: foot's own sixteen on the
# desktop, the console's at the console), a palette's name, or a
# saved theme's (a folder under ~/.config/spark-shell/themes, the whole
# look), as spark-shell theme list shows them. spark-shell theme NAME
# sets this; theme save NAME keeps the look in use.
THEME=none

# The console font on Linux, or the Terminal.app font on a Mac: the name
# and the size (Terminus 16x32, or MonaspaceNeon-Regular 13). Empty keeps
# the console's own font on Linux; on a Mac it is Monaspace Neon at 13
# once spark-shell on has installed it. spark-shell font sets this.
CONSOLE_FONT=

# Linux only. yes hides the distro's notice and the kernel line before
# the login prompt. spark-shell quiet login on|off sets this.
QUIET_LOGIN=no

# Linux only. yes hides the boot menu and the boot messages.
# spark-shell quiet boot on|off sets this.
QUIET_BOOT=no

# The dialog's composer (the desktop, from v0.64). Plus attaches a file to
# what you ask: yes or no, and the types it lists, lower case with a space
# between. spark reads text, so the first version takes text files only.
DIALOG_ATTACH=yes
DIALOG_ATTACH_TYPES=txt md

# The model chip, which shows the model spark uses and picks another: yes
# or no.
DIALOG_MODEL=yes

# Talk, which speaks to spark through its own voice: yes or no. It is
# hidden while spark's voice is off.
DIALOG_TALK=yes
