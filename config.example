# spark-shell config -- copied to ~/.config/spark-shell/config.
#
# Plain KEY=value, one per line. Every key is optional; a missing key
# takes the default shown. The first `spark-shell on` with no config
# seeds these from spark's site.env when the old SITE_* keys are there.

# The prompt: starship (rendered from the palette) or plain (yours).
PROMPT=starship

# starship's shape: minimal (a compact single line) or full.
PROMPT_STYLE=minimal

# The identity a .gitconfig is rendered with (git's author line): set
# both. A .gitconfig you already have stays yours.
GIT_NAME=Your Name
GIT_EMAIL=you@example.com

# The desktop (Linux): none, or sway -- sway and foot installed and
# rendered from the palette, and the login box (greetd) on tty1 at the
# next boot. `spark-shell desktop on|off` writes this line and does the
# rest; spark-shell desktop starts sway now, on a console.
DESKTOP=none

# foot's face, in foot's own spec (family, then :size=N).
FONT=DejaVu Sans Mono:size=12

# The desktop's picture: default (the forge, wallpapers/forge-1920x1080.jpg
# in this repository), none (the palette's background, edge to edge), or
# an absolute path to an image. With a picture sway keeps gaps around the
# windows and foot is a little translucent, so it shows.
# `spark-shell desktop wallpaper PATH|default|none` writes this line and applies it.
WALLPAPER=default

# foot over a picture: 0 to 1, 1 opaque. A dark picture reads well at
# 0.85; a bright one wants more.
ALPHA=0.85
