#!/bin/sh
# spark-shell pre-commit gate: the privacy patterns spark uses, syntax,
# and ASCII docs. A missing tool is a NOTICE, never a silent pass.
set -eu
cd "$(git rev-parse --show-toplevel)"
fail=0
notice() { printf 'NOTICE: %s\n' "$*"; }
bad() { printf 'pre-commit: %s\n' "$*"; fail=1; }

# --- 1. privacy gate: staged content only -------------------------------
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged_files" ]; then
    local_terms=${SPARK_PRIVACY_TERMS:-${XDG_CONFIG_HOME:-$HOME/.config}/spark/privacy-terms}
    terms=$(cat .privacy-terms "$local_terms" 2>/dev/null \
            | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | sort -u | paste -sd'|' -)
    [ -n "$terms" ] || notice "no privacy word list ($(printf '%s' "$local_terms" | sed "s|^$HOME|~|")) -- generic patterns only"
    added=$(git diff --cached --diff-filter=ACMR -U0 -- . ':(exclude).privacy-terms' \
            | grep '^+' | grep -v '^+++' || true)
    if [ -n "$added" ]; then
        if [ -n "$terms" ]; then
            hit=$(printf '%s\n' "$added" | grep -iEn "\\b($terms)\\b" || true)
            [ -z "$hit" ] || bad "banned word in staged change:
$hit"
        fi
        # a systemd instance (getty@tty1.service) is not an address
        hit=$(printf '%s\n' "$added" | sed -E 's/[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.(service|socket|timer|target)//g' \
              | grep -En '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' \
              | grep -v 'you@example.com' || true)
        [ -z "$hit" ] || bad "e-mail address in staged change:
$hit"
        hit=$(printf '%s\n' "$added" \
              | grep -En '\b(10\.[0-9]+\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+)\b' || true)
        [ -z "$hit" ] || bad "private IPv4 address in staged change:
$hit"
        hit=$(printf '%s\n' "$added" | grep -En '(^.|[^[:alnum:]/._-])/(home|Users)/[A-Za-z0-9_-]+' || true)
        [ -z "$hit" ] || bad "home path naming a user in staged change:
$hit"
    fi
fi

# --- 2. syntax ------------------------------------------------------------
sh -n spark-shell tests/shell_test.sh .githooks/pre-commit || bad "sh syntax"
if command -v shellcheck >/dev/null 2>&1; then
    shellcheck -S warning spark-shell tests/shell_test.sh || bad "shellcheck"
else notice "shellcheck not found; skipped"; fi

# --- 3. docs, script and templates stay ASCII (read on a console) -----
tab=$(printf '\t')
for f in README.md CHANGELOG.md CREDITS.md LICENSE config.example spark-shell tests/shell_test.sh $(find templates distro desks -type f | sort); do
    hit=$(LC_ALL=C grep -n "[^ -~${tab}]" "$f" | head -3 || true)
    [ -z "$hit" ] || bad "non-ASCII in $f:
$hit"
done

# --- 4. no hex colour in a template: the look is the 16 palette slots ---
# (the desktop's foot.ini and sway/config carry @HEX_*@ placeholders;
# the palette's own rrggbb lands at render time, never in the tree)
hit=$(grep -rnE '#[0-9a-fA-F]{6}' templates | head -3 || true)
[ -z "$hit" ] || bad "hex colour in a template (name a slot instead):
$hit"

[ "$fail" -eq 0 ] || { printf 'pre-commit: refused\n'; exit 1; }
