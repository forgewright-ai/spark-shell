#!/bin/sh
# spark-shell -- spark's own shell for a machine that is an AI box.
#
#   spark-shell                 the state: rc files, tools, the look
#   spark-shell on              tmux, starship, fzf, zoxide, eza, bat, btop, yazi,
#                               one palette on every surface;
#                               the rc files become spark-shell's (yours -> .bak)
#   spark-shell off             everything back: rc files and the rendered
#                               look from .bak, or gone; packages stay
#   spark-shell apply           re-render the look from the current palette
#                               (after: spark theme NAME; the login hook does
#                               the user's half by itself: spark-shell follow)
#   spark-shell check           is this machine still what this repo says?
#   spark-shell bar on | off    tmux's status line (the line itself is
#                               spark's: spark bar line)
#   spark-shell desktop on|off  the desktop and the login box, together:
#                               sway and foot, greetd's box on tty1 at the
#                               next boot (DESKTOP=sway in the config); off
#                               hands it all back, getty on tty1 again
#   spark-shell desktop         sway and one foot window on this console,
#                               now (Linux, from a console login)
#   spark-shell desktop wallpaper [PATH|default|none]
#                               the picture behind the windows (gaps and a
#                               translucent foot show it); bare: the current
#   spark-shell desktop "WORDS" a desk for that need: the model picks the
#                               windows from the apps this machine has and
#                               sway lays them out on an empty workspace
#                               (Super+d asks the same at a prompt)
#   spark-shell desktop keep [WORDS] | WORDS | forget WORDS
#                               keep the last desk under those words (its
#                               own by default), open a kept one by its
#                               words (no model), or drop it; bare, inside
#                               the desktop: the kept desks
#   spark-shell desktop apps | tools
#                               what a desk may open: a picker over the
#                               box's apps, or over its tools (Tab flips a
#                               mark, Enter saves), one list of marks,
#                               yours in ~/.config/spark-shell/apps
#   spark-shell sbom [apps|tools|parts|NAME] [--json]
#                               the box's software, in the package
#                               manager's words: version, licence, chosen
#                               or dependency, commands, desktop entries;
#                               --json writes CycloneDX 1.5
#   spark-shell on --dry-run    print what would change, touch nothing
#
# The one interface to spark is ~/.config/spark/theme.env -- the palette
# `spark theme NAME` writes (21 THEME_* keys, THEME_LOGO optional). No
# theme.env: the terminal keeps its own colours. Back to spark go three
# exports, SPARK_ACCENT_SGR, SPARK_MUTED_SGR and SPARK_WARN_SGR (the
# rendered ~/.config/spark-shell/sgr.sh): the prompt's colour, from the
# same slots. spark itself is not required; without it the status line
# stays empty and everything else works. Nothing leaves this machine
# except the package manager and two pinned, sha256-verified downloads
# (starship).
#
# POSIX sh, both OSes (Debian and Arch families, macOS). Choices live in
# ~/.config/spark-shell/config (KEY=value): PROMPT starship|plain,
# PROMPT_STYLE minimal|full, GIT_NAME, GIT_EMAIL, DESKTOP none|sway,
# FONT (foot's spec, DejaVu Sans Mono:size=12), WALLPAPER default|none|PATH,
# ALPHA (foot over a picture, 0.85). The first
# `on` with no config seeds them from spark's site.env when the old
# SITE_* keys are there (read once, copied, never read again). A
# .gitconfig is rendered with an identity you gave (both GIT_NAME and
# GIT_EMAIL); one you already have stays yours.
#
# The login box (DESKTOP=sway) is the one root render: /etc/greetd and a
# greetd.service drop-in, written with sudo only when they differ, and
# greetd enabled on tty1 in getty's place for the next boot -- never
# started or stopped live. SPARK_SHELL_ROOT=DIR (tests only) prefixes
# every root path with DIR, writes plainly, and takes systemctl from PATH.
set -eu

# ~/.local/bin/spark-shell is a symlink into the clone: resolve it, the
# way spark's bin/spark does, so the templates are found from anywhere
SELF=$0
while [ -L "$SELF" ]; do
    _t=$(readlink "$SELF")
    case $_t in /*) SELF=$_t ;; *) SELF=$(dirname "$SELF")/$_t ;; esac
done
REPO=$(cd "$(dirname "$SELF")" && pwd)
OS=$(uname -s)
ARCH=$(uname -m)
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/spark-shell
CONFIG=$CONFIG_DIR/config
SPARK_CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/spark
THEME_ENV=$SPARK_CONFIG_DIR/theme.env

# ------------------------------------------------------------ pinned bits
# Everything not packaged is pinned by version and sha256. An empty sha
# means "not pinned yet": the block skips with a notice, never guesses.
STARSHIP_VERSION=1.26.0
STARSHIP_SHA_X86_64=321f0dd7af8340a5f2e6a8fec6538a04f617486f9ec70d878f91c09cd8deef22
STARSHIP_SHA_AARCH64=dc30189378d2f2e287384e8a692d3f95ad1df64cf0e8c36aa9201516028aed6b
# yazi, the file manager: a package on Arch and Homebrew; Debian has none,
# so there it is this pinned release (a zip -- unzip is in PKG_CLI)
YAZI_VERSION=26.9.1
YAZI_SHA_X86_64=a02fe91d3304294048c681f010f1100856872a4e98ecf6927328e888d40a6ad2
YAZI_SHA_AARCH64=dd569daecaae914185f295634109295ccd25c1b42b02eb89a74f651970024f2e

# --------------------------------------------------------------- readers
# load_env FILE: set every KEY the environment does not already set.
# A deliberate copy of spark lib/env.sh load_env (the twin): a valid line
# is blank, a comment, or KEY=value with no shell syntax in the value.
load_env() {
    [ -f "$1" ] || return 0
    bad=$(grep -nEv '^[[:space:]]*(#|$)|^[A-Z_0-9]+=[^;`$()|&<>]*$' "$1" || true)
    if [ -n "$bad" ]; then
        printf 'spark-shell: %s: refused, these lines are not KEY=value:\n%s\n' "$1" "$bad" >&2
        return 1
    fi
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|'#'*|' '*|'	'*) continue ;; esac
        key=${line%%=*}
        val=${line#*=}
        case $val in \"*\") val=${val#\"}; val=${val%\"} ;; esac
        tilde='~'
        case $val in "$tilde"|"$tilde/"*) val=$HOME${val#"$tilde"} ;; esac
        [ -n "$val" ] || continue
        eval "cur=\${$key:-}"
        [ -n "$cur" ] || export "$key=$val"
    done < "$1"
}

# This machine's short name (the twin of spark lib/env.sh short_host)
short_host() {
    _host=
    [ "$OS" != Darwin ] || _host=$(scutil --get LocalHostName 2>/dev/null || true)
    [ -n "$_host" ] || _host=$(hostname -s 2>/dev/null || uname -n | cut -d. -f1)
    printf '%s' "$_host"
}

config_load() {
    if [ ! -f "$CONFIG" ] && [ -f "$SPARK_CONFIG_DIR/site.env" ]; then
        # first run on a machine that ran spark's old shell layer: the
        # choices are seeded from site.env once, then this file is
        # the only one read
        # shellcheck disable=SC2153   # the SITE_* names come from site.env
        ( load_env "$SPARK_CONFIG_DIR/site.env" || true
          mkdir -p "$CONFIG_DIR"
          {
            printf '# spark-shell config -- KEY=value; seeded from spark site.env\n'
            [ -z "${SITE_PROMPT:-}" ] || printf 'PROMPT=%s\n' "$SITE_PROMPT"
            [ -z "${SITE_PROMPT_STYLE:-}" ] || printf 'PROMPT_STYLE=%s\n' "$SITE_PROMPT_STYLE"
            [ -z "${SITE_GIT_NAME:-}" ] || [ "${SITE_GIT_NAME:-}" = "Your Name" ] || printf 'GIT_NAME=%s\n' "$SITE_GIT_NAME"
            [ -z "${SITE_GIT_EMAIL:-}" ] || [ "${SITE_GIT_EMAIL:-}" = "you@example.com" ] || printf 'GIT_EMAIL=%s\n' "$SITE_GIT_EMAIL"
          } > "$CONFIG" )
    fi
    load_env "$CONFIG" || exit 1
    : "${PROMPT:=starship}"
    : "${PROMPT_STYLE:=minimal}"
    : "${GIT_NAME:=}" "${GIT_EMAIL:=}"      # no guess: an identity is yours to give
    : "${DESKTOP:=none}"
    : "${FONT:=DejaVu Sans Mono:size=12}"   # foot's spec, verbatim
    : "${WALLPAPER:=default}"               # the desktop's picture: default (the forge), none, or an absolute path
    : "${ALPHA:=0.85}"                      # foot over a picture: 0..1, 1 = opaque
    case $ALPHA in 0|1|0.[0-9]|0.[0-9][0-9]|1.0) ;;
        *) echo "spark-shell: ALPHA=$ALPHA in $CONFIG: 0 to 1 (0.85)" >&2; exit 1 ;; esac
    case $DESKTOP in none|sway) ;;
        *) echo "spark-shell: DESKTOP=$DESKTOP in $CONFIG: none or sway" >&2; exit 1 ;; esac
    export PROMPT PROMPT_STYLE GIT_NAME GIT_EMAIL DESKTOP FONT WALLPAPER ALPHA
}
config_set() {   # config_set KEY VALUE -- one line replaced or added; every other line kept
    mkdir -p "$CONFIG_DIR"
    if [ -f "$CONFIG" ] && grep -q "^$1=" "$CONFIG"; then
        sed "s|^$1=.*|$1=$2|" "$CONFIG" > "$TMP/config"
        cp "$TMP/config" "$CONFIG"
    else
        [ -f "$CONFIG" ] || printf '# spark-shell config -- KEY=value (config.example shows the keys)\n' > "$CONFIG"
        printf '%s=%s\n' "$1" "$2" >> "$CONFIG"
    fi
    row ok config "$1=$2 ($CONFIG)"
}

THEME_KEYS="THEME_BG THEME_FG THEME_ACCENT THEME_MUTED THEME_BTOP THEME_ANSI_0 THEME_ANSI_1 THEME_ANSI_2 THEME_ANSI_3 THEME_ANSI_4 THEME_ANSI_5 THEME_ANSI_6 THEME_ANSI_7 THEME_ANSI_8 THEME_ANSI_9 THEME_ANSI_10 THEME_ANSI_11 THEME_ANSI_12 THEME_ANSI_13 THEME_ANSI_14 THEME_ANSI_15"

# ------------------------------------------------------------- the slots
# The rendered look names colours by palette slot (0-15: tmux colourN,
# starship's sixteen colour words), never by hex: the console
# palette `spark theme NAME` programs is what draws them, so one file is
# right on the Linux console and merely plain in an emulator. THEME_ACCENT
# and THEME_MUTED are hex in theme.env: each becomes the slot whose
# THEME_ANSI_n is nearest by RGB distance, the lowest index on a tie (a
# palette's bright row often repeats its dim one). A colour word (the
# no-theme.env defaults) is its own slot. BG and FG are the terminal's
# own (`default`).
# ACCENT_SGR and MUTED_SGR are the same two slots as SGR parameters
# (30-37 for slots 0-7, 90-97 for 8-15): what spark >= 1.41 reads from
# the three SPARK_*_SGR exports to colour its prompt at a tty.
SLOT_KEYS="ACCENT_SLOT MUTED_SLOT ACCENT_STAR MUTED_STAR ACCENT_SGR MUTED_SGR"
hex_rgb() {   # hex_rgb #rrggbb -> "r g b" (decimal), or false
    case $1 in \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;; *) return 1 ;; esac
    _h=${1#\#}; _m=${_h#??}
    printf '%d %d %d' "$((0x${_h%????}))" "$((0x${_m%??}))" "$((0x${_h#????}))"
}
slot_of() {   # slot_of COLOUR -> 0..15
    case $1 in
        black) echo 0; return ;; red) echo 1; return ;; green) echo 2; return ;;
        yellow) echo 3; return ;; blue) echo 4; return ;; magenta) echo 5; return ;;
        cyan) echo 6; return ;; white) echo 7; return ;;
    esac
    want=$(hex_rgb "$1") || { echo 7; return; }
    best=; slot=7; i=0
    while [ "$i" -le 15 ]; do
        eval "c=\$THEME_ANSI_$i"
        # shellcheck disable=SC2154   # c is set by the eval above
        if rgb=$(hex_rgb "$c"); then
            # shellcheck disable=SC2086   # six numbers, split on purpose
            set -- $want $rgb
            d=$(( ($1-$4)*($1-$4) + ($2-$5)*($2-$5) + ($3-$6)*($3-$6) ))
            if [ -z "$best" ] || [ "$d" -lt "$best" ]; then best=$d; slot=$i; fi
        fi
        i=$((i + 1))
    done
    echo "$slot"
}
sgr_of() {   # sgr_of N -> the SGR foreground parameter for slot N (30-37, 90-97)
    if [ "$1" -lt 8 ]; then echo $((30 + $1)); else echo $((82 + $1)); fi
}
slot_name() {   # slot_name N -> starship's word for slot N (black .. bright-white)
    _n=$1
    set -- black red green yellow blue purple cyan white
    if [ "$_n" -ge 8 ]; then shift $((_n - 8)); echo "bright-$1"; else shift "$_n"; echo "$1"; fi
}
tui_name() {   # tui_name N -> tuigreet's (ratatui's) word for slot N (black .. white)
    _n=$1
    set -- black red green yellow blue magenta cyan gray darkgray lightred lightgreen lightyellow lightblue lightmagenta lightcyan white
    shift "$_n"; echo "$1"
}
slot_or() {   # slot_or COLOUR FALLBACK -> the nearest slot of a #rrggbb, else FALLBACK (a colour word, `default`)
    if hex_rgb "$1" >/dev/null; then slot_of "$1"; else echo "$2"; fi
}

# theme.env: written by `spark theme NAME` -- the interface (contract 3's
# 21 keys). Absent, or spark absent: colour words, each its own slot (the
# twin of spark lib/env.sh theme_load's `none` block). Then the slots.
theme_load() {
    if [ -f "$THEME_ENV" ]; then
        load_env "$THEME_ENV" || return 1
    fi
    : "${THEME_BG:=default}" "${THEME_FG:=default}" "${THEME_ACCENT:=blue}" "${THEME_MUTED:=white}" "${THEME_BTOP:=Default}"
    : "${THEME_ANSI_0:=black}" "${THEME_ANSI_1:=red}" "${THEME_ANSI_2:=green}" "${THEME_ANSI_3:=yellow}"
    : "${THEME_ANSI_4:=blue}" "${THEME_ANSI_5:=magenta}" "${THEME_ANSI_6:=cyan}" "${THEME_ANSI_7:=white}"
    : "${THEME_ANSI_8:=black}" "${THEME_ANSI_9:=red}" "${THEME_ANSI_10:=green}" "${THEME_ANSI_11:=yellow}"
    : "${THEME_ANSI_12:=blue}" "${THEME_ANSI_13:=magenta}" "${THEME_ANSI_14:=cyan}" "${THEME_ANSI_15:=white}"
    for k in $THEME_KEYS; do export "${k?}"; done
    ACCENT_SLOT=$(slot_of "$THEME_ACCENT"); MUTED_SLOT=$(slot_of "$THEME_MUTED")
    ACCENT_STAR=$(slot_name "$ACCENT_SLOT"); MUTED_STAR=$(slot_name "$MUTED_SLOT")
    ACCENT_SGR=$(sgr_of "$ACCENT_SLOT"); MUTED_SGR=$(sgr_of "$MUTED_SLOT")
    export ACCENT_SLOT MUTED_SLOT ACCENT_STAR MUTED_STAR ACCENT_SGR MUTED_SGR
    tui_load
    hex_load
    wall_load
}

# The login box's words. tuigreet draws with ratatui's sixteen colour
# names, one per slot (gray is slot 7, darkgray slot 8, white slot 15),
# and the console palette gives them their colours: the same slots as
# the rest of the look. The box's background and text are the palette's
# BG and FG by their nearest slot (`default`, no theme.env: slots 0 and 7).
TUI_KEYS="ACCENT_TUI MUTED_TUI BG_TUI FG_TUI"
tui_load() {
    # shellcheck disable=SC2034   # read by render_expr through TUI_KEYS
    ACCENT_TUI=$(tui_name "$ACCENT_SLOT"); MUTED_TUI=$(tui_name "$MUTED_SLOT")
    # shellcheck disable=SC2034
    BG_TUI=$(tui_name "$(slot_or "$THEME_BG" 0)"); FG_TUI=$(tui_name "$(slot_or "$THEME_FG" 7)")
    export ACCENT_TUI MUTED_TUI BG_TUI FG_TUI
}

# The desktop's hex. foot is the desktop's twin of the console palette:
# the one surface that gives the sixteen slots their colours (the kernel
# console gets them from `spark theme NAME`), so it, and sway's borders
# beside it, take the palette's own rrggbb -- every other render keeps
# naming slots. A THEME_* that is #rrggbb is stripped of its `#`; a
# colour word (no theme.env) is the VGA sixteen, what `spark theme none`
# programs. HEX_BG and HEX_FG fall back to slots 0 and 7, HEX_ACCENT and
# HEX_MUTED to their slot's hex.
HEX_KEYS="HEX_BG HEX_FG HEX_ACCENT HEX_MUTED HEX_ANSI_0 HEX_ANSI_1 HEX_ANSI_2 HEX_ANSI_3 HEX_ANSI_4 HEX_ANSI_5 HEX_ANSI_6 HEX_ANSI_7 HEX_ANSI_8 HEX_ANSI_9 HEX_ANSI_10 HEX_ANSI_11 HEX_ANSI_12 HEX_ANSI_13 HEX_ANSI_14 HEX_ANSI_15"
VGA_HEX="000000 aa0000 00aa00 aa5500 0000aa aa00aa 00aaaa aaaaaa 555555 ff5555 55ff55 ffff55 5555ff ff55ff 55ffff ffffff"
hex_or() {   # hex_or COLOUR FALLBACK -> rrggbb, lowercase
    case $1 in
        \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) printf '%s' "${1#\#}" | tr 'A-F' 'a-f' ;;
        *) printf '%s' "$2" ;;
    esac
}
hex_load() {
    i=0
    for h in $VGA_HEX; do
        eval "c=\$THEME_ANSI_$i"
        eval "HEX_ANSI_$i=\$(hex_or \"\$c\" \"$h\")"
        i=$((i + 1))
    done
    # shellcheck disable=SC2034   # read by render_expr through HEX_KEYS
    HEX_BG=$(hex_or "$THEME_BG" "$HEX_ANSI_0")
    # shellcheck disable=SC2034
    HEX_FG=$(hex_or "$THEME_FG" "$HEX_ANSI_7")
    eval "HEX_ACCENT=\$(hex_or \"\$THEME_ACCENT\" \"\$HEX_ANSI_$ACCENT_SLOT\")"
    eval "HEX_MUTED=\$(hex_or \"\$THEME_MUTED\" \"\$HEX_ANSI_$MUTED_SLOT\")"
    for k in $HEX_KEYS; do export "${k?}"; done
}

# The wallpaper: a picture behind the windows, or the palette's own
# background. With a picture, sway keeps gaps around the windows and foot
# is a little translucent, so it shows; without one, edge to edge and
# opaque. A path that is not there falls back to the solid colour (the
# render says so in a row), never to a black screen.
WALL_KEYS="WALL_BG GAPS_INNER GAPS_OUTER FOOT_ALPHA"
WALL_DEFAULT=$REPO/wallpapers/forge-1920x1080.jpg   # the forge, shipped here (wallpapers/)
wall_path() { if [ "$WALLPAPER" = default ]; then printf '%s' "$WALL_DEFAULT"; else printf '%s' "$WALLPAPER"; fi; }
wall_there() { [ "$WALLPAPER" != none ] && [ -r "$(wall_path)" ]; }
wall_load() {
    # shellcheck disable=SC2034   # read by render_expr through WALL_KEYS
    if wall_there; then
        WALL_BG="\"$(wall_path)\" fill"; GAPS_INNER=8; GAPS_OUTER=12; FOOT_ALPHA=$ALPHA
    else
        WALL_BG="#$HEX_BG solid_color"; GAPS_INNER=0; GAPS_OUTER=0; FOOT_ALPHA=1.0
    fi
    # shellcheck disable=SC2034   # read by render_expr through WALL_KEYS
    for k in $WALL_KEYS; do export "${k?}"; done
}

# ------------------------------------------------------------------ rows
# The row vocabulary is spark bootstrap.sh's (the twin): ok | would |
# skip | todo; an apply run says what it changed, --dry-run says all.
MODE=apply
VERBOSE=0
todo=0
acting=0
row() { printf '%-6s %-12s %s\n' "$1" "$2" "${3:-}"; }
loud() { [ "$MODE" = dry ] || [ "$VERBOSE" = 1 ]; }
ok() { if loud || [ "$acting" = 1 ]; then row ok "$1" "${2:-}"; fi; acting=0; }
skip() { if loud; then row skip "$1" "${2:-}"; fi; acting=0; }
need() {
    todo=$((todo + 1))
    if [ "$MODE" = dry ]; then row would "$1" "${2:-}"; return 1; fi
    acting=1
    return 0
}
as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }
sudo_upfront() {
    # ask once, before anything is touched (the twin of bootstrap.sh's)
    [ "$MODE" = apply ] || return 0
    [ "$(id -u)" -ne 0 ] || return 0
    [ "$OS" = Darwin ] && return 0              # brew never needs root
    command -v sudo >/dev/null 2>&1 || return 0
    sudo -n true 2>/dev/null && return 0
    [ -t 0 ] || return 0
    what="the packages"
    desktop_wanted && what="the packages and the login box (tty1)"
    printf 'spark-shell needs sudo once, now: %s.\n' "$what"
    sudo -v || { echo "spark-shell: sudo refused. Nothing was changed." >&2; exit 1; }
}
# The root renders (the login box) go through these three. ROOT is empty
# on a machine; SPARK_SHELL_ROOT=DIR (tests) prefixes every root path and
# makes root_do a plain call -- no sudo, systemctl from PATH.
ROOT=${SPARK_SHELL_ROOT:-}
root_do() { if [ -n "$ROOT" ]; then "$@"; else as_root "$@"; fi; }
root_can() {   # is there a root to write with (now, or at a tty)?
    [ -n "$ROOT" ] || [ "$(id -u)" -eq 0 ] || sudo -n true 2>/dev/null || { command -v sudo >/dev/null 2>&1 && [ -t 0 ]; }
}
root_sudo_once() {   # the password, once, said why (a no-op after sudo_upfront)
    [ -z "$ROOT" ] || return 0
    [ "$(id -u)" -ne 0 ] || return 0
    sudo -n true 2>/dev/null && return 0
    printf 'spark-shell needs sudo once, now: the login box (tty1).\n'
    sudo -v
}
sha_ok() {
    if [ "$OS" = Darwin ]; then shasum -a 256 "$1" | awk '{print $1}' | grep -qx "$2"
    else sha256sum "$1" | awk '{print $1}' | grep -qx "$2"; fi
}
TMP=$(mktemp -d)
PARTIAL=
PULSE=''
trap 'rm -rf "$TMP"; [ -z "$PARTIAL" ] || rm -f "$PARTIAL"; [ -z "$PULSE" ] || kill "$PULSE" 2>/dev/null' EXIT
fetch() {   # fetch URL DEST SHA -- download, verify, or die (the twin)
    PARTIAL=$2
    if [ -t 2 ]; then
        printf '       downloading %s\n' "${1##*/}"
        curl -fL --retry 3 --progress-bar -o "$2" "$1" || { echo "spark-shell: download failed: $1" >&2; exit 1; }
    else
        curl -fsSL --retry 3 -o "$2" "$1" || { echo "spark-shell: download failed: $1" >&2; exit 1; }
    fi
    sha_ok "$2" "$3" || { echo "spark-shell: sha256 mismatch for $1" >&2; exit 1; }
    PARTIAL=
}

# -------------------------------------------------------------- packages
# One place switches on the manager (the twin of bootstrap.sh pkg_*).
PM=
DISTRO=
pm_detect() {
    # SPARK_OS_RELEASE pins the family (tests), even on macOS -- the
    # same fixture pattern spark's bootstrap uses
    if [ "$OS" = Darwin ] && [ -z "${SPARK_OS_RELEASE:-}" ]; then PM=brew; return; fi
    _f=${SPARK_OS_RELEASE:-/etc/os-release}
    for w in $(sed -n 's/^ID=//p; s/^ID_LIKE=//p' "$_f" 2>/dev/null | tr -d '"'); do
        case $w in debian|arch) DISTRO=$w; break ;; esac
    done
    [ -z "$DISTRO" ] || load_env "$REPO/distro/$DISTRO.env" || exit 1
    : "${PM:=}" "${PKG_SHELL:=}" "${PKG_CLI:=}" "${PKG_DESKTOP:=}" "${PKG_GREETER:=}"
}
pkg_installed() {
    case $PM in
        apt) dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed' ;;
        pacman) pacman -Qq "$1" >/dev/null 2>&1 ;;
        *) return 1 ;;
    esac
}
pkg_install() {
    case $PM in
        apt) as_root apt-get update -qq && as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@" ;;
        pacman) as_root pacman -S --needed --noconfirm "$@" ;;
        *) return 1 ;;
    esac
}

# --------------------------------------------------------------- renders
# The link/render engine is the twin of spark install.sh's: a symlink for
# a file used as-is, a rendered regular file where a value is baked in.
# Yours is never overwritten -- it moves to <path>.bak. A file marked
# `rendered by spark` (spark's old shell layer) is adopted as ours.
changes=0
backup() {
    changes=$((changes + 1))
    if [ "$MODE" = dry ]; then row would "back up" "$1"; return; fi
    mv "$1" "$1.bak"
    row "back" "up" "$1 -> $1.bak"
}
link_one() {   # link_one SRC DST
    if [ -L "$2" ] && [ "$(readlink "$2")" = "$1" ]; then ok rc "$2"; return; fi
    if [ -e "$2" ] && [ ! -L "$2" ]; then backup "$2"
    elif [ -L "$2" ]; then case $(readlink "$2") in "$REPO"/*) ;; *) backup "$2" ;; esac; fi
    changes=$((changes + 1))
    if [ "$MODE" = dry ]; then row would rc "$2"; return; fi
    mkdir -p "$(dirname "$2")"
    ln -sfn "$1" "$2"
    row link rc "$2"
}
esc() { printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'; }
render_expr() {
    e="s|@HOME@|$(esc "$HOME")|g;s|@USER@|$(esc "$(id -un)")|g;s|@NAME@|$(esc "$(short_host)")|g;s|@REPO@|$(esc "$REPO")|g"
    e="$e;s|@GIT_NAME@|$(esc "$GIT_NAME")|g;s|@GIT_EMAIL@|$(esc "$GIT_EMAIL")|g"
    for k in $THEME_KEYS; do
        eval "v=\$$k"
        # shellcheck disable=SC2154   # v is set by the eval above
        e="$e;s|@$k@|$(esc "$v")|g"
    done
    for k in $SLOT_KEYS $TUI_KEYS $HEX_KEYS $WALL_KEYS; do
        eval "v=\$$k"
        e="$e;s|@$k@|$(esc "$v")|g"
    done
    e="$e;s|@FONT@|$(esc "$FONT")|g"
    e="$e;s|@FOOT_COLORS@|$(foot_colors)|g"
    e="$e;s|@GREET_BG@|$(greet_background)|g"
    printf '%s' "$e"
}
render_tmp() {   # render_tmp SRC DST -- the template through EXPR, every placeholder gone
    sed -e "$EXPR" "$1" > "$2"
    if grep -q '@[A-Z_0-9]*@' "$2"; then
        printf 'spark-shell: %s: unrendered placeholder: %s\n' "$1" "$(grep -o '@[A-Z_0-9]*@' "$2" | head -1)" >&2
        exit 1
    fi
}
render_one() {   # render_one SRC DST -- EXPR must be set
    render_tmp "$1" "$TMP/render"
    if [ -f "$2" ] && [ ! -L "$2" ] && cmp -s "$TMP/render" "$2"; then ok look "$2"; return; fi
    if [ -f "$2" ] && [ ! -L "$2" ] && ! grep -q 'rendered by spark' "$2"; then backup "$2"; fi
    changes=$((changes + 1))
    if [ "$MODE" = dry ]; then row would look "$2"; return; fi
    mkdir -p "$(dirname "$2")"
    rm -f "$2"
    cp "$TMP/render" "$2"
    chmod 0644 "$2"
    row render look "$2"
}

# What `on` renders and `off` hands back. sgr.sh is the prompt's colour:
# the three exports the rc files source before spark's hook line.
RENDERED=".tmux.conf .config/btop/btop.conf .config/spark-shell/sgr.sh .config/yazi/theme.toml"
# .gitconfig: only with an identity you gave (GIT_NAME and GIT_EMAIL in
# the config, or seeded from an old site.env) -- never a guess -- and
# never over a .gitconfig of yours
GITCONFIG=.gitconfig
gitconfig_wanted() { [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; }
gitconfig_yours() { [ -f "$HOME/$GITCONFIG" ] && ! grep -q 'rendered by spark' "$HOME/$GITCONFIG"; }
render_gitconfig() {   # no identity given: nothing to do, nothing to say
    if ! gitconfig_wanted; then :
    elif gitconfig_yours; then skip gitconfig "$HOME/$GITCONFIG is yours, left alone (GIT_NAME/GIT_EMAIL not applied over it)"
    else render_one "$REPO/templates/$GITCONFIG" "$HOME/$GITCONFIG"; fi
}
rc_files() { if [ "$OS" = Darwin ]; then echo ".zshrc .zprofile"; else echo ".bashrc .bash_profile"; fi; }
rc_tree() { if [ "$OS" = Darwin ]; then echo "$REPO/templates/macos"; else echo "$REPO/templates/linux"; fi; }
# The desktop: sway and foot, rendered only when asked for (DESKTOP=sway)
# and only on Linux -- macOS has its own desktop. `off` hands both back
# whatever the config says.
DESKTOP_RENDERED=".config/foot/foot.ini .config/sway/config .local/share/applications/spark-shell-tmux.desktop"
foot_colors() {   # the name of foot's colour section: [colors] before 1.26, [colors-dark] from it
    _v=$(PATH=$HOME/.local/bin:$PATH foot --version 2>/dev/null | sed -n 's/^foot version: \([0-9]*\)\.\([0-9]*\).*/\1 \2/p')
    set -- ${_v:-1 26}
    if [ "$1" -gt 1 ] || [ "$2" -ge 26 ]; then echo colors-dark; else echo colors; fi
}
greet_background() {   # the login box's DOOM fire: tuigreet 0.11+ has --background; older, nothing
    if PATH=$HOME/.local/bin:$PATH tuigreet --help 2>&1 | grep -q -- '--background NAME'; then   # help is on stderr
        printf ' --background doom'
    fi
}
desktop_wanted() { [ "$OS" != Darwin ] && [ "$DESKTOP" = sway ]; }
desktop_tools() {   # -> the missing ones, if any (PATH or ~/.local/bin)
    _miss=''
    for t in sway foot; do
        command -v "$t" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$t" ] || _miss="$_miss $t"
    done
    printf '%s' "$_miss"
}
sway_reload() {   # a running sway takes the new render now (borders, background)
    [ "$MODE" = dry ] && return 0
    [ -n "${SWAYSOCK:-}" ] || return 0
    [ -f "$HOME/.config/sway/config" ] || return 0
    command -v swaymsg >/dev/null 2>&1 || return 0
    swaymsg reload >/dev/null 2>&1 || return 0
    row ok sway "reloaded (~/.config/sway/config)"
}
# The desktop, one path for `on`, `apply` and `desktop on`: the two user
# renders, a running sway reloaded, then the login box.
desktop_look_apply() {   # the two user renders and a live sway
    if [ "$WALLPAPER" != none ] && ! wall_there; then
        row todo wallpaper "$(wall_path) is not there -- the palette's colour meanwhile (spark-shell desktop wallpaper PATH)"
    fi
    for rel in $DESKTOP_RENDERED; do
        render_one "$REPO/templates/$rel" "$HOME/$rel"
    done
    sway_reload
}
desktop_apply() {
    desktop_look_apply
    greeter_apply
}

# The login box: greetd with tuigreet on tty1, in getty's place at the
# next boot. Three root renders (the greeter's config, the two sessions
# it offers -- desktop = sway, console = a login shell -- and a drop-in
# that orders it after spark's console-palette unit, so the first draw
# is already in the palette) and the two unit switches. A root render is
# written only when it differs from what is on disk, through root_do; a
# config.toml that is not ours goes to config.toml.spark-orig once and
# comes back on off. Neither unit is ever started or stopped live: that
# would end the tty1 session this runs in. Refusing sudo, or none at all,
# is a todo row, never a failure.
GREETD_CONF=etc/greetd/config.toml
ROOT_RENDERED="$GREETD_CONF etc/greetd/spark-shell/desktop.desktop etc/greetd/spark-shell/console.desktop etc/systemd/system/greetd.service.d/spark-shell.conf"
ROOT_DIRS="etc/greetd/spark-shell etc/systemd/system/greetd.service.d"
root_changed=0
greeter_tools() {   # -> the missing ones, if any (greetd may live in sbin)
    _miss=''
    command -v tuigreet >/dev/null 2>&1 || [ -x "$HOME/.local/bin/tuigreet" ] || _miss="$_miss tuigreet"
    command -v greetd >/dev/null 2>&1 || [ -x /usr/sbin/greetd ] || [ -x /usr/bin/greetd ] || [ -x "$HOME/.local/bin/greetd" ] || _miss="$_miss greetd"
    printf '%s' "$_miss"
}
greeter_ours() { grep -q 'rendered by spark' "$ROOT/$GREETD_CONF" 2>/dev/null || [ -e "$ROOT/$GREETD_CONF.spark-orig" ]; }
unit_enabled() { systemctl is-enabled "$1" >/dev/null 2>&1; }
greeter_at_boot() { unit_enabled greetd.service && ! unit_enabled getty@tty1.service; }
root_render_one() {   # root_render_one SRC DST -- EXPR must be set
    render_tmp "$1" "$TMP/render"
    if [ -f "$2" ] && cmp -s "$TMP/render" "$2"; then ok greeter "$2"; return; fi
    changes=$((changes + 1))
    need greeter "$2 (sudo)" || return 0
    if ! root_can; then row todo greeter "$2 -- spark-shell desktop on at a terminal (sudo once)"; acting=0; return 0; fi
    root_sudo_once || { row todo greeter "sudo refused -- spark-shell desktop on at a terminal (sudo once)"; acting=0; return 0; }
    if [ -f "$2" ] && ! grep -q 'rendered by spark' "$2" && [ ! -e "$2.spark-orig" ]; then
        root_do cp "$2" "$2.spark-orig"        # the original, once: off puts it back
    fi
    root_do mkdir -p "$(dirname "$2")"
    root_do cp "$TMP/render" "$2"
    root_do chmod 0644 "$2"
    root_changed=1
    row render greeter "$2"
}
greeter_apply() {
    miss=$(greeter_tools)
    if [ -n "$miss" ]; then row todo greeter "not installed:$miss -- spark-shell desktop on (the packages)"; return 0; fi
    for rel in $ROOT_RENDERED; do
        root_render_one "$REPO/templates/$rel" "$ROOT/$rel"
    done
    [ "$root_changed" = 0 ] || root_do systemctl daemon-reload >/dev/null 2>&1 || true
    if greeter_at_boot; then ok greeter "greetd on tty1 at boot (getty@tty1 off)"; return 0; fi
    need greeter "enable greetd.service, disable getty@tty1.service: greetd on tty1 at the next boot (sudo)" || return 0
    if ! root_can; then row todo greeter "greetd not yet on tty1 -- spark-shell desktop on at a terminal (sudo once)"; acting=0; return 0; fi
    root_sudo_once || { row todo greeter "sudo refused -- spark-shell desktop on at a terminal (sudo once)"; acting=0; return 0; }
    # greetd first: tty1 never loses its login
    if root_do systemctl enable greetd.service >/dev/null 2>&1; then
        root_do systemctl disable getty@tty1.service >/dev/null 2>&1 || true
        ok greeter "greetd on tty1 at the next boot (getty@tty1 until then)"
    else
        row todo greeter "systemctl enable greetd.service failed (is greetd installed?) -- spark-shell desktop on"; acting=0
    fi
}
greeter_off() {   # getty back on tty1 at the next boot, the root files handed back
    [ "$OS" != Darwin ] || return 0
    greeter_ours || return 0
    if ! root_can; then row todo greeter "greetd still on tty1 -- spark-shell desktop off at a terminal (sudo once)"; return 0; fi
    root_sudo_once || { row todo greeter "sudo refused -- spark-shell desktop off at a terminal (sudo once)"; return 0; }
    # getty first: tty1 never loses its login
    root_do systemctl enable getty@tty1.service >/dev/null 2>&1 || true
    root_do systemctl disable greetd.service >/dev/null 2>&1 || true
    conf=$ROOT/$GREETD_CONF
    if [ -e "$conf.spark-orig" ]; then
        root_do mv "$conf.spark-orig" "$conf"
        row ok restore "$conf -- back from config.toml.spark-orig"
    elif [ -e "$conf" ]; then
        root_do rm -f "$conf"
        row ok restore "$conf -- removed (no config.toml.spark-orig: there was no file before)"
    fi
    for rel in $ROOT_RENDERED; do
        [ "$rel" != "$GREETD_CONF" ] || continue
        [ -e "$ROOT/$rel" ] || continue
        root_do rm -f "$ROOT/$rel"
        row ok restore "$ROOT/$rel -- removed"
    done
    for d in $ROOT_DIRS; do [ -d "$ROOT/$d" ] && root_do rmdir "$ROOT/$d" 2>/dev/null || true; done
    root_do systemctl daemon-reload >/dev/null 2>&1 || true
    row ok greeter "getty on tty1 at the next boot (greetd until then)"
}

render_all() {
    theme_load
    EXPR=$(render_expr)
    for rel in $RENDERED; do
        render_one "$REPO/templates/$rel" "$HOME/$rel"
    done
    render_gitconfig
    if [ "$PROMPT" = starship ]; then
        render_one "$REPO/templates/.config/starship.toml.$PROMPT_STYLE" "$HOME/.config/starship.toml"
    fi
    if desktop_wanted; then desktop_apply; fi
    micro_look_gone
}

# micro (v0.2 and before) had a colorscheme rendered here. An editor's
# look is its own plugin's business (spark-micro), never the shell's: what
# v0.2 rendered is handed back once -- the scheme file if it is ours, and
# the `colorscheme` key it seeded, so micro never points at a scheme that
# is gone. settings.json is JSON, the one piece sh does not parse; python3
# is on any machine spark-shell makes sense on (spark requires it).
MICRO_SCHEME=$HOME/.config/micro/colorschemes/spark.micro
MICRO_SETTINGS=$HOME/.config/micro/settings.json
micro_look_gone() {
    [ "$MODE" = dry ] && return 0
    if [ -f "$MICRO_SCHEME" ] && grep -q 'rendered by spark' "$MICRO_SCHEME"; then
        rm -f "$MICRO_SCHEME"
        row ok restore "$MICRO_SCHEME -- removed (an editor's look is its plugin's, not the shell's)"
    fi
    python3 - "$MICRO_SETTINGS" <<'EOF' 2>/dev/null || true
import json, sys
p = sys.argv[1]
try:
    with open(p) as f: d = json.load(f)
except (OSError, ValueError): sys.exit(0)
if isinstance(d, dict) and d.get("colorscheme") == "spark":
    del d["colorscheme"]
    with open(p, "w") as f: json.dump(d, f, indent=4); f.write("\n")
    print("ok     restore      %s -- colorscheme key dropped, the rest is micro's" % p)
EOF
}

hand_back() {   # hand_back REL... -- each render of ours under HOME (marker or .bak) restored
    for rel in "$@"; do
        p=$HOME/$rel
        if [ -f "$p" ] && [ ! -L "$p" ]; then
            if grep -q 'rendered by spark' "$p" 2>/dev/null || [ -e "$p.bak" ]; then
                restore_one "$p"
            fi
        fi
    done
}
restore_one() {   # restore_one PATH -- .bak back, or gone; never a husk
    [ -e "$1" ] || [ -L "$1" ] || return 0
    rm -f "$1"
    if [ -e "$1.bak" ] || [ -L "$1.bak" ]; then
        mv "$1.bak" "$1"
        row ok restore "$1 -- back from ${1##*/}.bak"
    else
        row ok restore "$1 -- removed (no ${1##*/}.bak: there was no file before)"
    fi
}

tmux_reload() {
    command -v tmux >/dev/null 2>&1 || return 0
    tmux list-sessions >/dev/null 2>&1 || return 0
    if [ -f "$HOME/.tmux.conf" ]; then
        # what a v0.1 render set and a source-file cannot unset: the
        # console hook and the appended truecolor override
        tmux set-hook -gu client-attached >/dev/null 2>&1 || true
        tmux set -gu terminal-overrides >/dev/null 2>&1 || true
        tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
        row ok tmux "reloaded (~/.tmux.conf)"
    fi
}

# ------------------------------------------------------------------ verbs
cmd_on() {
    config_load
    sudo_upfront
    loud && printf '== packages\n'
    pm_detect
    if [ "$PM" = brew ]; then
        if ! command -v brew >/dev/null 2>&1; then
            row todo packages "Homebrew is not installed: https://brew.sh (then run again)"
        elif brew bundle check --file "$REPO/Brewfile" --no-upgrade >/dev/null 2>&1; then
            ok packages "Brewfile satisfied"
        elif need packages "brew bundle --file Brewfile"; then
            brew bundle --file "$REPO/Brewfile" --no-upgrade
            ok packages "Brewfile satisfied"
        fi
    elif [ -z "$PM" ]; then
        row todo packages "no package list for this Linux: distro/*.env know debian and arch"
    else
        missing=''
        pkgs="$PKG_SHELL $PKG_CLI"
        if desktop_wanted; then pkgs="$pkgs $PKG_DESKTOP $PKG_GREETER"; fi
        # shellcheck disable=SC2086
        for p in $pkgs; do pkg_installed "$p" || missing="$missing $p"; done
        if [ -z "$missing" ]; then ok packages "installed"
        elif [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
            # nobody to type a password here: say what is left, keep going
            # (the links and renders below need no root)
            row todo packages "still to install:$missing -- spark-shell on at a terminal (sudo once)"
        elif need packages "install$missing ($PM, sudo)"; then
            # shellcheck disable=SC2086
            pkg_install $missing
            ok packages "installed"
        fi
    fi
    # the desktop's packages ride the row above when DESKTOP=sway; say
    # why they are not there otherwise
    if [ "$OS" = Darwin ]; then
        [ "$DESKTOP" != sway ] || skip desktop "na: macOS has its own desktop"
    elif ! desktop_wanted; then
        skip desktop "DESKTOP=none (the config)"
    fi
    loud && printf '\n== pinned\n'
    if [ "$OS" = Darwin ]; then
        skip starship "Homebrew provides starship here"
    else
        if [ -x "$HOME/.local/bin/starship" ] || command -v starship >/dev/null 2>&1; then
            ok starship "$(PATH=$HOME/.local/bin:$PATH starship --version 2>/dev/null | head -1)"
        else
            case $ARCH in x86_64) sha=$STARSHIP_SHA_X86_64; tri=x86_64-unknown-linux-gnu ;;
                          aarch64) sha=$STARSHIP_SHA_AARCH64; tri=aarch64-unknown-linux-musl ;;
                          *) sha=; tri= ;; esac
            if [ -z "$sha" ]; then
                skip starship "no pin for $ARCH yet (NOTICE)"
            elif need starship "install $STARSHIP_VERSION into ~/.local/bin"; then
                fetch "https://github.com/starship/starship/releases/download/v$STARSHIP_VERSION/starship-$tri.tar.gz" "$TMP/starship.tgz" "$sha"
                mkdir -p "$HOME/.local/bin"
                tar -xzf "$TMP/starship.tgz" -C "$HOME/.local/bin" starship
                ok starship "$STARSHIP_VERSION"
            fi
        fi
        if [ -x "$HOME/.local/bin/yazi" ] || command -v yazi >/dev/null 2>&1; then
            ok yazi "$(PATH=$HOME/.local/bin:$PATH yazi --version 2>/dev/null | head -1)"
        elif [ "$PM" = pacman ]; then
            skip yazi "pacman's (the packages row)"
        else
            case $ARCH in x86_64) sha=$YAZI_SHA_X86_64; tri=x86_64-unknown-linux-gnu ;;
                          aarch64) sha=$YAZI_SHA_AARCH64; tri=aarch64-unknown-linux-musl ;;
                          *) sha=; tri= ;; esac
            if [ -z "$sha" ]; then
                skip yazi "no pin for $ARCH yet (NOTICE)"
            elif ! command -v unzip >/dev/null 2>&1; then
                skip yazi "needs unzip first (the packages row)"
            elif need yazi "install $YAZI_VERSION into ~/.local/bin"; then
                fetch "https://github.com/sxyazi/yazi/releases/download/v$YAZI_VERSION/yazi-$tri.zip" "$TMP/yazi.zip" "$sha"
                mkdir -p "$HOME/.local/bin"
                unzip -q -o -j "$TMP/yazi.zip" "yazi-$tri/yazi" "yazi-$tri/ya" -d "$HOME/.local/bin"
                chmod 0755 "$HOME/.local/bin/yazi" "$HOME/.local/bin/ya"
                ok yazi "$YAZI_VERSION"
            fi
        fi
    fi
    # terminfo: tmux-256color must know modified arrow keys
    if infocmp -1x tmux-256color 2>/dev/null | grep -q 'kUP='; then
        ok terminfo "tmux-256color knows modified arrow keys"
    elif [ "$OS" = Darwin ]; then
        nc=$(brew --prefix ncurses 2>/dev/null || true)
        if [ ! -x "$nc/bin/infocmp" ]; then skip terminfo "Homebrew ncurses not installed yet"
        elif need terminfo "compile tmux-256color from Homebrew ncurses into ~/.terminfo"; then
            "$nc/bin/infocmp" -x tmux-256color > "$TMP/tmux.ti"
            tic -x -o "$HOME/.terminfo" "$TMP/tmux.ti"
            ok terminfo "compiled into ~/.terminfo"
        fi
    else
        skip terminfo "tmux-256color lacks kUP here; a newer ncurses-term has it"
    fi
    loud && printf '\n== the look\n'
    tree=$(rc_tree)
    for f in $(rc_files); do
        link_one "$tree/$f" "$HOME/$f"
    done
    render_all
    # spark-shell on PATH, so the prompt and tmux can call it
    link_one "$REPO/spark-shell" "$HOME/.local/bin/spark-shell"
    tmux_reload
    if [ "$MODE" = dry ]; then
        if [ "$todo" -eq 0 ]; then echo "Nothing to do"; else echo "$todo to do"; fi
    else
        theme_seen
        echo "open a new shell (exec \$SHELL)"
    fi
}

cmd_off() {
    config_load
    for f in $(rc_files); do
        p=$HOME/$f
        # only spark-shell's own symlink is handed back; a hook line or
        # your own file is not ours to touch
        if [ -L "$p" ]; then
            case $(readlink "$p") in "$REPO"/*) restore_one "$p" ;; esac
        fi
    done
    hand_back $RENDERED $GITCONFIG .config/starship.toml $DESKTOP_RENDERED
    greeter_off
    micro_look_gone
    # spark's own hook must survive the hand-back: a restored or absent
    # rc file gets the one marked line back when spark is installed here
    hook_line=''
    case $OS in
        Darwin) [ -r "$SPARK_CONFIG_DIR/hook.zsh" ] && hook_line='[[ -r ~/.config/spark/hook.zsh ]] && source ~/.config/spark/hook.zsh   # spark: the AI at the prompt' ;;
        *) [ -r "$SPARK_CONFIG_DIR/hook.bash" ] && hook_line='[ -r ~/.config/spark/hook.bash ] && . ~/.config/spark/hook.bash   # spark: the AI at the prompt' ;;
    esac
    if [ -n "$hook_line" ]; then
        case $OS in Darwin) rcf=$HOME/.zshrc ;; *) rcf=$HOME/.bashrc ;; esac
        if ! grep -q 'config/spark/hook\.' "$rcf" 2>/dev/null; then
            printf '%s\n' "$hook_line" >> "$rcf"
            row ok rc "$rcf -- spark's hook line kept"
        fi
    fi
    tmux_reload
    echo "packages stay installed -- the package manager removes them if you want"
    echo "open a new shell (exec \$SHELL)"
}

cmd_apply() {
    config_load
    render_all
    tmux_reload
    if [ "$changes" -eq 0 ] && [ "$todo" -eq 0 ]; then echo "Nothing to do"; fi
    theme_seen
}

# The look follows the palette: the login profile runs `spark-shell
# follow`, which re-renders the user's files (never root's: the login box
# follows at the next apply, which has sudo) when theme.env changed since
# the last render -- one cksum, nothing else, when it did not. So `spark
# theme NAME` alone reaches the next login; apply is for now.
SEEN=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/theme.seen
theme_sum() { if [ -f "$THEME_ENV" ]; then cksum < "$THEME_ENV" | cut -d' ' -f1; else echo none; fi; }
theme_seen() { mkdir -p "$(dirname "$SEEN")"; theme_sum > "$SEEN"; }
cmd_follow() {
    config_load
    [ "$(theme_sum)" != "$(cat "$SEEN" 2>/dev/null)" ] || return 0
    theme_load
    EXPR=$(render_expr)
    n=0
    for rel in $RENDERED; do render_one "$REPO/templates/$rel" "$HOME/$rel" >/dev/null; done
    [ "$PROMPT" = starship ] && render_one "$REPO/templates/.config/starship.toml.$PROMPT_STYLE" "$HOME/.config/starship.toml" >/dev/null
    if desktop_wanted; then
        for rel in $DESKTOP_RENDERED; do render_one "$REPO/templates/$rel" "$HOME/$rel" >/dev/null; done
        sway_reload >/dev/null
    fi
    n=$changes
    tmux_reload >/dev/null 2>&1 || true
    theme_seen
    [ "$n" -eq 0 ] || echo "spark-shell: the look followed the palette ($n files; the login box at the next spark-shell apply)"
}

cmd_status() {
    config_load
    tree=$(rc_tree)
    printf 'spark-shell -- the look and the tools for an AI box\n'
    for f in $(rc_files); do
        p=$HOME/$f
        if [ -L "$p" ] && [ "$(readlink "$p")" = "$tree/$f" ]; then s="spark-shell's"
        elif [ -L "$p" ]; then s="a symlink elsewhere"
        elif [ -f "$p" ]; then grep -q 'config/spark/hook\.' "$p" 2>/dev/null && s="yours, with spark's hook" || s="yours"
        else s="absent"; fi
        # shellcheck disable=SC2088   # the tilde is display, not a path
        printf '  rc    %-16s %s\n' "~/$f" "$s"
    done
    for t in tmux starship fzf zoxide eza bat btop yazi; do
        command -v "$t" >/dev/null 2>&1 && s=yes || s=no
        printf '  tool  %-16s %s\n' "$t" "$s"
    done
    if ! gitconfig_wanted; then printf '  git   %-16s %s\n' .gitconfig "not written (no GIT_NAME/GIT_EMAIL in the config)"
    elif gitconfig_yours; then printf '  git   %-16s %s\n' .gitconfig "yours, left alone"
    else printf '  git   %-16s %s\n' .gitconfig "rendered: $GIT_NAME <$GIT_EMAIL>"; fi
    if [ "$OS" = Darwin ]; then s="na: macOS has its own desktop"
    elif [ "$DESKTOP" = none ]; then s="none (spark-shell desktop on)"
    elif [ -n "$(desktop_tools)" ]; then s="sway: not installed --$(desktop_tools) (spark-shell desktop on)"
    elif [ ! -f "$HOME/.config/sway/config" ] || [ ! -f "$HOME/.config/foot/foot.ini" ]; then s="sway: not rendered (spark-shell apply)"
    else s="sway: rendered, foot in $(fc-match -f '%{family}' "$FONT" 2>/dev/null || printf '%s' "${FONT%%:*}") (spark-shell desktop starts it)"; fi
    if [ "$OS" != Darwin ] && [ "$DESKTOP" = sway ]; then
        if greeter_at_boot; then s="$s; login box: greetd at boot"; else s="$s; login box: getty at boot (spark-shell desktop on)"; fi
    fi
    printf '  desk  %-16s %s\n' "$DESKTOP" "$s"
    if [ "$OS" != Darwin ] && [ "$DESKTOP" = sway ]; then
        if apps_marked; then printf '  apps  %-16s %s\n' "$(grep -c '^[A-Za-z0-9]' "$APPS") marked" "$(grep '^[A-Za-z0-9]' "$APPS" | sed 's/[: ].*//' | paste -sd',' - | sed 's/,/, /g') (spark-shell desktop apps)"
        else printf '  apps  %-16s %s\n' unmarked "every app with a desktop entry (spark-shell desktop apps picks)"; fi
        n=$(ls -A "$DESKS_DIR" 2>/dev/null | wc -l | tr -d ' ')
        if [ "$n" -gt 0 ]; then printf '  desks %-16s %s\n' "$n kept" "$(ls -A "$DESKS_DIR" | paste -sd ',' - | sed 's/,/, /g') (spark-shell desktop NAME)"
        else printf '  desks %-16s %s\n' none 'spark-shell desktop "WORDS" makes one'; fi
        if [ "$WALLPAPER" = none ]; then printf '  wall  %-16s %s\n' none "the palette's background (spark-shell desktop wallpaper PATH|default)"
        elif [ "$WALLPAPER" = default ] && wall_there; then printf '  wall  %-16s %s\n' default "the forge, $WALL_DEFAULT"
        elif wall_there; then printf '  wall  %-16s %s\n' picture "$WALLPAPER"
        else printf '  wall  %-16s %s\n' missing "$(wall_path) is not there -- the palette's colour meanwhile"; fi
    fi
    theme_load || true
    slots="accent colour${ACCENT_SLOT:-?}, muted colour${MUTED_SLOT:-?} (SGR 1;${ACCENT_SGR:-?} / ${MUTED_SGR:-?})"
    [ -f "$THEME_ENV" ] && printf '  theme %-16s %s\n' theme.env "read: $slots (spark theme NAME rewrites it; then spark-shell apply)" \
                        || printf '  theme %-16s %s\n' theme.env "none: the terminal's own sixteen; $slots"
}

cmd_check() {
    config_load
    fails=0
    chk() { # chk NAME ok|fail DETAIL [REMEDY]
        if [ "$2" = ok ]; then printf 'ok     %-12s %s\n' "$1" "$3"
        else printf 'FAIL   %-12s %s -- %s\n' "$1" "$3" "${4:-}"; fails=$((fails + 1)); fi
    }
    tree=$(rc_tree)
    rc_ok=1
    for f in $(rc_files); do
        [ -L "$HOME/$f" ] && [ "$(readlink "$HOME/$f")" = "$tree/$f" ] || rc_ok=0
    done
    [ "$rc_ok" = 1 ] && chk rc ok "the rc files are spark-shell's" || chk rc fail "an rc file is not spark-shell's" "spark-shell on"
    miss=''
    # ~/.local/bin holds the pinned starship (and spark): a non-login
    # ssh shell has no such PATH, so look there too
    for t in tmux starship fzf zoxide eza bat btop yazi; do
        command -v "$t" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$t" ] || miss="$miss $t"
    done
    [ -z "$miss" ] && chk tools ok "tmux, starship, fzf, zoxide, eza, bat, btop, yazi" || chk tools fail "missing:$miss" "spark-shell on"
    infocmp -1x tmux-256color 2>/dev/null | grep -q 'kUP=' && chk terminfo ok "tmux-256color knows modified arrows" \
        || chk terminfo fail "tmux-256color lacks kUP" "spark-shell on"
    # render freshness: what apply would write vs what is on disk
    theme_load
    EXPR=$(render_expr)
    stale=''
    for rel in $RENDERED; do
        [ -f "$HOME/$rel" ] || { stale="$stale $rel"; continue; }
        sed -e "$EXPR" "$REPO/templates/$rel" > "$TMP/chk"
        cmp -s "$TMP/chk" "$HOME/$rel" || stale="$stale $rel"
    done
    if gitconfig_wanted && ! gitconfig_yours; then
        if [ -f "$HOME/$GITCONFIG" ]; then
            sed -e "$EXPR" "$REPO/templates/$GITCONFIG" > "$TMP/chk"
            cmp -s "$TMP/chk" "$HOME/$GITCONFIG" || stale="$stale $GITCONFIG"
        else stale="$stale $GITCONFIG"; fi
    fi
    [ -z "$stale" ] && chk look ok "the rendered look matches the palette" || chk look fail "stale:$stale" "spark-shell apply"
    if [ "$OS" = Darwin ]; then chk desktop ok "na (macOS)"
    elif [ "$DESKTOP" = none ]; then chk desktop ok "na (DESKTOP=none)"
    elif [ -n "$(desktop_tools)" ]; then chk desktop fail "missing:$(desktop_tools)" "spark-shell on"
    else
        stale=''
        for rel in $DESKTOP_RENDERED; do
            [ -f "$HOME/$rel" ] || { stale="$stale $rel"; continue; }
            sed -e "$EXPR" "$REPO/templates/$rel" > "$TMP/chk"
            cmp -s "$TMP/chk" "$HOME/$rel" || stale="$stale $rel"
        done
        if [ -n "$stale" ]; then chk desktop fail "stale:$stale" "spark-shell apply"
        elif ! command -v jq >/dev/null 2>&1; then chk desktop fail "jq is missing (a desk reads the model's answer with it)" "spark-shell on"
        else chk desktop ok "sway and foot, the renders match the palette; a desk from your words"; fi
    fi
    if [ "$OS" = Darwin ]; then chk greeter ok "na (macOS)"
    elif [ "$DESKTOP" = none ]; then chk greeter ok "na (DESKTOP=none)"
    elif [ -n "$(greeter_tools)" ]; then chk greeter fail "missing:$(greeter_tools)" "spark-shell desktop on"
    else
        stale=''
        for rel in $ROOT_RENDERED; do
            [ -f "$ROOT/$rel" ] || { stale="$stale /$rel"; continue; }
            render_tmp "$REPO/templates/$rel" "$TMP/chk"
            cmp -s "$TMP/chk" "$ROOT/$rel" || stale="$stale /$rel"
        done
        if [ -n "$stale" ]; then chk greeter fail "stale:$stale" "spark-shell desktop on"
        elif ! unit_enabled greetd.service; then chk greeter fail "greetd.service is not enabled" "spark-shell desktop on"
        elif unit_enabled getty@tty1.service; then chk greeter fail "getty@tty1.service is still enabled" "spark-shell desktop on"
        else chk greeter ok "greetd on tty1 at boot, the box matches the palette"; fi
    fi
    if [ "$OS" = Darwin ] || [ "$DESKTOP" = none ]; then chk apps ok "na (no desktop)"
    else
        sbom_entries; ne=$(wc -l < "$TMP/entries" | tr -d ' ')
        if apps_marked; then
            gone=''
            for n in $(grep '^[A-Za-z0-9]' "$APPS" | sed 's/[: ].*//'); do desk_on_path "$n" || grep -q "^$n	" "$TMP/entries" || gone="$gone $n"; done
            [ -z "$gone" ] && chk apps ok "$(grep -c '^[A-Za-z0-9]' "$APPS") marked for the desk, $ne apps declare themselves" || chk apps fail "marked but not here:$gone" "spark-shell desktop apps"
        else chk apps ok "$ne apps declare themselves, none marked (spark-shell desktop apps picks)"; fi
    fi
    if command -v spark >/dev/null 2>&1 || [ -x "$HOME/.local/bin/spark" ]; then chk bar ok "spark bar line answers the status line"
    else chk bar ok "spark not found -- the status line stays empty (github.com/forgewright-ai/spark)"; fi
    [ "$fails" = 0 ]
}

cmd_bar() {
    command -v tmux >/dev/null 2>&1 || { echo "spark-shell bar: no tmux here (spark-shell on installs it)"; return 1; }
    tmux list-sessions >/dev/null 2>&1 || { echo "spark-shell bar: no tmux running -- the status line is tmux's (tmux starts one)"; return 1; }
    case ${1:-} in
        on) tmux set -g status on; echo "spark-shell bar -- shown (spark-shell bar off hides it)" ;;
        off) tmux set -g status off; echo "spark-shell bar -- hidden (spark-shell bar on brings it back)" ;;
        *) s=$(tmux show -gv status 2>/dev/null || echo on)
           [ "$s" != off ] && echo "spark-shell bar -- shown (spark-shell bar off hides it)" \
                           || echo "spark-shell bar -- hidden (spark-shell bar on brings it back)" ;;
    esac
}

# ------------------------------------------------------------------ desks
# A desk: the windows for one need, laid out by the model from what this
# machine has. `spark-shell desktop "focused news reading and music"`
# asks spark (spark edit, contract 10, from nothing) for one JSON answer
# -- why, a main window and its width, the side windows -- and turns it
# into sway commands: main at the left, the side stacked at the right,
# on the next empty workspace, so the windows already open are never
# touched. The lines are kept in ~/.local/state/spark-shell/desk.last;
# `desktop keep NAME` copies them to ~/.config/spark-shell/desks/NAME,
# and `desktop NAME` replays them with no model call. Every line, fresh
# or kept, passes desk_gate before swaymsg sees it: a known verb, no
# shell syntax (sway hands exec to sh -c), and exec only of an app in
# the inventory. The model never sees a window title or a file: the
# need's words, the screen and the inventory, nothing else.
DESKS_DIR=$CONFIG_DIR/desks
DESK_LAST=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/desk.last
DESK_PENDING=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/desk.pending
DESK_VERBS="workspace splith splitv layout resize focus move floating fullscreen exec"
DESK_NOT_APPS="sh bash zsh dash fish ksh sudo doas su pkexec"   # a shell or a way to root is not an app
DESK_WAIT=30                                                    # seconds for a window to map (gimp, a browser)

# The inventory: what the machine declares it has, read fresh each time.
# One line per app, `NAME: what it does[, terminal]`: the XDG desktop
# entries (Comment, else GenericName, else Name; Terminal=true marked),
# then the packages the user chose that are commands, then the need's
# own words that are on PATH (a pip tool has no entry and no package).
# ------------------------------------------------------------------- sbom
# The box's software bill of materials, in the package manager's own
# words: every package, its version, licence, description, whether you
# chose it or it came as a dependency, the commands it puts on PATH and
# the desktop entries it ships (with their XDG categories). Its kind
# follows from that, no list of ours: an app declares itself with an
# entry, a tool is a command without one, a part is neither. One TSV in
# TMP feeds the table, the CycloneDX 1.5 JSON (the format spark's own
# `spark ver --sbom` writes, so the two compose) and the desk's inventory.
SBOM_JSON=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/sbom.cdx.json
APPS=$CONFIG_DIR/apps     # yours: the apps a desk may use, one per line, `name[: your words]`
sbom_entries() {   # -> $TMP/entries: NAME<tab>FILE<tab>WHAT<tab>TERMINAL<tab>CATEGORIES<tab>LAUNCH, hidden ones out
    : > "$TMP/entries"
    for d in ${XDG_DATA_HOME:-$HOME/.local/share} $(printf '%s' "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' '); do
        [ -d "$d/applications" ] || continue
        for f in "$d"/applications/*.desktop; do
            [ -f "$f" ] || continue
            grep -qE '^(NoDisplay|Hidden)=true' "$f" && continue
            launch=$(sed -n 's/^Exec=//p' "$f" | head -1 | sed 's/^env [^ ]* //; s/ *%[ick]//g; s|^[^ ]*/||')
            name=${launch%% *}
            [ -n "$name" ] || continue
            grep -q "^$name	" "$TMP/entries" && continue
            what=''
            for key in Comment GenericName Name; do
                [ -n "$what" ] || what=$(sed -n "s/^$key=//p" "$f" | head -1)
            done
            term=no; grep -q '^Terminal=true' "$f" && term=yes
            cats=$(sed -n 's/^Categories=//p' "$f" | head -1 | sed 's/;$//')
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$f" "$what" "$term" "$cats" "$launch" >> "$TMP/entries"
        done
    done
}
sbom_collect() {   # -> $TMP/sbom: NAME VERSION LICENSE REASON DESCRIPTION COMMANDS ENTRIES (tab-separated; KIND first)
    sbom_entries
    pm_detect 2>/dev/null || true
    : > "$TMP/files"   # PACKAGE<tab>PATH for every command and entry a package ships
    case $PM in
        pacman)
            pacman -Qi 2>/dev/null | awk -F' *: ' '
                /^Name/ {n=$2} /^Version/ {v=$2} /^Licenses/ {l=$2} /^Description/ {d=$2}
                /^Install Reason/ {r=($2 ~ /Explicitly/) ? "chosen" : "dependency"}
                /^$/ && n != "" {printf "%s\t%s\t%s\t%s\t%s\n", n, v, l, r, d; n=""}' > "$TMP/pkgs"
            pacman -Ql 2>/dev/null | awk '$2 ~ /^\/usr\/bin\/[^\/]+$/ || $2 ~ /\/applications\/[^\/]+\.desktop$/ {print $1 "\t" $2}' > "$TMP/files" ;;
        apt)
            dpkg-query -W -f='${Package}\t${Version}\t?\t?\t${binary:Summary}\n' 2>/dev/null > "$TMP/pkgs.raw"
            apt-mark showmanual 2>/dev/null | sort > "$TMP/manual"
            while IFS='	' read -r n v _ _ d; do
                lic=$(sed -n 's/^License: //p' "/usr/share/doc/$n/copyright" 2>/dev/null | head -1)
                if grep -qx "$n" "$TMP/manual"; then r=chosen; else r=dependency; fi
                printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$v" "${lic:-?}" "$r" "$d"
                grep -E '^/usr/bin/[^/]+$|/applications/[^/]+\.desktop$' "/var/lib/dpkg/info/$n.list" 2>/dev/null | sed "s/^/$n\t/" >> "$TMP/files"
            done < "$TMP/pkgs.raw" > "$TMP/pkgs" ;;
        brew)
            brew info --json=v2 --installed 2>/dev/null | jq -r '
                (.formulae[] | [.name, (.installed[0].version // .versions.stable // "?"), (.license // "?"),
                    (if (.installed[0].installed_on_request // false) then "chosen" else "dependency" end), (.desc // "")] | @tsv),
                (.casks[] | [.token, (.installed // .version // "?"), "?", "chosen", (.desc // "")] | @tsv)' > "$TMP/pkgs" 2>/dev/null
            prefix=$(brew --prefix 2>/dev/null)
            while IFS='	' read -r n _ _ _ _; do
                for b in "$prefix/opt/$n/bin"/*; do [ -x "$b" ] && printf '%s\t/usr/bin/%s\n' "$n" "${b##*/}"; done
            done < "$TMP/pkgs" >> "$TMP/files" 2>/dev/null ;;
        *) : > "$TMP/pkgs" ;;
    esac
    # kind, commands and entries per package, one pass; an app is what declares itself
    awk -F'\t' '
        FILENAME == ARGV[1] { ent[$2] = $1 "=" $5; next }                         # entries: file -> NAME=Categories
        FILENAME == files { if ($2 ~ /\.desktop$/) { if ($2 in ent) e[$1] = e[$1] " " ent[$2] }
                            else { sub(".*/", "", $2); c[$1] = c[$1] " " $2 } ; next }
        { n = $1; cmds = substr(c[n], 2); ents = substr(e[n], 2)
          k = (ents != "") ? "app" : (cmds != "") ? "tool" : "part"
          printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", k, n, $2, $3, $4, $5, cmds, ents }' \
        "$TMP/entries" files="$TMP/files" "$TMP/files" "$TMP/pkgs" | sort -t'	' -k2,2 > "$TMP/sbom"
}
sbom_json() {   # the CycloneDX 1.5 document, from $TMP/sbom, to stdout
    _pm=${PM:-none}; _os=${DISTRO:-$(printf '%s' "$OS" | tr 'A-Z' 'a-z')}
    jq -R -s --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg host "$(short_host)" --arg pm "$_pm" --arg os "$_os" --arg ver "$(sed -n 's/^## v//p' "$REPO/CHANGELOG.md" | head -1)" '
        split("\n") | map(select(length > 0) | split("\t")) |
        {bomFormat: "CycloneDX", specVersion: "1.5", version: 1,
         metadata: {timestamp: $ts, tools: [{name: "spark-shell", version: $ver}],
                    component: {type: "operating-system", name: $host, description: ("the box, as " + $pm + " declares it")}},
         components: map({
            type: (if .[0] == "app" then "application" else "library" end),
            name: .[1], version: .[2], description: .[5],
            licenses: (if .[3] == "" or .[3] == "?" then [] else [{license: {name: .[3]}}] end),
            purl: ("pkg:" + $pm + "/" + $os + "/" + .[1] + "@" + .[2]),
            properties: ([{name: "spark-shell:kind", value: .[0]}, {name: "spark-shell:reason", value: .[4]}]
                         + (if .[6] != "" then [{name: "spark-shell:commands", value: .[6]}] else [] end)
                         + (if .[7] != "" then [{name: "spark-shell:entries", value: .[7]}] else [] end))})}' "$TMP/sbom"
}
cmd_sbom() {   # sbom [apps|tools|parts|NAME] [--json]
    config_load
    json=0; pick=''
    for a in "$@"; do case $a in --json) json=1 ;; -*) ;; *) pick=$a ;; esac; done
    command -v jq >/dev/null 2>&1 || { echo "spark-shell sbom: jq is not installed (spark-shell on)"; return 1; }
    sbom_collect
    [ -s "$TMP/sbom" ] || { echo "spark-shell sbom: no package manager here that this repo knows (pacman, apt, brew)"; return 1; }
    if [ "$json" = 1 ]; then
        mkdir -p "$(dirname "$SBOM_JSON")"
        sbom_json > "$SBOM_JSON"
        echo "$SBOM_JSON -- CycloneDX 1.5, $(wc -l < "$TMP/sbom" | tr -d ' ') components"
        return 0
    fi
    case $pick in
        ''|apps|tools|parts)
            k=${pick%s}
            awk -F'\t' -v k="$k" '$1 == k || k == "" {printf "%-5s %-24s %-14s %-22s %s\n", $1, $2, substr($3, 1, 14), substr($4, 1, 22), $6}' "$TMP/sbom"
            a=$(grep -c '^app	' "$TMP/sbom" || true); t=$(grep -c '^tool	' "$TMP/sbom" || true); p=$(grep -c '^part	' "$TMP/sbom" || true)
            echo "$a apps, $t tools, $p parts -- an app declares itself with a desktop entry; spark-shell desktop apps marks the desk's" ;;
        *)
            line=$(awk -F'\t' -v n="$pick" '$2 == n' "$TMP/sbom")
            [ -n "$line" ] || { echo "spark-shell sbom: no package named $pick"; return 1; }
            printf '%s\n' "$line" | awk -F'\t' '{printf "%s  %s %s\n  %s\n  licence   %s\n  reason    %s\n  commands  %s\n  entries   %s\n", $1, $2, $3, $6, $4, $5, ($7 == "" ? "-" : $7), ($8 == "" ? "-" : $8)}' ;;
    esac
}

# The desk's inventory: what a desk may open, in the machine's words and
# yours. Marked (~/.config/spark-shell/apps, `name[: your words]`): exactly
# those. Unmarked: every app that declares itself with a desktop entry.
# Always: a word of the need that is a program. Never: the desktop's own
# parts, a shell, a way to root. Lines `NAME: what[, terminal]`, and
# $TMP/exec keeps how each entry says to open it.
apps_marked() { [ -f "$APPS" ] && grep -q '^[A-Za-z0-9]' "$APPS"; }
desk_apps() {   # desk_apps NEED -> the lines
    sbom_entries
    awk -F'\t' '{print $1 "\t" $6}' "$TMP/entries" > "$TMP/exec"
    {
        if apps_marked; then
            [ -s "$TMP/sbom" ] || sbom_collect
            grep '^[A-Za-z0-9]' "$APPS" | while IFS= read -r m; do
                n=${m%%:*}; n=$(printf '%s' "$n" | tr -d ' '); note=''; case $m in *:*) note=$(printf '%s' "${m#*:}" | sed 's/^ *//') ;; esac
                e=$(awk -F'\t' -v n="$n" '$1 == n {print $3 "\t" $4}' "$TMP/entries" | head -1)
                if [ -n "$e" ]; then what=${e%	*}; term=${e#*	}
                else
                    what=$(awk -F'\t' -v n="$n" '$2 == n || (" " $7 " ") ~ (" " n " ") {print $6; exit}' "$TMP/sbom"); term=yes
                    if ! desk_on_path "$n"; then   # a package's name: its first command that is here (ripgrep -> rg)
                        for cmd in $(awk -F'\t' -v n="$n" '$2 == n {print $7; exit}' "$TMP/sbom"); do
                            desk_on_path "$cmd" && { n=$cmd; break; }
                        done
                    fi
                fi
                desk_on_path "$n" || [ -n "$e" ] || continue   # marked but not here: not offered
                [ -z "$note" ] || what=$note
                [ "$term" = yes ] && printf '%s: %s, terminal\n' "$n" "${what:-$n}" || printf '%s: %s\n' "$n" "${what:-$n}"
            done
        else
            awk -F'\t' '{printf "%s: %s%s\n", $1, $3, ($4 == "yes" ? ", terminal" : "")}' "$TMP/entries"
        fi
        for w in $1; do
            w=$(printf '%s' "$w" | tr -cd 'A-Za-z0-9_.-' | tr 'A-Z' 'a-z')
            [ -z "$w" ] || ! desk_on_path "$w" || printf '%s: named in the need, terminal\n' "$w"
        done
    } | grep -v "^\\($(printf '%s' "sway swaybg swaymsg foot footclient xdg-open $DESK_NOT_APPS" | sed 's/ /\\|/g')\\):" \
      | sort -t: -s -u -k1,1   # the desktop itself, a shell, a way to root: not apps
}
# spark-shell desktop apps: the picker. fzf over the box's apps and
# tools, Tab marks, Enter saves the marked names to your file (a note you
# wrote beside a name that stays marked is kept); Esc leaves it as it was.
cmd_apps() {   # cmd_apps apps|tools -- one picker, the same marks; apps are the box's declared ones, tools its commands
    kind=${1:-apps}
    command -v fzf >/dev/null 2>&1 || refuse "fzf is not installed (spark-shell on)"
    [ -t 0 ] || refuse "the picker needs a terminal; the file is $APPS (name[: your words], one per line)"
    sbom_collect
    # the rows, one per thing you could mark: an app package's entries as apps (the entry's
    # own words), then every other package with a command as a tool (the package's words,
    # the command in brackets when it differs); apps first, the tools you chose next,
    # dependency tools last. A marked row wears a *. Tab flips: what you select at Enter
    # is marked if it was not, unmarked if it was.
    marks=$(apps_marked && grep '^[A-Za-z0-9]' "$APPS" | sed 's/[: ].*//' | paste -sd' ' - || true)
    if [ "$kind" = apps ]; then what="The apps a desk may open."; else what="The tools a desk may open; each runs in a terminal window."; fi
    picked=$(awk -F'\t' -v marks=" $marks " -v kind="$kind" '
        FILENAME == ARGV[1] { ent[$1] = $3; next }
        function star(n) { return (index(marks, " " n " ") > 0) ? "* " : "  " }
        $1 == "app" && kind == "apps" {   # its entries are the apps; its other commands are part of them
            m = split($8, es, " ")
            for (j = 1; j <= m; j++) { split(es[j], kv, "="); if (kv[1] != "") printf "0\t%s\t%s%s: %s  [app]\n", kv[1], star(kv[1]), kv[1], ent[kv[1]] } }
        $1 == "tool" && kind == "tools" {
            n = split($7, c, " "); first = ""
            for (i = 1; i <= n; i++) if (c[i] ~ /^[A-Za-z]/) { first = c[i]; break }
            if (first == "") next
            name = ($2 ~ /^[A-Za-z]/) ? $2 : first
            shown = (index(" " $7 " ", " " name " ") > 0) ? name : name " (" first ")"
            printf "%d\t%s\t%s%s: %s  [tool]\n", ($5 == "chosen" ? 1 : 2), name, star(name), shown, $6 }' "$TMP/entries" "$TMP/sbom" \
             | sort -t'	' -k1,1n -k2,2f -u | cut -f3 \
             | grep -v "^..\\($(printf '%s' "sway swaybg swaymsg foot footclient xdg-open $DESK_NOT_APPS" | sed 's/ /\\|/g')\\)[ :(]" \
             | fzf --multi --prompt "$kind> " --layout=reverse --no-info --color=16 --no-unicode \
                   --header "$what Tab flips a mark, Enter saves, Esc leaves it.
Marked now: ${marks:-none}") || { echo "left as it was"; return 0; }
    [ -n "$picked" ] || { echo "left as it was"; return 0; }
    flipped=$(printf '%s\n' "$picked" | sed 's/^..//; s/[:(].*//; s/ *$//')
    mkdir -p "$CONFIG_DIR"
    {
        printf '# the apps a desk may open -- spark-shell desktop apps writes this; yours to edit: name[: your words]\n'
        for n in $marks; do   # the marks kept, minus the flipped; a note stays with its name
            printf '%s\n' "$flipped" | grep -qx "$n" && continue
            grep "^$n *\(:.*\)\{0,1\}$" "$APPS" 2>/dev/null | head -1 || printf '%s\n' "$n"
        done
        printf '%s\n' "$flipped" | while IFS= read -r n; do
            if [ -n "$n" ] && ! printf ' %s ' "$marks" | grep -q " $n "; then printf '%s\n' "$n"; fi
        done
        :
    } > "$TMP/apps.new"
    cp "$TMP/apps.new" "$APPS"
    echo "marked: $(grep '^[A-Za-z0-9]' "$APPS" | sed 's/[: ].*//' | paste -sd' ' -) ($APPS)"
}
desk_on_path() { case $(command -v "$1" 2>/dev/null) in /*) return 0 ;; *) return 1 ;; esac; }   # a program, not a keyword or builtin
desk_app_known() { grep -q "^$1: " "$TMP/apps"; }                       # desk_app_known NAME (after desk_apps > $TMP/apps)
desk_app_term() { grep "^$1: " "$TMP/apps" | grep -q ', terminal$'; }   # a terminal app opens inside foot
desk_launch() {   # desk_launch NAME ARGS -> how the machine says to open it: the entry's Exec, its
    # file/URL field taking the args (dropped when there are none), else the name and the args
    _l=$(grep "^$1	" "$TMP/exec" 2>/dev/null | head -1 | cut -f2-)
    [ -n "$_l" ] || _l="$1 %U"
    case $_l in *%[fFuU]*) _l=$(printf '%s' "$_l" | sed "s|%[fFuU]|$2|g") ;; *) _l="$_l $2" ;; esac
    printf '%s' "$_l" | sed 's/  */ /g; s/ *$//'
}
desk_screen() { swaymsg -t get_outputs 2>/dev/null | jq -r '.[0].current_mode | "\(.width)x\(.height)"' 2>/dev/null || echo 1920x1080; }
desk_next_ws() {   # the lowest workspace number not in use
    used=$(swaymsg -t get_workspaces 2>/dev/null | jq -r '.[].num' 2>/dev/null)
    n=1; while printf '%s\n' "$used" | grep -qx "$n"; do n=$((n + 1)); done
    echo "$n"
}
desk_windows() {   # desk_windows N -> how many windows workspace N has
    swaymsg -t get_tree 2>/dev/null | jq "[.. | objects | select(.type? == \"workspace\" and .num? == $1) | .. | objects | select(.pid? != null)] | length" 2>/dev/null || echo 0
}

# The gate: one line in, ok or a reason out. Read before jq, sway or
# anything else sees it, whether the line is fresh from the model or
# from a kept desk you edited by hand.
desk_gate() {   # desk_gate LINE -> '' when it may run, else why not
    verb=${1%% *}
    case " $DESK_VERBS " in *" $verb "*) ;; *) echo "$verb is not a desk verb"; return ;; esac
    bad=$(printf '%s' "$1" | LC_ALL=C tr -d 'A-Za-z0-9 _.:/=,%~@#+?[]"-' | head -c 1)   # what a sway line may hold; the rest is sh's
    [ -z "$bad" ] || { echo "shell syntax or a control character"; return; }
    [ "$verb" = exec ] || return 0
    set -- $1; shift
    [ "${1:-}" = foot ] && [ "${2:-}" = -e ] && shift 2
    app=${1:-}; app=${app##*/}
    [ -n "$app" ] || { echo "exec of nothing"; return; }
    case " $DESK_NOT_APPS " in *" $app "*) echo "$app is not an app"; return ;; esac
    desk_app_known "$app" || echo "$app is not on this machine"
}

# The model's answer to sway's words: main at the left, the side stacked
# at the right (a new window lands beside the focused one; splitv turns
# the side column vertical), then main sized. A terminal app opens in foot.
desk_lines() {   # desk_lines WS JSONFILE -> the lines
    printf 'workspace number %s\n' "$1"
    jq -r '[.main] + (.side // []) | .[] | "\(.app) \(.args // "")"' "$2" | sed 's/ *$//' | {
        i=0
        while IFS= read -r line; do
            app=${line%% *}; args=''; case $line in *' '*) args=${line#* } ;; esac
            if desk_app_term "$app"; then printf 'exec foot -e %s\n' "$(desk_launch "$app" "$args")"; else printf 'exec %s\n' "$(desk_launch "$app" "$args")"; fi
            case $i in 0) echo splith ;; 1) echo splitv ;; esac
            i=$((i + 1))
        done
        if [ "$i" -gt 1 ]; then
            echo "focus left"
            printf 'resize set width %s ppt\n' "$(jq -r '.main.width // 70 | if . < 20 then 20 elif . > 90 then 90 else floor end' "$2")"
        fi
    }
}

desk_play() {   # desk_play FILE -> the lines sent, a refused line named, exec waited for
    ws=$(sed -n 's/^workspace number //p' "$1" | head -1)
    sent=0; nowin=0
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|'#'*) continue ;; esac
        why=$(desk_gate "$line")
        if [ -n "$why" ]; then echo "  refused  $line  ($why)"; continue; fi
        # a split meant for a window that never came would cut the one
        # before it instead: skipped, the next window lands where that one would have
        case $line in split*) [ "$nowin" = 0 ] || { [ "$VERBOSE" != 1 ] || echo "  skipped  $line  (no window to split)"; nowin=0; continue; } ;; esac
        [ "$VERBOSE" != 1 ] || echo "  $line"   # the sway grammar is for the kept file, not the screen
        before=$(desk_windows "$ws")
        swaymsg -- "$line" >/dev/null || { echo "  sway refused: $line"; continue; }
        sent=$((sent + 1))
        case $line in exec*)
            # until its window maps; a program that ends first (mpv with
            # nothing to play) is not waited for past a 3 s grace. What a
            # person reads: the app and its args, and whether it came
            set -- $line; shift; [ "${1:-}" = foot ] && [ "${2:-}" = -e ] && shift 2
            prog=${1##*/}; shown=$*; t=0
            desk_pulse   # a sign of life while the window is on its way
            while [ "$(desk_windows "$ws")" -le "$before" ] && [ "$t" -lt $((DESK_WAIT * 4)) ]; do
                [ "$t" -lt 12 ] || pgrep -u "$(id -u)" -x "$prog" >/dev/null 2>&1 || break
                sleep 0.25; t=$((t + 1))
            done
            desk_pulse_stop
            if [ "$(desk_windows "$ws")" -gt "$before" ]; then nowin=0; echo "  $shown"; else nowin=1; echo "  $shown -- no window"; fi ;;
        esac
    done < "$1"
    [ "$sent" -gt 0 ]
}

desk_make() {   # desk_make NEED -> the desk laid out, its lines in DESK_LAST
    command -v jq >/dev/null 2>&1 || refuse "jq is not installed (spark-shell on)"
    spark=$(command -v spark 2>/dev/null || true); [ -n "$spark" ] || [ ! -x "$HOME/.local/bin/spark" ] || spark=$HOME/.local/bin/spark
    [ -n "$spark" ] || refuse "spark is not installed -- the desk is the model's (github.com/forgewright-ai/spark)"
    desk_apps "$1" > "$TMP/apps"
    [ -s "$TMP/apps" ] || refuse "no apps found on this machine (no desktop entries, no chosen packages)"
    ws=$(desk_next_ws)
    about="A desk: the windows for one need, on a $(desk_screen) screen. Apps on this machine (name: what it does): $(sed 's/, terminal$//' "$TMP/apps" | paste -sd ';' - | sed 's/;/; /g'). Rules: an app the need names by name is in the desk; otherwise only the apps the work itself needs, as few windows as that takes (one to four), never an app the need does not call for; an app may appear twice with different args (a browser on two pages: one window per page, args is that page's URL). Answer with one JSON object and nothing else: {\"why\": \"one sentence, from the need to the apps chosen\", \"main\": {\"app\": \"NAME\", \"args\": \"\", \"width\": 70}, \"side\": [{\"app\": \"NAME\", \"args\": \"\"}]} -- main is the big window at the left, width its percent of the screen; side is the windows stacked at the right, top to bottom."
    [ -n "${ASKED:-}" ] || printf 'desk> %s\n' "$1"
    desk_pulse
    st=0; "$spark" edit --type json --name desk.json --about "$about" -- "write the desk for this need: $1" </dev/null > "$TMP/desk.json" 2>"$TMP/desk.err" || st=$?
    desk_pulse_stop
    [ "$st" -eq 0 ] || refuse "spark did not answer: $(head -1 "$TMP/desk.err")"
    jq -e '.main.app | strings' "$TMP/desk.json" >/dev/null 2>&1 || refuse "the answer was not a desk (spark-shell desktop -v shows it)"
    why=$(jq -r '.why // "" | gsub("[\\n\\r]"; " ")' "$TMP/desk.json")
    [ -z "$why" ] || printf '  %s\n' "$why"
    for a in $(jq -r '[.main] + (.side // []) | .[].app' "$TMP/desk.json"); do
        desk_app_known "$a" || echo "  $a is not on this machine -- laid out without it"
    done
    mkdir -p "$(dirname "$DESK_LAST")"
    {
        printf '# desk: %s -- rendered by spark-shell (spark-shell desktop keep NAME keeps it)\n' "$1"
        [ -z "$why" ] || printf '# why: %s\n' "$why"
        desk_lines "$ws" "$TMP/desk.json"
    } > "$DESK_LAST"
    # asked at the prompt: its window goes with the desk, on top, to be read
    [ -z "${ASKED:-}" ] || swaymsg -- "[app_id=spark-desk] move container to workspace number $ws" >/dev/null 2>&1 || true
    desk_play "$DESK_LAST" || refuse "nothing ran"
    echo "on workspace $ws -- spark-shell desktop keep NAME keeps it"
    [ -z "${ASKED:-}" ] || swaymsg -- "[app_id=spark-desk] focus" >/dev/null 2>&1 || true   # Enter is ours, not the app's
}

# The pulse spark draws while a reply is on its way (spark text.Busy):
# `*` in the accent and `.` `..` `...` muted, redrawn every 0.35 s, at a
# tty only -- a pipe never sees a byte of it. The colours are the three
# SGR strings sgr.sh renders from the palette; unset = plain.
desk_pulse() {
    [ -t 1 ] || return 0
    # shellcheck disable=SC1091   # our own render, when there is one
    [ ! -f "$CONFIG_DIR/sgr.sh" ] || . "$CONFIG_DIR/sgr.sh"
    ( i=0; while :; do
        case $((i % 3)) in 0) d=. ;; 1) d=.. ;; *) d=... ;; esac
        printf '\r\033[2K\033[%sm*\033[0m \033[%sm%s\033[0m' "${SPARK_ACCENT_SGR:-}" "${SPARK_MUTED_SGR:-}" "$d"
        i=$((i + 1)); sleep 0.35
      done ) &
    PULSE=$!
}
desk_pulse_stop() {
    [ -n "${PULSE:-}" ] || return 0
    kill "$PULSE" 2>/dev/null || true; wait "$PULSE" 2>/dev/null || true; PULSE=''
    printf '\r\033[2K'
}
# The desk> line: fzf when there is one and a terminal (the tools row
# installs it): type a need, the arrows move over the kept desks, Enter
# takes the words or the desk under the cursor, Esc closes, the header
# says so. Without it, a plain line. Exit 1 when the window closed.
desk_prompt() {
    if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
        _st=0
        _sel=$(ls -A "$DESKS_DIR" 2>/dev/null | fzf --print-query --prompt 'desk> ' --layout=reverse --no-info --color=16 --no-unicode \
            --header 'Say what you are about to do and press Enter.
Up and Down pick a desk you kept. Esc closes.') || _st=$?
        [ "$_st" -ne 130 ] && [ "$_st" -ne 2 ] || return 1
        _need=$(printf '%s\n' "$_sel" | sed -n 1p); _pick=$(printf '%s\n' "$_sel" | sed -n 2p)
        [ -n "$_need" ] || _need=$_pick
        printf '%s' "$_need"
    else
        printf 'desk> ' >&2; IFS= read -r _need || return 1
        printf '%s' "$_need"
    fi
}
desk_words() { sed -n 's/^# desk: \(.*\) -- rendered by spark-shell.*/\1/p' "$1" | head -1; }   # desk_words FILE
desk_name_of() {   # desk_name_of WORDS... -> a file name: lowercase, the words joined by -, 40 at most
    printf '%s' "$*" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//' | cut -c1-40
}
desk_name_ok() { case $1 in ''|*[!A-Za-z0-9_-]*) return 1 ;; *) return 0 ;; esac; }
desk_list() {
    [ -d "$DESKS_DIR" ] && [ -n "$(ls -A "$DESKS_DIR" 2>/dev/null)" ] || { echo "no kept desks yet -- try: spark-shell desktop \"focused news reading and music\""; return 0; }
    for f in "$DESKS_DIR"/*; do
        printf '  %-24s %s\n' "${f##*/}" "$(desk_words "$f")"
    done
    echo "spark-shell desktop NAME opens one; keep [WORDS], forget NAME"
}

# desktop on|off: the desktop and the login box together, through the
# config (DESKTOP=sway|none) and the one path `on` takes. Alone: start
# sway now, on this console. A child, never exec: the EXIT trap
# still cleans TMP, and the cursor comes back after quiet boot's
# vt.global_cursor_default=0. sway's stderr goes to a log; its exit status
# is ours. Each refusal is one line and exit 1.
cmd_desktop() {
    config_load
    pending=''
    refuse() { echo "spark-shell desktop: $1"; exit 1; }
    case ${1:-} in
        on) [ "$OS" != Darwin ] || refuse "na: macOS has its own desktop"
            # the config first, then everything on does with DESKTOP=sway:
            # the packages, the renders, the login box (desktop_apply)
            [ "$MODE" = dry ] || config_set DESKTOP sway
            DESKTOP=sway; export DESKTOP
            cmd_on; return ;;
        off) [ "$OS" != Darwin ] || refuse "na: macOS has its own desktop"
            config_set DESKTOP none
            DESKTOP=none; export DESKTOP
            hand_back $DESKTOP_RENDERED
            greeter_off
            echo "packages stay installed -- the package manager removes them if you want"
            return ;;
        wallpaper)
            [ "$OS" != Darwin ] || refuse "na: macOS has its own desktop"
            case ${2:-} in
                '') if [ "$WALLPAPER" = none ]; then echo "wallpaper none -- the palette's background (spark-shell desktop wallpaper PATH|default)"
                    elif [ "$WALLPAPER" = default ] && wall_there; then echo "wallpaper default -- the forge, $WALL_DEFAULT"
                    elif wall_there; then echo "wallpaper $WALLPAPER"
                    else echo "wallpaper $(wall_path) -- not there; the palette's colour meanwhile"; fi
                    return ;;
                none|default) ;;
                /*) [ -r "$2" ] || refuse "$2 is not a readable file" ;;
                *) refuse "$2: an absolute path, default (the forge) or none" ;;
            esac
            [ "$DESKTOP" = sway ] || refuse "DESKTOP=$DESKTOP -- spark-shell desktop on first"
            config_set WALLPAPER "$2"
            WALLPAPER=$2; export WALLPAPER
            theme_load; EXPR=$(render_expr)
            desktop_look_apply
            if [ "$2" = none ]; then echo "the palette's background is back; a new foot window is opaque again"
            else echo "a running sway shows it now; the next foot window is translucent (Super+Return)"; fi
            return ;;
        apps|tools)
            [ "$OS" != Darwin ] || refuse "na: macOS has its own desktop"
            cmd_apps "$1"; return ;;
        keep|forget)   # keep [WORDS]: the last desk, under those words (its own by default); forget WORDS
            [ "$OS" != Darwin ] || refuse "na: macOS has its own desktop"
            verb=$1; shift
            if [ "$verb" = forget ]; then
                name=$(desk_name_of "$*"); [ -n "$name" ] || refuse "forget WORDS -- which desk?"
                [ -f "$DESKS_DIR/$name" ] || refuse "no kept desk named $name"
                grep -q 'rendered by spark-shell' "$DESKS_DIR/$name" || refuse "$DESKS_DIR/$name is not a desk of ours -- left alone"
                rm -f "${DESKS_DIR:?}/${name:?}"; echo "forgot $name"; return
            fi
            [ -f "$DESK_LAST" ] || refuse "no desk to keep yet -- spark-shell desktop \"WORDS\" makes one"
            name=$(desk_name_of "$*")
            [ -n "$name" ] || name=$(desk_name_of "$(desk_words "$DESK_LAST")")
            [ -n "$name" ] || refuse "keep WORDS -- a name for it"
            mkdir -p "$DESKS_DIR"; cp "$DESK_LAST" "$DESKS_DIR/$name"
            echo "kept $name -- spark-shell desktop $name opens it ($DESKS_DIR/$name)"; return ;;
        --ask)   # one line at a prompt (Super+d opens a foot on this), then a desk;
            # the window follows the desk and stays until Enter, so the why is read
            need=$(desk_prompt) || return 0
            [ -n "$need" ] || return 0
            case $need in
                keep|"keep "*|"forget "*) set -- $need; (cmd_desktop "$@") || true ;;   # the grammar's words, here too
                *) (ASKED=1 cmd_desktop "$need") || true ;;   # a refusal is read too, not lost with the window
            esac
            printf 'Enter closes '; IFS= read -r _ || true; return ;;
        --pending)   # the words left by a console start: laid out once, then gone
            [ -f "$DESK_PENDING" ] || return 0
            need=$(head -1 "$DESK_PENDING"); rm -f "$DESK_PENDING"
            [ -z "$need" ] || cmd_desktop "$need"; return ;;
        ''|-*) ;;
        *)  # a need, or a kept desk by name
            [ "$OS" != Darwin ] || refuse "na: macOS has its own desktop"
            [ "$DESKTOP" = sway ] || refuse "DESKTOP=$DESKTOP -- spark-shell desktop on first"
            command -v jq >/dev/null 2>&1 || refuse "jq is not installed (spark-shell on)"
            if [ -n "${SWAYSOCK:-}" ]; then
                kept=$(desk_name_of "$*")
                if [ -n "$kept" ] && [ -f "$DESKS_DIR/$kept" ]; then
                    desk_apps "$*" > "$TMP/apps"
                    [ -n "${ASKED:-}" ] || printf 'desk> %s\n' "$(desk_words "$DESKS_DIR/$kept")"
                    why=$(sed -n 's/^# why: //p' "$DESKS_DIR/$kept" | head -1); [ -z "$why" ] || printf '  %s\n' "$why"
                    ws=$(desk_next_ws)
                    sed "s/^workspace number .*/workspace number $ws/" "$DESKS_DIR/$kept" > "$TMP/desk"
                    [ -z "${ASKED:-}" ] || swaymsg -- "[app_id=spark-desk] move container to workspace number $ws" >/dev/null 2>&1 || true
                    desk_play "$TMP/desk" || refuse "nothing ran"
                    echo "on workspace $ws -- the kept desk $kept"
                    [ -z "${ASKED:-}" ] || swaymsg -- "[app_id=spark-desk] focus" >/dev/null 2>&1 || true
                    return
                fi
                desk_make "$*"; return
            fi
            pending=$* ;;   # no desktop yet: the words wait for the one about to start
    esac
    [ "$OS" != Darwin ] || refuse "na: macOS has its own desktop"
    [ "$DESKTOP" = sway ] || refuse "DESKTOP=$DESKTOP -- spark-shell desktop on"
    [ -z "$(desktop_tools)" ] || refuse "not installed:$(desktop_tools) (spark-shell on)"
    [ -f "$HOME/.config/sway/config" ] && [ -f "$HOME/.config/foot/foot.ini" ] || refuse "not rendered (spark-shell apply)"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then desk_list; return 0; fi
    # a console session the login box started has its seat too (greetd
    # sets XDG_VTNR): fine, sway starts on it like on a getty login
    [ -n "${XDG_VTNR:-}" ] || refuse "needs a console login: ssh has no seat"
    log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell
    mkdir -p "$log_dir"
    [ -z "${pending:-}" ] || printf '%s\n' "$pending" > "$DESK_PENDING"
    st=0
    PATH=$HOME/.local/bin:$PATH sway 2>"$log_dir/sway.log" || st=$?
    [ "${TERM:-}" != linux ] || printf '\033[?25h'
    exit "$st"
}

usage() {
    sed -n '2,/^# The one interface/p' "$0" | sed '$d' | sed '$d' | sed 's/^# \{0,1\}//'   # the command list
}

main() {
    sub=${1:-status}
    shift 2>/dev/null || true
    words=''
    for a in "$@"; do
        case $a in --dry-run) MODE=dry ;; --verbose|-v) VERBOSE=1 ;; *) words="$words$a\n" ;; esac
    done
    # the flags out of the words (a need is words; -v is not one of them)
    if [ -n "$words" ]; then set -- ; IFS_=$IFS; IFS='
'; for a in $(printf "%b" "$words"); do set -- "$@" "$a"; done; IFS=$IFS_; fi
    case $sub in
        -h|--help|help) usage ;;
        on) cmd_on ;;
        off) cmd_off ;;
        apply) cmd_apply ;;
        follow) cmd_follow ;;
        check) cmd_check ;;
        bar) cmd_bar "$@" ;;
        sbom) cmd_sbom "$@" ;;
        desktop) cmd_desktop "$@" ;;
        status) cmd_status ;;
        --dry-run) MODE=dry; cmd_on ;;
        *) usage >&2; exit 2 ;;
    esac
}

main "$@"
