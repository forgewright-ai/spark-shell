#!/bin/sh
# spark-shell -- sets up the terminal, its colours and a simple desktop
#
#   spark-shell on                    set up the terminal (asks first)
#   spark-shell on desktop            add the sway desktop on Linux (asks first)
#   spark-shell off desktop           remove the desktop, keep the terminal
#   spark-shell off                   undo it all (packages stay installed)
#   spark-shell on --dry-run          show what on would change, change nothing
#   spark-shell on --yes              do not ask first
#   spark-shell status                show what is set up
#   spark-shell check                 test the setup (exit 0 when all is ok)
#   spark-shell theme NAME|none       set the colours, or use the terminal's own
#   spark-shell theme [list]          show the palette in use, or list them all
#   spark-shell font FACE SIZE|none   set the console font, or use its own
#   spark-shell font list             list the fonts you can use
#   spark-shell quiet login on|off    hide the notice before the login (Linux)
#   spark-shell quiet boot on|off     hide the boot menu and messages (Linux)
#   spark-shell quiet                 show both settings
#   spark-shell layout "WORDS"        open apps for that task, picked by spark
#   spark-shell layout save [NAME]    save the last layout
#   spark-shell layout [NAME]         list the saved layouts, or open one
#   spark-shell layout delete NAME    delete a saved layout
#   spark-shell apps                  choose the apps a layout may open
#   spark-shell desktop               start the desktop now (from a console)
#   spark-shell desktop keys          list the desktop's keys
#   spark-shell desktop wallpaper X   set a picture, a colour, default or none
#   spark-shell bar on|off            show or hide the status line and the bar
#   spark-shell bar on|off --desktop  the bar alone (--terminal: the line alone)
#   spark-shell panel [SECTION]       open the panel (Super+d), SECTION first
#   spark-shell panel chat            spark chat in the panel's window (Super+s)
#   spark-shell panel "WORDS"         ask for it: "mute everything", "quiet"
#   spark-shell sbom [NAME]           list the installed software, or one
#   spark-shell sbom --json           write the list as a CycloneDX 1.5 file
#
# A layout opens as sway windows on the desktop and as tmux windows
# anywhere else: add --desktop or --terminal to choose. Add -v to see
# every step.
#
# The one interface to spark is ~/.config/spark/theme.env, the palette
# `spark-shell theme NAME` writes. The look reads THEME_BG, THEME_FG,
# THEME_ACCENT, THEME_MUTED and THEME_ANSI_0-15. With no theme.env the
# terminal keeps its own colours. Three exports go back to spark, from
# the same slots: SPARK_ACCENT_SGR, SPARK_MUTED_SGR and SPARK_WARN_SGR in
# the rendered ~/.config/spark-shell/sgr.sh colour the prompt. spark
# itself is not required. Without it the status line stays empty and
# everything else works. Nothing leaves this machine except what the
# package manager fetches. A layout, and a want at the bar, ask spark on
# this machine (spark edit).
#
# POSIX sh on both OSes: the Debian, Arch and Void families, and macOS. The choices live in ~/.config/spark-shell/
# config, one KEY=value a line. PROMPT is starship|plain, PROMPT_STYLE
# minimal|full, DESKTOP none|sway, FONT foot's spec (DejaVu Sans
# Mono:size=12), WALLPAPER default|none|PATH|#rrggbb, ALPHA foot over a
# picture (0.85) and DESKTOP_BAR yes|no (the bar at the top). THEME is a
# palette's name or none, CONSOLE_FONT "FACE SIZE" (empty: the console
# keeps its font), QUIET_LOGIN and QUIET_BOOT yes|no. starship comes
# from pacman, xbps or Homebrew. Debian has no
# package, so there the rc files draw the shell's own prompt.
#
# The root files are the console's (the palette at boot, the font, the
# login screen, the boot's kernel line), written with sudo only when
# they differ. The login screen is getty's on every Linux, and a login
# on tty1 starts the desktop (DESKTOP=sway, the rc file). On Void the
# desktop also needs seatd at boot and you in its group (sudo once).
# SPARK_SHELL_ROOT=DIR (tests only) prefixes every root path with DIR,
# writes plainly and takes systemctl from PATH.
set -eu

# ~/.local/bin/spark-shell is a symlink into the clone: resolve it, the
# way spark's bin/spark does, so the templates are found from anywhere
SELF=$0
while [ -L "$SELF" ]; do
    _t=$(readlink "$SELF")
    case $_t in /*) SELF=$_t ;; *) SELF=$(dirname "$SELF")/$_t ;; esac
done
REPO=$(cd "$(dirname "$SELF")" && pwd)
OS=$(uname -s)
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/spark-shell
CONFIG=$CONFIG_DIR/config
SPARK_CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/spark
THEME_ENV=$SPARK_CONFIG_DIR/theme.env

# --------------------------------------------------------------- readers
# load_env FILE [env]: every KEY in the file is set, whatever the
# environment holds. Close to spark lib/env.sh load_env (the twin), with
# one difference on purpose: there the environment wins, here the file
# does. spark-shell exports its keys and then starts sway, so every
# window, the bar and the panel inherit the keys as they were at login;
# a palette picked later must still be read from the file by each of
# them. With `env`, a key the environment already holds is kept: the
# distro files, whose package lists may be given on the command line.
# A valid line is blank, a comment, or KEY=value with no shell syntax.
load_env() {
    [ -f "$1" ] || return 0
    bad=$(grep -nEv '^[[:space:]]*(#|$)|^[A-Z_0-9]+=[^;`$()|&<>]*$' "$1" || true)
    if [ -n "$bad" ]; then
        printf 'spark-shell: %s: refused, these lines are not KEY=value:\n%s\n' "$1" "$bad" >&2
        return 1
    fi
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|'#'*|' '*|'	'*) continue ;; esac
        key=${line%%=*}
        val=${line#*=}
        case $val in \"*\") val=${val#\"}; val=${val%\"} ;; esac
        tilde='~'
        case $val in "$tilde"|"$tilde/"*) val=$HOME${val#"$tilde"} ;; esac
        [ -n "$val" ] || continue
        if [ "${2:-}" = env ]; then eval "cur=\${$key:-}"; [ -z "$cur" ] || continue; fi
        export "$key=$val"
    done < "$1"
}
# The keys spark-shell exports for its own runs; a shell or a desktop it
# starts for you gets them unset, so nothing stale is handed on.
CONFIG_UNSET='-u PROMPT -u PROMPT_STYLE -u DESKTOP -u FONT -u WALLPAPER -u ALPHA -u THEME -u CONSOLE_FONT -u QUIET_LOGIN -u QUIET_BOOT -u DESKTOP_BAR'

# This machine's short name (the twin of spark lib/env.sh short_host)
short_host() {
    _host=
    [ "$OS" != Darwin ] || _host=$(scutil --get LocalHostName 2>/dev/null || true)
    [ -n "$_host" ] || _host=$(hostname -s 2>/dev/null || uname -n | cut -d. -f1)
    printf '%s' "$_host"
}

config_load() {
    load_env "$CONFIG" || exit 1
    : "${PROMPT:=starship}"
    : "${PROMPT_STYLE:=minimal}"
    : "${DESKTOP:=none}"
    : "${FONT:=DejaVu Sans Mono:size=12}"   # foot's spec, verbatim
    : "${WALLPAPER:=default}"               # the desktop's background: default (the forge), none, a full path or #rrggbb
    : "${ALPHA:=0.85}"                      # foot over a picture: 0..1, 1 = opaque
    : "${DESKTOP_BAR:=yes}"                # the bar at the top of the desktop: yes or no
    case $ALPHA in 0|1|0.[0-9]|0.[0-9][0-9]|1.0) ;;
        *) echo "spark-shell: ALPHA=$ALPHA in $CONFIG: 0 to 1 (0.85)" >&2; exit 1 ;; esac
    case $DESKTOP in none|sway) ;;
        *) echo "spark-shell: DESKTOP=$DESKTOP in $CONFIG: none or sway" >&2; exit 1 ;; esac
    # the console's four: a palette's name, "FACE SIZE", and two switches
    : "${THEME:=}" "${CONSOLE_FONT:=}" "${QUIET_LOGIN:=no}" "${QUIET_BOOT:=no}"
    case $THEME in .*|*[!A-Za-z0-9._-]*) echo "spark-shell: THEME=$THEME in $CONFIG: a palette's name or none (spark-shell theme list)" >&2; exit 1 ;; esac
    if [ -n "$CONSOLE_FONT" ] && ! printf '%s' "$CONSOLE_FONT" | grep -qE '^[A-Za-z0-9._-]+ [0-9][0-9x.]*$'; then
        echo "spark-shell: CONSOLE_FONT=$CONSOLE_FONT in $CONFIG: FACE SIZE (spark-shell font list)" >&2; exit 1
    fi
    for k in QUIET_LOGIN QUIET_BOOT DESKTOP_BAR; do
        eval "v=\$$k"
        case $v in yes|no) ;; *) echo "spark-shell: $k=$v in $CONFIG: yes or no" >&2; exit 1 ;; esac
    done
    export PROMPT PROMPT_STYLE DESKTOP FONT WALLPAPER ALPHA THEME CONSOLE_FONT QUIET_LOGIN QUIET_BOOT DESKTOP_BAR
}
config_set() {   # config_set KEY VALUE -- one line replaced or added; every other line kept
    mkdir -p "$CONFIG_DIR"
    if [ -f "$CONFIG" ] && grep -q "^$1=" "$CONFIG"; then
        sed "s|^$1=.*|$1=$2|" "$CONFIG" > "$TMP/config"
        cp "$TMP/config" "$CONFIG"
    else
        [ -f "$CONFIG" ] || printf '# spark-shell config -- KEY=value (config.example shows the keys)\n' > "$CONFIG"
        printf '%s=%s\n' "$1" "$2" >> "$CONFIG"
    fi
    row ok config "$1=$2 ($CONFIG)"
}

THEME_KEYS="THEME_BG THEME_FG THEME_ACCENT THEME_MUTED THEME_ANSI_0 THEME_ANSI_1 THEME_ANSI_2 THEME_ANSI_3 THEME_ANSI_4 THEME_ANSI_5 THEME_ANSI_6 THEME_ANSI_7 THEME_ANSI_8 THEME_ANSI_9 THEME_ANSI_10 THEME_ANSI_11 THEME_ANSI_12 THEME_ANSI_13 THEME_ANSI_14 THEME_ANSI_15"

# ------------------------------------------------------------- the slots
# The rendered look names colours by palette slot (0-15: tmux colourN,
# starship's sixteen colour words), never by hex: the console
# palette `spark theme NAME` programs is what draws them, so one file is
# right on the Linux console and merely plain in an emulator. THEME_ACCENT
# and THEME_MUTED are hex in theme.env: each becomes the slot whose
# THEME_ANSI_n is nearest by RGB distance, the lowest index on a tie (a
# palette's bright row often repeats its dim one). A colour word (the
# no-theme.env defaults) is its own slot. BG and FG are the terminal's
# own (`default`).
# ACCENT_SGR and MUTED_SGR are the same two slots as SGR parameters
# (30-37 for slots 0-7, 90-97 for 8-15): what spark >= 1.41 reads from
# the three SPARK_*_SGR exports to colour its prompt at a tty.
SLOT_KEYS="ACCENT_SLOT MUTED_SLOT ACCENT_STAR MUTED_STAR ACCENT_SGR MUTED_SGR"
hex_rgb() {   # hex_rgb #rrggbb -> "r g b" (decimal), or false
    case $1 in \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;; *) return 1 ;; esac
    _h=${1#\#}; _m=${_h#??}
    printf '%d %d %d' "$((0x${_h%????}))" "$((0x${_m%??}))" "$((0x${_h#????}))"
}
slot_of() {   # slot_of COLOUR -> 0..15
    case $1 in
        black) echo 0; return ;; red) echo 1; return ;; green) echo 2; return ;;
        yellow) echo 3; return ;; blue) echo 4; return ;; magenta) echo 5; return ;;
        cyan) echo 6; return ;; white) echo 7; return ;;
    esac
    want=$(hex_rgb "$1") || { echo 7; return; }
    best=; slot=7; i=0
    while [ "$i" -le 15 ]; do
        eval "c=\$THEME_ANSI_$i"
        # shellcheck disable=SC2154   # c is set by the eval above
        if rgb=$(hex_rgb "$c"); then
            # shellcheck disable=SC2086   # six numbers, split on purpose
            set -- $want $rgb
            d=$(( ($1-$4)*($1-$4) + ($2-$5)*($2-$5) + ($3-$6)*($3-$6) ))
            if [ -z "$best" ] || [ "$d" -lt "$best" ]; then best=$d; slot=$i; fi
        fi
        i=$((i + 1))
    done
    echo "$slot"
}
sgr_of() {   # sgr_of N -> the SGR foreground parameter for slot N (30-37, 90-97)
    if [ "$1" -lt 8 ]; then echo $((30 + $1)); else echo $((82 + $1)); fi
}
slot_name() {   # slot_name N -> starship's word for slot N (black .. bright-white)
    _n=$1
    set -- black red green yellow blue purple cyan white
    if [ "$_n" -ge 8 ]; then shift $((_n - 8)); echo "bright-$1"; else shift "$_n"; echo "$1"; fi
}

# theme.env: written by `spark theme NAME` -- the interface (contract 3:
# BG, FG, ACCENT, MUTED and the sixteen ANSI slots; the file may carry
# more). Absent, or spark absent: colour words, each its own slot (the
# twin of spark lib/env.sh theme_load's `none` block). Then the slots.
theme_load() {
    if [ -f "$THEME_ENV" ]; then
        load_env "$THEME_ENV" || return 1
    fi
    : "${THEME_BG:=default}" "${THEME_FG:=default}" "${THEME_ACCENT:=blue}" "${THEME_MUTED:=white}"
    : "${THEME_ANSI_0:=black}" "${THEME_ANSI_1:=red}" "${THEME_ANSI_2:=green}" "${THEME_ANSI_3:=yellow}"
    : "${THEME_ANSI_4:=blue}" "${THEME_ANSI_5:=magenta}" "${THEME_ANSI_6:=cyan}" "${THEME_ANSI_7:=white}"
    : "${THEME_ANSI_8:=black}" "${THEME_ANSI_9:=red}" "${THEME_ANSI_10:=green}" "${THEME_ANSI_11:=yellow}"
    : "${THEME_ANSI_12:=blue}" "${THEME_ANSI_13:=magenta}" "${THEME_ANSI_14:=cyan}" "${THEME_ANSI_15:=white}"
    for k in $THEME_KEYS; do export "${k?}"; done
    ACCENT_SLOT=$(slot_of "$THEME_ACCENT"); MUTED_SLOT=$(slot_of "$THEME_MUTED")
    ACCENT_STAR=$(slot_name "$ACCENT_SLOT"); MUTED_STAR=$(slot_name "$MUTED_SLOT")
    ACCENT_SGR=$(sgr_of "$ACCENT_SLOT"); MUTED_SGR=$(sgr_of "$MUTED_SLOT")
    export ACCENT_SLOT MUTED_SLOT ACCENT_STAR MUTED_STAR ACCENT_SGR MUTED_SGR
    hex_load
    wall_load
    panel_load
}

# The desktop's hex. foot is the desktop's twin of the console palette:
# the one surface that gives the sixteen slots their colours (the kernel
# console gets them from `spark theme NAME`), so it, and sway's borders
# beside it, take the palette's own rrggbb -- every other render keeps
# naming slots. A THEME_* that is #rrggbb is stripped of its `#`; a
# colour word (no theme.env) is the VGA sixteen, what `spark theme none`
# programs. HEX_BG and HEX_FG fall back to slots 0 and 7, HEX_ACCENT and
# HEX_MUTED to their slot's hex.
HEX_KEYS="HEX_BG HEX_FG HEX_ACCENT HEX_MUTED HEX_ANSI_0 HEX_ANSI_1 HEX_ANSI_2 HEX_ANSI_3 HEX_ANSI_4 HEX_ANSI_5 HEX_ANSI_6 HEX_ANSI_7 HEX_ANSI_8 HEX_ANSI_9 HEX_ANSI_10 HEX_ANSI_11 HEX_ANSI_12 HEX_ANSI_13 HEX_ANSI_14 HEX_ANSI_15"
VGA_HEX="000000 aa0000 00aa00 aa5500 0000aa aa00aa 00aaaa aaaaaa 555555 ff5555 55ff55 ffff55 5555ff ff55ff 55ffff ffffff"
hex_or() {   # hex_or COLOUR FALLBACK -> rrggbb, lowercase
    case $1 in
        \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) printf '%s' "${1#\#}" | tr 'A-F' 'a-f' ;;
        *) printf '%s' "$2" ;;
    esac
}
hex_load() {
    i=0
    for h in $VGA_HEX; do
        eval "c=\$THEME_ANSI_$i"
        eval "HEX_ANSI_$i=\$(hex_or \"\$c\" \"$h\")"
        i=$((i + 1))
    done
    # shellcheck disable=SC2034   # read by render_expr through HEX_KEYS
    HEX_BG=$(hex_or "$THEME_BG" "$HEX_ANSI_0")
    # shellcheck disable=SC2034
    HEX_FG=$(hex_or "$THEME_FG" "$HEX_ANSI_7")
    eval "HEX_ACCENT=\$(hex_or \"\$THEME_ACCENT\" \"\$HEX_ANSI_$ACCENT_SLOT\")"
    eval "HEX_MUTED=\$(hex_or \"\$THEME_MUTED\" \"\$HEX_ANSI_$MUTED_SLOT\")"
    for k in $HEX_KEYS; do export "${k?}"; done
}

# The wallpaper: a picture behind the windows, a plain colour of yours,
# or the palette's own background. With a picture, sway keeps gaps
# around the windows and foot is a little translucent, so it shows;
# without one, edge to edge and opaque. A colour is #rrggbb in the
# config (a name is stored as its hex) and stays when the palette
# changes. A path that is not there falls back to the palette's colour
# (the render says so in a row), never to a black screen.
WALL_KEYS="WALL_BG GAPS_INNER GAPS_OUTER FOOT_ALPHA BAR_ALPHA"   # BAR_ALPHA: two hex digits after the bar background over a picture, else nothing
WALL_DEFAULT=$REPO/wallpapers/forge-1920x1080.jpg   # the forge, shipped here (wallpapers/)
WALL_NAMES="black white gray grey silver navy blue teal green olive maroon red purple brown orange"
wall_path() { if [ "$WALLPAPER" = default ]; then printf '%s' "$WALL_DEFAULT"; else printf '%s' "$WALLPAPER"; fi; }
wall_colour() { hex_rgb "$WALLPAPER" >/dev/null; }   # WALLPAPER is a plain colour, #rrggbb
wall_there() { [ "$WALLPAPER" != none ] && ! wall_colour && [ -f "$(wall_path)" ] && [ -r "$(wall_path)" ]; }
wall_hex() {   # wall_hex WORD -> #rrggbb, lowercase, for #rrggbb or one of WALL_NAMES (the CSS hex); false for anything else
    case $(printf '%s' "$1" | tr 'A-Z' 'a-z') in
        black) echo '#000000' ;; white) echo '#ffffff' ;; gray|grey) echo '#808080' ;;
        silver) echo '#c0c0c0' ;; navy) echo '#000080' ;; blue) echo '#0000ff' ;;
        teal) echo '#008080' ;; green) echo '#008000' ;; olive) echo '#808000' ;;
        maroon) echo '#800000' ;; red) echo '#ff0000' ;; purple) echo '#800080' ;;
        brown) echo '#a52a2a' ;; orange) echo '#ffa500' ;;
        *) hex_rgb "$1" >/dev/null || return 1; printf '%s\n' "$1" | tr 'A-F' 'a-f' ;;
    esac
}
wall_word() {   # wall_word WORD -> what WALLPAPER stores: none, default, #rrggbb, or a readable file's full path; nothing for anything else
    case $1 in '') return 0 ;; none|default) printf '%s' "$1"; return 0 ;; esac
    wall_hex "$1" && return 0
    _w=$1; _t='~'   # a quoted ~ is HOME, as the shell would have it
    case $_w in "$_t") _w=$HOME ;; "$_t/"*) _w=$HOME/${_w#"$_t/"} ;; esac
    [ -f "$_w" ] && [ -r "$_w" ] || return 0
    case $_w in /*) ;; *) _w=$(CDPATH='' cd -- "$(dirname -- "$_w")" && pwd)/$(basename -- "$_w") ;; esac
    printf '%s' "$_w"
}
alpha_hex() { awk -v a="$1" 'BEGIN { printf "%02x", int(a * 255 + 0.5) }'; }   # alpha_hex 0.85 -> d9
hex_mix() {   # hex_mix RRGGBB RRGGBB PERCENT -> rrggbb: the first colour moved PERCENT of the way to the second
    # shellcheck disable=SC2046   # three numbers each, split on purpose
    set -- $(hex_rgb "#$1") $(hex_rgb "#$2") "$3"
    printf '%02x%02x%02x' $(( $1 + ($4 - $1) * $7 / 100 )) $(( $2 + ($5 - $2) * $7 / 100 )) $(( $3 + ($6 - $3) * $7 / 100 ))
}
wall_load() {
    # shellcheck disable=SC2034   # read by render_expr through WALL_KEYS
    if wall_there; then
        WALL_BG="\"$(wall_path)\" fill"; GAPS_INNER=8; GAPS_OUTER=12; FOOT_ALPHA=$ALPHA; BAR_ALPHA=$(alpha_hex "$ALPHA")
    elif wall_colour; then
        WALL_BG="$(wall_hex "$WALLPAPER") solid_color"; GAPS_INNER=0; GAPS_OUTER=0; FOOT_ALPHA=1.0; BAR_ALPHA=""
    else
        WALL_BG="#$HEX_BG solid_color"; GAPS_INNER=0; GAPS_OUTER=0; FOOT_ALPHA=1.0; BAR_ALPHA=""
    fi
    # shellcheck disable=SC2034   # read by render_expr through WALL_KEYS
    for k in $WALL_KEYS; do export "${k?}"; done
}

# The panel's surface: its window is a shade of the palette's background
# towards the text, the picked row a shade more, with air around the
# text from the font size; no frame, so it reads as a surface of the
# desktop, not a window with a border. The sway template takes the keys.
PANEL_KEYS="PANEL_SIZE PANEL_PAD PANEL_BG PANEL_HI"
panel_load() {
    # shellcheck disable=SC2034   # read by render_expr through PANEL_KEYS
    PANEL_BG=$(hex_mix "$HEX_BG" "$HEX_FG" 9); PANEL_HI=$(hex_mix "$HEX_BG" "$HEX_FG" 18); PANEL_PAD=$(panel_pad)
    PANEL_MUTED=$(hex_mix "$HEX_MUTED" "$HEX_FG" 35)   # the palette's muted, lifted a third of the way to the text: readable on the surface
    for k in $PANEL_KEYS; do export "${k?}"; done
}
hex_sgr() {   # hex_sgr rrggbb -> the SGR of that colour as text
    # shellcheck disable=SC2046   # three numbers, split on purpose
    set -- $(hex_rgb "#$1"); printf '38;2;%s;%s;%s' "$1" "$2" "$3"
}
panel_pad() { _s=$(look_font_size); : "${_s:=12}"; printf '%sx%s' $(( _s * 2 )) $(( _s * 16 / 10 )); }   # the air in pixels: two cells wide, one tall, at the font's size
panel_foot() {   # panel_foot ARGS... -- the panel's window: foot sized, padded and coloured the way the sway template renders it, running spark-shell panel ARGS (PANEL_LEAD, setsid, before it)
    _fc=$(foot_colors)
    # shellcheck disable=SC2086   # the leader, or nothing
    ${PANEL_LEAD:-} foot --app-id "$PANEL_APP" -W "$PANEL_SIZE" -o "pad=$PANEL_PAD" -o "$_fc.background=$PANEL_BG" -o "$_fc.alpha=1.0" -e "$REPO/spark-shell" panel "$@"
}

# ------------------------------------------------------------------ rows
# The row vocabulary is spark bootstrap.sh's (the twin): ok | would |
# skip | todo; an apply run says what it changed, --dry-run says all.
MODE=apply
VERBOSE=0
YES=0       # --yes: on, on desktop and quiet boot on go ahead without asking
PLAYER=''   # a desk's player: windows | rooms, forced by --windows | --rooms; else where you ask from
todo=0
would=0   # the would rows printed: a dry run's last line counts them
acting=0
todos=0   # the todo rows printed: a verb's closing line says when one is left
row() {
    printf '%-6s %-12s %s\n' "$1" "$2" "${3:-}"
    [ "$1" != would ] || would=$((would + 1))
    [ "$1" != todo ] || todos=$((todos + 1))
}
dry_close() { if [ "$would" -eq 0 ]; then echo "Nothing to do"; else echo "$would to do"; fi; }
loud() { [ "$MODE" = dry ] || [ "$VERBOSE" = 1 ]; }
ok() { if loud || [ "$acting" = 1 ]; then row ok "$1" "${2:-}"; fi; acting=0; }
skip() { if loud; then row skip "$1" "${2:-}"; fi; acting=0; }
need() {
    todo=$((todo + 1))
    if [ "$MODE" = dry ]; then row would "$1" "${2:-}"; return 1; fi
    acting=1
    return 0
}
as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }
sudo_upfront() {
    # ask once, before anything is touched (the twin of bootstrap.sh's)
    [ "$MODE" = apply ] || return 0
    [ "$(id -u)" -ne 0 ] || return 0
    [ "$OS" = Darwin ] && return 0              # brew never needs root
    command -v sudo >/dev/null 2>&1 || return 0
    sudo -n true 2>/dev/null && return 0
    [ -t 0 ] || return 0
    what="the packages"
    if desktop_wanted; then pm_detect; seat_needed && what="the packages and seatd for the desktop"; fi
    if [ -n "$THEME$CONSOLE_FONT" ] || [ "$QUIET_LOGIN$QUIET_BOOT" != nono ]; then what="$what and the console"; fi
    printf 'spark-shell needs sudo once, now: %s.\n' "$what"
    sudo -v || { echo "spark-shell: sudo refused. Nothing was changed." >&2; exit 1; }
}
# The root files go through these three. ROOT is empty
# on a machine; SPARK_SHELL_ROOT=DIR (tests) prefixes every root path and
# makes root_do a plain call -- no sudo, systemctl from PATH.
ROOT=${SPARK_SHELL_ROOT:-}
root_do() { if [ -n "$ROOT" ]; then "$@"; else as_root "$@"; fi; }
root_can() {   # is there a root to write with (now, or at a tty)?
    [ -n "$ROOT" ] || [ "$(id -u)" -eq 0 ] || sudo -n true 2>/dev/null || { command -v sudo >/dev/null 2>&1 && [ -t 0 ]; }
}
root_sudo_once() {   # root_sudo_once [WHAT] -- the password, once, said why (a no-op after sudo_upfront)
    [ -z "$ROOT" ] || return 0
    [ "$(id -u)" -ne 0 ] || return 0
    sudo -n true 2>/dev/null && return 0
    printf 'spark-shell needs sudo once, now: %s.\n' "${1:-the console}"
    sudo -v
}
spark_bin() {   # -> spark's path, or nothing: PATH, then ~/.local/bin (a non-login ssh shell lacks it)
    if command -v spark >/dev/null 2>&1; then command -v spark
    elif [ -x "$HOME/.local/bin/spark" ]; then printf '%s\n' "$HOME/.local/bin/spark"; fi
}
TMP=$(mktemp -d)
PULSE=''
trap 'rm -rf "$TMP"; [ -z "$PULSE" ] || kill "$PULSE" 2>/dev/null' EXIT

# -------------------------------------------------------------- packages
# One place switches on the manager (the twin of bootstrap.sh pkg_*).
PM=
DISTRO=
pm_detect() {
    # SPARK_OS_RELEASE pins the family (tests), even on macOS -- the
    # same fixture pattern spark's bootstrap uses
    if [ "$OS" = Darwin ] && [ -z "${SPARK_OS_RELEASE:-}" ]; then PM=brew; return; fi
    _f=${SPARK_OS_RELEASE:-/etc/os-release}
    for w in $(sed -n 's/^ID=//p; s/^ID_LIKE=//p' "$_f" 2>/dev/null | tr -d '"'); do
        case $w in debian|arch|void) DISTRO=$w; break ;; esac
    done
    [ -z "$DISTRO" ] || load_env "$REPO/distro/$DISTRO.env" env || exit 1
    : "${PM:=}" "${PKG_SHELL:=}" "${PKG_CLI:=}" "${PKG_CONSOLE:=}" "${PKG_DESKTOP:=}"
}
tool_here() {   # tool_here NAME -- on PATH or in ~/.local/bin; under apt by Debian's name (fdfind, batcat), after pm_detect
    _n=$1
    if [ "$PM" = apt ]; then case $1 in fd) _n=fdfind ;; bat) _n=batcat ;; esac; fi
    command -v "$_n" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$_n" ]
}
pkg_installed() {
    case $PM in
        apt) dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed' ;;
        pacman) pacman -Qq "$1" >/dev/null 2>&1 ;;
        xbps) xbps-query "$1" >/dev/null 2>&1 ;;
        *) return 1 ;;
    esac
}
pkg_install() {
    case $PM in
        apt) as_root apt-get update -qq && as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@" ;;
        pacman) as_root pacman -S --needed --noconfirm "$@" ;;
        xbps) as_root xbps-install -Sy "$@" ;;
        *) return 1 ;;
    esac
}

# --------------------------------------------------------------- renders
# The link/render engine is the twin of spark install.sh's: a symlink for
# a file used as-is, a rendered regular file where a value is baked in.
# Yours is never overwritten -- it moves to <path>.bak. A file marked
# `rendered by spark-shell` is ours to render again; a file with any
# other marker, or none, is yours: it moves to .bak.
changes=0
backup() {
    changes=$((changes + 1))
    if [ "$MODE" = dry ]; then row would "back up" "$1"; return; fi
    mv "$1" "$1.bak"
    row "back" "up" "$1 -> $1.bak"
}
link_one() {   # link_one SRC DST
    if [ -L "$2" ] && [ "$(readlink "$2")" = "$1" ]; then ok rc "$2"; return; fi
    if [ -e "$2" ] && [ ! -L "$2" ]; then backup "$2"
    elif [ -L "$2" ]; then case $(readlink "$2") in "$REPO"/*) ;; *) backup "$2" ;; esac; fi
    changes=$((changes + 1))
    if [ "$MODE" = dry ]; then row would rc "$2"; return; fi
    mkdir -p "$(dirname "$2")"
    ln -sfn "$1" "$2"
    row link rc "$2"
}
esc() { printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'; }
bar_mode() { if [ "$DESKTOP_BAR" = yes ]; then echo dock; else echo invisible; fi; }   # sway bar mode: shown, or there but never drawn
bar_font() {   # foot's FONT ("Face:size=N", or :pixelsize=N) in pango's words: "Face N", "Face Npx"; no size, 12
    face=${FONT%%:*}; opts=""; case $FONT in *:*) opts=${FONT#*:} ;; esac
    size=$(printf '%s' "$opts" | tr ':' '\n' | sed -n 's/^size=\([0-9.]*\)$/\1/p' | head -1)
    px=$(printf '%s' "$opts" | tr ':' '\n' | sed -n 's/^pixelsize=\([0-9.]*\)$/\1/p' | head -1)
    if [ -n "$size" ]; then printf '%s %s' "$face" "$size"; elif [ -n "$px" ]; then printf '%s %spx' "$face" "$px"; else printf '%s 12' "$face"; fi
}
render_expr() {
    e="s|@HOME@|$(esc "$HOME")|g;s|@USER@|$(esc "$(id -un)")|g;s|@NAME@|$(esc "$(short_host)")|g;s|@REPO@|$(esc "$REPO")|g"
    for k in $THEME_KEYS; do
        eval "v=\$$k"
        # shellcheck disable=SC2154   # v is set by the eval above
        e="$e;s|@$k@|$(esc "$v")|g"
    done
    for k in $SLOT_KEYS $HEX_KEYS $WALL_KEYS $PANEL_KEYS; do
        eval "v=\$$k"
        e="$e;s|@$k@|$(esc "$v")|g"
    done
    e="$e;s|@FONT@|$(esc "$FONT")|g"
    e="$e;s|@BAR_MODE@|$(bar_mode)|g;s|@BAR_FONT@|$(esc "$(bar_font)")|g"
    e="$e;s|@FOOT_COLORS@|$(foot_colors)|g"
    printf '%s' "$e"
}
render_tmp() {   # render_tmp SRC DST -- the template through EXPR, every placeholder gone
    sed -e "$EXPR" "$1" > "$2"
    if grep -q '@[A-Z_0-9]*@' "$2"; then
        printf 'spark-shell: %s: unrendered placeholder: %s\n' "$1" "$(grep -o '@[A-Z_0-9]*@' "$2" | head -1)" >&2
        exit 1
    fi
}
render_one() {   # render_one SRC DST -- EXPR must be set
    render_tmp "$1" "$TMP/render"
    if [ -f "$2" ] && [ ! -L "$2" ] && cmp -s "$TMP/render" "$2"; then ok look "$2"; return; fi
    if [ -f "$2" ] && [ ! -L "$2" ] && ! grep -q 'rendered by spark-shell' "$2"; then backup "$2"; fi
    changes=$((changes + 1))
    if [ "$MODE" = dry ]; then row would look "$2"; return; fi
    mkdir -p "$(dirname "$2")"
    rm -f "$2"
    cp "$TMP/render" "$2"
    chmod 0644 "$2"
    row render look "$2"
}

# What `on` renders and `off` hands back. sgr.sh is the prompt's colour:
# the three exports the rc files source before spark's hook line.
RENDERED=".tmux.conf .config/btop/btop.conf .config/spark-shell/sgr.sh"
rc_files() { if [ "$OS" = Darwin ]; then echo ".zshrc .zprofile"; else echo ".bashrc .bash_profile"; fi; }
rc_tree() { if [ "$OS" = Darwin ]; then echo "$REPO/templates/macos"; else echo "$REPO/templates/linux"; fi; }
# The desktop: sway and foot, rendered only when asked for (DESKTOP=sway)
# and only on Linux -- macOS has its own desktop. `off` hands both back
# whatever the config says.
DESKTOP_RENDERED=".config/foot/foot.ini .config/sway/config .local/share/applications/spark-shell-tmux.desktop"
foot_colors() {   # the name of foot's colour section: [colors] before 1.26, [colors-dark] from it
    _v=$(PATH=$HOME/.local/bin:$PATH foot --version 2>/dev/null | sed -n 's/^foot version: \([0-9]*\)\.\([0-9]*\).*/\1 \2/p')
    set -- ${_v:-1 26}
    if [ "$1" -gt 1 ] || [ "$2" -ge 26 ]; then echo colors-dark; else echo colors; fi
}
desktop_wanted() { [ "$OS" != Darwin ] && [ "$DESKTOP" = sway ]; }
desktop_tools() {   # -> the missing ones, if any (PATH or ~/.local/bin)
    _miss=''
    for t in sway foot; do
        command -v "$t" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$t" ] || _miss="$_miss $t"
    done
    printf '%s' "$_miss"
}
sway_reload() {   # a running sway takes the new render now (borders, background)
    [ "$MODE" = dry ] && return 0
    [ -n "${SWAYSOCK:-}" ] || return 0
    [ -f "$HOME/.config/sway/config" ] || return 0
    command -v swaymsg >/dev/null 2>&1 || return 0
    swaymsg reload >/dev/null 2>&1 || return 0
    row ok sway "reloaded (~/.config/sway/config)"
}
# The desktop, one path for `on` and `on desktop`: the two user
# renders, a running sway reloaded, then seatd on Void.
desktop_look_apply() {   # the two user renders and a live sway
    if [ "$WALLPAPER" != none ] && ! wall_colour && ! wall_there; then
        row todo wallpaper "$(wall_path) is missing -- the palette's background colour instead (spark-shell desktop wallpaper PATH)"
    fi
    for rel in $DESKTOP_RENDERED; do
        render_one "$REPO/templates/$rel" "$HOME/$rel"
    done
    sway_reload
}
desktop_apply() {
    desktop_look_apply
    seat_apply
}

# The desktop on Void. Void has no logind, so sway takes the screen and
# the keyboard through seatd, a runit service that lets the members of
# the _seatd group in (its run file: seatd -g _seatd). on desktop links
# it into /var/service, where runit starts it now and at every boot, and
# adds you to _seatd. Each step leaves a record in STATE_DIR only when
# spark-shell took it, so off desktop undoes exactly those and nothing
# else. While a desktop runs, seatd stays: stopping it would end that
# desktop.
SEATD_SV=etc/sv/seatd
SEATD_LINK=var/service/seatd
seat_needed() { [ "$OS" != Darwin ] && [ "$DISTRO" = void ]; }
in_group() {   # in_group GROUP USER -- USER is a member of GROUP in /etc/group
    awk -F: -v g="$1" -v u="$2" '$1 == g { n = split($4, m, ","); for (i = 1; i <= n; i++) if (m[i] == u) f = 1 } END { exit !f }' "$ROOT/etc/group" 2>/dev/null
}
seatd_on() { [ -e "$ROOT/$SEATD_LINK" ] || [ -L "$ROOT/$SEATD_LINK" ]; }
seat_ready() { seatd_on && in_group _seatd "$(id -un)"; }
sway_running() { [ -n "${WAYLAND_DISPLAY:-}" ] || pgrep -x sway >/dev/null 2>&1; }
seat_root() {   # seat_root VERB -- a root to write with, asked once; else a todo row and false
    if ! root_can; then row todo desktop "root is needed for seatd -- spark-shell $1 desktop at a terminal (sudo once)"; acting=0; return 1; fi
    root_sudo_once "seatd for the desktop" || { row todo desktop "sudo refused -- spark-shell $1 desktop at a terminal (sudo once)"; acting=0; return 1; }
}
seat_apply() {
    seat_needed || return 0
    if [ ! -d "$ROOT/$SEATD_SV" ]; then
        need desktop "seatd at every boot and you in its group, once the packages are in (sudo)" || return 0
        row todo desktop "seatd is not installed -- spark-shell on desktop (the packages)"; acting=0; return 0
    fi
    _me=$(id -un)
    if seatd_on; then ok desktop "seatd starts at every boot (/$SEATD_LINK)"
    elif need desktop "seatd: link /$SEATD_SV into /var/service, it starts now and at every boot (sudo)" && seat_root on; then
        if root_do ln -s "/$SEATD_SV" "$ROOT/$SEATD_LINK"; then
            mkdir -p "$STATE_DIR"; : > "$STATE_DIR/seatd.linked"
            ok desktop "seatd runs now and at every boot"
        else row todo desktop "the link /$SEATD_LINK failed -- spark-shell on desktop again"; acting=0; fi
    fi
    if in_group _seatd "$_me"; then ok desktop "$_me is in the _seatd group"
    elif ! grep -q '^_seatd:' "$ROOT/etc/group" 2>/dev/null; then row todo desktop "there is no _seatd group: the seatd package makes it -- spark-shell on desktop"
    elif need desktop "add $_me to the _seatd group (sudo)" && seat_root on; then
        if root_do usermod -aG _seatd "$_me"; then
            mkdir -p "$STATE_DIR"; : > "$STATE_DIR/seatd.group"
            ok desktop "$_me is in the _seatd group now: it takes effect at your next login"
        else row todo desktop "usermod could not add $_me to _seatd -- spark-shell on desktop again"; acting=0; fi
    fi
}
seat_off() {   # by the records alone: the link spark-shell made, the membership it added
    [ -e "$STATE_DIR/seatd.linked" ] || [ -e "$STATE_DIR/seatd.group" ] || return 0
    need desktop "seatd's link and your _seatd membership removed, as spark-shell made them (sudo)" || return 0
    _keep=0
    if [ -e "$STATE_DIR/seatd.linked" ] && sway_running; then
        _keep=1
        row todo desktop "seatd stays while a desktop runs (stopping it would end the desktop) -- spark-shell off desktop again after leaving it"; acting=0
    fi
    seat_root off || return 0
    _me=$(id -un)
    if [ "$_keep" = 0 ] && [ -e "$STATE_DIR/seatd.linked" ]; then
        if [ ! -L "$ROOT/$SEATD_LINK" ] || root_do rm -f "$ROOT/$SEATD_LINK"; then
            rm -f "$STATE_DIR/seatd.linked"
            row ok desktop "seatd no longer starts at boot (the link spark-shell made is gone)"
        else row todo desktop "the link /$SEATD_LINK stays -- spark-shell off desktop again"; fi
    fi
    if [ -e "$STATE_DIR/seatd.group" ]; then
        if ! in_group _seatd "$_me" || root_do gpasswd -d "$_me" _seatd >/dev/null 2>&1; then
            rm -f "$STATE_DIR/seatd.group"
            row ok desktop "$_me is out of the _seatd group spark-shell added: it takes effect at your next login"
        else row todo desktop "gpasswd could not take $_me out of _seatd -- spark-shell off desktop again"; fi
    fi
}

# The login screen before v0.42: greetd and tuigreet on tty1, enabled by
# spark-shell in getty@tty1's place (systemd only, never on Void). on
# and off hand it back wherever spark-shell's files for it are still
# there: getty@tty1 enabled and greetd disabled for the next boot (never
# stopped live: that would end the session this runs in), spark-shell's
# files removed and a config.toml of the package's put back. The
# packages stay.
OLD_GREETD_CONF=etc/greetd/config.toml
OLD_GREETD_FILES="etc/greetd/spark-shell/desktop.desktop etc/greetd/spark-shell/console.desktop etc/systemd/system/greetd.service.d/spark-shell.conf"
OLD_GREETD_DIRS="etc/greetd/spark-shell etc/systemd/system/greetd.service.d"
unit_enabled() { systemctl is-enabled "$1" >/dev/null 2>&1; }
old_greetd_here() { grep -q 'rendered by spark-shell' "$ROOT/$OLD_GREETD_CONF" 2>/dev/null || [ -e "$ROOT/$OLD_GREETD_CONF.spark-orig" ]; }
old_greetd_off() {
    [ "$OS" != Darwin ] && old_greetd_here || return 0
    need login "the normal console login on tty1 from the next boot: greetd turned off, its spark-shell files removed (sudo)" || return 0
    if ! root_can; then row todo login "the old login screen (greetd) stays -- spark-shell on at a terminal (sudo once)"; acting=0; return 0; fi
    root_sudo_once "the login screen on tty1" || { row todo login "sudo refused -- spark-shell on at a terminal (sudo once)"; acting=0; return 0; }
    # getty first: tty1 never loses its login
    root_do systemctl enable getty@tty1.service >/dev/null 2>&1 || true
    root_do systemctl disable greetd.service >/dev/null 2>&1 || true
    conf=$ROOT/$OLD_GREETD_CONF
    if [ -e "$conf.spark-orig" ]; then root_do mv "$conf.spark-orig" "$conf"
    else root_do rm -f "$conf"; fi
    for rel in $OLD_GREETD_FILES; do [ ! -e "$ROOT/$rel" ] || root_do rm -f "$ROOT/$rel"; done
    for d in $OLD_GREETD_DIRS; do [ -d "$ROOT/$d" ] && root_do rmdir "$ROOT/$d" 2>/dev/null || true; done
    root_do systemctl daemon-reload >/dev/null 2>&1 || true
    ok login "the normal console login is back on tty1 from the next boot: greetd is off, its packages stay"
}

render_all() {
    theme_load
    EXPR=$(render_expr)
    for rel in $RENDERED; do
        render_one "$REPO/templates/$rel" "$HOME/$rel"
    done
    if [ "$PROMPT" = starship ]; then
        render_one "$REPO/templates/.config/starship.toml.$PROMPT_STYLE" "$HOME/.config/starship.toml"
    fi
    if desktop_wanted; then desktop_apply; fi
}

hand_back() {   # hand_back REL... -- each render of ours under HOME (marker or .bak) restored
    for rel in "$@"; do
        p=$HOME/$rel
        if [ -f "$p" ] && [ ! -L "$p" ]; then
            if grep -q 'rendered by spark-shell' "$p" 2>/dev/null || [ -e "$p.bak" ]; then
                restore_one "$p"
            fi
        fi
    done
}
restore_one() {   # restore_one PATH -- .bak back, or gone; never a husk
    [ -e "$1" ] || [ -L "$1" ] || return 0
    rm -f "$1"
    if [ -e "$1.bak" ] || [ -L "$1.bak" ]; then
        mv "$1.bak" "$1"
        row ok restore "$1 -- back from ${1##*/}.bak"
    else
        row ok restore "$1 -- removed (no ${1##*/}.bak: there was no file before)"
    fi
}

tmux_reload() {
    command -v tmux >/dev/null 2>&1 || return 0
    tmux list-sessions >/dev/null 2>&1 || return 0
    if [ -f "$HOME/.tmux.conf" ]; then
        # what a v0.1 render set and a source-file cannot unset: the
        # console hook and the appended truecolor override
        tmux set-hook -gu client-attached >/dev/null 2>&1 || true
        tmux set -gu terminal-overrides >/dev/null 2>&1 || true
        tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
        row ok tmux "reloaded (~/.tmux.conf)"
    fi
}

# ------------------------------------------------------------- the console
# The palette, the console font and a quiet login and boot: spark handed
# them back in 1.62, and they are spark-shell's now. Four keys in the
# config, each written by its verb and applied by it and by `on`:
# THEME (a palette name, or none), CONSOLE_FONT ("FACE SIZE", empty: the
# console keeps its font), QUIET_LOGIN and QUIET_BOOT (yes|no). `off`
# hands every one back. Every root file is found by spark-shell's own
# marks and names, so a machine that never had them does nothing, and
# root is asked only for what is there:
#   ~/.config/spark/theme.env     the palette, 20 THEME_* keys (spark reads it too)
#   ~/.config/spark-shell/console-colors[.rgb]  the escapes a console login
#                                 sends, and setvtrgb's form for the boot
#   /etc/systemd/system/spark-shell-console.service  setvtrgb at boot (systemd)
#   a line in /etc/rc.local ending ` #spark-shell-palette#`  the same (runit)
#   FILE.spark-shell-orig         a root file as it was before spark-shell
#   lines ending ` #spark-shell-quiet#`  a quiet boot on Void (GRUB, rc.conf, getty)
#   zz-spark-shell-quiet.*        the GRUB and the kernel image drop-ins
# Every root path is under ROOT (SPARK_SHELL_ROOT in the tests), even the
# ones only read (/run/systemd, /sys, /proc), so a fixture pins the shape.
PALETTE_DIR=$CONFIG_DIR/themes                     # yours: NAME.env wins over the repository's themes/
CONSOLE_COLORS=$CONFIG_DIR/console-colors          # the escapes, sent at a console login
CONSOLE_RGB=$CONFIG_DIR/console-colors.rgb         # setvtrgb's three lines, read by root at boot
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell
REBUILD=$STATE_DIR/boot-rebuild                    # a boot rebuild that has not held yet: grub | uki, one a line
TERMINAL_SEEN=$STATE_DIR/terminal.seen             # macOS: the palette and font Terminal.app's profile has
CONSOLE_UNIT=etc/systemd/system/spark-shell-console.service
PALETTE_MARK=' #spark-shell-palette#'
QUIET_MARK=' #spark-shell-quiet#'
SPLASH_MARK='#spark-shell-quiet# '
CURSOR_ON=$(printf '\033[?25h')
# the quiet kernel line, the same six words on every shape: quiet and
# loglevel=3 silence the kernel, splash hands Plymouth the boot when it
# is there, systemd.show_status=false keeps the unit lines off, udev's
# level quiets the initramfs, fbcon stops the flicker. The cursor stays:
# a cursor during a quiet boot is harmless, a console without one is not
QUIET_WORDS='quiet splash loglevel=3 systemd.show_status=false udev.log_level=3 fbcon=nodefer'

is_wsl() { [ "$OS" != Darwin ] && { [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qis microsoft "$ROOT/proc/version"; }; }
init_shape() {   # -> systemd | runit | none: what boots this Linux
    if [ -d "$ROOT/run/systemd/system" ]; then echo systemd
    elif [ -d "$ROOT/etc/runit" ]; then echo runit
    else echo none; fi
}
console_linux() { [ "$OS" != Darwin ] && ! is_wsl; }   # a Linux with a console of its own
root_ready() {   # root_ready ROW -- a root to write with, asked once; else a todo row and false
    if ! root_can; then row todo "$1" "root is needed -- spark-shell on at a terminal (sudo once)"; acting=0; return 1; fi
    root_sudo_once "the console" || { row todo "$1" "sudo refused -- spark-shell on at a terminal (sudo once)"; acting=0; return 1; }
}
# Under /boot (a vfat ESP, dmask 0077) a user can neither read nor even
# see a file: root reads and tests there, and a mode is a wish (vfat
# has none, so a failed chmod is no error).
root_exists() { [ -e "$1" ] || root_do test -e "$1" 2>/dev/null; }   # root_exists PATH
root_put() {   # root_put SRC DST [MODE] -- a root file written from SRC; a new one takes MODE (0644)
    _new=0; root_exists "$2" || _new=1
    root_do mkdir -p "$(dirname "$2")"
    root_do cp "$1" "$2"
    [ "$_new" = 0 ] || root_do chmod "${3:-0644}" "$2" 2>/dev/null || true
}
root_read() {   # root_read FILE -> its bytes (root when a user cannot read it); false when absent or unreadable
    if [ -r "$1" ]; then cat "$1"; else root_do cat "$1" 2>/dev/null; fi
}
# A marked line is one spark-shell appended to a file it does not own: it
# ends with the mark, and off deletes exactly those, every other line as
# it is (LC_ALL=C: the bytes pass through untouched, and a last line with
# no newline stays without one).
marked() {   # marked FILE MARK -> the lines carrying MARK, the mark off
    [ -f "$1" ] || return 0
    LC_ALL=C awk -v m="$2" 'length($0) >= length(m) && substr($0, length($0) - length(m) + 1) == m { print substr($0, 1, length($0) - length(m)) }' "$1"
}
marked_text() {   # marked_text FILE MARK [LINESFILE [exit]] -> FILE without MARK's lines, then LINESFILE's lines marked
    # (with exit: before a last `exit 0`, where rc.local still runs them)
    [ -f "$1" ] || { [ -z "${3:-}" ] || LC_ALL=C sed "s/\$/$2/" "$3"; return 0; }
    _open=0; [ -z "$(tail -c1 "$1")" ] || _open=1   # the last line has no newline
    LC_ALL=C awk -v m="$2" -v open="$_open" -v add="${3:-}" -v ex="${4:-}" '
        function add_lines(   l) { while ((getline l < add) > 0) print l m }
        { k = !(length($0) >= length(m) && substr($0, length($0) - length(m) + 1) == m); if (k) line[++n] = $0 }
        END {
            if (!k) open = 0
            last = n; while (last > 0 && line[last] ~ /^[ \t]*$/) last--
            at = n + 1; if (add != "" && ex != "" && last > 0 && line[last] ~ /^[ \t]*exit 0[ \t]*$/) at = last
            for (i = 1; i <= n; i++) {
                if (i == at) add_lines()
                printf "%s%s", line[i], (i == n && open && !(add != "" && at > n)) ? "" : "\n"
            }
            if (add != "" && at > n) add_lines()
        }' "$1"
}

# ------------------------------------------------------------ the palette
# A palette is a KEY=value file: the 20 THEME_* keys, each #rrggbb, and
# THEME_LOGO when it names spark's logo colours. `spark-shell theme NAME`
# writes three files from it: theme.env (what spark and every render
# read), console-colors (\033]P<n><rrggbb> for the 16 slots, what a
# console login sends) and its .rgb twin (setvtrgb's decimal lines, what
# root sets at boot, so the login prompt and every console wear it).
palette_file() {   # palette_file NAME -> its file, yours first; false when there is none
    case $1 in ''|.*|*[!A-Za-z0-9._-]*) return 1 ;; esac
    for _p in "$PALETTE_DIR/$1.env" "$REPO/themes/$1.env"; do
        [ -f "$_p" ] && { printf '%s' "$_p"; return 0; }
    done
    return 1
}
palette_names() { for _p in "$REPO"/themes/*.env "$PALETTE_DIR"/*.env; do [ -f "$_p" ] || continue; _n=${_p##*/}; printf '%s\n' "${_n%.env}"; done | sort -u; }
palette_get() { sed -n "s/^$2=//p" "$1" | tail -1 | tr -d '"\r'; }   # palette_get FILE KEY
console_render() {   # console_render RRGGBB... (16) -> $TMP/console-colors and $TMP/console-colors.rgb
    _i=0; _esc=''; _r=''; _g=''; _b=''
    for _h in "$@"; do
        _esc="$_esc$(printf '\033]P%x%s' "$_i" "$_h")"
        _rgb=$(hex_rgb "#$_h"); _gb=${_rgb#* }
        _r="$_r,${_rgb%% *}"; _g="$_g,${_gb% *}"; _b="$_b,${_gb#* }"
        _i=$((_i + 1))
    done
    printf '%s' "$_esc" > "$TMP/console-colors"
    printf '%s\n%s\n%s\n' "${_r#,}" "${_g#,}" "${_b#,}" > "$TMP/console-colors.rgb"
}
palette_render() {   # palette_render NAME -> the three files in $TMP; false, and why in $TMP/palette.why, when it cannot
    if ! _f=$(palette_file "$1"); then echo "no palette named $1 (spark-shell theme list)" > "$TMP/palette.why"; return 1; fi
    printf '# rendered by spark-shell from the palette %s -- spark-shell theme NAME changes it\n' "$1" > "$TMP/theme.env"
    _hexes=''
    for _k in $THEME_KEYS; do
        _v=$(palette_get "$_f" "$_k")
        hex_rgb "$_v" >/dev/null || { echo "$_f: $_k is not #rrggbb" > "$TMP/palette.why"; return 1; }
        printf '%s=%s\n' "$_k" "$_v" >> "$TMP/theme.env"
        case $_k in THEME_ANSI_*) _hexes="$_hexes $(printf '%s' "${_v#\#}" | tr 'A-F' 'a-f')" ;; esac
    done
    _v=$(palette_get "$_f" THEME_LOGO)
    case $_v in '') ;; *[!A-Za-z0-9\ _.#-]*) echo "$_f: THEME_LOGO holds more than names and colours" > "$TMP/palette.why"; return 1 ;;
        *) printf 'THEME_LOGO=%s\n' "$_v" >> "$TMP/theme.env" ;; esac
    # shellcheck disable=SC2086   # sixteen words, split on purpose
    console_render $_hexes
}
theme_ours() { [ -f "$THEME_ENV" ] && grep -q 'rendered by spark-shell' "$THEME_ENV"; }
console_send() {   # console_send FILE -- the escapes to this console, then a redraw; a console login at a tty only
    [ "${TERM:-}" = linux ] && [ -t 1 ] && console_linux || return 0
    [ "$MODE" != dry ] || return 0
    cat "$1" 2>/dev/null || return 0
    [ "$todos" -gt 0 ] || printf '\033[2J\033[H'   # a todo row stays on screen for the closing line to point at
}
# A framebuffer console paints a new palette only into the cells drawn
# after it, so the escapes wait for the end of the run: sent, the screen
# cleared (never over a todo row), then the closing line (console_now,
# just before it).
CONSOLE_NOW=''
console_now() { [ -z "$CONSOLE_NOW" ] || console_send "$CONSOLE_NOW"; }
root_path_ok() { case $1 in *[!A-Za-z0-9/._-]*) return 1 ;; *) return 0 ;; esac; }   # a path a root file may carry
unit_render() { sed -e "s|@CONSOLE_RGB@|$(esc "$CONSOLE_RGB")|g" "$REPO/templates/$CONSOLE_UNIT" > "$TMP/unit"; }
palette_line() { printf "[ -r '%s' ] && setvtrgb '%s'" "$CONSOLE_RGB" "$CONSOLE_RGB"; }   # the rc.local line (runit)
VT_SYSFS=$ROOT/sys/module/vt/parameters/default_red
vt_here() { [ -r "$VT_SYSFS" ]; }                              # a kernel with consoles (not a container)
vt_live() { head -1 "$VT_SYSFS" 2>/dev/null || true; }         # the kernel's default reds, now
vt_vga_rgb() {   # -> $TMP/vga.rgb: the VGA sixteen in setvtrgb's form
    # shellcheck disable=SC2086
    console_render $VGA_HEX; cp "$TMP/console-colors.rgb" "$TMP/vga.rgb"
}

theme_files() {   # before the renders: theme.env and the console's two files, as THEME says
    [ -n "$THEME" ] || { skip theme "THEME unset: the palette stays as it is (spark-shell theme NAME)"; return 0; }
    if [ "$THEME" = none ]; then
        if [ -f "$THEME_ENV" ] && need theme "remove $THEME_ENV (THEME=none)"; then
            rm -f "$THEME_ENV"; ok theme "none: theme.env removed, the terminal's own colours"
        fi
        return 0
    fi
    if ! palette_render "$THEME"; then row todo theme "THEME=$THEME: $(cat "$TMP/palette.why")"; return 0; fi
    for _f in theme.env console-colors console-colors.rgb; do
        case $_f in theme.env) _d=$THEME_ENV ;; *) _d=$CONFIG_DIR/$_f ;; esac
        if [ -f "$_d" ] && cmp -s "$TMP/$_f" "$_d"; then ok theme "$THEME ($_d)"; continue; fi
        changes=$((changes + 1))
        need theme "$THEME: write $_d" || continue
        mkdir -p "$(dirname "$_d")"; cp "$TMP/$_f" "$_d"
        [ "$_f" != console-colors ] || CONSOLE_NOW=$_d
        ok theme "$THEME: $_d written"
    done
}

palette_boot() {   # Linux: the palette at boot, root's; the kernel's defaults set now
    [ -n "$THEME" ] && [ "$THEME" != none ] && [ -f "$CONSOLE_RGB" ] || return 0
    console_linux || { skip palette "WSL has no console: the palette is Windows Terminal's"; return 0; }
    shape=$(init_shape)
    if [ "$shape" = none ]; then skip palette "no systemd or runit here: nothing sets the palette at boot"; return 0; fi
    command -v setvtrgb >/dev/null 2>&1 || { row todo palette "setvtrgb is missing: the kbd package has it (spark-shell on)"; return 0; }
    root_path_ok "$CONSOLE_RGB" || { row todo palette "$CONSOLE_RGB holds a character a root file cannot carry: the palette at boot is left alone"; return 0; }
    if [ "$shape" = systemd ]; then
        unit_render
        if cmp -s "$TMP/unit" "$ROOT/$CONSOLE_UNIT" && unit_enabled spark-shell-console.service; then
            ok palette "spark-shell-console.service sets it at boot"
        elif need palette "write /$CONSOLE_UNIT and enable it (sudo)" && root_ready palette; then
            root_put "$TMP/unit" "$ROOT/$CONSOLE_UNIT"
            root_do systemctl daemon-reload >/dev/null 2>&1 || true
            root_do systemctl enable spark-shell-console.service >/dev/null 2>&1 || true
            ok palette "spark-shell-console.service sets it at boot"
        fi
    else
        palette_line > "$TMP/line"; echo >> "$TMP/line"
        if [ "$(marked "$ROOT/etc/rc.local" "$PALETTE_MARK")" = "$(palette_line)" ]; then
            ok palette "a line in /etc/rc.local sets it at boot"
        elif need palette "add one line at the end of /etc/rc.local, before any exit 0 (sudo)" && root_ready palette; then
            { [ -f "$ROOT/etc/rc.local" ] || printf '#!/bin/sh\n'; marked_text "$ROOT/etc/rc.local" "$PALETTE_MARK" "$TMP/line" exit; } > "$TMP/rc.local"
            root_put "$TMP/rc.local" "$ROOT/etc/rc.local" 0755
            ok palette "a line in /etc/rc.local sets it at boot"
        fi
    fi
    # the kernel's defaults now, so every console and the login prompt
    # wear it before the next boot (sysfs says what they are)
    vt_here && [ "$(vt_live)" != "$(head -1 "$CONSOLE_RGB")" ] || return 0
    need palette "setvtrgb: every console uses the palette now (sudo)" || return 0
    root_ready palette || return 0
    if root_do setvtrgb "$CONSOLE_RGB" >/dev/null 2>&1; then ok palette "every console uses the palette now"
    else row todo palette "setvtrgb failed -- the next boot sets the palette"; acting=0; fi
}

palette_off() {   # palette_off all|ours -- VGA again, the boot's palette gone, the files gone once root held
    _unit=0; [ -e "$ROOT/$CONSOLE_UNIT" ] && _unit=1
    _line=$(marked "$ROOT/etc/rc.local" "$PALETTE_MARK")
    _files=0; [ -e "$CONSOLE_COLORS" ] || [ -e "$CONSOLE_RGB" ] && _files=1
    _env=0; if [ -f "$THEME_ENV" ] && { [ "$1" = all ] || theme_ours; }; then _env=1; fi
    [ "$_unit$_files$_env" != 000 ] || [ -n "$_line" ] || return 0
    held=1
    if console_linux && { [ "$_unit" = 1 ] || [ -n "$_line" ] || [ "$_files" = 1 ]; }; then
        vt_vga_rgb
        if [ "$_unit" = 0 ] && [ -z "$_line" ]; then
            # no root file: nothing sets it at boot; this console takes VGA by its escapes
            cp "$TMP/console-colors" "$TMP/vga-colors"; CONSOLE_NOW=$TMP/vga-colors
        elif [ "$MODE" = dry ]; then
            row would palette "the console's default colours again, nothing sets a palette at boot (sudo)"
        elif root_ready palette; then
            cp "$TMP/console-colors" "$TMP/vga-colors"; CONSOLE_NOW=$TMP/vga-colors   # VGA on this console at the end
            if [ "$_unit" = 1 ]; then
                root_do systemctl disable spark-shell-console.service >/dev/null 2>&1 || true
                root_do rm -f "$ROOT/$CONSOLE_UNIT" && root_do systemctl daemon-reload >/dev/null 2>&1 || true
                [ ! -e "$ROOT/$CONSOLE_UNIT" ] || held=0
            fi
            if [ -n "$_line" ]; then
                marked_text "$ROOT/etc/rc.local" "$PALETTE_MARK" > "$TMP/rc.local"
                if [ "$(cat "$TMP/rc.local")" = '#!/bin/sh' ]; then root_do rm -f "$ROOT/etc/rc.local" || held=0   # the one spark-shell made
                else root_put "$TMP/rc.local" "$ROOT/etc/rc.local" || held=0; fi
            fi
            if command -v setvtrgb >/dev/null 2>&1 && vt_here && [ "$(vt_live)" != "$(head -1 "$TMP/vga.rgb")" ]; then
                root_do setvtrgb vga >/dev/null 2>&1 || held=0
            fi
            [ "$held" = 0 ] || row ok palette "the console's default colours are back, nothing sets a palette at boot"
        else
            held=0
        fi
    fi
    if [ "$MODE" = dry ]; then
        [ "$_env$_files" = 00 ] || row would theme "remove the palette files from ~/.config (theme.env, console-colors)"
    elif [ "$held" = 1 ]; then
        [ "$_env" = 0 ] || rm -f "$THEME_ENV"
        rm -f "$CONSOLE_COLORS" "$CONSOLE_RGB"
        [ "$_env$_files" = 00 ] || row ok theme "the palette files are removed from ~/.config (theme.env, console-colors)"
    else
        row todo theme "the palette files stay until sudo resets the console colours -- spark-shell off at a terminal"
    fi
    return 0
}

# macOS: the palette and the font are a Terminal.app profile, written
# by the helper (lib/terminal_profile.py, python3 is every Mac's). The
# stamp says what the profile had when it was written, and the helper
# says it is still there, so `on` imports it again only when it changed
# or went (Terminal > Settings > Profiles can delete it).
terminal_has() { python3 "$REPO/lib/terminal_profile.py" has-profile >/dev/null 2>&1; }
terminal_apply() {
    [ "$OS" = Darwin ] || return 0
    [ -f "$THEME_ENV" ] && [ -n "$THEME" ] && [ "$THEME" != none ] || return 0
    set -- $CONSOLE_FONT
    _face=${1:-Menlo-Regular}; _size=${2:-13}
    _want="$(cksum < "$THEME_ENV" | cut -d' ' -f1) $_face $_size"
    _why="Terminal.app's profile from the palette, in $_face $_size"
    if [ "$(cat "$TERMINAL_SEEN" 2>/dev/null)" = "$_want" ]; then
        if terminal_has; then ok terminal "Terminal.app's profile is the palette, in $_face $_size"; return 0; fi
        _why="Terminal.app lost the spark-shell profile: import it again, in $_face $_size"
    fi
    need terminal "$_why" || return 0
    if python3 "$REPO/lib/terminal_profile.py" apply "$THEME_ENV" "$_face" "$_size"; then
        mkdir -p "$STATE_DIR"; printf '%s\n' "$_want" > "$TERMINAL_SEEN"
        ok terminal "Terminal.app's profile is the palette, in $_face $_size"
    else
        row todo terminal "the helper could not write Terminal.app's profile -- spark-shell on again"; acting=0
    fi
}
terminal_off() {
    [ "$OS" = Darwin ] && [ -f "$TERMINAL_SEEN" ] || return 0
    if [ "$MODE" = dry ]; then row would terminal "Terminal.app's spark-shell profile removed"; return 0; fi
    if python3 "$REPO/lib/terminal_profile.py" remove; then
        rm -f "$TERMINAL_SEEN"; row ok terminal "Terminal.app's spark-shell profile removed, open windows keep their look"
    else
        row todo terminal "Terminal.app kept the profile: Terminal > Settings > Profiles removes it"
    fi
}

# The open terminals (Linux). foot, like most terminals, reads its
# colours when a window opens and cannot reload them, so `theme NAME`
# sends the palette to each terminal you have open: OSC 4 for the 16
# slots, OSC 10 and 11 for the text and the background, OSC 12 for the
# cursor when the palette has a THEME_CURSOR. `theme none` sends the
# resets (OSC 104, 110, 111, 112). A terminal is a /dev/pts/N that you
# own and can write. A tmux pane is a pty too, but tmux would keep the
# codes for that pane alone, so the panes are left out: tmux's clients
# are the outer terminals, among your ptys, and tmux follows by its own
# re-render (tmux_reload). The Linux console is console_now's, a Mac's
# Terminal.app its profile's. SPARK_SHELL_PTS_DIR (tests only) is the
# directory the ptys are read from, with plain files standing in.
PTS_DIR=${SPARK_SHELL_PTS_DIR:-/dev/pts}
osc_render() {   # osc_render NAME|none -> $TMP/osc: the codes, each ended by ST (ESC \)
    if [ "$1" = none ]; then
        printf '\033]104\033\\\033]110\033\\\033]111\033\\\033]112\033\\' > "$TMP/osc"; return 0
    fi
    _f=$(palette_file "$1") || return 1
    : > "$TMP/osc"
    _i=0
    while [ "$_i" -le 15 ]; do
        printf '\033]4;%d;%s\033\\' "$_i" "$(palette_get "$_f" "THEME_ANSI_$_i" | tr 'A-F' 'a-f')" >> "$TMP/osc"
        _i=$((_i + 1))
    done
    printf '\033]10;%s\033\\\033]11;%s\033\\' "$(palette_get "$_f" THEME_FG | tr 'A-F' 'a-f')" "$(palette_get "$_f" THEME_BG | tr 'A-F' 'a-f')" >> "$TMP/osc"
    _c=$(palette_get "$_f" THEME_CURSOR)
    if hex_rgb "$_c" >/dev/null; then printf '\033]12;%s\033\\' "$(printf '%s' "$_c" | tr 'A-F' 'a-f')" >> "$TMP/osc"; fi
}
pts_mine() {   # -> the ptys to paint, one a line: yours, writable, not a tmux pane
    _me=$(id -u)
    _panes=''
    if command -v tmux >/dev/null 2>&1; then _panes=$(tmux list-panes -a -F '#{pane_tty}' 2>/dev/null || true); fi
    for _p in "$PTS_DIR"/*; do
        case ${_p##*/} in ''|*[!0-9]*) continue ;; esac   # N only: never ptmx
        [ -w "$_p" ] || continue
        [ "$(ls -lLdn "$_p" 2>/dev/null | awk '{print $3}')" = "$_me" ] || continue
        if printf '%s\n' "$_panes" | grep -qxF -- "$_p"; then continue; fi
        printf '%s\n' "$_p"
    done
}
pts_write() {   # pts_write PTY -- the codes to one terminal, given 2 seconds (a stopped terminal never hangs the verb)
    if command -v timeout >/dev/null 2>&1; then timeout 2 sh -c 'cat "$1" > "$2"' sh "$TMP/osc" "$1" 2>/dev/null
    else cat "$TMP/osc" > "$1" 2>/dev/null; fi
}
theme_repaint() {   # theme_repaint NAME|none -- every open terminal takes it now; one line when any did
    [ "$MODE" = apply ] && [ "$OS" != Darwin ] && [ -d "$PTS_DIR" ] || return 0
    osc_render "$1" || return 0
    pts_mine > "$TMP/pts"
    _n=0
    while IFS= read -r _p; do
        if pts_write "$_p"; then _n=$((_n + 1)); fi
    done < "$TMP/pts"
    if [ "$_n" -eq 1 ]; then echo "Repainted 1 open terminal."
    elif [ "$_n" -gt 1 ]; then echo "Repainted $_n open terminals."; fi
}

# --------------------------------------------------------- the console font
# By mechanism, never by family: console-setup's FONTFACE and FONTSIZE
# where /etc/default/console-setup is (Debian), vconsole.conf's FONT=
# where /etc/vconsole.conf is (Arch), rc.conf's FONT= beside /etc/runit
# (Void). The file's first copy is kept as FILE.spark-shell-orig, and off
# puts its font lines back, every other line as it is then.
console_shape() {   # -> setup | vconsole | rcconf, or nothing
    console_linux || return 0
    if [ -f "$ROOT/etc/default/console-setup" ]; then echo setup
    elif [ -f "$ROOT/etc/vconsole.conf" ]; then echo vconsole
    elif [ -f "$ROOT/etc/rc.conf" ] && [ -d "$ROOT/etc/runit" ]; then echo rcconf; fi
}
font_file() { case $1 in setup) echo "$ROOT/etc/default/console-setup" ;; rcconf) echo "$ROOT/etc/rc.conf" ;; *) echo "$ROOT/etc/vconsole.conf" ;; esac; }
font_keys() { if [ "$1" = setup ]; then echo "FONTFACE FONTSIZE"; else echo FONT; fi; }
font_value() { sed -n "s/^$2=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$1" 2>/dev/null | head -1; }   # font_value FILE KEY
font_now() {   # font_now SHAPE -> what the file says: FACE SIZE (console-setup), FACE (the others)
    _ff=$(font_file "$1")
    if [ "$1" = setup ]; then printf '%s %s' "$(font_value "$_ff" FONTFACE)" "$(font_value "$_ff" FONTSIZE)"
    else font_value "$_ff" FONT; fi
}
font_want() { if [ "$1" = setup ]; then printf '%s' "$CONSOLE_FONT"; else printf '%s' "${CONSOLE_FONT%% *}"; fi; }
font_text() {   # font_text FILE LINE[|LINE] [SEP] -- FILE with each KEY line set (a #KEY one when none is), added when absent
    # SEP is what follows the key (= in the font files, a space in loader.conf)
    LC_ALL=C awk -v kv="$2" -v sep="${3:-=}" '
        BEGIN { n = split(kv, a, "|"); for (i = 1; i <= n; i++) { key[i] = substr(a[i], 1, index(a[i], sep) - 1) } }
        NR == FNR { for (i = 1; i <= n; i++) { if (index($0, key[i] sep) == 1) on[i] = 1; else if (!(i in off) && index($0, "#" key[i] sep) == 1) off[i] = FNR }; next }
        { for (i = 1; i <= n; i++) if ((on[i] && index($0, key[i] sep) == 1) || (!on[i] && off[i] == FNR)) { print a[i]; seen[i] = 1; next } ; print }
        END { for (i = 1; i <= n; i++) if (!seen[i]) print a[i] }' "$1" "$1"
}
font_restored() {   # font_restored FILE ORIG KEYS SEP -- FILE with its KEY lines as ORIG had them, every other line as it is
    LC_ALL=C awk -v keys="$3" -v sep="$4" '
        function keyof(l,   i) { for (i = 1; i <= n; i++) if (index(l, k[i] sep) == 1 || index(l, "#" k[i] sep) == 1) return k[i]; return "" }
        BEGIN { n = split(keys, k, " ") }
        NR == FNR { x = keyof($0); if (x != "") old[x, ++no[x]] = $0; next }
        { x = keyof($0); if (x == "") { print; next } ; if (used[x] < no[x]) print old[x, ++used[x]] }' "$2" "$1"
}
font_redraw() {   # font_redraw SHAPE FACE -- the console takes the file's font now
    case $1 in
        setup) root_do setupcon --force >/dev/null 2>&1 || true ;;
        vconsole) root_do systemctl restart systemd-vconsole-setup >/dev/null 2>&1 || true ;;
        rcconf) root_do setfont "$2" >/dev/null 2>&1 || true ;;
    esac
}
font_apply() {
    if [ "$OS" = Darwin ]; then return 0; fi   # the Terminal.app profile carries it (terminal_apply)
    [ -n "$CONSOLE_FONT" ] || { skip font "CONSOLE_FONT unset: the console keeps its font"; return 0; }
    is_wsl && { skip font "WSL has no console: the font is Windows Terminal's"; return 0; }
    shape=$(console_shape)
    [ -n "$shape" ] || { row todo font "no console-setup, vconsole.conf or rc.conf here -- spark-shell font none"; return 0; }
    file=$(font_file "$shape"); face=${CONSOLE_FONT%% *}; size=${CONSOLE_FONT#* }
    if [ "$(font_now "$shape")" = "$(font_want "$shape")" ]; then ok font "$CONSOLE_FONT ($file)"; return 0; fi
    changes=$((changes + 1))
    need font "$CONSOLE_FONT in $file, the console redrawn (sudo)" || return 0
    root_ready font || return 0
    [ -e "$file.spark-shell-orig" ] || root_do cp "$file" "$file.spark-shell-orig"   # the original, once: off puts it back
    case $shape in
        setup) lines="FONTFACE=\"$face\"|FONTSIZE=\"$size\"" ;;
        vconsole) lines="FONT=$face" ;;
        *) lines="FONT=\"$face\"" ;;
    esac
    font_text "$file" "$lines" > "$TMP/font"
    root_put "$TMP/font" "$file"
    font_redraw "$shape" "$face"
    if [ "$shape" = rcconf ]; then ok font "$CONSOLE_FONT ($file): the console has it now and at every boot"
    else ok font "$CONSOLE_FONT ($file)"; fi
}
font_off() {   # every font file with a .spark-shell-orig: its font lines back, the copy gone, the console redrawn
    for shape in setup vconsole rcconf; do
        file=$(font_file "$shape")
        [ -e "$file.spark-shell-orig" ] || continue
        if [ "$MODE" = dry ]; then row would font "the font lines of $file back from ${file##*/}.spark-shell-orig (sudo)"; continue; fi
        root_ready font || continue
        root_read "$file.spark-shell-orig" > "$TMP/font.orig" || { row todo font "root could not read ${file##*/}.spark-shell-orig -- spark-shell off again"; continue; }
        if [ -e "$file" ]; then
            root_read "$file" > "$TMP/font.cur" || { row todo font "root could not read $file -- spark-shell off again"; continue; }
            font_restored "$TMP/font.cur" "$TMP/font.orig" "$(font_keys "$shape")" = > "$TMP/font"
        else cp "$TMP/font.orig" "$TMP/font"; fi
        root_put "$TMP/font" "$file" && root_do rm -f "$file.spark-shell-orig"
        if [ "$shape" = rcconf ]; then row ok font "the font lines of $file are back: the console's own font at the next boot"
        else font_redraw "$shape" ""; row ok font "the console's font is back as it was ($file)"; fi
    done
}

# Linux: what `spark-shell font list` may name. console-setup composes a
# face from /usr/share/consolefonts (the file names say <codeset>-<Face>
# <Size>, the size HxW, or the height of an 8-wide face); the other two
# shapes name a kbd font file, its cell size read from its own header.
consolefonts_dir() { for _d in "$ROOT/usr/share/kbd/consolefonts" "$ROOT/usr/share/consolefonts"; do [ -d "$_d" ] && { printf '%s' "$_d"; return 0; }; done; return 1; }
psf_size() {   # psf_size FILE -> WxH from its header (PSF1 or PSF2, gzip or plain), or nothing
    case $1 in *.gz) _hd=$(gzip -dc "$1" 2>/dev/null | od -An -tu1 -N32) ;; *) _hd=$(od -An -tu1 -N32 "$1" 2>/dev/null) ;; esac
    # shellcheck disable=SC2086   # the header's bytes, one word each
    set -- $_hd
    if [ "${1:-}" = 54 ] && [ "${2:-}" = 4 ] && [ $# -ge 4 ]; then echo "8x$4"
    elif [ "${1:-}" = 114 ] && [ "${2:-}" = 181 ] && [ "${3:-}" = 74 ] && [ "${4:-}" = 134 ] && [ $# -ge 32 ]; then
        shift 24; _h=$(($1 + $2 * 256)); shift 4; echo "$(($1 + $2 * 256))x$_h"
    fi
}
console_fonts() {   # -> "FACE SIZE" lines, sorted; nothing when the fonts dir is not here
    _d=$(consolefonts_dir) || return 0
    if [ "$(console_shape)" = setup ]; then
        for _f in "$_d"/*; do
            printf '%s\n' "${_f##*/}" | sed -n 's/^[A-Za-z0-9]*-\([A-Za-z]*\)\([0-9][0-9x]*\)\.psfu\{0,1\}\(\.gz\)\{0,1\}$/\1 \2/p'
        done | awk '{ s = $2; if (s ~ /x/) { split(s, p, "x"); s = p[2] "x" p[1] } else s = "8x" s; print $1, s }'
    else
        for _f in "$_d"/*.psf* ; do
            [ -f "$_f" ] || continue
            _s=$(psf_size "$_f"); [ -n "$_s" ] || continue
            _n=${_f##*/}; _n=${_n%.gz}; _n=${_n%.psfu}; _n=${_n%.psf}
            printf '%s %s\n' "$_n" "$_s"
        done
    fi | sort -u
}
MAC_FACES="Menlo-Regular Monaco SFMono-Regular Courier CourierNewPSMT AndaleMono JetBrainsMono-Regular FiraCode-Regular Hack-Regular SourceCodePro-Regular CascadiaCode-Regular UbuntuMono-Regular DejaVuSansMono IBMPlexMono"
MAC_SYSTEM_FACES="Menlo-Regular Monaco SFMono-Regular Courier CourierNewPSMT AndaleMono"
mac_face_here() {   # a face every Mac ships, one Spotlight finds, else the helper's word (SPARK_SHELL_MAC_FONTS pins them in tests)
    if [ -n "${SPARK_SHELL_MAC_FONTS:-}" ]; then case " $SPARK_SHELL_MAC_FONTS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; fi
    case " $MAC_SYSTEM_FACES " in *" $1 "*) return 0 ;; esac
    [ -n "$(mdfind "kMDItemFonts == '$1'" 2>/dev/null | head -1)" ] && return 0
    python3 "$REPO/lib/terminal_profile.py" has-font "$1" >/dev/null 2>&1   # Spotlight off: the helper does not refuse on no evidence
}

# --------------------------------------------------------- a quiet login
# No distro notice, no kernel line, a bare `login:`: /etc/motd empties,
# update-motd.d/10-uname stops running, and /etc/issue holds only the
# cursor-on escape (a belt: a console that lost its cursor gets it back
# at the login prompt). The first copies are FILE.spark-shell-orig, and
# 10-uname's mark is UNAME_OFF. off acts on those records alone: a file
# back only while the live one is still spark-shell's (the issue empty or
# the escape), never an issue it did not write, and nothing at all while
# spark core's own copy, /etc/issue.orig, is there (the login is spark's).
UNAME_OFF=$STATE_DIR/uname.off
login_quiet() {   # is the login quiet now?
    [ ! -s "$ROOT/etc/motd" ] && [ ! -x "$ROOT/etc/update-motd.d/10-uname" ] && [ "$(cat "$ROOT/etc/issue" 2>/dev/null)" = "$CURSOR_ON" ]
}
login_traces() {   # spark-shell's own records of a quiet login, and no spark core copy beside them
    [ ! -e "$ROOT/etc/issue.orig" ] && { [ -e "$ROOT/etc/motd.spark-shell-orig" ] || [ -e "$ROOT/etc/issue.spark-shell-orig" ] || [ -e "$UNAME_OFF" ]; }
}
login_apply() {
    [ "$OS" != Darwin ] || return 0
    if [ "$QUIET_LOGIN" != yes ]; then login_off; return 0; fi
    if login_quiet; then ok quiet "login: a bare login prompt, no notice, no kernel line"; return 0; fi
    changes=$((changes + 1))
    need quiet "login: empty /etc/motd and /etc/issue (the cursor escape only), 10-uname off (sudo)" || return 0
    root_ready quiet || return 0
    _mo=$ROOT/etc/motd; _is=$ROOT/etc/issue; _un=$ROOT/etc/update-motd.d/10-uname
    if [ -s "$_mo" ] && [ ! -e "$_mo.spark-shell-orig" ]; then root_do cp "$_mo" "$_mo.spark-shell-orig"; fi
    [ ! -s "$_mo" ] || { : > "$TMP/empty"; root_put "$TMP/empty" "$_mo"; }
    if [ -x "$_un" ]; then root_do chmod -x "$_un"; mkdir -p "$STATE_DIR"; : > "$UNAME_OFF"; fi
    if [ "$(cat "$_is" 2>/dev/null)" != "$CURSOR_ON" ]; then   # an issue that is the escape already is not taken over
        if [ -e "$_is.spark-shell-orig" ]; then :
        elif [ -e "$_is" ]; then root_do cp "$_is" "$_is.spark-shell-orig"
        else : > "$TMP/empty"; root_put "$TMP/empty" "$_is.spark-shell-orig"; fi
        printf '%s' "$CURSOR_ON" > "$TMP/issue"; root_put "$TMP/issue" "$_is"
    fi
    ok quiet "login: a bare login prompt, no notice, no kernel line (the originals: *.spark-shell-orig)"
}
login_off() {   # motd, issue and 10-uname back by spark-shell's own records; a stale copy of yours only goes
    [ "$OS" != Darwin ] || return 0
    login_traces || return 0
    if [ "$MODE" = dry ]; then row would quiet "login: the notice, the kernel line and the login banner back (sudo)"; return 0; fi
    root_ready quiet || return 0
    _mo=$ROOT/etc/motd; _is=$ROOT/etc/issue; _un=$ROOT/etc/update-motd.d/10-uname
    back=''
    if [ -e "$_mo.spark-shell-orig" ]; then
        if [ ! -s "$_mo" ]; then root_do cp "$_mo.spark-shell-orig" "$_mo"; back="$back motd"; fi
        root_do rm -f "$_mo.spark-shell-orig"
    fi
    if [ -e "$_is.spark-shell-orig" ]; then
        case $(cat "$_is" 2>/dev/null) in ''|"$CURSOR_ON") root_do cp "$_is.spark-shell-orig" "$_is"; back="$back issue" ;; esac
        root_do rm -f "$_is.spark-shell-orig"
    fi
    if [ -e "$UNAME_OFF" ]; then
        if [ -f "$_un" ] && [ ! -x "$_un" ]; then root_do chmod +x "$_un"; back="$back 10-uname"; fi
        rm -f "$UNAME_OFF"
    fi
    if [ -n "$back" ]; then row ok quiet "login: the login screen is as it was ($(printf '%s' "${back# }" | sed 's/ /, /g'))"
    else row ok quiet "login: spark-shell's stale copies are gone, yours stay as they are"; fi
}

# ---------------------------------------------------------- a quiet boot
# Straight past the boot menu, a quiet kernel line, and on Void runit's
# own lines off, per shape, each by spark-shell's own file or mark:
#   grub  (Debian) one drop-in, /etc/default/grub.d/zz-spark-shell-quiet.cfg
#         (the user's /etc/default/grub is never edited); update-grub
#   void  GRUB reads no drop-in there: three marked lines at the end of
#         /etc/default/grub, ten in /etc/rc.conf (runit's stage 1 quiet,
#         a warning or an error still printed and marked in /run) and two
#         in the tty1 getty's conf (the screen cleared after a clean boot
#         only); update-grub
#   uki   (Arch with a unified kernel image) /etc/cmdline.d/zz-spark-shell-
#         quiet.conf, the preset's --splash line marked off, systemd-boot's
#         menu wait 0 (loader.conf, its first copy kept); mkinitcpio -P
# WSL, an Arch without a UKI and a Linux with no GRUB are refused in one
# sentence. The rebuild is marked pending before a file changes and
# unmarked when it held, so a rebuild that failed runs again next time.
GRUB_DROPIN=etc/default/grub.d/zz-spark-shell-quiet.cfg
CMDLINE_DROPIN=etc/cmdline.d/zz-spark-shell-quiet.conf
LOADER_CONF=boot/loader/loader.conf
BOOT_LOUD='"${SPARK_SHELL_BOOT_LOUD:-/run/spark-shell-boot-loud}"'
grub_want() {
    printf '%s\n' 'GRUB_TIMEOUT=0' 'GRUB_TIMEOUT_STYLE=hidden' "GRUB_CMDLINE_LINUX_DEFAULT=\"\$GRUB_CMDLINE_LINUX_DEFAULT $QUIET_WORDS\""
}
rc_want() {
    printf '%s\n' '# spark-shell quiet boot on wrote these lines, spark-shell quiet boot off removes them' \
        'case $0 in */runit/1)' \
        'msg() { :; }' \
        "msg_warn() { { : >$BOOT_LOUD; } 2>/dev/null; printf \"\\033[1m\\033[33mWARNING: \$@\\033[m\\n\"; }" \
        "msg_error() { { : >$BOOT_LOUD; } 2>/dev/null; printf \"\\033[1m\\033[31mERROR: \$@\\033[m\\n\"; }" \
        "fsck() { _ss_out=\$(command fsck \"\$@\" 2>&1); _ss_rc=\$?; [ \"\$_ss_rc\" = 0 ] || { printf '%s\\n' \"\$_ss_out\"; { : >$BOOT_LOUD; } 2>/dev/null; }; return \"\$_ss_rc\"; }" \
        'sysctl() { if [ "$1" = -p ]; then command sysctl "$@" >/dev/null; else command sysctl "$@"; fi; }' \
        'seedrng() { command seedrng "$@" >/dev/null; }' \
        "alias modules-load='modules-load >/dev/null'" \
        'esac'
}
getty_want() {
    printf '%s\n' '# spark-shell quiet boot on wrote these lines, spark-shell quiet boot off removes them' \
        "[ -e $BOOT_LOUD ] || [ -n \"\$(dmesg -l emerg,alert,crit 2>/dev/null)\" ] || GETTY_ARGS=\$(printf '%s' \"\$GETTY_ARGS\" | sed 's/--noclear//')"
}
GETTY_CONF=etc/sv/agetty-tty1/conf
have_update_grub() { command -v update-grub >/dev/null 2>&1 || [ -x "$ROOT/usr/sbin/update-grub" ]; }
uki_here() { grep -qs '^[a-z_]*_uki=' "$ROOT"/etc/mkinitcpio.d/*.preset; }
splash_live() { grep -qs '^[a-z_]*_options=.*--splash' "$ROOT"/etc/mkinitcpio.d/*.preset; }
boot_shape() {   # -> grub | void | uki, or a refusal word: mac | wsl | arch | nogrub
    if [ "$OS" = Darwin ]; then echo mac
    elif is_wsl; then echo wsl
    elif uki_here; then echo uki
    elif [ "$DISTRO" = arch ]; then echo arch
    elif [ -f "$ROOT/etc/default/grub" ] && have_update_grub; then
        if [ "$DISTRO" = void ]; then echo void; else echo grub; fi
    else echo nogrub; fi
}
boot_refusal() {   # boot_refusal SHAPE -> the one sentence, or nothing when spark-shell may quiet it
    case $1 in
        mac) echo "macOS has no boot menu or kernel line to quiet." ;;
        wsl) echo "WSL has no boot of its own: Windows boots it." ;;
        arch) echo "This Arch has no unified kernel image, so its kernel line is the boot loader's and stays as it is." ;;
        nogrub) echo "There is no GRUB with update-grub here, so the boot loader stays as it is." ;;
    esac
}
pending_has() { grep -qx "$1" "$REBUILD" 2>/dev/null; }
pending_add() { pending_has "$1" && return 0; mkdir -p "$STATE_DIR"; printf '%s\n' "$1" >> "$REBUILD"; }
pending_drop() { [ -f "$REBUILD" ] || return 0; grep -vx "$1" "$REBUILD" > "$TMP/pending" || true; if [ -s "$TMP/pending" ]; then cp "$TMP/pending" "$REBUILD"; else rm -f "$REBUILD"; fi; }
boot_rebuild() {   # boot_rebuild grub|uki -- update-grub or mkinitcpio -P as root; the pending mark goes when it held
    case $1 in grub) set -- grub update-grub ;; *) set -- uki mkinitcpio -P ;; esac
    _kind=$1; shift
    if root_do "$@" >/dev/null 2>&1; then pending_drop "$_kind"; return 0; fi
    row todo quiet "boot: $* failed -- spark-shell on runs it again"; acting=0; return 1
}
boot_quiet() {   # boot_quiet SHAPE -- is every trace of a quiet boot in place?
    case $1 in
        grub) grub_want > "$TMP/want"; cmp -s "$TMP/want" "$ROOT/$GRUB_DROPIN" ;;
        void) [ "$(marked "$ROOT/etc/default/grub" "$QUIET_MARK")" = "$(grub_want)" ] \
                && [ "$(marked "$ROOT/etc/rc.conf" "$QUIET_MARK")" = "$(rc_want)" ] \
                && [ "$(marked "$ROOT/$GETTY_CONF" "$QUIET_MARK")" = "$(getty_want)" ] ;;
        uki) [ "$(cat "$ROOT/$CMDLINE_DROPIN" 2>/dev/null)" = "$QUIET_WORDS" ] && ! splash_live ;;
        *) return 1 ;;
    esac
}
boot_kind() { if [ "$1" = uki ]; then echo uki; else echo grub; fi; }
loader_timeout() {   # loader_timeout N -- systemd-boot's menu wait, the file's first copy kept (root reads under /boot)
    _lc=$ROOT/$LOADER_CONF
    [ -d "$ROOT/boot/loader" ] || root_do test -d "$ROOT/boot/loader" 2>/dev/null || return 0
    if ! root_exists "$_lc"; then : > "$TMP/loader"   # none yet: the copy says so, empty
    elif ! root_read "$_lc" > "$TMP/loader"; then
        row todo quiet "boot: root could not read /$LOADER_CONF, so its timeout stays -- spark-shell on again"; acting=0; return 0
    fi
    root_exists "$_lc.spark-shell-orig" || root_put "$TMP/loader" "$_lc.spark-shell-orig"
    font_text "$TMP/loader" "timeout $1" ' ' > "$TMP/loader.new"
    root_put "$TMP/loader.new" "$_lc"
}
boot_apply() {
    [ "$OS" != Darwin ] || return 0
    if [ "$QUIET_BOOT" != yes ]; then boot_off; return 0; fi
    shape=$(boot_shape); why=$(boot_refusal "$shape")
    if [ -n "$why" ]; then skip quiet "boot: $why"; return 0; fi
    kind=$(boot_kind "$shape")
    if boot_quiet "$shape"; then
        if ! pending_has "$kind"; then ok quiet "boot: menu hidden, a quiet kernel line$( [ "$shape" != void ] || printf ", runit's lines off")"; return 0; fi
        need quiet "boot: the last rebuild failed, run it again (sudo)" && root_ready quiet && boot_rebuilt "$kind" && ok quiet "boot: quiet after a reboot"
        return 0
    fi
    changes=$((changes + 1))
    case $shape in
        grub) need quiet "boot: GRUB drop-in /$GRUB_DROPIN; update-grub (sudo)" || return 0 ;;
        void) need quiet "boot: lines added at the end of /etc/default/grub, /etc/rc.conf and /$GETTY_CONF; update-grub (sudo)" || return 0 ;;
        uki) need quiet "boot: /$CMDLINE_DROPIN, the preset's --splash turned off, loader.conf timeout 0; mkinitcpio -P (sudo)" || return 0 ;;
    esac
    root_ready quiet || return 0
    pending_add "$kind"   # before a file changes: a failed rebuild runs again next time
    case $shape in
        grub) grub_want > "$TMP/dropin"; root_put "$TMP/dropin" "$ROOT/$GRUB_DROPIN" ;;
        void)
            grub_want > "$TMP/l"; marked_text "$ROOT/etc/default/grub" "$QUIET_MARK" "$TMP/l" > "$TMP/f"; root_put "$TMP/f" "$ROOT/etc/default/grub"
            rc_want > "$TMP/l"; marked_text "$ROOT/etc/rc.conf" "$QUIET_MARK" "$TMP/l" > "$TMP/f"; root_put "$TMP/f" "$ROOT/etc/rc.conf"
            getty_want > "$TMP/l"; marked_text "$ROOT/$GETTY_CONF" "$QUIET_MARK" "$TMP/l" > "$TMP/f"; root_put "$TMP/f" "$ROOT/$GETTY_CONF" ;;
        uki)
            printf '%s\n' "$QUIET_WORDS" > "$TMP/dropin"; root_put "$TMP/dropin" "$ROOT/$CMDLINE_DROPIN"
            for p in "$ROOT"/etc/mkinitcpio.d/*.preset; do
                grep -qs '^[a-z_]*_options=.*--splash' "$p" || continue
                LC_ALL=C sed "s/^\([a-z_]*_options=.*--splash\)/$SPLASH_MARK\1/" "$p" > "$TMP/preset"; root_put "$TMP/preset" "$p"
            done
            loader_timeout 0 ;;
    esac
    boot_rebuilt "$kind" || return 0
    ok quiet "boot: quiet after a reboot (hold Shift or Space at boot for the menu)"
}
boot_rebuilt() {   # boot_rebuilt grub|uki -- the rebuild, and for GRUB its artifact read back: grub.cfg carries the line
    boot_rebuild "$1" || return 1
    [ "$1" = grub ] || return 0
    root_do grep -q 'loglevel=3' "$ROOT/boot/grub/grub.cfg" 2>/dev/null && return 0
    pending_add grub   # the rebuild did not hold: the next on runs it again
    row todo quiet "boot: grub.cfg does not carry the quiet line -- spark-shell on runs update-grub again"; acting=0; return 1
}
boot_off() {   # spark-shell's boot traces out, per shape found, then the rebuild; a failed one stays pending
    [ "$OS" != Darwin ] || return 0
    _g=0; _u=0; _m=''
    [ ! -e "$ROOT/$GRUB_DROPIN" ] || _g=1
    for f in "$ROOT/etc/default/grub" "$ROOT/etc/rc.conf" "$ROOT/$GETTY_CONF"; do [ -z "$(marked "$f" "$QUIET_MARK")" ] || _m="$_m $f"; done
    case $_m in *"$ROOT/etc/default/grub"*) _g=1 ;; esac
    { [ -e "$ROOT/$CMDLINE_DROPIN" ] || grep -qs "^$SPLASH_MARK" "$ROOT"/etc/mkinitcpio.d/*.preset; } && _u=1
    [ "$_g$_u" != 00 ] || [ -n "$_m" ] || pending_has grub || pending_has uki || return 0
    if [ "$MODE" = dry ]; then row would quiet "boot: the boot menu and the kernel's messages back, spark-shell's boot lines removed (sudo)"; return 0; fi
    root_ready quiet || return 0
    [ "$_g" = 0 ] || pending_add grub
    [ "$_u" = 0 ] || pending_add uki
    [ ! -e "$ROOT/$GRUB_DROPIN" ] || root_do rm -f "$ROOT/$GRUB_DROPIN"
    for f in $_m; do marked_text "$f" "$QUIET_MARK" > "$TMP/f"; root_put "$TMP/f" "$f"; done
    if [ "$_u" = 1 ]; then
        root_do rm -f "$ROOT/$CMDLINE_DROPIN"
        for p in "$ROOT"/etc/mkinitcpio.d/*.preset; do
            grep -qs "^$SPLASH_MARK" "$p" || continue
            LC_ALL=C sed "s/^$SPLASH_MARK//" "$p" > "$TMP/preset"; root_put "$TMP/preset" "$p"
        done
        _lc=$ROOT/$LOADER_CONF
        if root_exists "$_lc.spark-shell-orig"; then
            : > "$TMP/loader"
            if root_read "$_lc.spark-shell-orig" > "$TMP/loader.orig" && { ! root_exists "$_lc" || root_read "$_lc" > "$TMP/loader"; }; then
                font_restored "$TMP/loader" "$TMP/loader.orig" timeout ' ' > "$TMP/loader.new"
                root_put "$TMP/loader.new" "$_lc" && root_do rm -f "$_lc.spark-shell-orig"
            else
                row todo quiet "boot: root could not read /$LOADER_CONF, so its timeout stays -- spark-shell off again"; acting=0
            fi
        fi
    fi
    _held=1
    if pending_has grub; then boot_rebuild grub || _held=0; fi
    if pending_has uki; then boot_rebuild uki || _held=0; fi
    [ "$_held" = 0 ] || row ok quiet "boot: after a reboot, the boot menu and the kernel's messages are back"
}

console_apply() {   # after the renders: the palette at boot, the font, a quiet login and boot; macOS: the profile
    palette_boot
    terminal_apply
    font_apply
    login_apply
    boot_apply
}
console_off() {   # off: every one handed back
    palette_off ours
    terminal_off
    font_off
    login_off
    boot_off
}

# ------------------------------------------------------------------ verbs
# One pair of switches: `on` is the terminal seat, `on desktop` the seat
# and the desktop; `off desktop` takes the desktop back and
# keeps the seat, `off` takes everything back. `apply`, `desktop on` and
# `desktop off` are spellings of the same paths. The one noun is desktop;
# any other word is refused before a thing is touched.
noun_ok() {   # noun_ok on|off [WORD...]
    [ $# -gt 1 ] || return 0
    [ "$*" != "$1 desktop" ] || return 0
    _v=$1; shift; _w=$*
    case $_w in *[!\ ]*) ;; *) _w="an empty word" ;; esac
    echo "spark-shell $_v: $_w is not known here (only desktop is)"; exit 1
}
# The warning: on, on desktop and quiet boot on change how this machine
# behaves, so each says what it changes and asks first. --yes goes
# ahead without asking; --dry-run changes nothing and never asks. The
# question is asked only at a terminal (stdin); with no terminal and no
# --yes, one line and exit 1, nothing changed. The suite drives the
# answer through stdin with SPARK_SHELL_TEST_TTY set.
asks() { [ "$MODE" = apply ] && [ "$YES" = 0 ]; }   # will this run ask?
ask_terminal() {   # before a word is printed: no terminal, one line and exit 1
    [ -t 0 ] || [ -n "${SPARK_SHELL_TEST_TTY:-}" ] || { echo "spark-shell: no terminal to ask on -- add --yes to go ahead"; exit 1; }
}
ask_continue() {   # the question; anything but y or yes stops here, nothing changed
    printf '\nContinue? [y/N] '
    if ! IFS= read -r _ans; then echo; _ans=''; fi
    case $_ans in y|Y|yes|Yes|YES) return 0 ;; esac
    echo "spark-shell: nothing was changed."; exit 1
}
warn_wrap() {   # warn_wrap LABEL WORDS... -- one row of the desktop list, wrapped within 80 columns
    _l=$1; shift
    printf '%s\n' "$*" | awk -v l="$_l" '{
        line = sprintf("  %-13s", l); n = length(line); first = 1
        for (i = 1; i <= NF; i++) {
            if (!first && n + 1 + length($i) > 79) { print line; line = sprintf("%15s", ""); n = 15; first = 1 }
            if (first) { line = line $i; n += length($i); first = 0 } else { line = line " " $i; n += 1 + length($i) }
        }
        print line }'
}
on_warning() {   # on_warning [desktop] -- at the very start of on: what it changes, then the question
    noun_ok on "$@"
    asks || return 0
    if [ "${1:-}" = desktop ]; then
        [ "$OS" != Darwin ] || return 0   # refused next, before anything
        pm_detect
    fi
    ask_terminal
    if [ "$OS" = Darwin ]; then
        printf '%s\n' 'spark-shell replaces your shell files, installs packages' \
            'and changes the Terminal.app colours.' 'spark-shell on --dry-run shows every change.'
    elif [ "${1:-}" = desktop ]; then
        printf '%s\n' 'spark-shell replaces your shell files, installs packages' \
            'and changes the console colours.' 'spark-shell on desktop --dry-run shows every change.'
    else
        printf '%s\n' 'spark-shell replaces your shell files, installs packages' \
            'and changes the console colours. spark-shell on --dry-run' 'shows every change.'
    fi
    if [ "${1:-}" = desktop ]; then
        printf '\nspark-shell changes how this machine works:\n\n'
        # shellcheck disable=SC2086
        [ -z "$PKG_DESKTOP" ] || warn_wrap packages $PKG_DESKTOP '(sudo)'
        warn_wrap login 'logging in on tty1 starts the desktop'
        warn_wrap '' 'Alt+F2 is a plain shell'
        if [ "$DISTRO" = void ]; then
            warn_wrap groups 'adds you to _seatd (sudo)'
            warn_wrap services 'turns on seatd at boot (sudo)'
        fi
        printf '\n%s\n%s\n' 'spark-shell off desktop puts the login back.' 'Packages stay.'
    fi
    ask_continue
}
boot_warning() {   # boot_warning SHAPE -- before quiet boot on: what it changes, then the question
    asks || return 0
    ask_terminal
    printf '%s\n' 'spark-shell quiet boot on changes how this machine starts:' \
        'the boot menu is hidden, and the kernel and init are silent.'
    case $1 in
        grub) echo 'It adds a GRUB settings file and runs update-grub (sudo).' ;;
        uki) echo 'It edits the kernel command line and runs mkinitcpio -P (sudo).' ;;
        void) echo 'It edits the GRUB settings and the runit boot files (sudo).' ;;
    esac
    echo 'spark-shell quiet boot off puts it back.'
    ask_continue
}
cmd_on() {   # cmd_on [desktop]
    on_warning "$@"
    noun_ok on "$@"
    [ "${1:-}" != desktop ] || [ "$OS" != Darwin ] || refuse "not on macOS, which has its own desktop"
    config_load
    if [ "${1:-}" = desktop ]; then
        # the config first, then everything on does with DESKTOP=sway:
        # the packages, the renders, seatd on Void (desktop_apply). The
        # line itself is a change: never "Nothing to do" after writing it
        if [ "$DESKTOP" != sway ]; then
            if [ "$MODE" = dry ]; then row would config "DESKTOP=sway ($CONFIG)"; else changes=$((changes + 1)); fi
        fi
        [ "$MODE" = dry ] || config_set DESKTOP sway
        DESKTOP=sway; export DESKTOP
    fi
    sudo_upfront
    loud && printf '== packages\n'
    pm_detect
    if [ "$PM" = brew ]; then
        if ! command -v brew >/dev/null 2>&1; then
            row todo packages "Homebrew is not installed: https://brew.sh (then run again)"
        elif brew bundle check --file "$REPO/Brewfile" --no-upgrade >/dev/null 2>&1; then
            ok packages "Brewfile satisfied"
        elif need packages "brew bundle --file Brewfile"; then
            brew bundle --file "$REPO/Brewfile" --no-upgrade
            ok packages "Brewfile satisfied"
        fi
    elif [ -z "$PM" ]; then
        row todo packages "no package list for this Linux: spark-shell knows Debian, Arch and Void"
    else
        missing=''
        pkgs="$PKG_SHELL $PKG_CLI $PKG_CONSOLE"
        if desktop_wanted; then pkgs="$pkgs $PKG_DESKTOP"; fi
        # shellcheck disable=SC2086
        for p in $pkgs; do pkg_installed "$p" || missing="$missing $p"; done
        if [ -z "$missing" ]; then ok packages "installed"
        elif [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
            # nobody to type a password here: say what is left, keep going
            # (the links and renders below need no root)
            row todo packages "still to install:$missing -- spark-shell on at a terminal (sudo once)"
        elif need packages "install$missing ($PM, sudo)"; then
            # shellcheck disable=SC2086
            if pkg_install $missing; then ok packages "installed"
            elif [ "$PM" = xbps ]; then row todo packages "xbps failed: update Void first (sudo xbps-install -Su), then spark-shell on"; acting=0
            else row todo packages "$PM failed (see above) -- run spark-shell on again"; acting=0; fi
        fi
    fi
    # the desktop's packages ride the row above when DESKTOP=sway; say
    # why they are not there otherwise
    if [ "$OS" = Darwin ]; then
        [ "$DESKTOP" != sway ] || skip desktop "not on macOS, which has its own desktop"
    elif ! desktop_wanted; then
        skip desktop "DESKTOP=none (the config)"
    fi
    # the prompt: starship from the package manager where one has it
    # (pacman, Homebrew); where none does, the rc files draw the shell's
    # own prompt. Nothing is downloaded. A skip, not a todo: Debian's
    # dry-run still ends in Nothing to do.
    loud && printf '\n== prompt\n'
    if [ "$PROMPT" != starship ]; then skip prompt "PROMPT=$PROMPT (the config): the shell's own"
    elif command -v starship >/dev/null 2>&1 || [ -x "$HOME/.local/bin/starship" ]; then
        v=$(PATH=$HOME/.local/bin:$PATH starship --version 2>/dev/null | head -1)
        ok prompt "${v:-starship} draws the prompt"
    elif [ "$PM" = pacman ] || [ "$PM" = xbps ] || [ "$PM" = brew ]; then skip prompt "starship comes with the packages above"
    else skip prompt "no starship package here: the shell's own prompt (the rc files draw it)"
    fi
    # terminfo: tmux-256color must know modified arrow keys
    if infocmp -1x tmux-256color 2>/dev/null | grep -q 'kUP='; then
        ok terminfo "tmux-256color knows modified arrow keys"
    elif [ "$OS" = Darwin ]; then
        nc=$(brew --prefix ncurses 2>/dev/null || true)
        if [ ! -x "$nc/bin/infocmp" ]; then skip terminfo "Homebrew ncurses not installed yet"
        elif need terminfo "compile tmux-256color from Homebrew ncurses into ~/.terminfo"; then
            "$nc/bin/infocmp" -x tmux-256color > "$TMP/tmux.ti"
            tic -x -o "$HOME/.terminfo" "$TMP/tmux.ti"
            ok terminfo "compiled into ~/.terminfo"
        fi
    else
        skip terminfo "tmux-256color lacks kUP here -- a newer ncurses-term has it"
    fi
    loud && printf '\n== files\n'
    tree=$(rc_tree)
    for f in $(rc_files); do
        link_one "$tree/$f" "$HOME/$f"
    done
    theme_files   # the palette first: every render reads theme.env
    render_all
    old_greetd_off   # the login screen before v0.42, handed back to getty
    # spark-shell on PATH, so the prompt and tmux can call it
    link_one "$REPO/spark-shell" "$HOME/.local/bin/spark-shell"
    tmux_reload
    loud && printf '\n== console\n'
    if [ "$THEME" = none ]; then palette_off all; fi
    console_apply
    if [ "$MODE" = dry ]; then
        dry_close
    else
        theme_seen
        console_now
        if [ "$changes" -eq 0 ] && [ "$todo" -eq 0 ]; then echo "Nothing to do"; else echo "open a new shell (exec \$SHELL)"; fi
    fi
}

cmd_off() {   # cmd_off [desktop]
    noun_ok off "$@"
    [ "${1:-}" != desktop ] || [ "$OS" != Darwin ] || refuse "not on macOS, which has its own desktop"
    config_load
    if [ "$MODE" = dry ]; then off_would "${1:-}"; return 0; fi
    if [ "${1:-}" = desktop ]; then
        config_set DESKTOP none
        DESKTOP=none; export DESKTOP
        hand_back $DESKTOP_RENDERED .config/alsa/asoundrc
        old_greetd_off
        seat_off
        echo "packages stay installed -- the package manager removes them if you want"
        return 0
    fi
    for f in $(rc_files); do
        p=$HOME/$f
        # only spark-shell's own symlink is handed back; a hook line or
        # your own file is not ours to touch
        if [ -L "$p" ]; then
            case $(readlink "$p") in "$REPO"/*) restore_one "$p" ;; esac
        fi
    done
    hand_back $RENDERED .config/starship.toml .config/yazi/theme.toml $DESKTOP_RENDERED .config/alsa/asoundrc   # alsa: the bar's default card; yazi: a render v0.35 left, its .bak yours
    old_greetd_off
    seat_off
    pm_detect
    console_off   # the palette, the font, the login screen and the boot, as they were
    # spark's own hook must survive the hand-back: a restored or absent
    # rc file gets the one marked line back when spark is installed here
    hook_line=''
    case $OS in
        Darwin) [ -r "$SPARK_CONFIG_DIR/hook.zsh" ] && hook_line='[[ -r ~/.config/spark/hook.zsh ]] && source ~/.config/spark/hook.zsh   # spark: the AI at the prompt' ;;
        *) [ -r "$SPARK_CONFIG_DIR/hook.bash" ] && hook_line='[ -r ~/.config/spark/hook.bash ] && . ~/.config/spark/hook.bash   # spark: the AI at the prompt' ;;
    esac
    if [ -n "$hook_line" ]; then
        case $OS in Darwin) rcf=$HOME/.zshrc ;; *) rcf=$HOME/.bashrc ;; esac
        if ! grep -q 'config/spark/hook\.' "$rcf" 2>/dev/null; then
            printf '%s\n' "$hook_line" >> "$rcf"
            row ok rc "$rcf -- spark's hook line kept"
        fi
    fi
    tmux_reload
    console_now
    echo "packages stay installed -- the package manager removes them if you want"
    echo "open a new shell (exec \$SHELL)"
}

# The dry run of off: what it would hand back, as the would rows on's dry
# run uses; nothing is touched. The same gates as the real run: an rc
# link of ours, a render with the marker or a .bak, the old login screen
# when its config.toml is ours, seatd by spark-shell's records.
off_would() {   # off_would [desktop]
    if [ "${1:-}" = desktop ]; then
        [ "$DESKTOP" = none ] || row would config "DESKTOP=none ($CONFIG)"
        list=$DESKTOP_RENDERED
    else
        for f in $(rc_files); do
            p=$HOME/$f
            [ -L "$p" ] || continue
            case $(readlink "$p") in "$REPO"/*) row would rc "$p" ;; esac
        done
        # the one write off may do: spark's hook line back into the rc
        # file it leaves there (the .bak, or nothing, where ours is linked)
        case $OS in Darwin) hook=hook.zsh; rcf=$HOME/.zshrc ;; *) hook=hook.bash; rcf=$HOME/.bashrc ;; esac
        if [ -r "$SPARK_CONFIG_DIR/$hook" ]; then
            after=$rcf; if [ -L "$rcf" ]; then case $(readlink "$rcf") in "$REPO"/*) after=$rcf.bak ;; esac; fi
            grep -q 'config/spark/hook\.' "$after" 2>/dev/null || row would rc "$rcf -- spark's hook line kept"
        fi
        list="$RENDERED .config/starship.toml .config/yazi/theme.toml $DESKTOP_RENDERED"
    fi
    for rel in $list; do
        p=$HOME/$rel
        [ -f "$p" ] && [ ! -L "$p" ] || continue
        grep -q 'rendered by spark-shell' "$p" 2>/dev/null || [ -e "$p.bak" ] || continue
        if [ -e "$p.bak" ]; then row would restore "$p -- back from ${p##*/}.bak"
        else row would restore "$p -- removed (no ${p##*/}.bak: there was no file before)"; fi
    done
    old_greetd_off
    seat_off
    if [ "${1:-}" != desktop ]; then pm_detect; console_off; fi
    dry_close
}

# The look follows the palette: the login profile runs `spark-shell
# follow`, which re-renders the user's files (never root's) when
# theme.env changed since
# the last render -- one cksum, nothing else, when it did not. So `spark
# theme NAME` alone reaches the next login; on is for now.
SEEN=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/theme.seen
theme_sum() { if [ -f "$THEME_ENV" ]; then cksum < "$THEME_ENV" | cut -d' ' -f1; else echo none; fi; }
theme_seen() { mkdir -p "$(dirname "$SEEN")"; theme_sum > "$SEEN"; }
cmd_follow() {
    config_load
    [ "$(theme_sum)" != "$(cat "$SEEN" 2>/dev/null)" ] || return 0
    theme_load
    EXPR=$(render_expr)
    for rel in $RENDERED; do render_one "$REPO/templates/$rel" "$HOME/$rel" >/dev/null; done
    [ "$PROMPT" = starship ] && render_one "$REPO/templates/.config/starship.toml.$PROMPT_STYLE" "$HOME/.config/starship.toml" >/dev/null
    if desktop_wanted; then
        for rel in $DESKTOP_RENDERED; do render_one "$REPO/templates/$rel" "$HOME/$rel" >/dev/null; done
        sway_reload >/dev/null
    fi
    n=$changes
    tmux_reload >/dev/null 2>&1 || true
    theme_seen
    [ "$n" -eq 0 ] || echo "spark-shell: $n files updated for the new palette."
}

# The first hour: the desktop's keys are the `# key: ` sentences in the
# sway template, one source (the README carries them verbatim and the
# suite holds it to them). The first window of the desktop shows them
# once, as a card (DESK_SEEN), and `desktop keys` any time. `status`
# ends with one `next` row when something is off, nothing when not.
DESK_SEEN=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/desktop.seen
desk_keys() { sed -n 's/^# key: //p' "$REPO/templates/.config/sway/config"; }
desk_keys_card() {
    echo "These are the desktop's keys. spark-shell desktop keys shows them again any time."
    desk_keys | sed 's/^/  /'
    echo
}
status_next() {   # the first sentence that applies, as a next row; nothing off, no row
    if [ -z "$(spark_bin)" ]; then n=spark; s="Install spark, the local AI: github.com/forgewright-ai/spark."
    elif [ "$OS" = Darwin ]; then return 0
    elif [ "$DESKTOP" = none ]; then [ -d /dev/dri ] || return 0; n=desktop; s="spark-shell on desktop adds the desktop."
    elif [ -n "$(desktop_tools)" ]; then n=desktop; s="spark-shell on installs sway and foot."
    elif [ ! -f "$HOME/.config/sway/config" ] || [ ! -f "$HOME/.config/foot/foot.ini" ]; then n=desktop; s="spark-shell on writes the sway and foot settings."
    elif seat_needed && ! seat_ready; then n=desktop; s="spark-shell on desktop at a terminal sets up seatd (sudo once)."
    elif seat_needed && ! id -Gn | tr ' ' '\n' | grep -qx _seatd; then n=desktop; s="Log out and in again: the _seatd group takes effect at the next login."
    else return 0; fi
    printf '  next  %-16s %s\n' "$n" "$s"
}

cmd_status() {
    config_load
    tree=$(rc_tree)
    printf 'spark-shell status\n'
    for f in $(rc_files); do
        p=$HOME/$f
        if [ -L "$p" ] && [ "$(readlink "$p")" = "$tree/$f" ]; then s="spark-shell's"
        elif [ -L "$p" ]; then s="a symlink elsewhere"
        elif [ -f "$p" ]; then grep -q 'config/spark/hook\.' "$p" 2>/dev/null && s="yours, with spark's hook" || s="yours"
        else s="absent"; fi
        # shellcheck disable=SC2088   # the tilde is display, not a path
        printf '  rc    %-16s %s\n' "~/$f" "$s"
    done
    pm_detect
    for t in tmux starship fzf zoxide eza bat btop fd; do
        tool_here "$t" && s=yes || s=no
        printf '  tool  %-16s %s\n' "$t" "$s"
    done
    if [ "$OS" = Darwin ]; then s="not on macOS, which has its own desktop"
    elif [ "$DESKTOP" = none ]; then s="none (spark-shell on desktop)"
    elif [ -n "$(desktop_tools)" ]; then s="sway: not installed --$(desktop_tools) (spark-shell on desktop)"
    elif [ ! -f "$HOME/.config/sway/config" ] || [ ! -f "$HOME/.config/foot/foot.ini" ]; then s="sway: settings not written (spark-shell on)"
    else s="sway: ready, foot uses $(fc-match -f '%{family}' "$FONT" 2>/dev/null || printf '%s' "${FONT%%:*}") (log in on tty1 to start it)"; fi
    printf '  desktop %-14s %s\n' "$DESKTOP" "$s"
    n=$(ls -A "$LAYOUTS_DIR" 2>/dev/null | wc -l | tr -d ' ')   # a saved layout opens as tmux windows anywhere
    if [ "$n" -gt 0 ]; then printf '  layouts %-14s %s\n' "$n saved" "$(ls -A "$LAYOUTS_DIR" | paste -sd ',' - | sed 's/,/, /g') (spark-shell layout NAME)"
    else printf '  layouts %-14s %s\n' none 'spark-shell layout "WORDS" makes one'; fi
    if [ "$OS" != Darwin ] && [ "$DESKTOP" = sway ]; then
        if apps_marked; then printf '  apps  %-16s %s\n' "$(grep -c '^[A-Za-z0-9]' "$APPS") allowed" "$(grep '^[A-Za-z0-9]' "$APPS" | sed 's/[: ].*//' | paste -sd',' - | sed 's/,/, /g') (spark-shell apps)"
        else printf '  apps  %-16s %s\n' all "every app with a desktop entry (spark-shell apps picks the allowed apps)"; fi
        if [ "$WALLPAPER" = none ]; then printf '  wall  %-16s %s\n' none "the palette's background (spark-shell desktop wallpaper PATH|default)"
        elif wall_colour; then printf '  wall  %-16s %s\n' colour "$WALLPAPER, a plain colour that stays when the palette changes"
        elif [ "$WALLPAPER" = default ] && wall_there; then printf '  wall  %-16s %s\n' default "the wallpaper that comes with spark-shell, $WALL_DEFAULT"
        elif wall_there; then printf '  wall  %-16s %s\n' picture "$WALLPAPER"
        else printf '  wall  %-16s %s\n' missing "$(wall_path) is missing -- the palette's background colour instead"; fi
        if [ "$DESKTOP_BAR" = yes ]; then printf '  bar   %-16s %s\n' shown "at the top of the screen: $(bar_names) (spark-shell bar off --desktop hides it)"
        else printf '  bar   %-16s %s\n' hidden "spark-shell bar on --desktop shows it"; fi
    fi
    theme_load || true
    slots="accent colour${ACCENT_SLOT:-?}, muted colour${MUTED_SLOT:-?} (SGR 1;${ACCENT_SGR:-?} / ${MUTED_SGR:-?})"
    [ -f "$THEME_ENV" ] && printf '  theme %-16s %s\n' "${THEME:-theme.env}" "in use: $slots (spark-shell theme NAME changes it)" \
                        || printf '  theme %-16s %s\n' "${THEME:-theme.env}" "none: the terminal's own 16 colours -- $slots"
    status_console
    status_next
}

cmd_check() {
    config_load
    fails=0
    chk() { # chk NAME ok|warn|fail DETAIL [REMEDY] -- a warn names its remedy and does not fail
        case $2 in
            ok) printf 'ok     %-12s %s\n' "$1" "$3" ;;
            warn) printf 'warn   %-12s %s -- %s\n' "$1" "$3" "${4:-}" ;;
            *) printf 'FAIL   %-12s %s -- %s\n' "$1" "$3" "${4:-}"; fails=$((fails + 1)) ;;
        esac
    }
    tree=$(rc_tree)
    rc_ok=1
    for f in $(rc_files); do
        [ -L "$HOME/$f" ] && [ "$(readlink "$HOME/$f")" = "$tree/$f" ] || rc_ok=0
    done
    [ "$rc_ok" = 1 ] && chk rc ok "the rc files are spark-shell's" || chk rc fail "an rc file is not spark-shell's" "spark-shell on"
    miss=''
    # starship is required only where a package manager has it (pacman,
    # Homebrew) and the config asks for it. ~/.local/bin may hold a tool
    # (and spark): a non-login ssh shell has no such PATH, so look there too
    pm_detect
    tools="tmux fzf zoxide eza bat btop fd"
    if [ "$PROMPT" = starship ] && { [ "$PM" = pacman ] || [ "$PM" = xbps ] || [ "$PM" = brew ]; }; then tools="$tools starship"; fi
    for t in $tools; do
        tool_here "$t" || miss="$miss $t"
    done
    [ -z "$miss" ] && chk tools ok "$(printf '%s' "$tools" | sed 's/ /, /g')" || chk tools fail "missing:$miss" "spark-shell on"
    infocmp -1x tmux-256color 2>/dev/null | grep -q 'kUP=' && chk terminfo ok "tmux-256color knows modified arrows" \
        || chk terminfo fail "tmux-256color lacks kUP" "spark-shell on"
    # render freshness: what on would write vs what is on disk
    theme_load
    EXPR=$(render_expr)
    stale=''
    for rel in $RENDERED; do
        [ -f "$HOME/$rel" ] || { stale="$stale $rel"; continue; }
        sed -e "$EXPR" "$REPO/templates/$rel" > "$TMP/chk"
        cmp -s "$TMP/chk" "$HOME/$rel" || stale="$stale $rel"
    done
    [ -z "$stale" ] && chk look ok "the settings files match the palette" || chk look fail "out of date:$stale" "spark-shell on"
    check_theme
    check_font
    check_quiet
    if [ "$OS" = Darwin ]; then chk desktop ok "na (macOS)"
    elif [ "$DESKTOP" = none ]; then chk desktop ok "na (DESKTOP=none)"
    elif [ -n "$(desktop_tools)" ]; then chk desktop fail "missing:$(desktop_tools)" "spark-shell on"
    else
        stale=''
        for rel in $DESKTOP_RENDERED; do
            [ -f "$HOME/$rel" ] || { stale="$stale $rel"; continue; }
            sed -e "$EXPR" "$REPO/templates/$rel" > "$TMP/chk"
            cmp -s "$TMP/chk" "$HOME/$rel" || stale="$stale $rel"
        done
        if [ -n "$stale" ]; then chk desktop fail "out of date:$stale" "spark-shell on"
        elif ! command -v jq >/dev/null 2>&1; then chk desktop fail "jq is missing (a layout reads the model's answer with it)" "spark-shell on"
        elif seat_needed && ! seatd_on; then chk desktop fail "seatd does not start at boot (Void has no logind)" "spark-shell on desktop"
        elif seat_needed && ! in_group _seatd "$(id -un)"; then chk desktop fail "$(id -un) is not in the _seatd group" "spark-shell on desktop"
        else chk desktop ok "sway and foot are installed and up to date"; fi
    fi
    if [ "$OS" = Darwin ] || [ "$DESKTOP" = none ]; then chk apps ok "na (no desktop)"
    else
        sbom_entries; ne=$(wc -l < "$TMP/entries" | tr -d ' ')
        if apps_marked; then
            gone=''
            for n in $(grep '^[A-Za-z0-9]' "$APPS" | sed 's/[: ].*//'); do desk_on_path "$n" || grep -q "^$n	" "$TMP/entries" || gone="$gone $n"; done
            [ -z "$gone" ] && chk apps ok "$(grep -c '^[A-Za-z0-9]' "$APPS") allowed apps, $ne apps installed" || chk apps fail "allowed but not here:$gone" "spark-shell apps"
        else chk apps ok "$ne apps installed, all allowed (spark-shell apps chooses)"; fi
    fi
    spark=$(spark_bin)
    if [ -z "$spark" ]; then chk bar ok "na (spark not found -- the status line stays empty)"
    elif "$spark" bar line >/dev/null 2>&1; then chk bar ok "spark bar line works"
    else chk bar fail "spark bar line failed" "spark check"; fi
    if [ "$OS" = Darwin ] || [ "$DESKTOP" = none ]; then chk top ok "na (no desktop)"
    elif [ "$DESKTOP_BAR" != yes ]; then chk top ok "hidden (spark-shell bar on --desktop shows it)"
    elif ! command -v jq >/dev/null 2>&1; then chk top warn "jq is not installed: the bar takes no clicks" "spark-shell on"
    elif line=$(bar_status --once 2>/dev/null) && printf '%s' "$line" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1; then
        chk top ok "the bar draws $(printf '%s' "$line" | jq -r '[.[] | select(.name != "div") | .name] | unique | join(", ")')"
        [ -n "$(snd_tool)" ] || chk sound warn "no audio system found, so no out or mic block" "install pipewire, or alsa-utils for plain ALSA"
    else chk top fail "spark-shell bar status draws nothing" "spark-shell on"; fi
    [ "$fails" = 0 ]
}

# ---------------------------------------------------------------- the bar
# The bar at the top of the desktop's screen: swaybar draws what
# `spark-shell bar status` prints, the i3bar JSON lines, one every 15 s
# and one at once after a click or a volume key (SIGUSR1 to the pid in
# STATE_DIR/bar.pid). It shows the screen and the hardware you sit at;
# the AI and the machine's load stay on tmux's status line inside each
# window. Its rules: a block appears only for hardware this machine has
# (no battery, no bat block); words show state and colour shows alarm
# (the kind word muted, a name in the text colour, red for a recording
# mic, a wire that is down and a battery under 15); the gauges, the
# output volume and the mic level, are the things you can set (a click
# sets, the wheel nudges, a right click mutes), so a read-only level
# takes another shape (wifi as rising bars, the battery as a number); a
# click on any other block opens its panel under the bar (below), and
# the bar itself never changes width; the groups (connections, sound,
# power, time, the look) are parted by a thin line, and a group that is
# absent takes its line with it. Sound comes from
# the audio system there is: wpctl (PipeWire), pactl (PulseAudio), else
# amixer on plain ALSA, where a change of output holds for programs
# started afterwards (ALSA has no live routing) and is written to
# spark-shell's own ~/.config/alsa/asoundrc, never your ~/.asoundrc.
# The glyphs are built from their bytes: this file stays ASCII.
BAR_SYS=${SPARK_SHELL_SYS:-/sys}      # tests: a fixture tree in place of /sys and /proc
BAR_PROC=${SPARK_SHELL_PROC:-/proc}
BAR_PID=$STATE_DIR/bar.pid            # the running `bar status`, for the redraw signal
BAR_ASOUNDRC=$HOME/.config/alsa/asoundrc   # ALSA reads it after ~/.asoundrc; ours only with the marker line
BAR_GAP=14                            # px between blocks of a group
BAR_FULL=$(printf '\342\226\210')     # U+2588 full block: the gauge's level
BAR_SHADE=$(printf '\342\226\221')    # U+2591 light shade: the gauge's rest
BAR_DIV=$(printf '\342\224\202')      # U+2502 light vertical line: between groups
BAR_STEPS='\342\226\202 \342\226\204 \342\226\206 \342\226\210'   # U+2582 2584 2586 2588: the wifi bars

bar_esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/\\/\\\\/g; s/"/\\"/g'; }   # a name: pango, then JSON
bar_span() { printf "<span foreground='#%s'>%s</span>" "$1" "$2"; }   # bar_span RRGGBB MARKUP
bar_block() {   # bar_block NAME INSTANCE MARKUP [GAP] -> one block; swaybar's own separator off (the dividers are blocks)
    printf '{"name":"%s","instance":"%s","full_text":"%s","markup":"pango","separator":false,"separator_block_width":%s}' "$1" "$2" "$3" "${4:-$BAR_GAP}"
}
bar_short() {   # bar_short NAME -> lowercase, whole words up to 12 characters
    printf '%s' "$1" | tr 'A-Z' 'a-z' | awk '{ s = ""; for (i = 1; i <= NF; i++) { t = (s == "" ? $i : s " " $i); if (length(t) > 12 && s != "") break; s = t } print s }' | cut -c1-12
}
bar_gauge() {   # bar_gauge LEVEL MUTED -> 10 cells, the level in the accent (muted when MUTED=1), the rest muted
    n=$(( ($1 + 5) / 10 )); [ "$1" -le 0 ] || [ "$n" -gt 0 ] || n=1; [ "$n" -le 10 ] || n=10
    full=''; i=0; while [ "$i" -lt "$n" ]; do full="$full$BAR_FULL"; i=$((i + 1)); done
    rest=''; while [ "$i" -lt 10 ]; do rest="$rest$BAR_SHADE"; i=$((i + 1)); done
    c=$HEX_ACCENT; [ "$2" != 1 ] || c=$HEX_MUTED
    printf '%s%s' "$(bar_span "$c" "$full")" "$(bar_span "$HEX_MUTED" "$rest")"
}
bar_bars() {   # bar_bars LEVEL (0-4) -> the four rising bars, LEVEL of them lit
    i=1; out=''
    for s in $BAR_STEPS; do
        g=$(printf "$s"); c=$HEX_MUTED; [ "$i" -gt "$1" ] || c=$HEX_ACCENT
        out="$out$(bar_span "$c" "$g")"; i=$((i + 1))
    done
    printf '%s' "$out"
}
bar_timeout() { if command -v timeout >/dev/null 2>&1; then timeout 3 "$@"; else "$@"; fi; }

# --- what the hardware says
bar_addr() { ip -4 -o addr show dev "$1" scope global 2>/dev/null | awk '{print $4; exit}' | cut -d/ -f1; }   # bar_addr IFACE -> a.b.c.d or nothing
bar_wired() {   # -> the wired interfaces: a real device (not lo, not a bridge), ethernet, not wireless
    for d in "$BAR_SYS"/class/net/*; do
        [ -e "$d/device" ] && [ ! -d "$d/wireless" ] && [ "$(cat "$d/type" 2>/dev/null)" = 1 ] || continue
        basename "$d"
    done
    return 0
}
bar_wireless() { for d in "$BAR_SYS"/class/net/*/wireless; do [ -d "$d" ] && basename "$(dirname "$d")"; done; return 0; }
bar_lan() {   # -> "up ADDR", "down", or nothing (no wired interface)
    any=''; up=''
    for i in $(bar_wired); do
        any=1
        [ "$(cat "$BAR_SYS/class/net/$i/carrier" 2>/dev/null)" = 1 ] || continue
        up="up $(bar_addr "$i")"; break
    done
    [ -n "$any" ] || return 0
    if [ -n "$up" ]; then printf '%s\n' "$up"; else echo down; fi
}
bar_wifi() {   # -> "LEVEL ADDR" (0-4) for the first wireless interface that is up, else nothing
    for i in $(bar_wireless); do
        [ "$(cat "$BAR_SYS/class/net/$i/operstate" 2>/dev/null)" = up ] || continue
        lvl=''
        if command -v iw >/dev/null 2>&1; then   # -100 dBm is 0, -50 dBm is 100
            dbm=$(iw dev "$i" link 2>/dev/null | awk '/signal:/ {print $2; exit}')
            [ -z "$dbm" ] || lvl=$(( (dbm + 100) * 2 ))
        fi
        if [ -z "$lvl" ]; then   # the kernel's link quality, out of 70
            q=$(awk -v i="$i:" '$1 == i {gsub(/\./, "", $3); print $3; exit}' "$BAR_PROC/net/wireless" 2>/dev/null)
            [ -z "$q" ] || lvl=$(( q * 100 / 70 ))
        fi
        [ -n "$lvl" ] || lvl=0; [ "$lvl" -ge 0 ] || lvl=0; [ "$lvl" -le 100 ] || lvl=100
        printf '%s %s\n' "$(( (lvl + 12) / 25 ))" "$(bar_addr "$i")"
        return
    done
    return 0
}
bar_bt() {   # -> "name NAME", "on", "off", or nothing (no controller)
    ls -d "$BAR_SYS"/class/bluetooth/hci* >/dev/null 2>&1 || return 0
    command -v bluetoothctl >/dev/null 2>&1 || { echo on; return; }
    bar_timeout bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' || { echo off; return; }
    dev=$(bar_timeout bluetoothctl devices Connected 2>/dev/null | awk '$1 == "Device" { $1 = ""; $2 = ""; sub(/^ +/, ""); print; exit }')
    if [ -n "$dev" ]; then printf 'name %s\n' "$dev"; else echo on; fi
}
bar_power() {   # -> "CAPACITY STATUS" of the first battery, or nothing
    for b in "$BAR_SYS"/class/power_supply/*; do
        [ -f "$b/capacity" ] || continue
        [ ! -f "$b/type" ] || [ "$(cat "$b/type")" = Battery ] || continue
        printf '%s %s\n' "$(cat "$b/capacity")" "$(cat "$b/status" 2>/dev/null || echo Unknown)"; return
    done
    return 0
}

# --- sound: the audio system that answers, asked once per line
snd_tool() {   # -> wpctl | pactl | alsa | nothing
    if command -v wpctl >/dev/null 2>&1 && wpctl status >/dev/null 2>&1; then echo wpctl
    elif command -v pactl >/dev/null 2>&1 && pactl info >/dev/null 2>&1; then echo pactl
    elif command -v amixer >/dev/null 2>&1 && grep -q '^ *[0-9]' "$BAR_PROC/asound/cards" 2>/dev/null; then echo alsa
    fi
}
# wpctl status: a section's rows are "N. Description [vol: ...]", the default starred
wp_rows() { wpctl status 2>/dev/null | awk -v sec="$1:" 'index($0, sec) {on = 1; next} on && !/[0-9]+\. / {exit} on { star = index($0, "*") ? 1 : 0; id = $0; sub(/^[^0-9]*/, "", id); sub(/\..*$/, "", id); d = $0; sub(/^.*[0-9]+\. /, "", d); sub(/[ \t]+\[vol:.*$/, "", d); sub(/[ \t]+$/, "", d); print star "\t" id "\t" d }'; }   # wp_rows Sinks|Sources -> STAR<tab>ID<tab>DESCRIPTION
wp_default() { wp_rows "$1" | awk -F '\t' '$1 == 1 {print $3; exit}'; }
wp_level() { wpctl get-volume "$1" 2>/dev/null | awk '{printf "%d", $2 * 100 + 0.5}'; }   # wp_level @DEFAULT_AUDIO_SINK@|SOURCE@
wp_muted() { wpctl get-volume "$1" 2>/dev/null | grep -q MUTED && echo 1 || echo 0; }
wp_live() { command -v pw-dump >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && pw-dump 2>/dev/null | jq -e 'any(.[]; .info.props["media.class"]? == "Stream/Input/Audio" and .info.state? == "running")' >/dev/null 2>&1 && echo 1 || echo 0; }
# pactl: names and descriptions in the long list, the default by name
pa_desc() { pactl list "$1" 2>/dev/null | awk -v n="$2" '/^\tName: / {cur = $2} /^\tDescription: / && cur == n {sub(/^\tDescription: /, ""); print; exit}'; }   # pa_desc sinks|sources NAME
pa_level() { pactl "get-$1-volume" "$2" 2>/dev/null | grep -o '[0-9]*%' | head -1 | tr -d %; }   # pa_level sink|source @DEFAULT_SINK@|@DEFAULT_SOURCE@
pa_muted() { pactl "get-$1-mute" "$2" 2>/dev/null | grep -q 'yes' && echo 1 || echo 0; }
pa_live() { [ -n "$(pactl list short source-outputs 2>/dev/null)" ] && echo 1 || echo 0; }
# plain ALSA: the cards in /proc/asound, their mixers through amixer
al_cards() { awk '/^ *[0-9]+ \[/ { n = $1; id = $0; sub(/^[^[]*\[/, "", id); sub(/ *\].*$/, "", id); long = $0; sub(/^[^:]*: [^ ]* - /, "", long); print n "\t" id "\t" long }' "$BAR_PROC/asound/cards" 2>/dev/null; }   # -> N<tab>ID<tab>LONG NAME (past "DRIVER - ": a driver's own hyphen, as USB-Audio, is not the dash)
al_name() { al_cards | awk -F '\t' -v n="$1" '$1 == n { if ($2 ~ /^(Device|USB|Generic|PCH|Intel|SB|NVidia|Audio)$/) print $3; else print $2; exit }'; }   # al_name N -> its name for the bar
al_with() { for c in $(al_cards | cut -f1); do ls -d "$BAR_PROC/asound/card$c/pcm"*"$1" >/dev/null 2>&1 && echo "$c"; done 2>/dev/null; return 0; }   # al_with p|c -> the cards that play | capture
al_first() { al_with "$1" | sed -n 1p; }   # al_first p|c -> the first card that plays | captures (sed reads the whole pipe: no broken pipe)
al_running() { for c in $(al_with "$1"); do grep -qs 'state: RUNNING' "$BAR_PROC/asound/card$c/pcm"*"$1"/sub*/status && { echo "$c"; return 0; }; done; return 0; }   # al_running p|c -> the card in use now
al_default() {   # -> the card ALSA's default resolves to: the ctl device's card, else spark-shell's file, else the first that plays
    d=$(amixer -D default info 2>/dev/null | sed -n "s/^Card default '\([^']*\)'.*/\1/p" | head -1)
    [ -z "$d" ] || { al_cards | awk -F '\t' -v id="$d" '$2 == id {print $1; exit}'; return; }
    [ ! -f "$BAR_ASOUNDRC" ] || { d=$(sed -n 's/^defaults\.pcm\.!*card //p' "$BAR_ASOUNDRC" | head -1); [ -z "$d" ] || { al_cards | awk -F '\t' -v id="$d" '$2 == id || $1 == id {print $1; exit}'; return; }; }
    al_first p
}
al_out() { c=$(al_running p); [ -n "$c" ] || c=$(al_default); [ -n "$c" ] && al_with p | grep -qx "$c" || c=$(al_first p); printf '%s' "$c"; }   # -> the card the out block is about
al_mic() { c=$(al_running c); [ -n "$c" ] || { c=$(al_default); al_with c | grep -qx "${c:-x}" || c=$(al_first c); }; printf '%s' "$c"; }
al_control() {   # al_control N p|c -> the mixer control to read and set: Master, PCM, Speaker, Headphone (Capture, Mic), else none
    want='Master PCM Speaker Headphone'; [ "$2" = p ] || want='Capture Mic'
    have=$(amixer -c "$1" scontrols 2>/dev/null | sed -n "s/^Simple mixer control '\([^']*\)',0$/\1/p")
    for w in $want; do printf '%s\n' "$have" | grep -qx "$w" && { echo "$w"; return; }; done
    return 1
}
al_level() { amixer -c "$1" sget "$2" 2>/dev/null | grep -o '\[[0-9]*%\]' | head -1 | tr -d '[]%'; }   # al_level N CONTROL -> 0..100 or nothing
al_muted() { amixer -c "$1" sget "$2" 2>/dev/null | grep -o '\[\(on\|off\)\]' | head -1 | grep -q off && echo 1 || echo 0; }
al_set_default() {   # al_set_default N -- the card for programs started from now, in spark-shell's own file; refused when the file is yours, taken back when ALSA refuses it
    id=$(al_cards | awk -F '\t' -v n="$1" '$1 == n {print $2; exit}')
    if [ -f "$BAR_ASOUNDRC" ] && ! grep -q 'rendered by spark-shell' "$BAR_ASOUNDRC"; then echo "asoundrc is yours"; return 1; fi
    mkdir -p "$(dirname "$BAR_ASOUNDRC")"
    # !card: alsa.conf sets the card as a number, and only the ! form lets a name replace it (the plain form is refused, and ALSA drops its whole configuration with it)
    printf '# rendered by spark-shell (bar): the sound card for programs started from now -- spark-shell off removes it\ndefaults.pcm.!card %s\ndefaults.ctl.!card %s\n' "$id" "$id" > "$BAR_ASOUNDRC"
    amixer -c "$1" scontrols >/dev/null 2>&1 || { rm -f "$BAR_ASOUNDRC"; echo "ALSA refused the file"; return 1; }   # ALSA reads every file at each start: a refused one would take every program's sound
}
al_mend_file() {   # a file v0.45 wrote said `defaults.pcm.card NAME`, which ALSA refuses: the ! form from now
    [ -f "$BAR_ASOUNDRC" ] && grep -q 'rendered by spark-shell' "$BAR_ASOUNDRC" && grep -q '^defaults\.pcm\.card ' "$BAR_ASOUNDRC" || return 0
    t=$(sed -e 's/^defaults\.pcm\.card /defaults.pcm.!card /' -e 's/^defaults\.ctl\.card /defaults.ctl.!card /' "$BAR_ASOUNDRC") && printf '%s\n' "$t" > "$BAR_ASOUNDRC"
}
snd_out() {   # -> NAME, LEVEL (or -), MUTED on three lines; nothing without an output
    case $SND in
        wpctl) n=$(wp_default Sinks); [ -n "$n" ] || return 0; printf '%s\n%s\n%s\n' "$n" "$(wp_level @DEFAULT_AUDIO_SINK@)" "$(wp_muted @DEFAULT_AUDIO_SINK@)" ;;
        pactl) s=$(pactl get-default-sink 2>/dev/null); [ -n "$s" ] || return 0; n=$(pa_desc sinks "$s"); printf '%s\n%s\n%s\n' "${n:-$s}" "$(pa_level sink @DEFAULT_SINK@)" "$(pa_muted sink @DEFAULT_SINK@)" ;;
        alsa) c=$(al_out); [ -n "$c" ] || return 0
            if ctl=$(al_control "$c" p); then printf '%s\n%s\n%s\n' "$(al_name "$c")" "$(al_level "$c" "$ctl")" "$(al_muted "$c" "$ctl")"; else printf '%s\n-\n0\n' "$(al_name "$c")"; fi ;;
    esac
}
snd_mic() {   # -> NAME, LIVE, MUTED, LEVEL (or -) on four lines; nothing without a microphone
    case $SND in
        wpctl) n=$(wp_default Sources); [ -n "$n" ] || return 0; printf '%s\n%s\n%s\n%s\n' "$n" "$(wp_live)" "$(wp_muted @DEFAULT_AUDIO_SOURCE@)" "$(wp_level @DEFAULT_AUDIO_SOURCE@)" ;;
        pactl) s=$(pactl get-default-source 2>/dev/null); [ -n "$s" ] || return 0; case $s in *.monitor) return 0 ;; esac
            n=$(pa_desc sources "$s"); printf '%s\n%s\n%s\n%s\n' "${n:-$s}" "$(pa_live)" "$(pa_muted source @DEFAULT_SOURCE@)" "$(pa_level source @DEFAULT_SOURCE@)" ;;
        alsa) c=$(al_mic); [ -n "$c" ] || return 0; live=0; [ -z "$(al_running c)" ] || live=1
            if ctl=$(al_control "$c" c); then printf '%s\n%s\n%s\n%s\n' "$(al_name "$c")" "$live" "$(al_muted "$c" "$ctl")" "$(al_level "$c" "$ctl")"; else printf '%s\n%s\n0\n-\n' "$(al_name "$c")" "$live"; fi ;;
    esac
}
snd_set() {   # snd_set out|mic LEVEL|+5|-5|mute|muted|unmuted -- the change asked by a click, a key or the panel (mute toggles)
    SND=${SND:-$(snd_tool)}
    t=$1; shift
    case $SND in
        wpctl) n=@DEFAULT_AUDIO_SINK@; [ "$t" = out ] || n=@DEFAULT_AUDIO_SOURCE@
            case $1 in
                mute) wpctl set-mute "$n" toggle ;; muted) wpctl set-mute "$n" 1 ;; unmuted) wpctl set-mute "$n" 0 ;;
                +*|-*) wpctl set-volume -l 1.0 "$n" "${1#[+-]}%${1%"${1#?}"}" ;;
                *) wpctl set-volume -l 1.0 "$n" "$1%" ;;
            esac ;;
        pactl) k=sink; n=@DEFAULT_SINK@; [ "$t" = out ] || { k=source; n=@DEFAULT_SOURCE@; }
            case $1 in
                mute) pactl "set-$k-mute" "$n" toggle ;; muted) pactl "set-$k-mute" "$n" 1 ;; unmuted) pactl "set-$k-mute" "$n" 0 ;;
                +*|-*) pactl "set-$k-volume" "$n" "${1#[+-]}%${1%"${1#?}"}" ;;   # 5%+ / 5%-
                *) pactl "set-$k-volume" "$n" "$1%" ;;
            esac ;;
        alsa) if [ "$t" = out ]; then c=$(al_out); k=p; else c=$(al_mic); k=c; fi
            [ -n "$c" ] && ctl=$(al_control "$c" "$k") || return 0
            off=mute; on=unmute; [ "$k" = p ] || { off=nocap; on=cap; }   # a capture control has a capture switch: amixer's words for it are cap and nocap (mute is refused)
            case $1 in
                mute) amixer -q -c "$c" sset "$ctl" toggle ;; muted) amixer -q -c "$c" sset "$ctl" "$off" ;; unmuted) amixer -q -c "$c" sset "$ctl" "$on" ;;
                +*|-*) amixer -q -c "$c" sset "$ctl" "${1#[+-]}%${1%"${1#?}"}" ;;
                *) amixer -q -c "$c" sset "$ctl" "$1%" ;;
            esac ;;
    esac >/dev/null 2>&1 || :
}
snd_said() {   # snd_said out|mic muted|unmuted -> the state read back, one line; exit 1 when the audio system did not take it
    if [ "$1" = out ]; then _m=$(snd_out | sed -n 3p); else _m=$(snd_mic | sed -n 3p); fi
    case $2:$_m in muted:1|unmuted:0) echo "$1 $2" ;; *) echo "$1 is not $2: the audio system did not take it"; return 1 ;; esac
}

# --- the line, the clicks, the loop
bar_line() {   # one JSON array of the blocks present now; groups parted by a divider
    line=''; group=''
    bar_add() { group="${group:+$group,}$1"; }
    bar_group() { [ -z "$group" ] || { [ -z "$line" ] || line="$line,$(bar_block div '' "$(bar_span "$HEX_MUTED" "$BAR_DIV")")"; line="${line:+$line,}$group"; group=''; }; }
    SND=$(snd_tool)
    # connections
    lan=$(bar_lan)
    case $lan in
        up*) bar_add "$(bar_block lan '' "$(bar_span "$HEX_MUTED" lan)")" ;;
        down) bar_add "$(bar_block lan '' "$(bar_span "$HEX_MUTED" lan) $(bar_span "$HEX_ANSI_1" "$PANEL_WARN down")")" ;;
    esac
    wifi=$(bar_wifi)
    [ -z "$wifi" ] || bar_add "$(bar_block wifi '' "$(bar_span "$HEX_MUTED" wifi) $(bar_bars "${wifi%% *}")")"
    bt=$(bar_bt)
    case $bt in
        name*) bar_add "$(bar_block bt '' "$(bar_span "$HEX_MUTED" bt) $(bar_span "$HEX_ACCENT" "$PANEL_DOT") $(bar_esc "$(bar_short "${bt#name }")")")" ;;
        on) bar_add "$(bar_block bt '' "$(bar_span "$HEX_MUTED" bt)")" ;;
        off) bar_add "$(bar_block bt '' "$(bar_span "$HEX_MUTED" 'bt off')")" ;;
    esac
    bar_group
    # sound
    out=$(snd_out)
    if [ -n "$out" ]; then
        n=$(printf '%s\n' "$out" | sed -n 1p); lvl=$(printf '%s\n' "$out" | sed -n 2p); m=$(printf '%s\n' "$out" | sed -n 3p)
        shown=$(bar_esc "$(bar_short "$n")")
        gap=$BAR_GAP; [ "$lvl" = - ] || [ -z "$lvl" ] || gap=6   # the gauge sits close to its name
        bar_add "$(bar_block out name "$(bar_span "$HEX_MUTED" out) $shown" "$gap")"
        [ "$lvl" = - ] || [ -z "$lvl" ] || bar_add "$(bar_block out gauge "$(bar_gauge "$lvl" "$m")")"
    fi
    mic=$(snd_mic)
    if [ -n "$mic" ]; then
        n=$(printf '%s\n' "$mic" | sed -n 1p); live=$(printf '%s\n' "$mic" | sed -n 2p); m=$(printf '%s\n' "$mic" | sed -n 3p); lvl=$(printf '%s\n' "$mic" | sed -n 4p)
        c=$HEX_MUTED; k=mic; [ "$live" != 1 ] || { c=$HEX_ANSI_1; k="mic $PANEL_DOT"; }   # red, with a dot, while a program records
        if [ "$lvl" = - ] || [ -z "$lvl" ]; then   # no level control: the word says muted
            if [ "$m" = 1 ]; then bar_add "$(bar_block mic name "$(bar_span "$HEX_MUTED" 'mic off')")"
            else bar_add "$(bar_block mic name "$(bar_span "$c" "$k") $(bar_esc "$(bar_short "$n")")")"; fi
        else
            bar_add "$(bar_block mic name "$(bar_span "$c" "$k") $(bar_esc "$(bar_short "$n")")" 6)"
            bar_add "$(bar_block mic gauge "$(bar_gauge "$lvl" "$m")")"
        fi
    fi
    bar_group
    # power
    bat=$(bar_power)
    if [ -n "$bat" ]; then
        cap=${bat%% *}; stt=${bat#* }; plus=''; c=$HEX_FG
        [ "$stt" != Charging ] || plus=$(bar_span "$HEX_ACCENT" +)
        [ "$cap" -ge 15 ] || [ "$stt" = Charging ] || { c=$HEX_ANSI_1; cap="$PANEL_WARN $cap"; }
        bar_add "$(bar_block bat '' "$(bar_span "$HEX_MUTED" bat) $(bar_span "$c" "$cap")$plus")"
    fi
    bar_group
    # time
    bar_add "$(bar_block clock '' "$(bar_span "$HEX_MUTED" "$(date '+%a %d %b')") $(date '+%H:%M')")"
    bar_group
    # the look: the palette's name, or the word alone with none
    t=''; [ -z "$THEME" ] || [ "$THEME" = none ] || t=" $(bar_esc "$THEME")"
    bar_add "$(bar_block theme '' "$(bar_span "$HEX_MUTED" theme)$t" 6)"
    bar_group
    printf '[%s],\n' "$line"
}
bar_click() {   # bar_click NAME INSTANCE BUTTON RELX WIDTH X -- one click or wheel step on a block
    case $1:$2:$3 in
        div:*) ;;
        out:gauge:1|mic:gauge:1) [ "$5" -gt 0 ] 2>/dev/null || return 0; l=$(( ($4 * 100 / $5 + 2) / 5 * 5 )); [ "$l" -le 100 ] || l=100; [ "$l" -ge 0 ] || l=0; snd_set "$1" "$l" ;;
        out:*:4|mic:*:4) snd_set "$1" +5 ;;
        out:*:5|mic:*:5) snd_set "$1" -5 ;;
        out:*:2|out:*:3|mic:*:2|mic:*:3) snd_set "$1" mute ;;
        *:*:1) bar_panel_open "$1" ;;   # the panel, that block first
    esac
}
bar_clicks() {   # swaybar's clicks on stdin: `[` then one `,{...}` a line; each acted on, then the bar redrawn
    while IFS= read -r c; do
        c=${c#,}; [ -n "$c" ] && [ "$c" != '[' ] || continue
        # shellcheck disable=SC2046   # the six fields, split on purpose
        set -- $(printf '%s' "$c" | jq -r 'def w: if . == null or . == "" then "-" else . end; [(.name | w), (.instance | w), .button // 0, .relative_x // 0, .width // 0, .x // 0] | @tsv' 2>/dev/null) || continue
        [ $# -ge 6 ] || continue
        bar_click "$1" "$2" "$3" "$4" "$5" "$6"
        kill -USR1 "$$" 2>/dev/null || :
    done
}
bar_status() {   # bar_status [--once] -- the bar's program: the header, then a line every 15 s and at once on a click or SIGUSR1
    [ "$OS" != Darwin ] || refuse_in bar "not on macOS, which has its own desktop"
    theme_load; al_mend_file
    if [ "${1:-}" = --once ]; then bar_line | sed 's/,$//'; return 0; fi
    command -v jq >/dev/null 2>&1 || echo "spark-shell bar status: jq is not installed, so the bar takes no clicks (spark-shell on)" >&2
    mkdir -p "$STATE_DIR"; printf '%s\n' "$$" > "$BAR_PID"
    printf '{"version":1,"click_events":true}\n[\n'
    # the traps first: the reader's first SIGUSR1 may come before it is read here
    reader=''; sleeper=''
    trap 'kill ${reader:-} ${sleeper:-} 2>/dev/null || :; rm -f "$BAR_PID"; exit 0' INT TERM HUP PIPE   # || : -- a failing kill inside a trap would end the shell under set -e
    trap 'redraw=1; kill ${sleeper:-} 2>/dev/null || :' USR1   # redraw: a click while a line is drawn draws again at once
    exec 3<&0; bar_clicks <&3 &   # an explicit stdin: a background job's own would be /dev/null in dash (POSIX)
    reader=$!
    while :; do
        redraw=0
        bar_line || break
        t=0   # 15 one-second sleeps: a signal ends the current one, and a click that fell between two is seen within 1 s
        while [ "$t" -lt 15 ] && [ "$redraw" = 0 ]; do
            sleep 1 & sleeper=$!
            wait "$sleeper" 2>/dev/null || :
            t=$((t + 1))
        done
    done
    kill ${reader:-} 2>/dev/null || :; rm -f "$BAR_PID"
}
bar_redraw() { [ -f "$BAR_PID" ] && read -r p < "$BAR_PID" && kill -USR1 "$p" 2>/dev/null || :; }   # the running bar draws again now
bar_volume_key() {   # bar_volume_key up|down|mute|mic -- the keyboard's volume keys
    case $1 in up) snd_set out +5 ;; down) snd_set out -5 ;; mute) snd_set out mute ;; mic) snd_set mic mute ;;
        *) refuse_in bar "volume takes up, down, mute or mic" ;; esac
    bar_redraw
}
bar_names() { bar_status --once 2>/dev/null | jq -r '[.[] | select(.name != "div") | .name] | unique | join(", ")' 2>/dev/null || :; }   # the blocks present now
bar_tmux() {   # bar_tmux [on|off] WHICH -- tmux's status line, live
    if ! command -v tmux >/dev/null 2>&1; then [ "$2" = both ] || refuse_in bar "no tmux here (spark-shell on installs it)"; return 0; fi
    if ! tmux list-sessions >/dev/null 2>&1; then
        if [ "$2" = both ]; then echo "status line: tmux is not running (it shows inside tmux)"; else refuse_in bar "tmux is not running -- start tmux first"; fi; return 0
    fi
    case $1 in
        on) tmux set -g status on; echo "status line: shown in tmux (spark-shell bar off --terminal hides it)" ;;
        off) tmux set -g status off; echo "status line: hidden in tmux (spark-shell bar on --terminal brings it back)" ;;
        *) s=$(tmux show -gv status 2>/dev/null || echo on)
           if [ "$s" != off ]; then echo "status line: shown in tmux (spark-shell bar off --terminal hides it)"; else echo "status line: hidden in tmux (spark-shell bar on --terminal brings it back)"; fi ;;
    esac
}
bar_desktop() {   # bar_desktop [on|off] WHICH -- the bar at the top: the config key, the render, a running sway
    if [ "$OS" = Darwin ] || [ "$DESKTOP" != sway ]; then [ "$2" = both ] || refuse_in bar "no desktop here (spark-shell on desktop)"; return 0; fi
    case $1 in
        on|off) want=yes; [ "$1" = on ] || want=no
            config_set DESKTOP_BAR "$want"; DESKTOP_BAR=$want; export DESKTOP_BAR
            theme_load; EXPR=$(render_expr); desktop_look_apply
            if [ "$want" = yes ]; then echo "bar: shown at the top of the screen (spark-shell bar off --desktop hides it)"; else echo "bar: hidden (spark-shell bar on --desktop shows it)"; fi ;;
        *) if [ "$DESKTOP_BAR" = yes ]; then echo "bar: shown at the top of the screen -- $(bar_names) (spark-shell bar off --desktop hides it)"; else echo "bar: hidden (spark-shell bar on --desktop shows it)"; fi ;;
    esac
}
cmd_bar() {   # cmd_bar [on|off] [--terminal|--desktop] | status [--once] | volume up|down|mute|mic | panel [PAGE] [--list|ACTION [ARG]] | WORDS
    config_load
    case ${1:-} in
        status) shift; bar_status "$@"; return ;;
        volume) shift; bar_volume_key "${1:-}"; return ;;
        panel) shift; cmd_panel "$@"; return ;;   # the old spelling of spark-shell panel
        on|off|'') ;;
        -*) refuse_in bar "$1 is not a bar command: on, off, status, volume, panel, or words for what you want" ;;
        *) [ "$OS" != Darwin ] || refuse_in bar "not on macOS, which has its own desktop"; bar_want "$*"; return ;;
    esac
    which=both; case ${PLAYER:-} in rooms) which=rooms ;; windows) which=windows ;; esac
    [ "$which" = windows ] || bar_tmux "${1:-}" "$which"
    [ "$which" = rooms ] || bar_desktop "${1:-}" "$which"
}

# ================================================================ the panel
# THE PANEL is the desktop's one surface: see the machine, say what you
# would like, have it done, and take it back. One small floating window, the same
# size and place every time (the sway template centres it), in the
# palette's colours. Super+d opens it, Super+s opens it already in spark
# chat, a click on a bar block opens it with that block first. Esc
# closes it, and so does the key that opened it, pressed again. The
# focus is never watched: the mouse may wander.
#
# What it shows, top to bottom: the glance (what opened it, the bar's
# facts in words, an alarm on its own line), the receipt of the last
# thing done, then ONE list of everything this machine can do right
# now: an undo row while the last thing can be taken back, the rows you
# picked most recently, then the sections in order of use (spark,
# layout, out, mic, theme, bt, apps, wifi; the section you came from on
# top), each row with a sign where there is a state: in use or
# connected, available, current or saved, opens something. Under the
# list, one line and the prompt. The apps are rows that open; a layout
# can be saved from what is open on the screen.
#
# Every step goes through panel_step: the inverse is read before the
# act and kept in the journal (plain files under the state directory:
# `undo` holds the last group's inverses, `recent` the last picks), so
# the undo is exact, not guessed.
#
# How words are routed, in this order: a row (fzf narrows the list as
# you type), a program this machine declares (a layout for it, by the
# machine's own word), spark (a change becomes steps from that same
# list, checked against it then played; a question gets its answer
# from the bar's facts). spark reads only what the machine cannot know.
#
# How it stays quick: the window draws at once from what costs nothing
# to know; a probe that takes time (the Wi-Fi scan, Bluetooth) keeps
# its last answer with its age and fills the list in place while a
# march says it is looking; a want shows the think cells with the
# seconds and each step as it lands. Every wait over a second shows a
# pulse; nothing is probed twice within its age; a pipe sees no pulse.
#
# The parts, in this order below: the signs and sizes; the sections
# (order, presence, cost); the cache and the journal; the pulse; the
# probes; the sources (one title, rows and act per section); the step
# with its inverse; the gate and the list as text; the router and the
# want; the window; the verb and the click.
# `spark-shell panel [SECTION] --list` prints the list as text, and
# `panel SECTION ACTION [ARG]` does one step by hand: the tests' doors.

# --- the signs and the sizes
PANEL_APP='spark-panel'               # the window's app id (the sway template floats and centres it)
PANEL_SIZE=76x36                      # columns x rows of the window: the clock and the month, a list of twenty rows, the hint and the prompt
PANEL_COL=6                           # the section column: as wide as the longest section's name
PANEL_IN=4                            # the glance's indent: the section column, where every row's text begins
panel_col() { printf "%-${PANEL_COL}s  " "$1"; }   # panel_col SECTION -> the name in its column, two cells before the text
panel_sign() { case $1 in "$PANEL_DOT"|"$PANEL_TICK") printf '%s%s%s' "${PANEL_MARK:-}" "$1" "${PANEL_UNMARK:-}" ;; "$PANEL_CROSS") printf '%s%s%s' "${PANEL_RED:-}" "$1" "${PANEL_UNMARK:-}" ;; *) printf '%s' "$1" ;; esac; }   # panel_sign SIGN -> coloured: what is current in the accent, a refusal red
panel_indent() { sed "s/^/$(printf "%${PANEL_IN}s" '')/"; }   # the glance's lines, in from the edge
panel_line_sign() { case $1 in "$PANEL_DOT "*|"$PANEL_TICK "*|"$PANEL_CROSS "*) printf '%s %s' "$(panel_sign "${1%% *}")" "${1#* }" ;; *) printf '%s' "$1" ;; esac; }   # panel_line_sign LINE -> the line, its leading sign coloured
TAB=$(printf '\t')
PANEL_DOT=$(printf '\342\227\217')    # U+25CF, a filled circle: in use, connected
PANEL_RING=$(printf '\342\227\213')   # U+25CB, an empty circle: available
PANEL_TICK=$(printf '\342\234\223')   # U+2713, a check: current, saved; a step done
PANEL_CROSS=$(printf '\342\234\227')  # U+2717, a cross: a step refused
PANEL_GO=$(printf '\342\226\270')     # U+25B8, a small triangle: opens something
PANEL_WARN=$(printf '\342\232\240')   # U+26A0, a warning sign: an alarm
PANEL_SEP=$(printf '\302\267')        # U+00B7, a middle dot: between facts on a line
PANEL_PROMPT=$(printf '\342\235\257') # U+276F, a heavy angle: the prompt, as starship draws it
PANEL_MARK=''; PANEL_UNMARK=''; PANEL_DIM=''   # the accent, its end, the muted colour: set at a terminal (panel_colours)
panel_colours() {   # the three SGRs from our own render, when there is one (a pipe gets none)
    # shellcheck disable=SC1091   # our own render
    [ ! -f "$CONFIG_DIR/sgr.sh" ] || . "$CONFIG_DIR/sgr.sh"
    PANEL_MARK=$(printf '\033[%sm' "${SPARK_ACCENT_SGR:-1}"); PANEL_UNMARK=$(printf '\033[0m'); PANEL_DIM=$(printf '\033[%sm' "$(hex_sgr "$PANEL_MUTED")"); PANEL_RED=$(printf '\033[31m')
}

# --- the sections: their order by use, which of them this machine has, what each costs
PANEL_ORDER="undo spark layout out mic theme bt apps wifi"   # the sections with something to do, most used first; undo only while there is one; the slow one last, so the order never shifts
PANEL_BLOCKS="lan wifi bt out mic bat clock theme"      # the bar's blocks, in the bar's order (facts, presence)
PANEL_LOOKS="lan bat clock"                            # blocks with nothing to set: shown only when they opened the panel
panel_blocks_here() {   # -> the bar's blocks this machine has, in the bar's order
    for p in $PANEL_BLOCKS; do
        case $p in
            lan) [ -n "$(bar_wired)" ] || continue ;;
            wifi) [ -n "$(bar_wireless)" ] || continue ;;
            bt) ls -d "$BAR_SYS"/class/bluetooth/hci* >/dev/null 2>&1 || continue ;;
            out|mic) [ -n "${SND:-}" ] || continue ;;
            bat) [ -n "$(bar_power)" ] || continue ;;
        esac
        echo "$p"
    done
}
panel_sections() {   # panel_sections [FIRST] -> the sections in order, FIRST on top, absent blocks left out (on macOS: spark and layout)
    _f=${1:-glance}; _here=" $(panel_blocks_here | paste -sd ' ' -) "
    [ "$_f" = glance ] || echo "$_f"
    for s in $PANEL_ORDER; do
        [ "$s" != "$_f" ] || continue
        case $s in undo) [ -s "$PANEL_CACHE/undo" ] || continue ;; spark|layout) ;; apps) [ "$OS" != Darwin ] || continue ;; *) case $_here in *" $s "*) ;; *) continue ;; esac ;; esac
        echo "$s"
    done
}
panel_cost() {   # panel_cost SECTION -> instant | fast | slow: what its rows cost to know
    case $1 in wifi) echo slow ;; bt|out|mic|apps) echo fast ;; *) echo instant ;; esac
}
panel_section_ok() { case " glance chat $PANEL_ORDER $PANEL_BLOCKS " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }   # panel_section_ok WORD

# --- the cache: a probe's last answer, kept with its age under the state directory
PANEL_CACHE=$STATE_DIR/panel
panel_cache() {   # panel_cache NAME AGE CMD... -> CMD's output, from the cache while younger than AGE seconds, else fresh (and kept)
    _pc_file=$PANEL_CACHE/$1; _pc_age=$2; _pc_now=$(date +%s); shift 2   # names of their own: CMD may use the usual short ones
    if [ -f "$_pc_file" ] && [ $(( _pc_now - $(sed -n 1p "$_pc_file") )) -lt "$_pc_age" ] 2>/dev/null; then sed 1d "$_pc_file"; return 0; fi
    mkdir -p "$PANEL_CACHE"
    { echo "$_pc_now"; "$@"; } > "$_pc_file.new" 2>/dev/null && mv "$_pc_file.new" "$_pc_file" || { rm -f "$_pc_file.new"; "$@"; return; }
    sed 1d "$_pc_file"
}
panel_forget() { rm -f "$PANEL_CACHE/$1"; }   # panel_forget NAME -- after a change the probe must see
panel_age() {   # panel_age NAME SECONDS -- an answer made older by that much, so it is asked again sooner
    _pc_file=$PANEL_CACHE/$1; [ -f "$_pc_file" ] || return 0
    { echo $(( $(sed -n 1p "$_pc_file") - $2 )); sed 1d "$_pc_file"; } > "$_pc_file.new" && mv "$_pc_file.new" "$_pc_file"
}
# the journal: `undo` = the last group's inverse steps, newest first, as SECTION<tab>ACTION ARG<tab>WORDS; `recent` = the last picks, as SECTION<tab>ACTION ARG, newest first, 5 kept
panel_group_begin() { : > "$TMP/group"; }   # a pick, a want, a step by hand: one group, one undo
panel_group_end() {   # the group's inverses become the undo (none: the old undo stays)
    [ -s "$TMP/group" ] || return 0
    mkdir -p "$PANEL_CACHE"; awk '{ l[NR] = $0 } END { for (i = NR; i >= 1; i--) print l[i] }' "$TMP/group" > "$PANEL_CACHE/undo"
}
panel_recent_add() {   # panel_recent_add SECTION "ACTION ARG" -- the newest first, once, five kept
    mkdir -p "$PANEL_CACHE"; printf '%s\t%s\n' "$1" "$2" > "$TMP/recent.new"
    [ ! -f "$PANEL_CACHE/recent" ] || grep -vxF "$(printf '%s\t%s' "$1" "$2")" "$PANEL_CACHE/recent" | head -4 >> "$TMP/recent.new"
    mv "$TMP/recent.new" "$PANEL_CACHE/recent"
}
panel_fresh() {   # panel_fresh NAME AGE -> 0 when the cache would answer without a probe
    _f=$PANEL_CACHE/$1; [ -f "$_f" ] && [ $(( $(date +%s) - $(sed -n 1p "$_f") )) -lt "$2" ] 2>/dev/null
}

# --- the pulse: spark's shapes, drawn by this shell. The mark in the
# accent, eight cells muted: a cell back and forth while spark thinks,
# a march while the machine looks around, a step while a layout opens.
# From two seconds the elapsed seconds beside the cells. Silent on a pipe.
pulse_frame() {   # pulse_frame KIND TICK -> the eight cells
    case $1 in
        march) case $(( $2 % 4 )) in 0) printf '>   >   ' ;; 1) printf ' >   >  ' ;; 2) printf '  >   > ' ;; *) printf '   >   >' ;; esac ;;
        steps) case $(( $2 % 4 )) in 0) printf '# . . . ' ;; 1) printf '. # . . ' ;; 2) printf '. . # . ' ;; *) printf '. . . # ' ;; esac ;;
        *) case $(( $2 % 14 )) in 0|13) printf '=       ' ;; 1|12) printf ' =      ' ;; 2|11) printf '  =     ' ;; 3|10) printf '   =    ' ;; 4|9) printf '    =   ' ;; 5|8) printf '     =  ' ;; 6|7) printf '      = ' ;; esac ;;
    esac
}
pulse_line() {   # pulse_line KIND TICK SINCE [LABEL] -> one line: the mark, the cells, the seconds from 2 s, the label
    _el=$(( $(date +%s) - $3 )); _s=''; [ "$_el" -lt 2 ] || _s=" $_el s"
    printf '%s*%s %s[%s]%s%s%s' "$PANEL_MARK" "$PANEL_UNMARK" "$PANEL_DIM" "$(pulse_frame "$1" "$2")" "$_s" "${4:+ $4}" "$PANEL_UNMARK"
}
pulse_start() {   # pulse_start KIND [LABEL] [ROW] -- redrawn every 0.35 s on the cursor's row (or at ROW, the cursor put back) until pulse_stop; silent on a pipe
    [ -t 1 ] || return 0
    _k=$1; _l=${2:-}; _row=${3:-}; _t0=$(date +%s)
    ( i=0; while :; do
        if [ -n "$_row" ]; then printf '\0337\033[%s;%sH\033[2K%s\0338' "$_row" "${PULSE_COL:-1}" "$(pulse_line "$_k" "$i" "$_t0" "$_l")"
        else printf '\r\033[2K%s' "$(pulse_line "$_k" "$i" "$_t0" "$_l")"; fi
        i=$((i + 1)); sleep 0.35
      done ) &
    PULSE=$!
}
pulse_stop() {   # the pulse ends and its row is cleared
    [ -n "${PULSE:-}" ] || return 0
    kill "$PULSE" 2>/dev/null || :; wait "$PULSE" 2>/dev/null || :; PULSE=''
    [ ! -t 1 ] || { if [ -n "${1:-}" ]; then printf '\0337\033[%s;1H\033[2K\0338' "$1"; else printf '\r\033[2K'; fi; }
}

# --- the probes: the tools that answer for this machine's radios and sound
panel_lower() { printf '%s' "$*" | tr 'A-Z' 'a-z'; }
panel_bars() { bar_bars_plain "$1"; }
bar_bars_plain() {   # bar_bars_plain LEVEL (0-4) -> the four rising bars as text, the unlit ones as a light shade
    i=1; out=''
    for s in $BAR_STEPS; do
        if [ "$i" -gt "$1" ]; then out="$out$BAR_SHADE"; else out="$out$(printf "$s")"; fi
        i=$((i + 1))
    done
    printf '%s' "$out"
}
panel_secret() {   # panel_secret PROMPT -> what was typed, unseen; nothing when there is no terminal
    [ -t 0 ] || return 0
    printf '%s' "$1" > /dev/tty
    stty -echo 2>/dev/null; IFS= read -r _s </dev/tty || _s=''; stty echo 2>/dev/null; echo >/dev/tty
    printf '%s' "$_s"
}

# --- wifi: the tool that answers for this machine's wireless interface
wifi_if() { bar_wireless | sed -n 1p; }
wifi_tool() {   # -> nmcli | iwctl | wpa_cli | nothing
    _i=$(wifi_if); [ -n "$_i" ] || return 0
    if command -v nmcli >/dev/null 2>&1 && nmcli -t -f RUNNING general 2>/dev/null | grep -q running; then echo nmcli
    elif command -v iwctl >/dev/null 2>&1 && iwctl station "$_i" show >/dev/null 2>&1; then echo iwctl
    elif command -v wpa_cli >/dev/null 2>&1 && wpa_cli -i "$_i" status >/dev/null 2>&1; then echo wpa_cli
    fi
}
wifi_level() { _l=$(( ($1 + 100) * 2 )); [ "$_l" -ge 0 ] || _l=0; [ "$_l" -le 100 ] || _l=100; echo $(( (_l + 12) / 25 )); }   # wifi_level DBM -> 0..4
wifi_strip() { sed 's/\x1b\[[0-9;]*m//g; s/^[ >]*//; s/ *$//'; }   # iwctl's colours and marks off
wifi_connected() {   # -> the network in use, or nothing
    case $(wifi_tool) in
        nmcli) nmcli -t -e yes -f IN-USE,SSID dev wifi list 2>/dev/null | awk -F: '$1 == "*" { sub(/^[^:]*:/, ""); gsub(/\\:/, ":"); print; exit }' ;;
        iwctl) iwctl station "$(wifi_if)" show 2>/dev/null | wifi_strip | awk '$1 == "Connected" && $2 == "network" { $1 = ""; $2 = ""; sub(/^ +/, ""); print; exit }' ;;
        wpa_cli) wpa_cli -i "$(wifi_if)" status 2>/dev/null | sed -n 's/^ssid=//p' | sed -n 1p ;;
    esac
}
wifi_known() {   # -> ID<tab>NAME per saved network (ID is the tool's handle: a name for nmcli and iwctl, a number for wpa_cli)
    case $(wifi_tool) in
        nmcli) nmcli -t -e yes -f NAME,TYPE con show 2>/dev/null | awk -F: '$NF ~ /wireless/ { $NF = ""; sub(/:$/, ""); gsub(/\\:/, ":"); print $0 "\t" $0 }' ;;
        iwctl) iwctl known-networks list 2>/dev/null | wifi_strip | awk 'NR > 4 && NF >= 3 { n = ""; for (i = 1; i <= NF - 3; i++) n = n (n == "" ? "" : " ") $i; if (n != "") print n "\t" n }' ;;
        wpa_cli) wpa_cli -i "$(wifi_if)" list_networks 2>/dev/null | awk -F '\t' 'NR > 1 && $2 != "" { print $1 "\t" $2 }' ;;
    esac
}
wifi_scan() {   # -> NAME<tab>LEVEL<tab>SECURED per network around, strongest first; a scan is kept for a minute, a thin one (the radio was busy) for ten seconds
    panel_cache wifi.scan 60 wifi_scan_now | tee "$TMP/wifi.last"
    [ "$(grep -c '' "$TMP/wifi.last")" -ge 2 ] || panel_age wifi.scan 50
}
wifi_scan_now() {
    case $(wifi_tool) in
        nmcli) nmcli -t -e yes -f SIGNAL,SECURITY,SSID dev wifi list --rescan auto 2>/dev/null \
            | awk -F: '{ sig = $1; sec = ($2 == "" || $2 == "--") ? 0 : 1; $1 = ""; $2 = ""; sub(/^::/, ""); gsub(/\\:/, ":"); if ($0 != "") print $0 "\t" int((sig + 12) / 25) "\t" sec }' ;;
        iwctl) iwctl station "$(wifi_if)" scan >/dev/null 2>&1; sleep 2
            iwctl station "$(wifi_if)" get-networks 2>/dev/null | wifi_strip | awk 'NR > 4 && NF >= 3 { s = $NF; l = gsub(/\*/, "*", s); sec = ($(NF - 1) == "open") ? 0 : 1; n = ""; for (i = 1; i <= NF - 2; i++) n = n (n == "" ? "" : " ") $i; if (n != "") print n "\t" l "\t" sec }' ;;
        wpa_cli) wpa_cli -i "$(wifi_if)" scan >/dev/null 2>&1; sleep 2
            wpa_cli -i "$(wifi_if)" scan_results 2>/dev/null | awk -F '\t' 'NR > 1 && $5 != "" { sec = ($4 ~ /WPA|WEP|PSK|SAE/) ? 1 : 0; print $5 "\t" $3 "\t" sec }' \
            | while IFS="$TAB" read -r n dbm sec; do printf '%s\t%s\t%s\n' "$n" "$(wifi_level "$dbm")" "$sec"; done ;;
    esac | awk -F '\t' '!seen[$1]++ || $2 > best[$1] { best[$1] = $2; sec[$1] = $3 } END { for (n in best) print n "\t" best[n] "\t" sec[n] }' | sort -t "$TAB" -k2,2nr -k1,1
}
wifi_known_id() { wifi_known | awk -F '\t' -v n="$(panel_lower "$1")" 'tolower($2) == n && !done { print $1; done = 1 }'; }   # wifi_known_id NAME -> its handle, or nothing
wifi_connect() {   # wifi_connect NAME [PASSWORD] -> one line
    _i=$(wifi_if); _id=$(wifi_known_id "$1"); _r=''
    case $(wifi_tool) in
        nmcli) if [ -n "$_id" ]; then _r=$(nmcli con up id "$_id" 2>&1) || { echo "could not connect to $1: $(printf '%s\n' "$_r" | tail -1)"; return 1; }
               else _r=$(nmcli dev wifi connect "$1" ${2:+password "$2"} 2>&1) || { echo "could not connect to $1: $(printf '%s\n' "$_r" | tail -1)"; return 1; }; fi ;;
        iwctl) _r=$(iwctl ${2:+--passphrase "$2"} station "$_i" connect "$1" 2>&1) || { echo "could not connect to $1: $(printf '%s\n' "$_r" | wifi_strip | tail -1)"; return 1; } ;;
        wpa_cli) if [ -z "$_id" ]; then
                _id=$(wpa_cli -i "$_i" add_network 2>/dev/null | tail -1)
                case $_id in ''|*[!0-9]*) echo "could not connect to $1: wpa_cli did not add it"; return 1 ;; esac
                wpa_cli -i "$_i" set_network "$_id" ssid "\"$1\"" >/dev/null 2>&1
                if [ -n "${2:-}" ]; then wpa_cli -i "$_i" set_network "$_id" psk "\"$2\"" >/dev/null 2>&1; else wpa_cli -i "$_i" set_network "$_id" key_mgmt NONE >/dev/null 2>&1; fi
                wpa_cli -i "$_i" enable_network "$_id" >/dev/null 2>&1
                wpa_cli -i "$_i" save_config 2>/dev/null | grep -q OK || _r="(kept until the next boot: wpa_supplicant.conf is not writable from here)"
            fi
            wpa_cli -i "$_i" select_network "$_id" >/dev/null 2>&1
            wpa_cli -i "$_i" enable_network all >/dev/null 2>&1   # select_network puts the other saved networks aside
            wpa_cli -i "$_i" reconnect >/dev/null 2>&1
            _t=0; while [ "$_t" -lt 15 ]; do [ "$(wifi_connected)" = "$1" ] && break; sleep 1; _t=$((_t + 1)); done
            [ "$(wifi_connected)" = "$1" ] || { echo "could not connect to $1 (wrong password, or out of reach)"; return 1; } ;;
        *) echo "no tool answers for wifi (nmcli, iwctl or wpa_cli)"; return 1 ;;
    esac
    panel_forget wifi.scan
    echo "connected to $1${_r:+ $_r}"
}
wifi_disconnect() {   # -> one line
    _i=$(wifi_if); _c=$(wifi_connected)
    case $(wifi_tool) in
        nmcli) nmcli dev disconnect "$_i" >/dev/null 2>&1 ;;
        iwctl) iwctl station "$_i" disconnect >/dev/null 2>&1 ;;
        wpa_cli) wpa_cli -i "$_i" disconnect >/dev/null 2>&1 ;;
        *) echo "no tool answers for wifi (nmcli, iwctl or wpa_cli)"; return 1 ;;
    esac || { echo "could not disconnect"; return 1; }
    echo "disconnected${_c:+ from $_c}"
}
wifi_forget() {   # wifi_forget NAME -> one line
    _i=$(wifi_if); _id=$(wifi_known_id "$1"); [ -n "$_id" ] || { echo "$1 is not a saved network"; return 1; }
    case $(wifi_tool) in
        nmcli) nmcli con delete id "$_id" >/dev/null 2>&1 ;;
        iwctl) iwctl known-networks "$_id" forget >/dev/null 2>&1 ;;
        wpa_cli) wpa_cli -i "$_i" remove_network "$_id" >/dev/null 2>&1 && wpa_cli -i "$_i" save_config >/dev/null 2>&1 ;;
    esac || { echo "could not forget $1"; return 1; }
    echo "forgot $1"
}

# --- bluetooth: bluetoothctl, the one tool
bt_powered() { bar_timeout bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; }
bt_list() { panel_cache bt.list 30 bt_list_now; }   # -> MAC<tab>NAME<tab>PAIRED<tab>CONNECTED per device bluez knows; kept for half a minute
bt_list_now() {
    _p=$(bar_timeout bluetoothctl devices Paired 2>/dev/null | awk '$1 == "Device" {print $2}')
    _c=$(bar_timeout bluetoothctl devices Connected 2>/dev/null | awk '$1 == "Device" {print $2}')
    bar_timeout bluetoothctl devices 2>/dev/null | awk '$1 == "Device" { mac = $2; $1 = ""; $2 = ""; sub(/^ +/, ""); print mac "\t" $0 }' | while IFS="$TAB" read -r mac name; do
        p=0; c=0
        printf '%s\n' "$_p" | grep -qx "$mac" && p=1
        printf '%s\n' "$_c" | grep -qx "$mac" && c=1
        printf '%s\t%s\t%s\t%s\n' "$mac" "$name" "$p" "$c"
    done
}
bt_mac() { bt_list | awk -F '\t' -v n="$(panel_lower "$1")" 'tolower($2) == n && !done { print $1; done = 1 }'; }   # bt_mac NAME -> its address, or nothing (the whole list read: no broken pipe)
bt_act() {   # bt_act connect|disconnect|pair NAME | scan | power on|off -> one line; the device list is read afresh after
    panel_forget bt.list
    case $1 in
        connect|disconnect|pair)
            _m=$(bt_mac "$2"); [ -n "$_m" ] || { echo "no device named $2"; return 1; }
            case $1 in
                connect) bar_timeout bluetoothctl connect "$_m" 2>&1 | grep -q 'successful' && echo "connected $2" || { echo "could not connect $2 (is it on, and near?)"; return 1; } ;;
                disconnect) bar_timeout bluetoothctl disconnect "$_m" 2>&1 | grep -q 'Successful' && echo "disconnected $2" || { echo "could not disconnect $2"; return 1; } ;;
                pair) timeout 25 bluetoothctl pair "$_m" 2>&1 | grep -q 'Pairing successful' || { echo "could not pair $2 (put it in pairing mode, then try again)"; return 1; }
                      bar_timeout bluetoothctl trust "$_m" >/dev/null 2>&1
                      bar_timeout bluetoothctl connect "$_m" >/dev/null 2>&1 && echo "paired and connected $2" || echo "paired $2" ;;
            esac ;;
        scan) timeout 10 bluetoothctl --timeout 8 scan on >/dev/null 2>&1 || :
              _n=$(bt_list | awk -F '\t' '$3 == 0 {print $2}' | paste -sd, - | sed 's/,/, /g')
              if [ -n "$_n" ]; then echo "new: $_n (Enter on one pairs it)"; else echo "nothing new near (put the device in pairing mode)"; fi ;;
        power) bar_timeout bluetoothctl power "$2" >/dev/null 2>&1 && echo "bluetooth $2" || { echo "could not turn bluetooth $2"; return 1; } ;;
        *) echo "$1 is not something bt does"; return 1 ;;
    esac
}

# --- sound: the devices, through the same tool the bar reads
snd_devices() {   # snd_devices out|mic -> NAME<tab>DEFAULT(1/0) per device
    case $SND in
        wpctl) _s=Sinks; [ "$1" = out ] || _s=Sources; wp_rows "$_s" | awk -F '\t' '{print $3 "\t" $1}' ;;
        pactl) _k=sinks; _d=$(pactl get-default-sink 2>/dev/null); [ "$1" = out ] || { _k=sources; _d=$(pactl get-default-source 2>/dev/null); }
            pactl list short "$_k" 2>/dev/null | cut -f2 | while IFS= read -r s; do
                case $s in *.monitor) continue ;; esac
                n=$(pa_desc "$_k" "$s"); d=0; [ "$s" != "$_d" ] || d=1; printf '%s\t%s\n' "${n:-$s}" "$d"
            done ;;
        alsa) if [ "$1" = out ]; then _k=p; _d=$(al_out); else _k=c; _d=$(al_mic); fi
            for c in $(al_with "$_k"); do d=0; [ "$c" != "$_d" ] || d=1; printf '%s\t%s\n' "$(al_name "$c")" "$d"; done ;;
    esac
}
snd_use() {   # snd_use out|mic NAME -> one line; on plain ALSA the output's card holds for programs started from now
    _n=$(panel_lower "$2")
    case $SND in
        wpctl) _s=Sinks; [ "$1" = out ] || _s=Sources
            _id=$(wp_rows "$_s" | awk -F '\t' -v n="$_n" 'tolower($3) == n && !done {print $2; done = 1}'); [ -n "$_id" ] || { echo "no $1 named $2"; return 1; }
            wpctl set-default "$_id" >/dev/null 2>&1 && echo "$1 $2" || { echo "could not switch $1 to $2"; return 1; } ;;
        pactl) _k=sinks; _v=set-default-sink; [ "$1" = out ] || { _k=sources; _v=set-default-source; }
            _id=$(pactl list short "$_k" 2>/dev/null | cut -f2 | while IFS= read -r s; do d=$(pa_desc "$_k" "$s"); [ "$(panel_lower "${d:-$s}")" != "$_n" ] || { echo "$s"; break; }; done)
            [ -n "$_id" ] || { echo "no $1 named $2"; return 1; }
            pactl "$_v" "$_id" >/dev/null 2>&1 && echo "$1 $2" || { echo "could not switch $1 to $2"; return 1; } ;;
        alsa) [ "$1" = out ] || { echo "on plain ALSA the mic follows the output's card"; return 0; }
            _c=''; for c in $(al_with p); do [ "$(panel_lower "$(al_name "$c")")" != "$_n" ] || { _c=$c; break; }; done
            [ -n "$_c" ] || { echo "no output named $2"; return 1; }
            _r=$(al_set_default "$_c") || { echo "$_r"; return 1; }
            echo "out $2 for programs started from now" ;;
        *) echo "no audio system answers"; return 1 ;;
    esac
}

# --- the sources: one title, the rows and the act per section. A row is
# MARK<tab>TEXT<tab>ACTION [ARG]: the mark a sign or -, a look-only row
# carries `show`. Not every row of a long section shows when it is not
# the one that opened the panel: a `more` row opens it in full.
panel_title() {   # panel_title SECTION -> the line(s) that say what opened the panel, as text, the section in its column; `glance` is the date and time, the facts, an alarm line when there is one
    case $1 in
        lan) _l=$(bar_lan); case $_l in up*) echo "$(panel_col lan)up $PANEL_SEP ${_l#up }" ;; down) echo "$(panel_col lan)$PANEL_WARN down: no carrier on the wire" ;; *) echo "$(panel_col lan)no wire" ;; esac ;;
        wifi) _t=$(wifi_tool); _c=$(wifi_connected); _w=$(bar_wifi)
            if [ -z "$_t" ]; then echo "$(panel_col wifi)no tool answers (nmcli, iwctl or wpa_cli)"
            elif [ -z "$_c" ]; then echo "$(panel_col wifi)not connected"
            else case $_w in *' '*) _a=${_w#* } ;; *) _a='' ;; esac; echo "$(panel_col wifi)$(panel_bars "${_w%% *}") $_c${_a:+ $PANEL_SEP $_a}"; fi ;;
        bt) _b=$(bar_bt); case $_b in name*) echo "$(panel_col bt)$PANEL_DOT ${_b#name }" ;; on) echo "$(panel_col bt)on $PANEL_SEP nothing connected" ;; off) echo "$(panel_col bt)off" ;; *) echo "$(panel_col bt)no controller" ;; esac ;;
        out|mic) if [ "$1" = out ]; then _o=$(snd_out); else _o=$(snd_mic); fi
            [ -n "$_o" ] || { echo "$(panel_col "$1")nothing found"; return 0; }
            _n=$(printf '%s\n' "$_o" | sed -n 1p); _lv=$(printf '%s\n' "$_o" | sed -n 2p); _m=$(printf '%s\n' "$_o" | sed -n 3p); _live=0
            if [ "$1" = mic ]; then _lv=$(printf '%s\n' "$_o" | sed -n 4p); _live=$(printf '%s\n' "$_o" | sed -n 2p); fi
            _s="$(panel_col "$1")$_n"; [ "$_lv" = - ] || [ -z "$_lv" ] || _s="$_s $PANEL_SEP $_lv%"; [ "$_m" != 1 ] || _s="$_s $PANEL_SEP muted"; [ "${_live:-0}" != 1 ] || _s="$_s $PANEL_SEP $PANEL_DOT recording"
            echo "$_s" ;;
        bat) _b=$(bar_power); [ -n "$_b" ] || { echo "$(panel_col bat)no battery"; return 0; }
            _cap=${_b%% *}; _st=$(panel_lower "${_b#* }"); _w=''; [ "$_cap" -ge 15 ] 2>/dev/null || [ "$_st" = charging ] || _w="$PANEL_WARN "
            _s="$(panel_col bat)$_w$_cap% $PANEL_SEP $_st"; _left=$(bat_left); [ -z "$_left" ] || _s="$_s $PANEL_SEP $_left"; echo "$_s" ;;
        clock) date '+%A %d %B %Y' ;;   # the time and the month are drawn under it (clock_view)
        theme) echo "$(panel_col theme)${THEME:-none} $PANEL_SEP $(bar_font)" ;;   # the wallpaper and alpha are named in their rows
        layout) _n=$(ls -A "$LAYOUTS_DIR" 2>/dev/null | wc -l | tr -d ' '); _last=''; [ ! -f "$DESK_LAST" ] || _last=$(desk_words "$DESK_LAST")
            if [ "$_n" -eq 0 ]; then echo "$(panel_col layout)none saved yet"
            else echo "$(panel_col layout)$_n saved${_last:+ $PANEL_SEP last: $_last}"; fi ;;
        apps) if apps_marked; then echo "$(panel_col apps)$(grep -c '^[A-Za-z0-9]' "$APPS") allowed $PANEL_SEP Enter opens one"; else echo "$(panel_col apps)every app allowed $PANEL_SEP Enter opens one"; fi ;;
        spark) echo "$(panel_col spark)a conversation, in this window" ;;
        undo) echo "$(panel_col undo)the last thing done, taken back" ;;
        glance) panel_glance_line
            _f=$(panel_facts_short); [ -z "$_f" ] || echo "$_f"
            _a=$(panel_alarms); [ -z "$_a" ] || echo "$_a" ;;
    esac
}
panel_glance_line() { echo "$(date '+%A %d %B') $PANEL_SEP $(date '+%H:%M')"; }   # -> the date and the time on a pipe (the window draws the clock instead)
panel_glance() {   # panel_glance WIDTH -> the lines over the list in the window, the same behind every door: the date, the clock beside the month, an alarm in red under them when there is one (the facts are on the bar)
    date '+%A %d %B'; echo
    clock_view "$PANEL_MARK" "$PANEL_UNMARK"
    _a=$(panel_alarms); [ -z "$_a" ] || { echo; printf '%s\n' "$_a" | fold -s -w "$1" | sed "s/.*/$PANEL_RED&$PANEL_UNMARK/"; }
}
panel_facts_short() {   # -> the bar's facts in a few words each, one line (the second line of the list as text: on a pipe there is no bar to read them from)
    _s=''
    for p in $(panel_blocks_here); do
        case $p in
            lan) _l=$(bar_lan); case $_l in up*) continue ;; down) _w="lan down" ;; *) continue ;; esac ;;   # a wire that is up says nothing
            wifi) _c=$(wifi_connected); [ -n "$_c" ] || continue; _w="wifi $_c" ;;
            bt) _b=$(bar_bt); case $_b in name*) _w="bt $PANEL_DOT ${_b#name }" ;; on|off) _w="bt $_b" ;; *) continue ;; esac ;;
            out|mic) if [ "$p" = out ]; then _o=$(snd_out); _lv=$(printf '%s\n' "$_o" | sed -n 2p); else _o=$(snd_mic); _lv=$(printf '%s\n' "$_o" | sed -n 4p); fi
                [ -n "$_o" ] || continue
                if [ "$(printf '%s\n' "$_o" | sed -n 3p)" = 1 ]; then _w="$p muted"; elif [ "$_lv" = - ] || [ -z "$_lv" ]; then _w="$p on"; else _w="$p $_lv%"; fi ;;
            bat) _b=$(bar_power); _w="bat ${_b%% *}%" ;;
            clock) continue ;;
            theme) _w="theme ${THEME:-none}" ;;
        esac
        _s="${_s:+$_s $PANEL_SEP }$_w"
    done
    printf '%s\n' "$_s"
}
panel_alarms() {   # -> the alarms the bar shows in red, on one line with the warning sign; nothing when all is well
    _a=''
    for p in $(panel_blocks_here); do
        case $p in
            lan) case $(bar_lan) in down) _a="${_a:+$_a $PANEL_SEP }$PANEL_WARN lan down" ;; esac ;;
            bat) _b=$(bar_power); [ "${_b%% *}" -ge 15 ] 2>/dev/null || [ "$(panel_lower "${_b#* }")" = charging ] || _a="${_a:+$_a $PANEL_SEP }$PANEL_WARN battery ${_b%% *}%" ;;
            mic) [ "$(snd_mic | sed -n 2p)" != 1 ] || _a="${_a:+$_a $PANEL_SEP }$PANEL_DOT mic recording" ;;
        esac
    done
    printf '%s\n' "$_a"
}
panel_facts() {   # -> what the bar shows now, one title per block, for a question at the prompt
    for p in $(panel_blocks_here); do [ "$p" = clock ] || printf '%s; ' "$(panel_title "$p")"; done | sed 's/; $//' | tr -s ' '
}
panel_rows() {   # panel_rows SECTION [full] -> the rows; without `full` a long section shows what matters and a `more` row
    case $1 in
        lan) for i in $(bar_wired); do
                [ "$(cat "$BAR_SYS/class/net/$i/carrier" 2>/dev/null)" = 1 ] || { printf -- '-\twire %s: no carrier\tshow\n' "$i"; continue; }
                printf -- '-\taddress %s\tshow\n' "$(bar_addr "$i")"
                _sp=$(cat "$BAR_SYS/class/net/$i/speed" 2>/dev/null); [ -z "$_sp" ] || [ "$_sp" -le 0 ] 2>/dev/null || printf -- '-\tspeed %s Mb/s\tshow\n' "$_sp"
                _gw=$(ip -4 route show default dev "$i" 2>/dev/null | awk '{print $3; exit}'); [ -z "$_gw" ] || printf -- '-\tgateway %s\tshow\n' "$_gw"
                _ns=$(awk '$1 == "nameserver" {print $2; exit}' /etc/resolv.conf 2>/dev/null); [ -z "$_ns" ] || printf -- '-\tname server %s\tshow\n' "$_ns"
                break
            done ;;
        wifi) [ -n "$(wifi_tool)" ] || { printf -- '-\tno tool answers for wifi (nmcli, iwctl or wpa_cli)\tshow\n'; return 0; }
            _c=$(wifi_connected); wifi_known | cut -f2 > "$TMP/wifi.known"
            [ -z "$_c" ] || printf '%s\t%s\tdisconnect\n' "$PANEL_DOT" "$_c"
            # around: the saved ones and, unless full, the strongest three of the rest; what is left counts in a `more` row
            wifi_scan | awk -F '\t' -v c="$_c" '$1 != c' > "$TMP/wifi.around"
            _n=0; _left=0
            while IFS="$TAB" read -r n l sec; do
                if grep -qxF "$n" "$TMP/wifi.known"; then _k=" $PANEL_TICK saved"; else _k=''; fi
                if [ "${2:-}" != full ] && [ -z "$_k" ] && [ "$_n" -ge 3 ]; then _left=$((_left + 1)); continue; fi
                printf '%s\t%s %s%s\tconnect %s\n' "$PANEL_RING" "$n" "$(panel_bars "$l")" "$_k" "$n"
                [ -n "$_k" ] || _n=$((_n + 1))
            done < "$TMP/wifi.around"
            [ "$_left" -eq 0 ] || printf -- '-\t%s more\tmore\n' "$_left"
            while IFS= read -r n; do [ -n "$n" ] && [ "$n" != "$_c" ] && printf -- '-\tforget %s\tforget %s\n' "$n" "$n"; done < "$TMP/wifi.known" ;;
        bt) command -v bluetoothctl >/dev/null 2>&1 || { printf -- '-\tbluetoothctl is not installed\tshow\n'; return 0; }
            if bt_powered; then
                bt_list | while IFS="$TAB" read -r mac n p c; do
                    if [ "$c" = 1 ]; then printf '%s\t%s\tdisconnect %s\n' "$PANEL_DOT" "$n" "$n"
                    elif [ "$p" = 1 ]; then printf '%s\t%s\tconnect %s\n' "$PANEL_RING" "$n" "$n"
                    else printf '%s\t%s %s new\tpair %s\n' "$PANEL_RING" "$n" "$PANEL_SEP" "$n"; fi
                done
                printf -- '-\tfind new devices\tscan\n-\tturn off\tpower off\n'
            else printf -- '-\tturn on\tpower on\n'; fi ;;
        out|mic) [ -n "${SND:-}" ] || { printf -- '-\tno audio system found\tshow\n'; return 0; }
            snd_devices "$1" | while IFS="$TAB" read -r n d; do if [ "$d" = 1 ]; then printf '%s\t%s\tshow\n' "$PANEL_DOT" "$n"; else printf '%s\t%s\tuse %s\n' "$PANEL_RING" "$n" "$n"; fi; done
            if [ "$1" = out ]; then _o=$(snd_out); _m=$(printf '%s\n' "$_o" | sed -n 3p); _lv=$(printf '%s\n' "$_o" | sed -n 2p)
            else _o=$(snd_mic); _m=$(printf '%s\n' "$_o" | sed -n 3p); _lv=$(printf '%s\n' "$_o" | sed -n 4p); fi
            [ "$_lv" = - ] || [ -z "$_lv" ] || { if [ "$_m" = 1 ]; then printf -- '-\tunmute\tunmute\n'; else printf -- '-\tmute\tmute\n'; fi; } ;;
        bat) _d=$(bat_dir); [ -n "$_d" ] || { printf -- '-\tno battery\tshow\n'; return 0; }
            printf -- '-\tcharge %s%% %s %s\tshow\n' "$(bat_num capacity)" "$PANEL_SEP" "$(panel_lower "$(bat_num status)")"
            _left=$(bat_left); [ -z "$_left" ] || printf -- '-\t%s\tshow\n' "$_left"
            _f=$(bat_num energy_full); _fd=$(bat_num energy_full_design); [ -n "$_f" ] || { _f=$(bat_num charge_full); _fd=$(bat_num charge_full_design); }
            [ -z "$_f" ] || [ -z "$_fd" ] || [ "$_fd" -le 0 ] 2>/dev/null || printf -- '-\thealth %s%% of new\tshow\n' $(( _f * 100 / _fd ))
            _cy=$(bat_num cycle_count); [ -z "$_cy" ] || printf -- '-\tcycles %s\tshow\n' "$_cy"
            _r=$(bat_num power_now); [ -z "$_r" ] || [ "$_r" -le 0 ] 2>/dev/null || printf -- '-\tpower %s W\tshow\n' "$(awk -v r="$_r" 'BEGIN { printf "%.1f", r / 1000000 }')" ;;
        clock) : ;;   # nothing to pick: the face under the title holds the time and the month
        theme) { echo none; palette_names; } | while IFS= read -r n; do   # a palette's step is its name alone
                if [ "$n" = "${THEME:-none}" ]; then printf '%s\t%s\tshow\n' "$PANEL_TICK" "$n"; else printf -- '-\t%s\t%s\n' "$n" "$n"; fi
            done
            _sz=$(look_font_size); [ -z "$_sz" ] || printf -- '-\tfont bigger %s %s now\tfont bigger\n-\tfont smaller\tfont smaller\n' "$PANEL_SEP" "$_sz"
            [ "${2:-}" = full ] || { printf -- '-\twallpaper and alpha\tmore\n'; return 0; }
            _cur=$WALLPAPER; case $_cur in default|none) ;; *) if wall_colour; then _cur=$WALLPAPER; else printf '%s\twallpaper %s\tshow\n' "$PANEL_TICK" "$_cur"; _cur=''; fi ;; esac
            for w in default none $WALL_NAMES; do
                _h=$(wall_hex "$w" 2>/dev/null || :)
                if [ "$w" = "$_cur" ] || { [ -n "$_h" ] && [ "$_h" = "$(panel_lower "$WALLPAPER")" ]; }; then printf '%s\twallpaper %s\tshow\n' "$PANEL_TICK" "$w"; else printf -- '-\twallpaper %s\twallpaper %s\n' "$w" "$w"; fi
            done
            for a in 1.0 0.9 0.85 0.75 0.5; do
                if [ "$a" = "$ALPHA" ]; then printf '%s\talpha %s\tshow\n' "$PANEL_TICK" "$a"; else printf -- '-\talpha %s\talpha %s\n' "$a" "$a"; fi
            done ;;
        layout) if [ -d "$LAYOUTS_DIR" ] && [ -n "$(ls -A "$LAYOUTS_DIR" 2>/dev/null)" ]; then
                for f in "$LAYOUTS_DIR"/*; do _w=$(desk_words "$f"); [ -n "$_w" ] || _w=${f##*/}; printf '%s\t%s\topen %s\n' "$PANEL_GO" "$_w" "${f##*/}"; done
            else printf -- '-\tnone saved yet: say what you want to do at the prompt\tshow\n'; fi
            [ ! -f "$DESK_LAST" ] || jq -r '.suggested // [] | .[]' "$DESK_LAST" 2>/dev/null | while IFS= read -r a; do printf '%s\talso open %s\tadd %s\n' "$PANEL_GO" "$a" "$a"; done   # what spark also suggested for the last layout, one Enter away
            [ -z "${SWAYSOCK:-}" ] || printf '%s\tsave what is open now\tsave\n' "$PANEL_GO" ;;
        apps) panel_apps_known | { _n=0; while IFS= read -r a; do   # the apps a layout may open, as rows that open one; six unless full
                    _n=$((_n + 1)); if [ "${2:-}" != full ] && [ "$_n" -gt 6 ]; then continue; fi
                    printf '%s\t%s\topen %s\n' "$PANEL_GO" "$a" "$a"
                done; [ "${2:-}" = full ] || [ "$_n" -le 6 ] || printf -- '-\t%s more\tmore\n' $((_n - 6)); }
            printf '%s\tchoose the allowed apps\tpick\n' "$PANEL_GO" ;;
        spark) printf '%s\tchat\tchat\n' "$PANEL_GO" ;;
        undo) [ -s "$PANEL_CACHE/undo" ] || return 0
            printf -- '-\t%s\tall\n' "$(cut -f3 "$PANEL_CACHE/undo" | paste -sd '|' - | sed "s/|/ $PANEL_SEP /g")" ;;
    esac
}
panel_apps_known() {   # -> the apps a layout may open (your allowed list, else every desktop entry), one name per line; never the desktop's own
    ( [ "$OS" = Darwin ] || pm_detect; desk_apps '' ) 2>/dev/null | sed -n 's/^\([A-Za-z0-9][^:]*\): .*/\1/p' | grep -vx shell
}
panel_section_rows() {   # panel_section_rows SECTION FIRST -> the section's rows for the list, "MARK SECTION  TEXT<tab>SECTION ACTION [ARG]"; look-only rows only for FIRST
    _full=''; [ "$1" != "$2" ] || _full=full
    panel_rows "$1" $_full | while IFS="$TAB" read -r m t a; do
        [ "$1" = "$2" ] || [ "$a" != show ] || continue
        [ "$m" != - ] || m=' '
        printf '%s %s%s%s%s\t%s %s\n' "$(panel_sign "$m")" "${PANEL_DIM:-}" "$(panel_col "$1")" "${PANEL_UNMARK:-}" "$t" "$1" "$a"
    done
}
panel_stream() {   # panel_stream FIRST -> the one list, in the order rows are ready: FIRST, the recent picks, the instant and fast sections, then the slow ones as each answers
    _slow=''; : > "$TMP/quick.rows"
    for s in $(panel_sections "$1"); do
        if [ "$s" != "$1" ] && [ "$(panel_cost "$s")" = slow ]; then _slow="$_slow $s"; continue; fi
        if [ "$s" = "$1" ] || [ "$s" = undo ]; then panel_section_rows "$s" "$1"; else panel_section_rows "$s" "$1" >> "$TMP/quick.rows"; fi
    done
    panel_recent_first "$TMP/quick.rows"
    for s in $_slow; do panel_section_rows "$s" "$1"; done
}
panel_recent_first() {   # panel_recent_first ROWS -- the rows you picked most recently first, in that order, then the others as they were
    if [ -s "$PANEL_CACHE/recent" ]; then
        awk -F '\t' 'NR == FNR { want[$1 " " $2] = NR; next } { k = $2; sub(/ +$/, "", k); if (k in want) { picked[want[k]] = $0; next } print > "/dev/stderr" } END { for (i = 1; i <= 5; i++) if (i in picked) print picked[i] }' "$PANEL_CACHE/recent" "$1" 2>"$TMP/rest.rows"
        cat "$TMP/rest.rows"
    else cat "$1"; fi
}
look_apply() {   # the look's renders and a running sway, quietly
    theme_load; EXPR=$(render_expr); desktop_look_apply >/dev/null 2>&1 || :
}
panel_act() {   # panel_act SECTION ACTION [ARG] -> one line (what was done, or why not); exit 1 when it was not done
    _p=$1; _a=$2; shift 2; _arg=$*
    case $_a in show) return 0 ;; esac
    case $_p in
        wifi) case $_a in
                connect) _sec=$(wifi_scan | awk -F '\t' -v n="$(panel_lower "$_arg")" 'tolower($1) == n && !done {print $3; done = 1}')
                    if [ -n "$(wifi_known_id "$_arg")" ] || [ "${_sec:-0}" = 0 ]; then wifi_connect "$_arg"
                    else _pw=$(panel_secret "password for $_arg: "); [ -n "$_pw" ] || { echo "no password given, so not connected"; return 1; }; wifi_connect "$_arg" "$_pw"; fi ;;
                disconnect) wifi_disconnect ;;
                forget) wifi_forget "$_arg" ;;
                *) echo "$_a is not something wifi does"; return 1 ;;
            esac ;;
        bt) bt_act "$_a" "$_arg" ;;
        out|mic) case $_a in
                use) snd_use "$_p" "$_arg" ;;
                level) snd_set "$_p" "$_arg" && echo "$_p at $_arg%" ;;
                mute) snd_set "$_p" muted; snd_said "$_p" muted ;;
                unmute) snd_set "$_p" unmuted; snd_said "$_p" unmuted ;;
                *) echo "$_a is not something $_p does"; return 1 ;;
            esac ;;
        theme) case $_a in
                font) _sz=$(look_font_size); [ -n "$_sz" ] || { echo "FONT=$FONT has no size to change (the config)"; return 1; }
                    if [ "$_arg" = bigger ]; then _new=$((_sz + 1)); else _new=$((_sz - 1)); fi
                    [ "$_new" -ge 6 ] && [ "$_new" -le 40 ] || { echo "font size $_sz stays (6 to 40)"; return 1; }
                    _f=$(printf '%s' "$FONT" | sed "s/size=$_sz/size=$_new/")
                    config_set FONT "$_f" >/dev/null; FONT=$_f; export FONT; look_apply
                    echo "font $_new" ;;
                wallpaper) _r=$(cmd_desktop wallpaper "$_arg" 2>&1) || { printf '%s\n' "$_r" | tail -1; return 1; }; echo "wallpaper $_arg" ;;
                alpha) case $_arg in 1|1.0|0|0.[0-9]|0.[0-9][0-9]) ;; *) echo "alpha is 0 to 1, as 0.85"; return 1 ;; esac
                    config_set ALPHA "$_arg" >/dev/null; ALPHA=$_arg; export ALPHA; look_apply
                    echo "alpha $_arg" ;;
                theme) _r=$(cmd_theme "$_arg" 2>&1) || { printf '%s\n' "$_r" | tail -1; return 1; }; echo "theme $_arg" ;;   # the old spelling of a step
                *) _r=$(cmd_theme "$_a" 2>&1) || { printf '%s\n' "$_r" | tail -1; return 1; }; echo "theme $_a" ;;   # a palette, by its name
            esac ;;
        layout) case $_a in
                open) [ -f "$LAYOUTS_DIR/$_arg" ] || { echo "no saved layout named $_arg"; return 1; }
                    ( [ "$OS" = Darwin ] || pm_detect; REFUSE_AS=layout; desk_need "$_arg" ) ;;
                new) [ -n "$_arg" ] || { echo "say what you want to do"; return 1; }
                    ( [ "$OS" = Darwin ] || pm_detect; REFUSE_AS=layout; desk_need "$_arg" ) ;;
                save) panel_layout_save "$_arg" ;;
                add) panel_app_open "$_arg" || return 1   # on this workspace, where the panel followed the layout
                    jq --arg a "$_arg" '.suggested = ((.suggested // []) - [$a])' "$DESK_LAST" > "$DESK_LAST.new" && mv "$DESK_LAST.new" "$DESK_LAST" ;;
                *) echo "$_a is not something layout does"; return 1 ;;
            esac ;;
        apps) case $_a in
                pick) ( cmd_apps_verb ) ;;
                open) panel_app_open "$_arg" ;;
                *) echo "$_a is not something apps does"; return 1 ;;
            esac ;;
        spark) case $_a in chat) panel_chat ;; *) echo "$_a is not something spark does here"; return 1 ;; esac ;;
        undo) case $_a in all) panel_undo ;; *) echo "$_a is not something undo does"; return 1 ;; esac ;;
        *) echo "$_p takes no action"; return 1 ;;
    esac
}
panel_app_open() {   # panel_app_open NAME -> the app opens on the current workspace, the way its desktop entry says (a terminal app inside foot)
    desk_in_sway || { echo "opening an app needs the desktop"; return 1; }
    ( [ "$OS" = Darwin ] || pm_detect; desk_apps '' ) > "$TMP/apps" 2>/dev/null
    _n=$(sed -n "s/^\($(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')\): .*/\1/Ip" "$TMP/apps" | head -1); [ -n "$_n" ] || { echo "no app named $1 here"; return 1; }
    _l=$(desk_launch "$_n" ''); ! desk_app_term "$_n" || _l="foot -e $_l"
    _before=$(desk_windows_all)
    swaymsg -- exec "$_l" >/dev/null 2>&1 || { echo "could not open $_n"; return 1; }
    _t=0; while [ "$(desk_windows_all)" -le "$_before" ] && [ "$_t" -lt $((DESK_WAIT * 4)) ]; do sleep 0.25; _t=$((_t + 1)); done   # until its window maps and takes the focus; then the panel may go
    [ "$(desk_windows_all)" -gt "$_before" ] || { echo "$_n opened no window"; return 1; }
    : > "$TMP/opened"; echo "opened $_n"   # the mark the panel's window reads: it closes, the app has the screen
}
desk_windows_all() { swaymsg -t get_tree 2>/dev/null | jq '[.. | objects | select(.pid? != null)] | length' 2>/dev/null || echo 0; }   # -> how many windows sway shows, on every workspace
panel_layout_save() {   # panel_layout_save NAME -> what is open on the focused workspace, saved as a layout under NAME
    desk_in_sway || { echo "saving what is open needs the desktop"; return 1; }
    [ -n "$1" ] || { echo "a name for it"; return 1; }
    swaymsg -t get_tree 2>/dev/null | jq -r '.. | objects | select(.type? == "workspace" and (.. | objects | select(.focused? == true)) != null) | .. | objects | select(.app_id? != null or .window_properties? != null) | "\(.app_id // .window_properties.class)\t\(.pid // 0)"' > "$TMP/open" 2>/dev/null
    [ -s "$TMP/open" ] || { echo "nothing is open on this workspace"; return 1; }
    : > "$TMP/open.apps"
    while IFS="$TAB" read -r _id _pid; do
        _app=$_id
        if [ "$_id" = foot ] || [ "$_id" = "$PANEL_APP" ]; then   # a terminal: the program inside it, else a shell
            _child=$(pgrep -P "$_pid" 2>/dev/null | head -1); _app=$(ps -o comm= -p "${_child:-0}" 2>/dev/null | sed 's/.*\///'); case $_app in ''|sh|bash|zsh|dash|fish) _app=shell ;; esac
            [ "$_id" != "$PANEL_APP" ] || continue   # not the panel itself
        fi
        _known=$(panel_apps_known | awk -v w="$(panel_lower "$_app")" 'tolower($0) == w && !d {print; d = 1}'); [ -z "$_known" ] || _app=$_known   # the name a layout knows it by (Firefox is firefox)
        [ -z "$_app" ] || echo "$_app" >> "$TMP/open.apps"
    done < "$TMP/open"
    [ -s "$TMP/open.apps" ] || { echo "nothing is open on this workspace"; return 1; }
    _main=$(sed -n 1p "$TMP/open.apps"); _side=$(sed 1d "$TMP/open.apps" | jq -R '{app: .}' | jq -s -c .)
    _name=$(desk_name_of "$1"); [ -n "$_name" ] || { echo "a name for it, in letters"; return 1; }
    mkdir -p "$LAYOUTS_DIR"
    jq -n --arg w "$1" --arg why "saved from the screen on $(date '+%d %B %Y')" --arg m "$_main" --argjson side "${_side:-[]}" '{words: $w, why: $why, main: {app: $m}, side: $side}' > "$LAYOUTS_DIR/$_name"
    echo "saved $_name: $(paste -sd, "$TMP/open.apps" | sed 's/,/, /g')"
}
panel_undo() {   # the last group's inverse steps, played newest first, then forgotten
    [ -s "$PANEL_CACHE/undo" ] || { echo "nothing to undo"; return 1; }
    cp "$PANEL_CACHE/undo" "$TMP/undo"; rm -f "$PANEL_CACHE/undo"
    while IFS="$TAB" read -r pg step _; do   # the words are the row's, not needed here
        # shellcheck disable=SC2086   # the inverse's ACTION ARG, split on purpose
        if _l=$(panel_act "$pg" $step 2>&1); then printf '%s %s\n' "$PANEL_TICK" "$_l"; else printf '%s %s\n' "$PANEL_CROSS" "$_l"; fi
    done < "$TMP/undo"
}

# --- the step: the inverse read before the act, kept in the journal; the pick remembered
panel_inverse() {   # panel_inverse SECTION ACTION [ARG] -> "ACTION ARG<tab>WORDS" that takes the step back, or nothing when it cannot be taken back
    _p=$1; _a=$2; shift 2; _arg=$*
    case $_p:$_a in
        out:mute|mic:mute) printf 'unmute\t%s unmute\n' "$_p" ;;
        out:unmute|mic:unmute) printf 'mute\t%s mute\n' "$_p" ;;
        out:level|mic:level) if [ "$_p" = out ]; then _lv=$(snd_out | sed -n 2p); else _lv=$(snd_mic | sed -n 4p); fi
            case $_lv in ''|-) ;; *) printf 'level %s\t%s at %s%%\n' "$_lv" "$_p" "$_lv" ;; esac ;;
        out:use|mic:use) _cur=$(snd_devices "$_p" | awk -F '\t' '$2 == 1 && !d {print $1; d = 1}'); [ -z "$_cur" ] || printf 'use %s\t%s %s\n' "$_cur" "$_p" "$_cur" ;;   # the whole list read: no broken pipe
        theme:font) if [ "$_arg" = bigger ]; then printf 'font smaller\tfont smaller\n'; else printf 'font bigger\tfont bigger\n'; fi ;;
        theme:alpha) printf 'alpha %s\talpha %s\n' "$ALPHA" "$ALPHA" ;;
        theme:wallpaper) printf 'wallpaper %s\twallpaper %s\n' "$WALLPAPER" "$WALLPAPER" ;;
        theme:theme) printf '%s\ttheme %s\n' "${THEME:-none}" "${THEME:-none}" ;;
        theme:*) printf '%s\ttheme %s\n' "${THEME:-none}" "${THEME:-none}" ;;
        wifi:connect) _c=$(wifi_connected); if [ -n "$_c" ]; then printf 'connect %s\twifi %s\n' "$_c" "$_c"; else printf 'disconnect\twifi off\n'; fi ;;
        wifi:disconnect) _c=$(wifi_connected); [ -z "$_c" ] || printf 'connect %s\twifi %s\n' "$_c" "$_c" ;;
        bt:connect) printf 'disconnect %s\tbt %s off\n' "$_arg" "$_arg" ;;
        bt:disconnect) printf 'connect %s\tbt %s\n' "$_arg" "$_arg" ;;
        bt:power) if [ "$_arg" = off ]; then printf 'power on\tbt on\n'; else printf 'power off\tbt off\n'; fi ;;
    esac
}
panel_step() {   # panel_step SECTION ACTION [ARG] -> panel_act's line; a step that worked is remembered as recent, and its inverse kept for undo
    _inv=$(panel_inverse "$@")
    if panel_act "$@"; then
        case $2 in show|all|pick|chat|more|save) ;; *) panel_recent_add "$1" "$(printf '%s' "$2${3:+ $3}${4:+ $4}${5:+ $5}" | sed 's/ *$//')" ;; esac
        [ -z "$_inv" ] || printf '%s\t%s\n' "$1" "$_inv" >> "$TMP/group"
        return 0
    fi
    return 1
}
bat_dir() { for b in "$BAR_SYS"/class/power_supply/*; do [ -f "$b/capacity" ] && { [ ! -f "$b/type" ] || [ "$(cat "$b/type")" = Battery ]; } && { echo "$b"; return; }; done; }
bat_num() { cat "$(bat_dir)/$1" 2>/dev/null || :; }
bat_left() {   # -> "H:MM left" or "H:MM to full", from the kernel's energy or charge numbers; nothing when it cannot tell
    _d=$(bat_dir); [ -n "$_d" ] || return 0
    _now=$(bat_num energy_now); _full=$(bat_num energy_full); _rate=$(bat_num power_now)
    [ -n "$_now" ] || { _now=$(bat_num charge_now); _full=$(bat_num charge_full); _rate=$(bat_num current_now); }
    [ -n "$_now" ] && [ -n "$_rate" ] && [ "$_rate" -gt 0 ] 2>/dev/null || return 0
    case $(bat_num status) in
        Discharging) _m=$(( _now * 60 / _rate )); printf '%d:%02d left\n' $((_m / 60)) $((_m % 60)) ;;
        Charging) [ -n "$_full" ] && [ "$_full" -gt "$_now" ] || return 0; _m=$(( (_full - _now) * 60 / _rate )); printf '%d:%02d to full\n' $((_m / 60)) $((_m % 60)) ;;
    esac
}
cal_rows() {   # cal_rows [MARK UNMARK] -> this month, 28 cells wide: its name over the week, Sunday first, each day a cell four wide, today between MARK and UNMARK (awk: no cal, no GNU date needed)
    date '+%Y %m %d' | awk -v mark="${1:-}" -v unmark="${2:-}" '{
        y = $1; m = $2 + 0; d = $3 + 0
        split("31 28 31 30 31 30 31 31 30 31 30 31", dim, " "); if ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) dim[2] = 29
        mm = m; yy = y; if (mm < 3) { mm += 12; yy-- }; k = yy % 100; j = int(yy / 100)
        h = (1 + int(13 * (mm + 1) / 5) + k + int(k / 4) + int(j / 4) + 5 * j) % 7; w = (h + 6) % 7
        split("January February March April May June July August September October November December", mon, " ")
        title = mon[m] " " y; pad = ""; for (i = 0; i < int((28 - length(title)) / 2); i++) pad = pad " "
        print pad title; print " Su  Mo  Tu  We  Th  Fr  Sa"
        line = ""; for (i = 0; i < w; i++) line = line "    "
        for (day = 1; day <= dim[m]; day++) {
            cell = sprintf(" %2d ", day); if (day == d) cell = mark cell unmark
            line = line cell; w++; if (w == 7) { print line; line = ""; w = 0 } }
        if (line != "") print line }'
}
clock_digit() {   # clock_digit D -> five rows of a figure six cells wide in full blocks, every stroke two cells wide (D is 0-9; : is two cells wide)
    case $1 in
        0) printf '%s\n' '###' '# #' '# #' '# #' '###' ;;
        1) printf '%s\n' '  #' ' ##' '  #' '  #' '  #' ;;
        2) printf '%s\n' '###' '  #' '###' '#  ' '###' ;;
        3) printf '%s\n' '###' '  #' '###' '  #' '###' ;;
        4) printf '%s\n' '# #' '# #' '###' '  #' '  #' ;;
        5) printf '%s\n' '###' '#  ' '###' '  #' '###' ;;
        6) printf '%s\n' '###' '#  ' '###' '# #' '###' ;;
        7) printf '%s\n' '###' '  #' '  #' '  #' '  #' ;;
        8) printf '%s\n' '###' '# #' '###' '# #' '###' ;;
        9) printf '%s\n' '###' '# #' '###' '  #' '###' ;;
        :) printf '%s\n' ' ' '#' ' ' '#' ' ' ;;
    esac | sed "s/ /  /g; s/#/$BAR_FULL$BAR_FULL/g"
}
clock_rows() {   # -> the time, five rows tall and 34 cells wide, the figures two cells apart
    _t=$(date '+%H:%M')
    for _r in 1 2 3 4 5; do
        _line=''; _k=0
        while [ "$_k" -lt ${#_t} ]; do
            _c=$(printf '%s' "$_t" | cut -c$((_k + 1))); _line="$_line${_line:+  }$(clock_digit "$_c" | sed -n "${_r}p")"; _k=$((_k + 1))
        done
        printf '%s\n' "$_line"
    done
}
clock_view() {   # clock_view [MARK UNMARK] -> the time large on the left, in MARK, and this month on the right, today a chip: one block, as tall as the month (seven or eight rows)
    clock_rows > "$TMP/clock.time"; cal_rows "${1:-}${1:+$(printf '\033[7m')}" "${2:-}" > "$TMP/clock.month"
    _i=0
    while IFS= read -r _m; do
        _i=$((_i + 1)); _l=''
        [ "$_i" -lt 2 ] || [ "$_i" -gt 6 ] || _l=$(sed -n "$((_i - 1))p" "$TMP/clock.time")   # the time beside the week's names and the first four weeks
        if [ -n "$_l" ]; then printf '%s%s%s      %s\n' "${1:-}" "$_l" "${2:-}" "$_m"; else printf '%34s      %s\n' '' "$_m"; fi
    done < "$TMP/clock.month"
}
look_font_size() { printf '%s' "$FONT" | sed -n 's/.*size=\([0-9][0-9]*\).*/\1/p' | sed -n 1p; }

# --- the gate and the list as text
panel_gate() {   # panel_gate SECTION ACTION [ARG] -> the row's own ARG (exit 0), or why not (exit 1): only a step the section offers now
    if ! panel_section_ok "$1" || [ "$1" = glance ] || [ "$1" = chat ]; then if [ -n "$1" ]; then echo "no $1 here"; else echo "a step with no section"; fi; return 1; fi
    case $1:$2 in
        spark:chat|undo:all) echo ''; return 0 ;;
        layout:save) [ -n "$3" ] && { echo "$3"; return 0; }; echo "layout: save takes a name"; return 1 ;;
        layout:add) _n=$(jq -r '.suggested // [] | .[]' "$DESK_LAST" 2>/dev/null | awk -v w="$(panel_lower "$3")" 'tolower($0) == w && !d {print; d = 1}'); [ -n "$_n" ] && { echo "$_n"; return 0; }; echo "layout: $3 was not suggested for the last layout"; return 1 ;;
        apps:open) _n=$(panel_apps_known | awk -v w="$(panel_lower "$3")" 'tolower($0) == w && !d {print; d = 1}'); [ -n "$_n" ] && { echo "$_n"; return 0; }; echo "apps: no app named $3 here"; return 1 ;;
        layout:open) _n=$(desk_name_of "$3"); if [ -n "$_n" ] && [ -f "$LAYOUTS_DIR/$_n" ]; then echo "$_n"; return 0; fi; echo "layout: no saved layout named $3"; return 1 ;;
        layout:new) [ -n "$3" ] && { echo "$3"; return 0; }; echo "layout: new takes the words for it"; return 1 ;;
        apps:pick) echo ''; return 0 ;;
        out:level|mic:level) case $3 in [0-9]|[1-9][0-9]|100) echo "$3"; return 0 ;; *) echo "$1: level takes 0 to 100"; return 1 ;; esac ;;
        theme:alpha) case $3 in 1|1.0|0|0.[0-9]|0.[0-9][0-9]) echo "$3"; return 0 ;; *) echo "theme: alpha takes 0 to 1"; return 1 ;; esac ;;
    esac
    _want=$(panel_lower "$2 $3" | sed 's/ *$//')
    _m=$(panel_rows "$1" full | cut -f3 | awk -v w="$_want" 'tolower($0) == w { print; exit }')
    [ -n "$_m" ] && [ "$_m" != show ] || { echo "$1: $2${3:+ $3} is not on the panel now"; return 1; }
    printf '%s\n' "${_m#* }" | awk -v a="$2" '$0 == a { print ""; exit } { print }'
}
panel_list() {   # panel_list [SECTION] -> the glance (the clock's view under it), then the one list as text (tests, no terminal)
    SND=${SND:-$(snd_tool)}
    panel_title "$1"
    [ "$1" != clock ] || { echo; clock_view; }
    panel_stream "$1"
}

# --- the router and the want: a row is fzf's; an app named is a layout; the rest is spark's
panel_brief() {   # -> "section: action ARG, ...; section: ..." -- what spark may pick from
    for p in layout apps $(panel_blocks_here); do
        case $p in lan|bat|clock) continue ;; esac
        if [ "$p" = layout ]; then
            _saved=$(ls -A "$LAYOUTS_DIR" 2>/dev/null | sed 's/^/open /' | paste -sd, - | sed 's/,/, /g')
            _acts="${_saved:+$_saved, }new TASK"
        elif [ "$p" = apps ]; then
            [ "$OS" != Darwin ] || continue
            _acts=$(panel_apps_known | sed 's/^/open /' | paste -sd, - | sed 's/,/, /g')
        else
            _acts=$(panel_rows "$p" full | cut -f3 | grep -vx show | awk '!seen[$0]++' | paste -sd, - | sed 's/,/, /g')
            case $p in out|mic) _acts="${_acts:+$_acts, }level N" ;; esac
        fi
        [ -z "$_acts" ] || printf '%s: %s; ' "$p" "$_acts"
    done | sed 's/; $//'
}
want_names_app() {   # want_names_app WORDS -> the first word that names an app this machine declares (a desktop entry's name or command, or one you allowed), or nothing
    sbom_entries >/dev/null 2>&1 || :   # $TMP/entries
    for w in $1; do
        w=$(printf '%s' "$w" | tr -cd 'A-Za-z0-9_.-' | tr 'A-Z' 'a-z'); [ -n "$w" ] || continue
        case " sway swaybg swaymsg foot footclient xdg-open $DESK_NOT_APPS " in *" $w "*) continue ;; esac
        if [ -s "$TMP/entries" ] && awk -F '\t' -v w="$w" 'tolower($1) == w { f = 1 } { split($6, a, " "); b = a[1]; sub(/.*\//, "", b); if (tolower(b) == w) f = 1 } END { exit !f }' "$TMP/entries"; then echo "$w"; return 0; fi
        if apps_marked && grep -iq "^$w\([: ]\|$\)" "$APPS"; then echo "$w"; return 0; fi
    done
    return 1
}
want_is_question() {   # want_is_question WORDS -> 0 when the words ask something (a question mark, or a question's first word)
    case $1 in *'?') return 0 ;; esac
    case " $(printf '%s' "$1" | tr 'A-Z' 'a-z' | cut -d' ' -f1) " in ' what '|' how '|' why '|' when '|' where '|' who '|' which '|' is '|' are '|' can '|' could '|' do '|' does '|' did '|' will '|' should '|' was '|' were ') return 0 ;; *) return 1 ;; esac
}
want_layout() { ( [ "$OS" = Darwin ] || pm_detect; REFUSE_AS=layout; desk_need "$1" ) || :; }   # want_layout WORDS -- a layout for the task, by the layout's own model
want_play() {   # want_play WORDS -> one line per step with its sign, or the answer to a question; an app named is a layout first
    command -v jq >/dev/null 2>&1 || { echo "jq is not installed (spark-shell on)"; return 1; }
    spark=$(spark_bin); [ -n "$spark" ] || { echo "spark is not installed -- spark reads what you want (github.com/forgewright-ai/spark)"; return 1; }
    SND=${SND:-$(snd_tool)}
    if _app=$(want_names_app "$1"); then   # the machine's own word: an app named opens, or is a layout for the task; never a question for the model
        if [ "$(printf '%s\n' "$1" | wc -w | tr -d ' ')" -le 2 ] && [ "$(desk_words_full "$1")" = false ] && [ -z "$(desk_words_ws "$1")" ]; then   # a word or two and no layout word: the app itself, at once
            if _l=$(panel_step apps open "$(panel_apps_known | awk -v w="$_app" 'tolower($0) == w && !d {print; d = 1}')" 2>&1); then printf '%s %s\n' "$PANEL_TICK" "$_l"; else printf '%s %s\n' "$PANEL_CROSS" "$_l"; fi
        else want_layout "$1"; fi   # the layout's model reads the whole sentence: the workspace, fullscreen, the pages
        return 0
    fi
    _brief=$(panel_brief)
    [ -n "$_brief" ] || { echo "nothing on the panel takes an action on this machine"; return 1; }
    about="The panel of a desktop. What the bar shows now: $(panel_facts). What this machine can do now, by section -- $_brief. Rules: only steps from that list; N is a number (0 to 100 for level, 0 to 1 for alpha), NAME a name as listed, TASK the want in the user's own words, as {\"page\": \"layout\", \"action\": \"new\", \"arg\": \"write notes\"}, which opens the apps for that task, any program by name included; a layout step for a want that names a program or a task to do, never for a setting alone; as few steps as the want takes; no step when nothing on the list does it; when the words ask something rather than ask for a change, put the answer in \"answer\", one or two sentences, and give no steps. Answer with one JSON object and nothing else: {\"why\": \"one sentence\", \"answer\": \"\", \"steps\": [{\"page\": \"bt\", \"action\": \"connect\", \"arg\": \"NAME\"}]}"
    st=0; "$spark" edit --type json --name panel.json --about "$about" -- "do this on the desktop: $1" </dev/null > "$TMP/want.json" 2>"$TMP/want.err" || st=$?
    [ "$st" -eq 0 ] || { echo "$PANEL_CROSS spark did not answer: $(head -1 "$TMP/want.err")"; return 1; }
    jq -e '.steps | arrays' "$TMP/want.json" >/dev/null 2>&1 || { echo "$PANEL_CROSS the answer was not steps for the panel"; return 1; }
    if [ "$(jq -r '.steps | length' "$TMP/want.json")" -eq 0 ]; then   # the model's why is not shown: the steps say it; a question gets its answer
        _ans=$(jq -r '.answer // "" | gsub("[\\n\\r]+"; " ")' "$TMP/want.json")
        if want_is_question "$1"; then if [ -n "$_ans" ]; then printf '%s\n' "$_ans"; else echo "nothing here answers that"; fi
        else want_layout "$1"; fi   # not a question and no step: a task, then -- the layout's own model reads it (never a shrug for "writing with vi")
        return 0
    fi
    jq -r '.steps[] | [(.page // "" | tostring), (.action // "" | tostring), (.arg // "" | tostring)] | @tsv' "$TMP/want.json" | while IFS="$TAB" read -r pg ac ar; do
        if arg=$(panel_gate "$pg" "$ac" "$ar"); then
            # shellcheck disable=SC2086   # the row's own ARG, split on purpose
            if _l=$(panel_step "$pg" "$ac" $arg 2>&1); then printf '%s %s\n' "$PANEL_TICK" "$_l"; else printf '%s %s\n' "$PANEL_CROSS" "$_l"; fi
        else printf '%s %s\n' "$PANEL_CROSS" "$arg"; fi
    done
}
bar_want() {   # bar_want WORDS -- from the shell: `spark-shell panel "mute everything"` (and the old `bar "WORDS"`)
    [ -n "$(spark_bin)" ] || refuse_in panel "spark is not installed -- spark reads what you want (github.com/forgewright-ai/spark)"
    printf 'panel> %s\n' "$1"
    panel_group_begin
    st=0; want_play "$1" > "$TMP/want.out" 2>&1 || st=$?
    panel_group_end
    sed 's/^/  /' "$TMP/want.out"
    return "$st"
}

# --- the window: centred by the sway template, closed by Esc or by its key again
panel_quit() { kill "${FZF:-}" 2>/dev/null || :; panel_tick_stop; panel_pulse_kill; stty echo 2>/dev/null || :; }
panel_tick_start() {   # panel_tick_start ROW -- the time's five rows drawn again at ROW as each minute turns, the cursor put back, until panel_tick_stop; silent on a pipe
    [ -t 1 ] || return 0
    _row=$1
    ( while :; do
        _s=$(date +%S); _s=${_s#0}; sleep $((60 - ${_s:-0}))
        _r=$_row; clock_rows | while IFS= read -r _l; do printf '\0337\033[%s;%sH%s%s%s\0338' "$_r" "$((PANEL_IN + 1))" "$PANEL_MARK" "$_l" "$PANEL_UNMARK"; _r=$((_r + 1)); done
      done ) &
    TICK=$!
}
panel_tick_stop() { [ -z "${TICK:-}" ] || { kill "$TICK" 2>/dev/null || :; wait "$TICK" 2>/dev/null || :; TICK=''; }; }
panel_full_aside() {   # a window fullscreen on the panel's workspace steps aside, and the panel is focused over it (sway draws nothing but a dialog over a fullscreen window); FULL_ID remembers it for panel_full_back
    FULL_ID=$(swaymsg -t get_tree 2>/dev/null | jq -r --argjson p "$PPID" '[.. | objects | select(.type? == "workspace") | select([.. | objects | select(.pid? == $p)] | length > 0) | .. | objects | select((.type? == "con" or .type? == "floating_con") and (.fullscreen_mode? // 0) > 0 and .pid? != $p) | .id] | first // empty' 2>/dev/null)   # a window or a container, never the workspace (it says fullscreen too)
    [ -n "$FULL_ID" ] || return 0
    swaymsg -- "[con_id=$FULL_ID] fullscreen disable" >/dev/null 2>&1 || { FULL_ID=''; return 0; }
    swaymsg -- "[app_id=$PANEL_APP] focus" >/dev/null 2>&1 || :
}
panel_full_back() {   # the window that stepped aside is fullscreen again, unless a pick put a window on the screen
    [ -n "${FULL_ID:-}" ] && [ ! -f "$TMP/opened" ] || return 0
    swaymsg -- "[con_id=$FULL_ID] fullscreen enable" >/dev/null 2>&1 || :
}
panel_reload() {   # the settings again, as a pick may have changed them (a palette, the font): the config, the palette's hex, the panel's shades and signs
    config_load
    for _k in $THEME_KEYS; do unset "$_k"; done   # a palette gone (theme none) leaves no file to read: the defaults again, not the old one
    theme_load; panel_colours
}
panel_paint() {   # the panel's own window takes the palette and the surface as the settings say now: a theme step repaints every terminal flat, this one included
    ! osc_render "${THEME:-none}" || cat "$TMP/osc"
    printf '\033]11;#%s\033\\' "$PANEL_BG"
}
panel_pulse_kill() { [ -f "$TMP/pulse.pid" ] && kill "$(cat "$TMP/pulse.pid")" 2>/dev/null; rm -f "$TMP/pulse.pid"; :; }   # a march left by a list that fzf stopped reading
panel_chat_why() {   # -> why there is no chat here, or nothing
    [ -n "$(spark_bin)" ] || echo "spark is not installed, so there is no chat (github.com/forgewright-ai/spark)"
}
panel_chat() {   # spark chat takes this window (Super+s, the spark row): the palette's exports first; without spark, one line that waits to be read
    _why=$(panel_chat_why)
    if [ -n "$_why" ]; then echo "$_why"; printf 'Enter closes '; IFS= read -r _ || true; return 0; fi
    # shellcheck disable=SC1091   # our own render, when there is one
    [ ! -f "$CONFIG_DIR/sgr.sh" ] || . "$CONFIG_DIR/sgr.sh"
    stty echo 2>/dev/null || :
    rm -rf "$TMP"; trap - EXIT; exec "$(spark_bin)" chat
}
panel_open_count() {   # -> how many panel windows a running sway shows (0 without sway)
    [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1 || { echo 0; return 0; }
    swaymsg -t get_tree 2>/dev/null | jq -r --arg a "$PANEL_APP" '[.. | objects | select(.app_id? == $a)] | length' 2>/dev/null || echo 0
}
panel_warm() {   # panel_warm SECTION -- a slow section that opened the panel is probed first, whole, with the march on the status row
    case $1 in wifi) panel_fresh wifi.scan 60 || { pulse_start march 'looking around' "$2"; wifi_scan >/dev/null; pulse_stop "$2"; } ;; esac
}
panel_stream_live() {   # panel_stream_live FIRST ROW -> panel_stream, with the march at ROW while the slow sections look; the list fills in place
    _slow=''
    for s in $(panel_sections "$1"); do
        if [ "$s" != "$1" ] && [ "$(panel_cost "$s")" = slow ] && ! panel_fresh wifi.scan 60; then _slow="$_slow $s"; continue; fi
        panel_section_rows "$s" "$1"
    done
    [ -n "$_slow" ] || return 0
    pulse_start march 'looking around' "$2" >/dev/tty 2>/dev/null; echo "${PULSE:-}" > "$TMP/pulse.pid"
    for s in $_slow; do panel_section_rows "$s" "$1"; done
    pulse_stop "$2" >/dev/tty 2>/dev/null; rm -f "$TMP/pulse.pid"
}
panel_run() {   # panel_run KIND CMD... -> CMD's lines as they land under the glance, the pulse of KIND beneath them until CMD ends; the lines stay in $TMP/run.out
    _kind=$1; shift
    : > "$TMP/run.out"
    "$@" > "$TMP/run.out" 2>&1 & _w=$!
    if [ -t 1 ]; then
        _n=0; i=0; _t0=$(date +%s); _in=$(printf "%${PANEL_IN}s" '')
        while kill -0 "$_w" 2>/dev/null; do
            _m=$(grep -c '' "$TMP/run.out" || :)
            while [ "$_n" -lt "$_m" ]; do _n=$((_n + 1)); printf '\r\033[2K%s%s\n' "$_in" "$(panel_line_sign "$(sed -n "${_n}p" "$TMP/run.out")")"; done
            printf '\r\033[2K%s%s' "$_in" "$(pulse_line "$_kind" "$i" "$_t0")"; i=$((i + 1)); sleep 0.35
        done
        printf '\r\033[2K'
    fi
    wait "$_w"
}
panel_own_window() {   # the terminal is the panel's own window: foot is our parent, under a running sway, and its window carries the panel's app id
    [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1 || return 1
    _c=$(cat "/proc/$PPID/comm" 2>/dev/null || ps -o comm= -p "$PPID" 2>/dev/null); [ "${_c##*/}" = foot ] || return 1
    _i=0
    while :; do   # foot maps its window a moment after it starts us: up to a second for the tree to show it
        _a=$(swaymsg -t get_tree 2>/dev/null | jq -r --argjson p "$PPID" '[.. | objects | select(.pid? == $p) | .app_id // empty] | first // empty' 2>/dev/null)
        [ -z "$_a" ] && [ "$_i" -lt 10 ] || break
        sleep 0.1; _i=$((_i + 1))
    done
    [ "$_a" = "$PANEL_APP" ]
}
panel_fzf_new() { fzf --version 2>/dev/null | awk '{ split($1, v, "."); exit !(v[1] > 0 || v[2] >= 54) }'; }   # fzf 0.54 or newer: the picked row lit across, no pointer cell
panel_fzf() {   # panel_fzf HEIGHT -- the list, the hint and the prompt in HEIGHT rows: the rows in from the edge, the picked row lit across the window, the prompt at the foot; stdin the rows, stdout the query and the pick
    _c="fg:-1,bg:-1,fg+:-1,bg+:#$PANEL_HI,hl:#$HEX_ACCENT,hl+:#$HEX_ACCENT,prompt:#$HEX_ACCENT,header:#$PANEL_MUTED,gutter:-1,query:-1,scrollbar:#$HEX_MUTED"
    _h=$1
    if panel_fzf_new; then set -- --highlight-line --pointer '' --marker '' --padding "0,0,0,$((PANEL_IN - 2))"
    else set -- --pointer ' ' --padding "0,0,0,$((PANEL_IN - 3))"; fi
    fzf --delimiter "$TAB" --with-nth 1 --print-query --exact --ansi --layout=reverse-list --no-info --no-separator --color="$_c" \
        --prompt "$PANEL_PROMPT " --header "$(printf ' \n%s' "$(panel_hint)")" --height="$_h" "$@"
}
panel_loop() {   # panel_loop SECTION -- the window: the glance, the receipt, the list streamed into fzf under the hint and the prompt; a pick or words, then again with the settings read anew; gone once a pick put a window on the screen
    panel_colours
    ASKED=1; export ASKED   # a layout asked here: its window follows the layout, and the layout> line is not repeated
    FZF=''; PULSE=''; TICK=''; FULL_ID=''
    trap 'panel_quit; panel_full_back; rm -rf "$TMP"' EXIT
    trap 'trap "" TERM INT HUP; kill "${FZF:-}" 2>/dev/null || :; exit 0' TERM INT HUP   # the window closed under us: one signal is enough, a second must not cut the leaving short
    what=$1; said=''; own=''; ! panel_own_window || { own=yes; panel_full_aside; }
    while :; do
        cols=$(tput cols 2>/dev/null || echo 76); [ "$cols" -ge 24 ] 2>/dev/null || cols=76   # read each time: a font step changes the cells
        lines=$(tput lines 2>/dev/null || echo 36); [ "$lines" -ge 12 ] 2>/dev/null || lines=36
        width=$((cols - PANEL_IN)); PULSE_COL=$((PANEL_IN + 1))   # the text's width, and the column the march draws at
        [ -z "$own" ] || panel_paint
        printf '\033[2J\033[H\n'   # a row of air on top, as at the sides
        panel_glance "$width" > "$TMP/glance"; panel_indent < "$TMP/glance"
        n=$(( $(grep -c '' "$TMP/glance" || :) + 1 ))
        if [ -n "$said" ]; then   # the receipt: what the last pick or want did, a blank over it
            echo; printf '%s\n' "$said" | fold -s -w "$width" > "$TMP/receipt"
            while IFS= read -r _r; do panel_line_sign "$_r"; echo; done < "$TMP/receipt" | panel_indent
            n=$((n + 1 + $(grep -c '' "$TMP/receipt" || :)))
        fi
        status_row=$((n + 1)); echo   # the status row: the march while something looks around
        panel_warm "$what" "$status_row"
        h=$((lines - n - 2)); [ "$h" -ge 6 ] || h=6   # the list fills the rest, the hint and the prompt at the foot, a row of air under them
        panel_tick_start $(( $(grep -nF "$BAR_FULL" "$TMP/glance" | head -1 | cut -d: -f1) + 1 ))   # the time's first row: the glance's first row with a stroke, under the air
        panel_stream_live "$what" "$status_row" | panel_fzf "$h" > "$TMP/sel" 2>/dev/null & FZF=$!
        st=0; wait "$FZF" || st=$?
        FZF=''; panel_tick_stop; panel_pulse_kill
        [ "$st" -lt 128 ] || break   # Esc, Ctrl-C, or the window was closed
        q=$(sed -n 1p "$TMP/sel"); s=$(sed -n 2p "$TMP/sel")
        rm -f "$TMP/opened"
        if [ -n "$s" ]; then
            # shellcheck disable=SC2086   # the row's SECTION ACTION ARG, split on purpose
            set -- ${s#*"$TAB"}; pg=$1; a=$2; shift 2
            case $pg:$a in
                spark:chat) _why=$(panel_chat_why); [ -n "$_why" ] || { panel_quit; panel_chat; }; said=$_why ;;   # exec: the conversation takes the window
                *:more) what=$pg; said='' ;;   # the section in full
                *:show) ;;
                layout:save) printf 'a name for it: '; IFS= read -r _nm </dev/tty || _nm=''; [ -n "$_nm" ] || { said="not saved: no name"; continue; }
                   if panel_run march panel_step layout save "$_nm"; then said="$PANEL_TICK $(cat "$TMP/run.out")"; else said="$PANEL_CROSS $(cat "$TMP/run.out")"; fi ;;
                *) kind=march; [ "$pg" != layout ] || kind=steps
                   panel_group_begin
                   if panel_run "$kind" panel_step "$pg" "$a" "$@"; then said="$PANEL_TICK $(cat "$TMP/run.out")"; else said="$PANEL_CROSS $(cat "$TMP/run.out")"; fi
                   panel_group_end ;;
            esac
        elif [ -n "$q" ]; then panel_group_begin; panel_run think want_play "$q" || :; panel_group_end; said=$(cat "$TMP/run.out")   # words that matched no row: a want
        fi
        if [ -f "$TMP/opened" ]; then   # an app or a layout came up for it: the window is the receipt, and the panel is out of its way
            printf '\033[2J\033[H\n'; printf '%s\n' "$said" | while IFS= read -r _r; do panel_line_sign "$_r"; echo; done | panel_indent
            break
        fi
        panel_reload
    done
}
panel_hint() { printf 'Pick an option, or say what you would like.'; }   # the one line under the list

# --- the verb and the click
cmd_panel() {   # cmd_panel [SECTION] [--list | ACTION [ARG...]] | chat | "WORDS" -- Super+d, Super+s (chat), a click on a block, the tests, a step by hand
    config_load
    command -v jq >/dev/null 2>&1 || refuse_in panel "jq is not installed (spark-shell on)"
    [ "$OS" = Darwin ] || pm_detect
    theme_load; SND=''; [ "$OS" = Darwin ] || SND=$(snd_tool)   # on macOS the panel holds the chat and the layouts: the desktop is the Mac's own
    case ${1:-} in
        chat) [ "$(panel_open_count)" -lt 2 ] || { swaymsg "[app_id=$PANEL_APP] kill" >/dev/null 2>&1 || :; return 0; }   # the key again: a panel already open goes
              panel_chat; return ;;
        ''|--list) what=glance ;;
        -*) refuse_in panel "$1 is not an option here: a section ($(printf '%s' "$PANEL_ORDER $PANEL_LOOKS" | sed 's/ /, /g')), --list, or words for what you would like" ;;
        *) what=$1; shift; [ "$what" != look ] || what=theme   # look: the block's old word
           panel_section_ok "$what" || { bar_want "$what${1:+ $*}"; return; } ;;   # any other words: a want
    esac
    case ${1:-} in
        --list) panel_list "$what"; return 0 ;;
        '') ;;
        *) a=$1; shift; arg=$(panel_gate "$what" "$a" "$*") || { echo "spark-shell panel: $arg"; exit 1; }
           panel_group_begin
           # shellcheck disable=SC2086   # the row's own ARG, split on purpose
           panel_step "$what" "$a" $arg; st=$?
           panel_group_end; return "$st" ;;
    esac
    if { [ -t 0 ] || [ -n "${SPARK_SHELL_TEST_TTY:-}" ]; } && command -v fzf >/dev/null 2>&1; then   # the tests drive the window with an fzf of their own
        # the key pressed again: this window is the second panel, so both go (a click on a block closed the old one before opening)
        [ "$(panel_open_count)" -lt 2 ] || { swaymsg "[app_id=$PANEL_APP] kill" >/dev/null 2>&1 || :; return 0; }
        panel_loop "$what"
    else panel_list "$what"; fi
}
bar_panel_open() {   # bar_panel_open BLOCK -- from a click: the panel with that block first; a panel already open goes first, and is gone before the new one looks
    command -v foot >/dev/null 2>&1 || return 0
    if [ -n "${SWAYSOCK:-}" ]; then
        swaymsg "[app_id=$PANEL_APP] kill" >/dev/null 2>&1 || :
        _i=0; while [ "$_i" -lt 10 ] && [ "$(panel_open_count)" -gt 0 ]; do sleep 0.1; _i=$((_i + 1)); done
    fi
    lead=''; ! command -v setsid >/dev/null 2>&1 || lead=setsid
    PANEL_LEAD=$lead panel_foot "$1" >/dev/null 2>&1 </dev/null &
}

# ---------------------------------------------- verbs: theme, font, quiet
# Each writes its key in the config and applies it now, the same steps
# `on` runs; bare, each says what is set. A refusal is one sentence and
# exit 1, before the config is touched.
refuse_in() { echo "spark-shell $1: $2"; exit 1; }   # refuse_in VERB SENTENCE
seat_on() { _r=$(rc_files); _r=${_r%% *}; [ -L "$HOME/$_r" ] && [ "$(readlink "$HOME/$_r")" = "$(rc_tree)/$_r" ]; }
look_follow() {   # after a palette change: the renders follow while the seat is on
    seat_on || return 0
    render_all
    [ "$MODE" = dry ] || { tmux_reload; theme_seen; }
}
verb_close() {   # the last line of a verb: the count on a dry run, the sentence when all of it held
    if [ "$MODE" = dry ]; then dry_close
    elif [ "$todos" -gt 0 ]; then echo "Not all of it is done: the todo rows above say what is left."
    else echo "$1"; fi
}

cmd_theme() {   # theme [NAME|none|list|show]
    config_load
    case ${1:-show} in
        show) [ $# -le 1 ] || refuse_in theme "show takes no word"; theme_show; return ;;
        list) [ $# -le 1 ] || refuse_in theme "list takes no word"; theme_list; return ;;
    esac
    [ $# -eq 1 ] || refuse_in theme "one palette at a time: spark-shell theme NAME"
    name=$1
    if [ "$name" != none ]; then
        palette_file "$name" >/dev/null || refuse_in theme "no palette named $name -- spark-shell theme list shows them"
        palette_render "$name" || refuse_in theme "$(cat "$TMP/palette.why")"
    fi
    pm_detect
    [ "$MODE" = dry ] || [ "$THEME" = "$name" ] || config_set THEME "$name"
    THEME=$name; export THEME
    theme_files
    look_follow
    if [ "$name" = none ]; then palette_off all; terminal_off
    else palette_boot; terminal_apply; fi
    console_now
    theme_repaint "$name"
    if [ "$name" = none ]; then verb_close "No palette: the console and the terminal use their own colours."
    else verb_close "The palette is $name. A program that is already running, such as btop, takes it when it starts again."; fi
}
theme_show() {
    if [ -z "$THEME" ]; then echo "theme  unset: the palette stays as it is (spark-shell theme list shows them)"
    else echo "theme  $THEME ($CONFIG)"; fi
    if [ -f "$THEME_ENV" ]; then src=$THEME_ENV
    elif [ -n "$THEME" ] && [ "$THEME" != none ]; then src=$(palette_file "$THEME") || src=''
    else src=''; fi
    if [ -z "$src" ]; then echo "  none: the console's and the terminal's own colours"; return 0; fi
    for k in BG FG ACCENT MUTED; do printf '  %-8s %s\n' "$(printf '%s' "$k" | tr 'A-Z' 'a-z')" "$(palette_get "$src" "THEME_$k")"; done
    row8() { _l=''; for n in "$@"; do _l="$_l $(palette_get "$src" "THEME_ANSI_$n")"; done; printf '%s' "${_l# }"; }
    printf '  %-8s %s\n' ansi "$(row8 0 1 2 3 4 5 6 7)" bright "$(row8 8 9 10 11 12 13 14 15)"
    [ "$src" != "$THEME_ENV" ] || printf '  %-8s %s\n' files "theme.env and console-colors, written from the palette"
}
theme_list() {
    echo "The palettes (yours in $PALETTE_DIR come first):"
    { echo none; palette_names; } | while IFS= read -r n; do
        note=''
        case $n in none) note="the console's and the terminal's own colours" ;; esac
        [ ! -f "$PALETTE_DIR/$n.env" ] || note=yours
        [ "$n" != "${THEME:-}" ] || note="${note:+$note, }current"
        printf '  %-20s %s\n' "$n" "$note"
    done
    echo "spark-shell theme NAME uses one everywhere."
}

cmd_font() {   # font [FACE SIZE|list|none]
    config_load
    pm_detect
    case ${1:-show} in
        show) [ $# -le 1 ] || refuse_in font "show takes no word"; font_show; return ;;
        list) [ $# -le 1 ] || refuse_in font "list takes no word"; font_list; return ;;
        none)
            [ $# -eq 1 ] || refuse_in font "none takes no word"
            [ "$MODE" = dry ] || [ -z "$CONSOLE_FONT" ] || config_set CONSOLE_FONT ''
            CONSOLE_FONT=''
            if [ "$OS" = Darwin ]; then terminal_apply; else font_off; fi
            verb_close "The console keeps its own font."; return ;;
    esac
    [ $# -eq 2 ] || refuse_in font "a face and a size: spark-shell font FACE SIZE (spark-shell font list shows them)"
    face=$1; size=$2
    printf '%s' "$face" | grep -qE '^[A-Za-z0-9._-]+$' || refuse_in font "$face is not a font name (spark-shell font list shows them)"
    if [ "$OS" = Darwin ]; then
        printf '%s' "$size" | grep -qE '^[0-9]{1,2}(\.[0-9])?$' && [ "${size%%.*}" -ge 6 ] && [ "${size%%.*}" -le 72 ] \
            || refuse_in font "$size is not a size: points on macOS, 6 to 72 (13)"
        mac_face_here "$face" || refuse_in font "no font named $face is installed here (spark-shell font list shows them)"
    else
        is_wsl && refuse_in font "WSL has no console: the font is Windows Terminal's."
        [ -n "$(console_shape)" ] || refuse_in font "this Linux has no console-setup, vconsole.conf or rc.conf."
        printf '%s' "$size" | grep -qE '^[0-9]+x[0-9]+$' || refuse_in font "$size is not a size: WxH on the console (16x32)"
        console_fonts > "$TMP/fonts"
        if [ -s "$TMP/fonts" ]; then
            grep -q "^$face " "$TMP/fonts" || refuse_in font "no console font named $face here (spark-shell font list shows them)"
            grep -qx "$face $size" "$TMP/fonts" || refuse_in font "$face comes in $(sed -n "s/^$face //p" "$TMP/fonts" | paste -sd' ' -), not $size"
        fi
    fi
    [ "$MODE" = dry ] || [ "$CONSOLE_FONT" = "$face $size" ] || config_set CONSOLE_FONT "$face $size"
    CONSOLE_FONT="$face $size"; export CONSOLE_FONT
    if [ "$OS" = Darwin ]; then
        [ -f "$THEME_ENV" ] && [ -n "$THEME" ] && [ "$THEME" != none ] \
            || { verb_close "On a Mac the font is part of the Terminal.app profile, which spark-shell theme NAME makes."; return 0; }
        terminal_apply
    else
        font_apply
    fi
    verb_close "The console's font is $face $size."
}
font_show() {
    if [ "$OS" = Darwin ]; then
        set -- $CONSOLE_FONT
        echo "font  ${1:-Menlo-Regular} ${2:-13}: Terminal.app's profile$([ -n "$CONSOLE_FONT" ] || printf ' (the default)')"
    elif is_wsl; then echo "font  WSL has no console: the font is Windows Terminal's"
    elif [ -z "$(console_shape)" ]; then echo "font  there is no console-setup, vconsole.conf or rc.conf here"
    elif [ -z "$CONSOLE_FONT" ]; then echo "font  unset: the console keeps its font (spark-shell font list shows the faces)"
    else echo "font  $CONSOLE_FONT ($(font_file "$(console_shape)"))"; fi
}
font_list() {
    if [ "$OS" = Darwin ]; then
        echo "The monospace faces here, by PostScript name (the size is points, 13):"
        for f in $MAC_FACES; do mac_face_here "$f" && printf '  %s\n' "$f"; done
        echo "Font Book shows any other font's PostScript name."
        return 0
    fi
    is_wsl && { echo "WSL has no console: the font is Windows Terminal's."; return 0; }
    shape=$(console_shape)
    [ -n "$shape" ] || { echo "There is no console-setup, vconsole.conf or rc.conf here."; return 0; }
    console_fonts > "$TMP/fonts"
    if [ ! -s "$TMP/fonts" ]; then echo "No console fonts under /usr/share/kbd/consolefonts or /usr/share/consolefonts."; return 0; fi
    echo "The console fonts in $(consolefonts_dir), as spark-shell font takes them:"
    awk '{ s[$1] = s[$1] " " $2 } END { for (f in s) printf "  %-24s%s\n", f, s[f] }' "$TMP/fonts" | sort
    echo "spark-shell font FACE SIZE puts one in $(font_file "$shape")."
}

cmd_quiet() {   # quiet [login|boot [on|off]]
    config_load
    pm_detect
    case ${1:-} in
        '') quiet_show login; quiet_show boot; return ;;
        login|boot) ;;
        *) refuse_in quiet "$1 is not known here (login or boot)" ;;
    esac
    what=$1
    case ${2:-} in
        '') quiet_show "$what"; return ;;
        on|off) [ $# -eq 2 ] || refuse_in quiet "one switch at a time: spark-shell quiet $what on|off" ;;
        *) refuse_in quiet "$2 is not known here (on or off)" ;;
    esac
    [ "$OS" != Darwin ] || refuse_in quiet "macOS has no login notice or boot menu to quiet."
    if [ "$what" = boot ] && [ "$2" = on ]; then
        why=$(boot_refusal "$(boot_shape)"); [ -z "$why" ] || refuse_in quiet "$why"
        boot_warning "$(boot_shape)"
    fi
    if [ "$2" = on ]; then val=yes; else val=no; fi
    if [ "$what" = login ]; then
        [ "$MODE" = dry ] || [ "$QUIET_LOGIN" = "$val" ] || config_set QUIET_LOGIN "$val"
        QUIET_LOGIN=$val; export QUIET_LOGIN; login_apply
    else
        [ "$MODE" = dry ] || [ "$QUIET_BOOT" = "$val" ] || config_set QUIET_BOOT "$val"
        QUIET_BOOT=$val; export QUIET_BOOT; boot_apply
    fi
    case $what$val in
        loginyes) verb_close "The login is quiet: a bare login prompt from the next login." ;;
        loginno) verb_close "The login is as the distro made it from the next login." ;;
        bootyes) verb_close "The boot is quiet from the next boot." ;;
        *) verb_close "The boot is as the distro made it from the next boot." ;;
    esac
}
quiet_show() {   # quiet_show login|boot -- one row
    if [ "$OS" = Darwin ]; then printf '%-6s na: macOS has no login notice or boot menu to quiet\n' "$1"; return 0; fi
    if [ "$1" = login ]; then
        if [ "$QUIET_LOGIN" = yes ]; then echo "login  on: a bare login prompt, no notice, no kernel line"
        else echo "login  off: the distro's notice and the kernel line (spark-shell quiet login on)"; fi
        return 0
    fi
    why=$(boot_refusal "$(boot_shape)")
    if [ -n "$why" ]; then echo "boot   na: $why"
    elif [ "$QUIET_BOOT" = yes ]; then echo "boot   on: no boot menu, no kernel messages"
    else echo "boot   off: the boot menu and the kernel's messages (spark-shell quiet boot on)"; fi
}

# check and status: the three console rows, ok|warn|fail, a remedy each
check_theme() {
    if [ -z "$THEME" ]; then chk theme ok "na (THEME unset: the palette stays as it is -- spark-shell theme NAME)"; return; fi
    if [ "$THEME" = none ]; then
        if [ -f "$THEME_ENV" ]; then chk theme fail "THEME=none, but theme.env is here" "spark-shell on"
        elif console_linux && { [ -e "$ROOT/$CONSOLE_UNIT" ] || [ -n "$(marked "$ROOT/etc/rc.local" "$PALETTE_MARK")" ]; }; then
            chk theme fail "THEME=none, but a palette is still set at boot" "spark-shell on"
        else chk theme ok "none: the console's and the terminal's own colours"; fi
        return
    fi
    if ! palette_render "$THEME"; then chk theme fail "THEME=$THEME: $(cat "$TMP/palette.why")" "spark-shell theme list"; return; fi
    cmp -s "$TMP/theme.env" "$THEME_ENV" || { chk theme fail "$THEME: theme.env is not the palette's" "spark-shell on"; return; }
    if [ "$OS" = Darwin ]; then
        set -- $CONSOLE_FONT
        if [ "$(cat "$TERMINAL_SEEN" 2>/dev/null)" != "$(cksum < "$THEME_ENV" | cut -d' ' -f1) ${1:-Menlo-Regular} ${2:-13}" ]; then
            chk theme warn "$THEME: Terminal.app's profile is not the palette's yet" "spark-shell on"; return
        fi
        terminal_has || { chk theme warn "$THEME: Terminal.app has no spark-shell profile" "spark-shell on"; return; }
        chk theme ok "$THEME: theme.env and Terminal.app's profile are current"; return
    fi
    if console_linux; then
        { cmp -s "$TMP/console-colors" "$CONSOLE_COLORS" && cmp -s "$TMP/console-colors.rgb" "$CONSOLE_RGB"; } \
            || { chk theme fail "$THEME: console-colors is not the palette's" "spark-shell on"; return; }
        case $(init_shape) in
            systemd) unit_render
                { cmp -s "$TMP/unit" "$ROOT/$CONSOLE_UNIT" && unit_enabled spark-shell-console.service; } \
                    || { chk theme fail "$THEME: spark-shell-console.service does not set it at boot" "spark-shell on (sudo once)"; return; } ;;
            runit) [ "$(marked "$ROOT/etc/rc.local" "$PALETTE_MARK")" = "$(palette_line)" ] \
                    || { chk theme fail "$THEME: no line in /etc/rc.local sets it at boot" "spark-shell on (sudo once)"; return; } ;;
        esac
        if vt_here && [ "$(vt_live)" != "$(head -1 "$CONSOLE_RGB")" ]; then
            chk theme warn "$THEME: the console uses another palette until the next boot" "spark-shell on"; return
        fi
    fi
    chk theme ok "$THEME: theme.env and the console's palette are current"
}
check_font() {
    if [ -z "$CONSOLE_FONT" ]; then chk font ok "na (CONSOLE_FONT unset: the console keeps its font)"; return; fi
    if [ "$OS" = Darwin ]; then chk font ok "$CONSOLE_FONT in Terminal.app's profile"; return; fi
    if is_wsl; then chk font ok "na (WSL has no console)"; return; fi
    shape=$(console_shape)
    if [ -z "$shape" ]; then chk font warn "no console-setup, vconsole.conf or rc.conf here" "spark-shell font none"; return; fi
    if [ "$(font_now "$shape")" = "$(font_want "$shape")" ]; then chk font ok "$CONSOLE_FONT ($(font_file "$shape"))"
    else chk font fail "$(font_file "$shape") says $(font_now "$shape")" "spark-shell on (sudo once)"; fi
}
check_quiet() {
    if [ "$OS" = Darwin ]; then chk quiet ok "na (macOS)"; return; fi
    st=ok; say=''
    if [ "$QUIET_LOGIN" = yes ]; then
        if login_quiet; then say="login quiet"; else say="login loud"; st=fail; fi
    elif login_traces; then say="login still quiet (QUIET_LOGIN=no)"; st=fail
    else say="login loud"; fi
    shape=$(boot_shape); kind=$(boot_kind "$shape")
    if [ "$QUIET_BOOT" = yes ]; then
        case $shape in
            wsl) say="$say, boot na (WSL)" ;;
            arch) say="$say, boot na (no unified kernel image)" ;;
            nogrub) say="$say, boot na (no GRUB)" ;;
            *)
                if ! boot_quiet "$shape"; then say="$say, boot loud"; st=fail
                elif pending_has "$kind"; then say="$say, boot quiet but its rebuild failed"; st=fail
                elif [ "$kind" = grub ] && [ -r "$ROOT/boot/grub/grub.cfg" ] && ! grep -q 'loglevel=3' "$ROOT/boot/grub/grub.cfg"; then say="$say, boot loud (grub.cfg lacks the quiet line)"; st=fail
                elif [ -r "$ROOT/proc/cmdline" ] && ! grep -q 'loglevel=3' "$ROOT/proc/cmdline"; then
                    say="$say, boot quiet after a reboot"; [ "$st" = fail ] || st=warn
                else say="$say, boot quiet"; fi ;;
        esac
    elif [ -e "$ROOT/$GRUB_DROPIN" ] || [ -e "$ROOT/$CMDLINE_DROPIN" ] || pending_has grub || pending_has uki \
         || [ -n "$(marked "$ROOT/etc/default/grub" "$QUIET_MARK")$(marked "$ROOT/etc/rc.conf" "$QUIET_MARK")" ]; then
        say="$say, boot still quiet (QUIET_BOOT=no)"; st=fail
    else say="$say, boot loud"; fi
    case $st in
        ok) chk quiet ok "$say" ;;
        warn) chk quiet warn "$say" "reboot: the next boot is quiet" ;;
        *) chk quiet fail "$say" "spark-shell on (sudo once)" ;;
    esac
}
status_console() {   # the font and quiet rows of status (the theme row is the look's)
    if [ "$OS" = Darwin ]; then set -- $CONSOLE_FONT; printf '  font  %-16s %s\n' "${1:-Menlo-Regular} ${2:-13}" "Terminal.app's profile (spark-shell font FACE SIZE)"
    elif is_wsl; then printf '  font  %-16s %s\n' na "WSL has no console"
    elif [ -z "$CONSOLE_FONT" ]; then printf '  font  %-16s %s\n' unset "the console keeps its font (spark-shell font list)"
    else printf '  font  %-16s %s\n' "$CONSOLE_FONT" "$(font_file "$(console_shape)")"; fi
    if [ "$OS" = Darwin ]; then printf '  quiet %-16s %s\n' na "macOS has no login notice or boot menu"; return 0; fi
    l=off; [ "$QUIET_LOGIN" != yes ] || l=on
    b=off; [ "$QUIET_BOOT" != yes ] || b=on
    [ -z "$(boot_refusal "$(boot_shape)")" ] || b=na
    printf '  quiet %-16s %s\n' "login $l" "boot $b (spark-shell quiet login|boot on|off)"
}

# ------------------------------------------------------------------ desks
# A layout (a desk, in the code): the windows for one need, laid out by
# the model from what this machine has. `spark-shell layout "focused news
# reading and music"` asks spark (spark edit, contract 10, from nothing)
# for one JSON answer -- why, a main window and its width, the side
# windows. The apps the words name always open (added when the answer
# lacks them); the answer's other apps are then said as suggestions, and
# its why only when what opens is the answer unchanged. A saved layout is
# what opened (JSON, yours to edit), rendered for the screen when it opens:
# it is kept in ~/.local/state/spark-shell/desk.last with the need's
# words first, `layout save NAME` copies it to
# ~/.config/spark-shell/layouts/NAME, and `layout NAME` renders it again
# with no model call. The old desks/ folder is not read. `desktop
# "WORDS"`, `desktop keep|forget`, `--rooms` and `--windows` are the old
# spellings, still taken. The render is sway commands: main at the left, the
# side stacked at the right, on the next empty workspace, so the windows
# already open are never touched. Every rendered line passes desk_gate
# before swaymsg sees it: a known verb, no shell syntax (sway hands exec
# to sh -c), and exec only of an app in the inventory (a kept desk: any
# program the machine has). The model never sees a window title or a
# file: the need's words, the screen and the inventory, nothing else.
LAYOUTS_DIR=$CONFIG_DIR/layouts   # the saved layouts; the old desks/ folder beside it is never read
DESK_LAST=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/desk.last
DESK_PENDING=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/desk.pending
DESK_VERBS="workspace rename splith splitv layout resize focus move floating fullscreen exec session window"   # session and window: the tmux lines; rename: the workspace takes the layout's words
DESK_NOT_APPS="sh bash zsh dash fish ksh sudo doas su pkexec"   # a shell or a way to root is not an app
DESK_WAIT=30                                                    # seconds for a window to map (gimp, a browser)

# ------------------------------------------------------------------- sbom
# This machine's software bill of materials, in the package manager's own
# words: every package, its version, licence, description, whether you
# chose it or it came as a dependency, the commands it puts on PATH and
# the desktop entries it ships (with their XDG categories). Its kind
# follows from that, no list of ours: an app declares itself with an
# entry, a tool is a command without one, a part is neither. One TSV in
# TMP feeds the table, the CycloneDX 1.5 JSON (the format spark's own
# `spark ver --sbom` writes, so the two compose) and the desk's inventory.
SBOM_JSON=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell/sbom.cdx.json
APPS=$CONFIG_DIR/apps     # yours: the allowed apps, what a layout may open, one per line, `name[: your words]`
sbom_entries() {   # -> $TMP/entries: NAME<tab>FILE<tab>WHAT<tab>TERMINAL<tab>CATEGORIES<tab>LAUNCH, hidden ones out
    : > "$TMP/entries"
    for d in ${XDG_DATA_HOME:-$HOME/.local/share} $(printf '%s' "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' '); do
        [ -d "$d/applications" ] || continue
        for f in "$d"/applications/*.desktop; do
            [ -f "$f" ] || continue
            grep -qE '^(NoDisplay|Hidden)=true' "$f" && continue
            launch=$(sed -n 's/^Exec=//p' "$f" | head -1 | sed 's/^env [^ ]* //; s/ *%[ick]//g; s|^[^ ]*/||')
            name=${launch%% *}
            [ -n "$name" ] || continue
            grep -q "^$name	" "$TMP/entries" && continue
            what=''
            for key in Comment GenericName Name; do
                [ -n "$what" ] || what=$(sed -n "s/^$key=//p" "$f" | head -1)
            done
            term=no; grep -q '^Terminal=true' "$f" && term=yes
            cats=$(sed -n 's/^Categories=//p' "$f" | head -1 | sed 's/;$//')
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$f" "$what" "$term" "$cats" "$launch" >> "$TMP/entries"
        done
    done
}
sbom_collect() {   # -> $TMP/sbom: NAME VERSION LICENSE REASON DESCRIPTION COMMANDS ENTRIES (tab-separated; KIND first)
    sbom_entries
    pm_detect 2>/dev/null || true
    : > "$TMP/files"   # PACKAGE<tab>PATH for every command and entry a package ships
    case $PM in
        pacman)
            pacman -Qi 2>/dev/null | awk -F' *: ' '
                /^Name/ {n=$2} /^Version/ {v=$2} /^Licenses/ {l=$2} /^Description/ {d=$2}
                /^Install Reason/ {r=($2 ~ /Explicitly/) ? "chosen" : "dependency"}
                /^$/ && n != "" {printf "%s\t%s\t%s\t%s\t%s\n", n, v, l, r, d; n=""}' > "$TMP/pkgs"
            pacman -Ql 2>/dev/null | awk '$2 ~ /^\/usr\/bin\/[^\/]+$/ || $2 ~ /\/applications\/[^\/]+\.desktop$/ {print $1 "\t" $2}' > "$TMP/files" ;;
        apt)
            dpkg-query -W -f='${Package}\t${Version}\t?\t?\t${binary:Summary}\n' 2>/dev/null > "$TMP/pkgs.raw"
            apt-mark showmanual 2>/dev/null | sort > "$TMP/manual"
            while IFS='	' read -r n v _ _ d; do
                lic=$(sed -n 's/^License: //p' "/usr/share/doc/$n/copyright" 2>/dev/null | head -1)
                if grep -qx "$n" "$TMP/manual"; then r=chosen; else r=dependency; fi
                printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$v" "${lic:-?}" "$r" "$d"
                grep -E '^/usr/bin/[^/]+$|/applications/[^/]+\.desktop$' "/var/lib/dpkg/info/$n.list" 2>/dev/null | sed "s/^/$n\t/" >> "$TMP/files"
            done < "$TMP/pkgs.raw" > "$TMP/pkgs" ;;
        xbps)
            xbps-query -m 2>/dev/null | sort > "$TMP/manual"
            xbps-query -l 2>/dev/null | while read -r _ pv d; do
                n=${pv%-*}
                lic=$(xbps-query -p license "$n" 2>/dev/null | head -1)
                if grep -qx "$pv" "$TMP/manual"; then r=chosen; else r=dependency; fi
                printf '%s\t%s\t%s\t%s\t%s\n' "$n" "${pv##*-}" "${lic:-?}" "$r" "$d"
                grep -oE '/usr/bin/[^<]+|/usr/share/applications/[^<]+\.desktop' "$ROOT/var/db/xbps/.$n-files.plist" 2>/dev/null \
                    | awk -v n="$n" '{print n "\t" $0}' >> "$TMP/files"
            done > "$TMP/pkgs" ;;
        brew)
            brew info --json=v2 --installed 2>/dev/null | jq -r '
                (.formulae[] | [.name, (.installed[0].version // .versions.stable // "?"), (.license // "?"),
                    (if (.installed[0].installed_on_request // false) then "chosen" else "dependency" end), (.desc // "")] | @tsv),
                (.casks[] | [.token, (.installed // .version // "?"), "?", "chosen", (.desc // "")] | @tsv)' > "$TMP/pkgs" 2>/dev/null
            prefix=$(brew --prefix 2>/dev/null)
            while IFS='	' read -r n _ _ _ _; do
                for b in "$prefix/opt/$n/bin"/*; do [ -x "$b" ] && printf '%s\t/usr/bin/%s\n' "$n" "${b##*/}"; done
            done < "$TMP/pkgs" >> "$TMP/files" 2>/dev/null ;;
        *) : > "$TMP/pkgs" ;;
    esac
    # kind, commands and entries per package, one pass; an app is what declares itself
    awk -F'\t' '
        FILENAME == ARGV[1] { ent[$2] = $1 "=" $5; next }                         # entries: file -> NAME=Categories
        FILENAME == files { if ($2 ~ /\.desktop$/) { if ($2 in ent) e[$1] = e[$1] " " ent[$2] }
                            else { sub(".*/", "", $2); c[$1] = c[$1] " " $2 } ; next }
        { n = $1; cmds = substr(c[n], 2); ents = substr(e[n], 2)
          k = (ents != "") ? "app" : (cmds != "") ? "tool" : "part"
          printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", k, n, $2, $3, $4, $5, cmds, ents }' \
        "$TMP/entries" files="$TMP/files" "$TMP/files" "$TMP/pkgs" | sort -t'	' -k2,2 > "$TMP/sbom"
}
sbom_json() {   # the CycloneDX 1.5 document, from $TMP/sbom, to stdout
    _pm=${PM:-none}; _os=${DISTRO:-$(printf '%s' "$OS" | tr 'A-Z' 'a-z')}
    jq -R -s --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg host "$(short_host)" --arg pm "$_pm" --arg os "$_os" --arg ver "$(sed -n 's/^## v//p' "$REPO/CHANGELOG.md" | head -1)" '
        split("\n") | map(select(length > 0) | split("\t")) |
        {bomFormat: "CycloneDX", specVersion: "1.5", version: 1,
         metadata: {timestamp: $ts, tools: [{name: "spark-shell", version: $ver}],
                    component: {type: "operating-system", name: $host, description: ("this machine, as " + $pm + " declares it")}},
         components: map({
            type: (if .[0] == "app" then "application" else "library" end),
            name: .[1], version: .[2], description: .[5],
            licenses: (if .[3] == "" or .[3] == "?" then [] else [{license: {name: .[3]}}] end),
            purl: ("pkg:" + $pm + "/" + $os + "/" + .[1] + "@" + .[2]),
            properties: ([{name: "spark-shell:kind", value: .[0]}, {name: "spark-shell:reason", value: .[4]}]
                         + (if .[6] != "" then [{name: "spark-shell:commands", value: .[6]}] else [] end)
                         + (if .[7] != "" then [{name: "spark-shell:entries", value: .[7]}] else [] end))})}' "$TMP/sbom"
}
cmd_sbom() {   # sbom [apps|tools|parts|NAME] [--json]
    config_load
    json=0; pick=''
    for a in "$@"; do case $a in --json) json=1 ;; -*) ;; *) pick=$a ;; esac; done
    command -v jq >/dev/null 2>&1 || { echo "spark-shell sbom: jq is not installed (spark-shell on)"; return 1; }
    sbom_collect
    [ -s "$TMP/sbom" ] || { echo "spark-shell sbom: no package manager here that this repo knows (pacman, apt, xbps, brew)"; return 1; }
    if [ "$json" = 1 ]; then
        mkdir -p "$(dirname "$SBOM_JSON")"
        sbom_json > "$SBOM_JSON"
        echo "$SBOM_JSON -- CycloneDX 1.5, $(wc -l < "$TMP/sbom" | tr -d ' ') components"
        return 0
    fi
    case $pick in
        ''|apps|tools|parts)
            k=${pick%s}
            awk -F'\t' -v k="$k" '$1 == k || k == "" {printf "%-5s %-24s %-14s %-22s %s\n", $1, $2, substr($3, 1, 14), substr($4, 1, 22), $6}' "$TMP/sbom"
            a=$(grep -c '^app	' "$TMP/sbom" || true); t=$(grep -c '^tool	' "$TMP/sbom" || true); p=$(grep -c '^part	' "$TMP/sbom" || true)
            echo "$a apps, $t tools, $p parts -- an app is a package with a desktop entry (spark-shell apps chooses the allowed apps)" ;;
        *)
            line=$(awk -F'\t' -v n="$pick" '$2 == n' "$TMP/sbom")
            [ -n "$line" ] || { echo "spark-shell sbom: no package named $pick"; return 1; }
            printf '%s\n' "$line" | awk -F'\t' '{printf "%s  %s %s\n  %s\n  licence   %s\n  reason    %s\n  commands  %s\n  entries   %s\n", $1, $2, $3, $6, $4, $5, ($7 == "" ? "-" : $7), ($8 == "" ? "-" : $8)}' ;;
    esac
}

# The desk's inventory: what a layout may open, in the machine's words and
# yours. The allowed apps (~/.config/spark-shell/apps, `name[: your
# words]`): exactly those. No list: every app that declares itself with a
# desktop entry.
# Always: a word of the need that is a program. Never: the desktop's own
# parts, a shell, a way to root. Lines `NAME: what[, terminal]`, and
# $TMP/exec keeps how each entry says to open it.
apps_marked() { [ -f "$APPS" ] && grep -q '^[A-Za-z0-9]' "$APPS"; }
desk_apps() {   # desk_apps NEED -> the lines
    sbom_entries
    awk -F'\t' '{print $1 "\t" $6}' "$TMP/entries" > "$TMP/exec"
    {
        if apps_marked; then
            [ -s "$TMP/sbom" ] || sbom_collect
            grep '^[A-Za-z0-9]' "$APPS" | while IFS= read -r m; do
                n=${m%%:*}; n=$(printf '%s' "$n" | tr -d ' '); note=''; case $m in *:*) note=$(printf '%s' "${m#*:}" | sed 's/^ *//') ;; esac
                e=$(awk -F'\t' -v n="$n" '$1 == n {print $3 "\t" $4}' "$TMP/entries" | head -1)
                if [ -n "$e" ]; then what=${e%	*}; term=${e#*	}
                else
                    what=$(awk -F'\t' -v n="$n" '$2 == n || (" " $7 " ") ~ (" " n " ") {print $6; exit}' "$TMP/sbom"); term=yes
                    if ! desk_on_path "$n"; then   # a package's name: its first command that is here (the two may differ)
                        for cmd in $(awk -F'\t' -v n="$n" '$2 == n {print $7; exit}' "$TMP/sbom"); do
                            desk_on_path "$cmd" && { n=$cmd; break; }
                        done
                    fi
                fi
                desk_on_path "$n" || [ -n "$e" ] || continue   # marked but not here: not offered
                [ -z "$note" ] || what=$note
                [ "$term" = yes ] && printf '%s: %s, terminal\n' "$n" "${what:-$n}" || printf '%s: %s\n' "$n" "${what:-$n}"
            done
        else
            awk -F'\t' '{printf "%s: %s%s\n", $1, $3, ($4 == "yes" ? ", terminal" : "")}' "$TMP/entries"
        fi
        for w in $1; do
            w=$(printf '%s' "$w" | tr -cd 'A-Za-z0-9_.-' | tr 'A-Z' 'a-z')
            [ -z "$w" ] || ! desk_on_path "$w" || printf '%s: named in the need, terminal\n' "$w"
        done
        echo "shell: a terminal with a prompt, terminal"   # a desk word: foot alone, or a room with no command
    } | grep -v "^\\($(printf '%s' "sway swaybg swaymsg foot footclient xdg-open $DESK_NOT_APPS" | sed 's/ /\\|/g')\\):" \
      | sort -t: -s -u -k1,1   # the desktop itself, a shell, a way to root: not apps
}
REFUSE_AS=desktop   # the verb a refusal names, as typed: desktop, layout or apps
refuse() { echo "spark-shell $REFUSE_AS: $1"; exit 1; }   # a refusal: one line, exit 1
# spark-shell apps: the picker. fzf over this machine's apps and tools
# together, Tab flips a row, Enter saves the allowed names to your file (a
# note you wrote beside a name that stays allowed is kept); Esc leaves it
# as it was. `desktop apps` and `desktop tools` are old spellings of it.
cmd_apps() {   # cmd_apps -- one picker, one list; apps are this machine's declared ones, tools its commands
    command -v fzf >/dev/null 2>&1 || refuse "fzf is not installed (spark-shell on)"
    [ -t 0 ] || refuse "the picker needs a terminal -- the file is $APPS (name[: your words], one per line)"
    sbom_collect
    # the rows, one per thing you could allow: an app package's entries as apps (the entry's
    # own words), then every other package with a command as a tool (the package's words,
    # the command in brackets when it differs); apps first, the tools you chose next,
    # dependency tools last. An allowed row wears a *. Tab flips: what you select at Enter
    # is allowed if it was not, taken off the list if it was.
    marks=$(apps_marked && grep '^[A-Za-z0-9]' "$APPS" | sed 's/[: ].*//' | paste -sd' ' - || true)
    picked=$(awk -F'\t' -v marks=" $marks " '
        FILENAME == ARGV[1] { ent[$1] = $3; next }
        function star(n) { return (index(marks, " " n " ") > 0) ? "* " : "  " }
        $1 == "app" {   # its entries are the apps; its other commands are part of them
            m = split($8, es, " ")
            for (j = 1; j <= m; j++) { split(es[j], kv, "="); if (kv[1] != "") printf "0\t%s\t%s%s: %s  [app]\n", kv[1], star(kv[1]), kv[1], ent[kv[1]] } }
        $1 == "tool" {
            n = split($7, c, " "); first = ""
            for (i = 1; i <= n; i++) if (c[i] ~ /^[A-Za-z]/) { first = c[i]; break }
            if (first == "") next
            name = ($2 ~ /^[A-Za-z]/) ? $2 : first
            shown = (index(" " $7 " ", " " name " ") > 0) ? name : name " (" first ")"
            printf "%d\t%s\t%s%s: %s  [tool]\n", ($5 == "chosen" ? 1 : 2), name, star(name), shown, $6 }' "$TMP/entries" "$TMP/sbom" \
             | sort -t'	' -k1,1n -k2,2f -u | cut -f3 \
             | grep -v "^..\\($(printf '%s' "sway swaybg swaymsg foot footclient xdg-open $DESK_NOT_APPS" | sed 's/ /\\|/g')\\)[ :(]" \
             | fzf --multi --prompt "apps> " --layout=reverse --no-info --color=16 --no-unicode \
                   --header "The allowed apps: what a layout may open. A tool opens in a terminal window.
Tab flips a row, Enter saves, Esc leaves the list as it was. A * row is allowed.
Allowed now: ${marks:-no list, so every app with a desktop entry}") || { echo "nothing changed"; return 0; }
    [ -n "$picked" ] || { echo "nothing changed"; return 0; }
    flipped=$(printf '%s\n' "$picked" | sed 's/^..//; s/[:(].*//; s/ *$//')
    mkdir -p "$CONFIG_DIR"
    {
        printf '# the allowed apps, what a layout may open, one per line: name[: your words] -- yours to edit\n'
        for n in $marks; do   # the allowed ones kept, minus the flipped; a note stays with its name
            printf '%s\n' "$flipped" | grep -qx "$n" && continue
            grep "^$n *\(:.*\)\{0,1\}$" "$APPS" 2>/dev/null | head -1 || printf '%s\n' "$n"
        done
        printf '%s\n' "$flipped" | while IFS= read -r n; do
            if [ -n "$n" ] && ! printf ' %s ' "$marks" | grep -q " $n "; then printf '%s\n' "$n"; fi
        done
        :
    } > "$TMP/apps.new"
    cp "$TMP/apps.new" "$APPS"
    if apps_marked; then echo "allowed apps: $(grep '^[A-Za-z0-9]' "$APPS" | sed 's/[: ].*//' | paste -sd' ' -) ($APPS)"
    else echo "allowed apps: no list, so every app with a desktop entry ($APPS)"; fi
}
cmd_apps_verb() {   # spark-shell apps (and the old desktop apps|tools): the picker, where there is a desktop
    config_load
    [ "$OS" = Darwin ] || pm_detect
    [ "$OS" != Darwin ] || refuse "not on macOS, which has its own desktop"
    cmd_apps
}
desk_on_path() { case $(command -v "$1" 2>/dev/null) in /*) return 0 ;; *) return 1 ;; esac; }   # a program, not a keyword or builtin
desk_app_known() { grep -q "^$1: " "$TMP/apps"; }                       # desk_app_known NAME (after desk_apps > $TMP/apps)
desk_app_term() { grep "^$1: " "$TMP/apps" | grep -q ', terminal$'; }   # a terminal app opens inside foot
desk_launch() {   # desk_launch NAME ARGS -> how the machine says to open it: the entry's Exec, its
    # file/URL field taking the args (dropped when there are none), else the name and the args
    _l=$(grep "^$1	" "$TMP/exec" 2>/dev/null | head -1 | cut -f2-)
    [ -n "$_l" ] || _l="$1 %U"
    case $_l in *%[fFuU]*) _l="${_l%%"%"[fFuU]*}$2${_l#*"%"[fFuU]}" ;; *) _l="$_l $2" ;; esac
    printf '%s' "$_l" | sed 's/  */ /g; s/ *$//'
}
# The screens: the active outputs left to right, name and mode only
# (never make, model or serial), one per line in $TMP/screens as
# `NAME WxH left|middle|right`; one line of a guess when sway is silent.
desk_screens() {
    [ ! -f "$TMP/screens" ] || return 0
    swaymsg -t get_outputs 2>/dev/null | jq -r '[.[] | select(.active != false)] | sort_by(.rect.x) | length as $n | to_entries[]
        | "\(.value.name) \(.value.current_mode.width)x\(.value.current_mode.height) \(if .key == 0 then "left" elif .key == $n - 1 then "right" else "middle" end)"' > "$TMP/screens" 2>/dev/null || true
    [ -s "$TMP/screens" ] || echo "- 1920x1080 left" > "$TMP/screens"
}
desk_said() { paste -sd, - | sed "s/,\([^,]*\)\$/ $1 \1/; s/,/, /g"; }   # desk_said and|or, one per line on stdin -> "a, b and c"
desk_screens_say() {   # -> the brief's words for them
    if [ "$(wc -l < "$TMP/screens")" -le 1 ]; then echo "one screen, $(cut -d' ' -f2 "$TMP/screens")"
    else echo "screens: $(awk '{print $3, $2}' "$TMP/screens" | paste -sd, - | sed 's/,/, /g')"; fi
}
desk_ws_said() { sed -n 's/^workspace number //p' "$1" | desk_said and; }   # desk_ws_said FILE -> "3" or "3 and 4"
desk_next_ws() {   # desk_next_ws [SKIP...] -> the lowest workspace number not in use, nor among SKIP
    used="$(swaymsg -t get_workspaces 2>/dev/null | jq -r '.[].num' 2>/dev/null) $*"
    n=1; while printf '%s\n' $used | grep -qx "$n"; do n=$((n + 1)); done
    echo "$n"
}
desk_windows() {   # desk_windows N -> how many windows workspace N has
    swaymsg -t get_tree 2>/dev/null | jq "[.. | objects | select(.type? == \"workspace\" and .num? == $1) | .. | objects | select(.pid? != null)] | length" 2>/dev/null || echo 0
}

# The gate: one line in, ok or a reason out. Read before jq, sway or
# anything else sees it, whether the line is fresh from the model or
# from a kept desk you edited by hand.
desk_gate() {   # desk_gate LINE -> '' when it may run, else why not
    verb=${1%% *}
    case " $DESK_VERBS " in *" $verb "*) ;; *) echo "$verb is not a layout command"; return ;; esac
    bad=$(printf '%s' "$1" | LC_ALL=C tr -d 'A-Za-z0-9 _.:/=,%~@#+?[]"-' | head -c 1)   # what a sway line may hold; the rest is sh's
    [ -z "$bad" ] || { echo "shell syntax or a control character"; return; }
    # sway splits a command line at a comma too: in an exec, the rest would
    # be a second command nobody checked
    case $verb in exec|window) case $1 in *,*) echo "a comma starts a second sway command"; return ;; esac ;; esac
    case $1 in 'focus output '*) grep -q "^${1#focus output } " "$TMP/screens" 2>/dev/null || echo "${1#focus output } is not a screen here"; return ;; esac
    [ "$verb" = exec ] || [ "$verb" = window ] || return 0
    set -- $1; shift
    if [ "$verb" = window ]; then   # window NAME [CMD ARGS]: bare is a shell, the rest is judged like an exec
        [ $# -gt 0 ] || { echo "window with no name"; return; }
        shift; [ $# -gt 0 ] || return 0
    elif [ "${1:-}" = foot ]; then   # exec foot alone is a shell; exec foot -e CMD is the CMD
        [ $# -gt 1 ] || return 0
        [ "${2:-}" != -e ] || shift 2
    fi
    app=${1:-}; app=${app##*/}
    [ -n "$app" ] || { echo "exec of nothing"; return; }
    case " $DESK_NOT_APPS " in *" $app "*) echo "$app is not an app"; return ;; esac
    # the model's answer stays inside the list it was given; a desk you kept may
    # open any program this machine has (you kept it, you can read and edit it)
    if [ -n "${KEPT:-}" ]; then desk_on_path "$app" || desk_app_known "$app" || echo "$app is not on this machine"
    elif desk_app_known "$app"; then :
    elif desk_on_path "$app"; then echo "$app is not one of the allowed apps (spark-shell apps adds it)"
    else echo "$app is not on this machine"; fi
}

# The model's answer to sway's words, in two passes. First each window's
# screen: `screen` is left or right (or an output's name), a side window
# without one sits with the main, a screen named but not here maps to the
# main's (said in one line) and the main's own to the first. Then one
# group per screen, the main's first: `focus output NAME` (only with more
# than one screen), `workspace number N` (a fresh number each; never
# `workspace N output`, which would pin), main at the left, the side
# stacked at the right (a new window lands beside the focused one; splitv
# turns the side column vertical), then main sized. A terminal app opens
# in foot, and so does a program with no desktop entry (a kept desk's).
desk_windows_of() {   # desk_windows_of JSONFILE -> $TMP/windows: SCREEN<tab>APP<tab>ARGS, the main first
    jq -r --rawfile s "$TMP/screens" '
        ($s | split("\n") | map(select(. != "") | split(" "))) as $scr
        | def out(w; dflt): (w.screen // "") as $n | ([$scr[] | select(.[0] == $n or .[2] == $n)] | first // [dflt]) | .[0];
        out(.main; $scr[0][0]) as $mo | ([.main] + (.side // [])) as $all
        | ([$all[] | (.screen // "") | select(. != "" and (. as $n | [$scr[] | .[0], .[2]] | index($n)) == null)] | first // "") as $miss
        | $mo, $miss, ($all[] | "\(out(.; $mo))\t\(.app)\t\(.args // "")")' "$1" > "$TMP/windows.all"
    # the main's output on line 1, the screen missed (or nothing) on line 2, one line each: a
    # tab-split read would drop an empty first field (a leading tab is IFS whitespace)
    mo=$(sed -n 1p "$TMP/windows.all"); miss=$(sed -n 2p "$TMP/windows.all")
    sed 1,2d "$TMP/windows.all" > "$TMP/windows"
    [ -z "$miss" ] || echo "  the $miss screen is not here -- all on $mo"
}
desk_words_full() { case " $(panel_lower "$1") " in *' fullscreen '*|*' full screen '*|*' full-screen '*) echo true ;; *) echo false ;; esac; }   # desk_words_full WORDS -> the words ask for fullscreen (the machine reads that, not the model)
desk_words_ws() { printf '%s' "$1" | tr 'A-Z' 'a-z' | sed -n 's/.*workspace \([1-9][0-9]*\).*/\1/p' | sed -n 1p; }   # desk_words_ws WORDS -> the workspace the words name, or nothing
desk_lines() {   # desk_lines WS JSONFILE -> the lines, after desk_windows_of: one group per screen, the main's on WS
    w=$1; used=''; main=1; many=$(wc -l < "$TMP/screens" | tr -d ' ')
    for scr in $(cut -f1 "$TMP/windows" | awk '!seen[$0]++'); do
        [ "$many" -le 1 ] || printf 'focus output %s\n' "$scr"
        [ -z "$used" ] || w=$(desk_next_ws $used)
        used="$used $w"
        printf 'workspace number %s\n' "$w"
        [ -z "${DESK_LABEL:-}" ] || printf 'rename workspace to "%s %s"\n' "$w" "$DESK_LABEL"   # the bar reads "3 writing"
        grep "^$scr	" "$TMP/windows" | {
            i=0
            while IFS='	' read -r _ app args; do
                [ "$app" != editor ] || [ -n "$ED" ] || continue   # no editor here: that window skipped (said in desk_render)
                case $i in 1) echo splith ;; 2) echo splitv ;; esac   # the split the next window lands in
                case $app in
                    shell) echo "exec foot" ;;
                    editor) printf 'exec foot -e %s\n' "$(desk_launch "$ED" "$args")" ;;
                    *) if desk_app_term "$app" || { ! desk_app_known "$app" && desk_on_path "$app"; }; then printf 'exec foot -e %s\n' "$(desk_launch "$app" "$args")"; else printf 'exec %s\n' "$(desk_launch "$app" "$args")"; fi ;;
                esac
                [ "$i" -ne 0 ] || [ -z "$main" ] || [ "$(jq -r '.main.fullscreen // false' "$2")" != true ] || echo "fullscreen enable"   # the main window, once it is there, fills the screen
                i=$((i + 1))
            done
            if [ -n "$main" ] && [ "$i" -gt 1 ]; then
                echo "focus left"
                printf 'resize set width %s ppt\n' "$(jq -r '.main.width // 70 | if . < 20 then 20 elif . > 90 then 90 else floor end' "$2")"
            fi
        }
        main=''
    done
}
# The same desk as rooms: a tmux session named after the words, one
# window per app (windows, not panes: a terminal app wants the whole
# page, and tmux's line names the rooms). `window NAME` bare is tmux's
# own shell; `window NAME CMD ARGS` runs the command. width is the
# desktop's and is not read here.
desk_rooms() {   # desk_rooms NAME JSONFILE -> the lines
    printf 'session %s\n' "$1"
    jq -r '[.main] + (.side // []) | .[] | "\(.app) \(.args // "")"' "$2" | sed 's/ *$//' | while IFS= read -r line; do
        app=${line%% *}; args=''; case $line in *' '*) args=${line#* } ;; esac
        case $app in
            shell) echo "window shell" ;;
            editor) [ -z "$ED" ] || printf 'window editor %s\n' "$(desk_launch "$ED" "$args")" ;;   # none here: skipped (said in desk_render)
            *) printf 'window %s %s\n' "$app" "$(desk_launch "$app" "$args")" ;;
        esac
    done
}
desk_play_rooms() {   # desk_play_rooms FILE -> the session made (or found open), one line per room; true when a room ran
    name=$(sed -n 's/^session //p' "$1" | head -1)
    if tmux has-session -t "=$name" 2>/dev/null; then echo "  the tmux session $name is open already"; return 0; fi
    ran=0
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|'#'*) continue ;; esac
        why=$(desk_gate "$line")
        if [ -n "$why" ]; then echo "  refused  $line  ($why)"; continue; fi
        [ "$VERBOSE" != 1 ] || echo "  $line"   # the rooms grammar is for the file, not the screen
        case $line in 'session '*) continue ;; esac
        set -- $line; shift; room=$1; shift; cmd=$*; prog=${1:-}; prog=${prog##*/}
        if [ "$prog" = "$room" ]; then shown=$cmd; else shown="$room $cmd"; fi; shown=${shown% }
        # the model's answer keeps to the terminal apps it was offered; a desk you kept runs what the machine has
        if [ -z "${KEPT:-}" ] && [ -n "$prog" ] && desk_app_known "$prog" && ! desk_app_term "$prog"; then echo "  $shown -- needs the desktop"; continue; fi
        if [ "$ran" -eq 0 ]; then set -- new-session -d -s "$name" -n "$room"; else set -- new-window -t "=$name" -n "$room"; fi
        [ -z "$cmd" ] || set -- "$@" "$cmd"   # the command is one argument: tmux hands it to sh -c, like sway's exec
        tmux "$@" || { echo "  tmux refused: $line"; continue; }
        ran=$((ran + 1)); echo "  $shown"
    done < "$1"
    [ "$ran" -gt 0 ]
}
desk_join() {   # desk_join NAME -- inside tmux: switch to it; at a terminal: attach; on a pipe: say how
    if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$1"
    elif [ -t 0 ] && [ -t 1 ]; then tmux attach-session -t "=$1"
    else echo "tmux session $1 -- tmux attach-session -t $1 joins it"; fi
}
desk_editor() {   # -> what a layout's `editor` word opens: EDITOR's basename, else micro, else vi when here; false when none
    if [ -n "${EDITOR:-}" ]; then printf '%s\n' "${EDITOR##*/}"
    elif desk_on_path micro; then echo micro
    elif desk_on_path vi; then echo vi
    else return 1; fi
}
# The words name the apps to open. An app of the answer is named when
# it is a word of the need (any case, a whole word); `editor` is named by
# "editor" or by the editor's own program (vi), and that program by
# "editor". A word that is an app of the list (shell, a program on PATH,
# `editor` when there is one) always opens: the answer's named apps in
# its order (the main window first when it is one, else the first named
# in its place, the answer's width kept), then each named app the answer
# lacks as a side window, in the words' order, once (`editor` and its
# program are one app). The answer's other apps are said as suggestions.
# None named: the answer as it came.
DESK_SMALL_WORDS='["and","or","with","the","a","an","in","on","for","to","my","of","at","plus","also","then","now","please","open","window","windows","layout","desktop","terminal","workspace","fullscreen","full","screen","it","them","me","i","some"]'   # words that ground nothing on their own
desk_named() {   # desk_named JSONFILE NEED -> JSONFILE narrowed to the windows the need asks for; one line names the others
    # A window the model ties to words of the need (its `quote`) stays when those words are in the need and
    # say something on their own; an app the need names stays always, and is added when the model forgot it; the
    # rest -- a helper, a shell, a monitor the need did not ask for -- is suggested, never opened. An answer with no
    # `quote` at all (an older model, a saved layout) keeps the named apps alone.
    _w=" $(printf '%s' "$2" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_.+-' ' ' | sed 's/[.-]*  */ /g; s/[.-]*$//; s/  */ /g') "
    _ed=$(printf '%s' "$ED" | tr 'A-Z' 'a-z'); _names=''
    for _x in $_w; do   # the apps the words name, in their order: the list's names, any case
        if [ "$_x" = editor ]; then [ -z "$ED" ] || _names="$_names$_x
"; continue; fi
        _n=$(awk -F': ' -v w="$_x" 'tolower($1) == w {print $1; exit}' "$TMP/apps")
        [ -z "$_n" ] || _names="$_names$_n
"
    done
    jq --arg w "$_w" --arg ed "$_ed" --arg names "$_names" --argjson small "$DESK_SMALL_WORDS" '
        def key: ascii_downcase as $a | if $a == "editor" or ($ed != "" and $a == $ed) then "editor" else $a end;
        def named: (.app | ascii_downcase) as $a
            | ($w | contains(" " + $a + " "))
              or ($a == "editor" and $ed != "" and ($w | contains(" " + $ed + " ")))
              or ($ed != "" and $a == $ed and ($w | contains(" editor ")));
        def grounded: ((.quote // "") | ascii_downcase | gsub("[^a-z0-9_.+-]+"; " ") | split(" ") | map(select(. != "" and (. as $x | $small | index($x) | not)))) as $fw
            | ($fw | length) > 0 and all($fw[]; . as $x | $w | contains(" " + $x + " "));
        ([.main] + (.side // [])) as $all
        | (any($all[]; has("quote"))) as $tied
        | ([$all[] | select(named or ($tied and grounded))] | reduce .[] as $x ([]; if any(.[]; (.app | ascii_downcase) == ($x.app | ascii_downcase) and (.args // "") == ($x.args // "")) then . else . + [$x] end)) as $k
        | ($names | split("\n") | map(select(. != ""))
           | reduce .[] as $n ([]; if (map(key) | index([$n | key])) then . else . + [$n] end)) as $nm
        | ($k | map(.app | key)) as $have
        | [$nm[] | select((key) as $x | $have | index([$x]) | not) | {app: ., args: ""}] as $add
        | ($k + $add) as $open
        | if ($open | length) == 0 then .
          else .main.width as $wd
            | .main = ($open[0] + (if $open[0].width == null and $wd != null then {width: $wd} else {} end))
            | .side = $open[1:] | .suggested = ([$all[] | select((named or ($tied and grounded)) | not) | .app] | reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end))
          end' "$1" > "$TMP/named.json" 2>/dev/null || return 0
    _s=''
    for a in $(jq -r '.suggested // [] | .[]' "$TMP/named.json"); do   # only what naming it would open: an app on the list
        case $a in shell|editor) ;; *) desk_app_known "$a" || continue ;; esac
        _s="$_s$a
"
    done
    jq --arg s "$(printf '%s' "$_s" | paste -sd, -)" '.suggested = ($s | split(",") | map(select(. != "")))' "$TMP/named.json" > "$1"   # kept with the last layout: the panel offers each as a row
    [ -n "$_s" ] || return 0
    if [ "$(printf '%s' "$_s" | wc -l)" -gt 1 ]; then _it=them; else _it=it; fi
    echo "  also suggested: $(printf '%s' "$_s" | desk_said and) -- add $_it to your words to open $_it"
}
desk_set() { jq -c '[.main] + (.side // []) | map([.app, (.args // "")])' "$1" 2>/dev/null; }   # desk_set JSONFILE -> its windows, to compare
desk_has() { jq -e --arg a "$2" '[.main] + (.side // []) | any(.app == $a)' "$1" >/dev/null 2>&1; }   # desk_has JSONFILE APP
desk_in_sway() { [ -n "${SWAYSOCK:-}" ] && [ -n "$(swaymsg -t get_version 2>/dev/null)" ]; }   # a sway that answers
desk_player() {   # -> windows inside sway, else rooms; --desktop and --terminal (--windows, --rooms) force one
    if [ -n "${PLAYER:-}" ]; then echo "$PLAYER"; elif desk_in_sway; then echo windows; else echo rooms; fi
}
desk_render() {   # desk_render JSONFILE -> $TMP/desk: the lines for the player; ws is the main's workspace (windows)
    ED=$(desk_editor) || ED=''
    : "${DESK_LABEL:=$(desk_ws_label "$(desk_words "$1")")}"   # a saved layout's name, else the words
    [ -n "$ED" ] || ! desk_has "$1" editor || echo "  editor -- no editor on this machine: set EDITOR in ~/.config/spark-shell/rc"
    if [ "$PLAYER" = rooms ]; then desk_rooms "$(desk_name_of "$(desk_words "$1")")" "$1" > "$TMP/desk"; return; fi
    desk_screens
    desk_windows_of "$1"
    ws=$(desk_words_ws "$(desk_words "$1")"); [ -n "$ws" ] || ws=$(desk_next_ws)   # the words may name the workspace; else the lowest free one
    desk_lines "$ws" "$1" > "$TMP/desk"
}
desk_show() {   # desk_show WHOSE -- the rendered desk played, then the closing line; KEPT=1 for a kept one
    if [ "$PLAYER" = rooms ]; then
        name=$(sed -n 's/^session //p' "$TMP/desk" | head -1)
        desk_play_rooms "$TMP/desk" || refuse "nothing ran"
        echo "tmux session $name -- $1"
        if desk_in_sway; then   # asked inside the desktop with --terminal: the session in a foot window of its own
            _w=$(desk_next_ws); printf 'workspace number %s\nrename workspace to "%s %s"\nexec foot -e tmux attach-session -t =%s\n' "$_w" "$_w" "$(desk_ws_label "$name")" "$name" > "$TMP/desk.win"
            KEPT=1 desk_play "$TMP/desk.win" >/dev/null || true; : > "$TMP/opened"
        else desk_join "$name"; fi
        return
    fi
    # asked at the prompt: its window goes with the desk, on top, to be read
    [ -z "${ASKED:-}" ] || swaymsg -- "[app_id=$PANEL_APP] move container to workspace number $ws" >/dev/null 2>&1 || true
    desk_play "$TMP/desk" || refuse "nothing ran"
    : > "$TMP/opened"   # the mark the panel's window reads: it closes, the layout has the screen
    echo "on workspace $(desk_ws_said "$TMP/desk")${1:+ -- $1}"
    [ -z "${ASKED:-}" ] || swaymsg -- "[app_id=$PANEL_APP] focus" >/dev/null 2>&1 || true   # the panel's keys are ours, not the app's
}

desk_play() {   # desk_play FILE -> the lines sent, a refused line named, exec waited for
    sent=0; nowin=0; _ws=''
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|'#'*) continue ;; esac
        why=$(desk_gate "$line")
        if [ -n "$why" ]; then echo "  refused  $line  ($why)"; case $line in exec*) nowin=1 ;; esac; continue; fi
        # a split meant for a window that never came (or was refused) would cut
        # the one before it instead: skipped, the next window lands where that one would have
        case $line in split*) [ "$nowin" = 0 ] || { [ "$VERBOSE" != 1 ] || echo "  skipped  $line  (no window to split)"; nowin=0; continue; } ;; esac
        [ "$VERBOSE" != 1 ] || echo "  $line"   # the sway grammar is for the kept file, not the screen
        case $line in 'workspace number '*) _ws=${line#workspace number } ;; esac
        before=$(desk_windows "$_ws")
        swaymsg -- "$line" >/dev/null || { echo "  sway refused: $line"; continue; }
        sent=$((sent + 1))
        case $line in exec*)
            # until its window maps; a program that ends first (mpv with
            # nothing to play) is not waited for past a 3 s grace. What a
            # person reads: the app and its args, and whether it came
            set -- $line; shift; [ "${1:-}" = foot ] && [ "${2:-}" = -e ] && shift 2
            prog=${1##*/}; shown=$*; t=0
            desk_pulse   # a sign of life while the window is on its way
            while [ "$(desk_windows "$_ws")" -le "$before" ] && [ "$t" -lt $((DESK_WAIT * 4)) ]; do
                [ "$t" -lt 12 ] || pgrep -u "$(id -u)" -x "$prog" >/dev/null 2>&1 || break
                sleep 0.25; t=$((t + 1))
            done
            desk_pulse_stop
            if [ "$(desk_windows "$_ws")" -gt "$before" ]; then nowin=0; echo "  $shown"; else nowin=1; echo "  $shown -- no window"; fi ;;
        esac
    done < "$1"
    [ "$sent" -gt 0 ]
}

desk_make() {   # desk_make NEED -> the desk laid out, the model's answer in DESK_LAST
    command -v jq >/dev/null 2>&1 || refuse "jq is not installed (spark-shell on)"
    spark=$(spark_bin)
    [ -n "$spark" ] || refuse "spark is not installed -- spark picks the apps for a layout (github.com/forgewright-ai/spark)"
    [ "$PLAYER" != rooms ] || command -v tmux >/dev/null 2>&1 || refuse "tmux is not installed (spark-shell on)"
    desk_apps "$1" > "$TMP/apps"
    [ -s "$TMP/apps" ] || refuse "no apps found on this machine (no desktop entries, no chosen packages)"
    [ "$PLAYER" = rooms ] || desk_screens
    about=$(desk_brief)
    [ -n "${ASKED:-}" ] || printf 'layout> %s\n' "$1"
    desk_pulse
    st=0; "$spark" edit --type json --name layout.json --about "$about" -- "write the layout for this need: $1" </dev/null > "$TMP/desk.json" 2>"$TMP/desk.err" || st=$?
    desk_pulse_stop
    [ "$st" -eq 0 ] || refuse "spark did not answer: $(head -1 "$TMP/desk.err")"
    jq -e '.main.app | strings' "$TMP/desk.json" >/dev/null 2>&1 || refuse "the answer was not a layout (spark-shell layout -v shows it)"
    # what opens is what the words name, when they name any; the model's why is
    # said only when what opens is its answer, unchanged
    ED=$(desk_editor) || ED=''
    answer=$(desk_set "$TMP/desk.json")
    desk_named "$TMP/desk.json" "$1" > "$TMP/named.say"
    changed=''; [ "$(desk_set "$TMP/desk.json")" = "$answer" ] || changed=1
    why=$(desk_why "$TMP/desk.json")
    [ -n "$changed" ] || [ -z "$why" ] || printf '  %s\n' "$why"
    for a in $(jq -r '[.main] + (.side // []) | .[].app' "$TMP/desk.json"); do
        [ "$a" != editor ] || continue   # a layout word: the editor this machine has, or one line in desk_render
        desk_app_known "$a" && continue
        if desk_on_path "$a"; then echo "  $a is not one of the allowed apps -- laid out without it (spark-shell apps adds it)"
        else echo "  $a is not on this machine -- laid out without it"; fi
    done
    cat "$TMP/named.say"
    mkdir -p "$(dirname "$DESK_LAST")"   # what opened; a why only when that is the answer
    jq --arg w "$1" --arg ch "$changed" --argjson full "$(desk_words_full "$1")" '{words: $w} + . | if $ch == "" then . else del(.why) end | if $full then .main.fullscreen = true else . end' "$TMP/desk.json" > "$DESK_LAST"
    desk_render "$DESK_LAST"
    if [ -n "${ASKED:-}" ]; then desk_show ''; else desk_show "spark-shell layout save NAME saves it"; fi   # the panel has its save row
}
desk_replay() {   # desk_replay NAME -> the saved layout rendered for the player and played, no model call, no narrowing
    DESK_LABEL=$(desk_ws_label "$1")
    why=$(desk_open "$LAYOUTS_DIR/$1"); [ -z "$why" ] || refuse "$why"
    desk_apps "$(desk_words "$LAYOUTS_DIR/$1")" > "$TMP/apps"   # the desk's words, not its file name: a program they name is on the desk
    [ -n "${ASKED:-}" ] || printf 'layout> %s\n' "$(desk_words "$LAYOUTS_DIR/$1")"
    why=$(desk_why "$LAYOUTS_DIR/$1"); [ -z "$why" ] || printf '  %s\n' "$why"
    desk_render "$LAYOUTS_DIR/$1"
    KEPT=1 desk_show "the saved layout $1"
}
# The brief: the screens (or the terminal, for rooms), the apps, the
# rules, the shape asked for. With more than one screen the example
# carries `screen` and one rule more; rooms are offered the terminal
# apps only and no screen at all.
desk_brief() {
    ex='{"why": "one sentence, from the need to the apps chosen", "main": {"app": "NAME", "quote": "the words of the need this window is for", "args": "", "width": 70, "fullscreen": false}, "side": [{"app": "NAME", "quote": "the words of the need this window is for", "args": ""}]}'
    rule=' The need is read part by part: each thing it names, split at and or a comma, is one window of its own, with quote: the words of that part as they are in the need (two things named, two windows, each with the words of its own part). A window the need has no words for is not in the layout, and one window never answers two parts. main fullscreen is true only when the need says fullscreen or full screen: that window alone fills the screen, and side is then empty.'
    if [ "$PLAYER" = rooms ]; then
        opening="A layout of tmux windows: the apps for one need, each in a terminal window, on a $(tput cols 2>/dev/null || echo 80)x$(tput lines 2>/dev/null || echo 24) terminal."
        apps=$(grep ', terminal$' "$TMP/apps")
    else
        opening="A layout: the windows for one need, on $(desk_screens_say)."
        apps=$(cat "$TMP/apps")
        if [ "$(wc -l < "$TMP/screens")" -gt 1 ]; then
            ex='{"why": "one sentence, from the need to the apps chosen", "main": {"app": "NAME", "quote": "the words of the need this window is for", "args": "", "width": 70, "fullscreen": false, "screen": "left"}, "side": [{"app": "NAME", "quote": "the words of the need this window is for", "args": "", "screen": "right"}]}'
            rule="$rule A window is on one screen; screen is $(cut -d' ' -f3 "$TMP/screens" | desk_said or); one screen unless the need names two or the work needs two."
        fi
    fi
    echo "$opening Apps on this machine (name: what it does): $(printf '%s\n' "$apps" | sed 's/, terminal$//' | paste -sd ';' - | sed 's/;/; /g'). Rules: an app the need names by name is in the layout; otherwise only the apps the work itself needs, as few windows as that takes (one to four), never an app the need does not call for (no helper, no shell, no monitor the need did not ask for); an app may appear twice with different args (a browser on two pages: one window per page, args is that page's URL).$rule Answer with one JSON object and nothing else: $ex -- main is the big window at the left, width its percent of the screen; side is the windows stacked at the right, top to bottom."
}

# The pulse spark draws while a reply is on its way (spark text.Busy):
# `*` in the accent and `.` `..` `...` muted, redrawn every 0.35 s, at a
# tty only -- a pipe never sees a byte of it. The colours are the three
# SGR strings sgr.sh renders from the palette; unset = plain.
desk_pulse() { [ ! -t 1 ] || { panel_colours; pulse_start think; }; }   # the layout's wait: the panel's think cells (one pulse for all of spark-shell)
desk_pulse_stop() { pulse_stop; }
# The layout> line: fzf when there is one and a terminal (the tools row
# installs it): type a need, the arrows move over the saved layouts, Enter
# takes the words or the layout under the cursor, Esc closes, the header
# says so. Without it, a plain line. Exit 1 when the window closed.
# A saved layout is one JSON object: words, why, main, side. A file that
# is not one is left alone; one of the shape before v0.36 (sway lines
# under a `# desk:` header) is refused with the words that make it again.
desk_json_ok() { jq -e '(.words | strings) and (.main.app | strings)' "$1" >/dev/null 2>&1; }
desk_old_shape() { head -1 "$1" 2>/dev/null | grep -q '^# desk: '; }
desk_words() { jq -r '.words // ""' "$1" 2>/dev/null; }   # desk_words FILE
desk_why() { jq -r '.why // "" | gsub("[\\n\\r]"; " ")' "$1" 2>/dev/null; }
desk_open() {   # desk_open FILE -> '' when it may open, else one sentence
    if desk_old_shape "$1"; then
        echo "$1 is a layout of the old shape (sway lines). spark-shell layout \"$(sed -n 's/^# desk: \(.*\) -- rendered by spark-shell.*/\1/p' "$1" | head -1)\" makes it again, then spark-shell layout save saves it."
    elif ! desk_json_ok "$1"; then echo "$1 is not a layout spark-shell made (one JSON object: words, why, main, side) -- left alone."; fi
}
desk_name_of() {   # desk_name_of WORDS... -> a file name: lowercase, the words joined by -, 40 at most
    printf '%s' "$*" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/^-//; s/-$//' | cut -c1-40
}
desk_name_ok() { case $1 in ''|*[!A-Za-z0-9_-]*) return 1 ;; *) return 0 ;; esac; }
desk_ws_label() {   # desk_ws_label WORDS... -> what a workspace is named after: lowercase words, letters and digits, whole words up to 24
    printf '%s' "$*" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' ' ' | awk '{ s = ""; for (i = 1; i <= NF; i++) { t = (s == "" ? $i : s " " $i); if (length(t) > 24 && s != "") break; s = t } print s }' | cut -c1-24
}
desk_list() {
    [ -d "$LAYOUTS_DIR" ] && [ -n "$(ls -A "$LAYOUTS_DIR" 2>/dev/null)" ] || { echo "no saved layouts yet -- try: spark-shell layout \"focused news reading and music\""; return 0; }
    for f in "$LAYOUTS_DIR"/*; do
        printf '  %-24s %s\n' "${f##*/}" "$(desk_words "$f")"
    done
    echo "spark-shell layout NAME opens one -- layout save [NAME] saves the last layout, layout delete NAME deletes one"
}
desk_save() {   # desk_save [NAME...] -- the last layout under that name (its own words by default)
    [ -f "$DESK_LAST" ] || refuse "no layout to save yet -- spark-shell layout \"WORDS\" makes one"
    why=$(desk_open "$DESK_LAST"); [ -z "$why" ] || refuse "$why"
    name=$(desk_name_of "$*")
    [ -n "$name" ] || name=$(desk_name_of "$(desk_words "$DESK_LAST")")
    [ -n "$name" ] || refuse "save NAME -- a name for it"
    mkdir -p "$LAYOUTS_DIR"; jq 'del(.suggested)' "$DESK_LAST" > "$LAYOUTS_DIR/$name"   # a saved layout is what opened, not what was suggested
    echo "saved $name -- spark-shell layout $name opens it ($LAYOUTS_DIR/$name)"
}
desk_delete() {   # desk_delete NAME...
    name=$(desk_name_of "$*"); [ -n "$name" ] || refuse "delete NAME -- which layout?"
    [ -f "$LAYOUTS_DIR/$name" ] || refuse "no saved layout named $name"
    why=$(desk_open "$LAYOUTS_DIR/$name"); [ -z "$why" ] || refuse "$why"
    rm -f "${LAYOUTS_DIR:?}/${name:?}"; echo "deleted $name"
}
# Words: a saved layout by that name first, else words for the model. The
# player is where you ask from: sway windows inside sway, tmux windows
# anywhere else; --desktop from a console starts sway first, the words
# waiting for it (desk_start).
desk_need() {   # desk_need WORDS...
    command -v jq >/dev/null 2>&1 || refuse "jq is not installed (spark-shell on)"
    PLAYER=$(desk_player)
    if [ "$PLAYER" = windows ] && ! desk_in_sway; then desk_start "$*"; return; fi
    [ "$PLAYER" = rooms ] || [ "$OS" != Darwin ] || refuse "not on macOS, which has its own desktop"
    [ "$PLAYER" = rooms ] || [ "$DESKTOP" = sway ] || refuse "DESKTOP=$DESKTOP -- spark-shell on desktop first"
    kept=$(desk_name_of "$*")
    if [ -n "$kept" ] && [ -f "$LAYOUTS_DIR/$kept" ]; then desk_replay "$kept"; else desk_make "$*"; fi
}

# The layout verb: the same layouts under their own name. Bare, the saved
# ones; save, delete, a name or words. --ask is the old Super+d (the panel
# with the layouts first now); --pending is the desktop's first start's.
cmd_layout() {   # cmd_layout [save [NAME] | delete NAME | NAME | WORDS | --ask | --pending]
    config_load
    [ "$OS" = Darwin ] || pm_detect
    REFUSE_AS=layout
    case ${1:-} in
        '') desk_list ;;
        save) shift; desk_save "$@" ;;
        delete) shift; desk_delete "$@" ;;
        --ask) cmd_panel layout ;;
        --pending) desk_pending ;;
        -*) refuse "$1 is not an option here (spark-shell -h)" ;;
        *) desk_need "$@" ;;
    esac
}
desk_pending() {   # the words left by a console start: laid out once, then gone
    [ -f "$DESK_PENDING" ] || return 0
    need=$(head -1 "$DESK_PENDING"); rm -f "$DESK_PENDING"
    [ -z "$need" ] || desk_need "$need"
}

# A console, by the tty this runs on: /dev/tty1 to /dev/tty9 (and up)
# on every distro, whatever started the login. XDG_VTNR is not used: it
# is logind's, and Void has no logind.
on_console() { case $(tty 2>/dev/null) in /dev/tty[1-9]*) return 0 ;; *) return 1 ;; esac; }
# sway refuses to start without XDG_RUNTIME_DIR, which logind sets and
# Void leaves empty. When it is unset, a private directory of yours under
# TMPDIR (/tmp: a tmpfs, empty at every boot): made with mode 0700, or
# taken only when it is a real directory you own, never a symlink.
runtime_dir() {
    [ -z "${XDG_RUNTIME_DIR:-}" ] || return 0
    _uid=$(id -u); _rd=${TMPDIR:-/tmp}; _rd=${_rd%/}/$_uid-runtime-dir
    [ -e "$_rd" ] || [ -L "$_rd" ] || mkdir -m 0700 "$_rd" 2>/dev/null || true
    if [ -d "$_rd" ] && [ ! -L "$_rd" ] && [ "$(ls -ldn "$_rd" | awk '{print $3}')" = "$_uid" ] && chmod 0700 "$_rd"; then
        XDG_RUNTIME_DIR=$_rd; export XDG_RUNTIME_DIR; return 0
    fi
    refuse "$_rd is not a private directory of yours, and sway needs one (XDG_RUNTIME_DIR)"
}

# The desktop verb. `desktop on|off` are spellings of `on desktop` and
# `off desktop` (one path, cmd_on and cmd_off). Alone: start sway now,
# on this console. A child, never exec: the EXIT trap still cleans TMP,
# and the cursor comes back after sway (a belt: a console that lost it
# gets it back). sway's stderr goes to a log; its exit
# status is ours. Each refusal is one line and exit 1.
cmd_desktop() {
    config_load
    [ "$OS" = Darwin ] || pm_detect
    case ${1:-} in
        on) shift; cmd_on desktop "$@"; return ;;
        off) shift; cmd_off desktop "$@"; return ;;
        wallpaper)
            [ "$OS" != Darwin ] || refuse "not on macOS, which has its own desktop"
            want=$(wall_word "${2:-}")
            if [ -z "${2:-}" ]; then
                if [ "$WALLPAPER" = none ]; then echo "wallpaper none -- the palette's background (spark-shell desktop wallpaper PATH|default)"
                elif wall_colour; then echo "wallpaper $WALLPAPER -- a plain colour, it stays when the palette changes"
                elif [ "$WALLPAPER" = default ] && wall_there; then echo "wallpaper default -- the wallpaper that comes with spark-shell, $WALL_DEFAULT"
                elif wall_there; then echo "wallpaper $WALLPAPER"
                else echo "wallpaper $(wall_path) -- missing, the palette's background colour instead"; fi
                return
            fi
            [ -n "$want" ] || refuse "$2 is not a readable file or a colour. Give a picture's path, default, none, #rrggbb or one of these colours: $(printf '%s' "$WALL_NAMES" | sed 's/ /, /g')"
            [ "$DESKTOP" = sway ] || refuse "DESKTOP=$DESKTOP -- spark-shell on desktop first"
            config_set WALLPAPER "$want"
            WALLPAPER=$want; export WALLPAPER
            theme_load; EXPR=$(render_expr)
            desktop_look_apply
            if [ "$want" = none ]; then echo "the palette's background is back -- a new foot window is opaque again"
            elif wall_colour; then echo "a running sway shows $want now, and it stays when the palette changes -- a new foot window is opaque"
            else echo "a running sway shows it now -- the next foot window is translucent (Super+Return)"; fi
            return ;;
        apps|tools) cmd_apps_verb; return ;;   # the old spellings of spark-shell apps
        keep) shift; desk_save "$@"; return ;;       # the old spellings of layout save and layout delete
        forget) shift; desk_delete "$@"; return ;;
        --ask) cmd_panel layout; return ;;           # the old spellings of layout --ask and layout --pending
        --pending) desk_pending; return ;;
        --chat) cmd_panel chat; return ;;             # the old Super+s: spark chat in the panel's window
        keys) desk_keys; return ;;   # the template's sentences, anywhere (documentation)
        --first)   # the desktop's first window: the keys once (the stamp first, so never twice), then your shell, always
            if [ ! -f "$DESK_SEEN" ]; then
                { mkdir -p "$(dirname "$DESK_SEEN")" && : > "$DESK_SEEN"; } 2>/dev/null || true
                desk_keys_card || true
            fi
            # the config's exports are ours, not the shell's (PROMPT would be zsh's prompt string)
            # shellcheck disable=SC2086   # the -u words, split on purpose
            rm -rf "$TMP"; trap - EXIT; exec env $CONFIG_UNSET "${SHELL:-/bin/sh}" ;;
        ''|-*) ;;
        *) desk_need "$@"; return ;;   # the old spelling of layout WORDS (and layout NAME)
    esac
    desk_start ''
}
# Start sway now, on this console; inside the desktop, the saved layouts.
# PENDING is words a layout waits with for the sway about to start.
desk_start() {   # desk_start PENDING
    pending=$1
    [ "$OS" != Darwin ] || refuse "not on macOS, which has its own desktop"
    # the desktop off, asked from a console (the old login screen, still
    # running until the next boot, runs this on Enter): your shell, never
    # a dead end
    if [ "$DESKTOP" != sway ] && on_console && [ -z "${WAYLAND_DISPLAY:-}" ]; then
        echo "The desktop is off (spark-shell on desktop brings it back). This is your shell."
        rm -rf "$TMP"; trap - EXIT
        # shellcheck disable=SC2086   # the -u words, split on purpose
        exec env $CONFIG_UNSET "${SHELL:-/bin/sh}" -l
    fi
    [ "$DESKTOP" = sway ] || refuse "DESKTOP=$DESKTOP -- spark-shell on desktop"
    [ -z "$(desktop_tools)" ] || refuse "not installed:$(desktop_tools) (spark-shell on)"
    [ -f "$HOME/.config/sway/config" ] && [ -f "$HOME/.config/foot/foot.ini" ] || refuse "the sway and foot settings are missing (spark-shell on)"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then desk_list; return 0; fi
    # a console is /dev/tty1 to tty9 on every distro; ssh and a terminal
    # window are /dev/pts/N
    on_console || refuse "needs a console login (tty1 to tty9): ssh and terminal windows cannot start sway"
    runtime_dir
    log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/spark-shell
    mkdir -p "$log_dir"
    [ -z "${pending:-}" ] || printf '%s\n' "$pending" > "$DESK_PENDING"
    st=0
    # shellcheck disable=SC2086   # the -u words, split on purpose: sway and all it starts read the file, never a key from this login
    PATH=$HOME/.local/bin:$PATH env $CONFIG_UNSET sway 2>"$log_dir/sway.log" || st=$?
    [ "${TERM:-}" != linux ] || printf '\033[?25h'
    exit "$st"
}

usage() {
    sed -n '2,/^# The one interface/p' "$0" | sed '$d' | sed '$d' | sed 's/^# \{0,1\}//'   # the command list
}

main() {
    sub=${1:-status}
    shift 2>/dev/null || true
    # the flags out of the words (a need is words; -v and the layout's player
    # are not among them): the list rotated once, every word byte-exact.
    # --desktop and --terminal; --windows and --rooms are their old spellings
    n=$#
    while [ "$n" -gt 0 ]; do
        a=$1; shift; n=$((n - 1))
        case $a in
            --dry-run) MODE=dry ;; --yes) YES=1 ;; --verbose|-v) VERBOSE=1 ;;
            --desktop|--windows) PLAYER=windows ;; --terminal|--rooms) PLAYER=rooms ;;
            *) set -- "$@" "$a" ;;
        esac
    done
    case ${1:-} in -h|--help) usage; return 0 ;; esac   # a verb's -h answers first
    case $sub in
        -h|--help|help) usage ;;
        on) cmd_on "$@" ;;
        off) cmd_off "$@" ;;
        apply) cmd_on "$@" ;;
        follow) cmd_follow ;;
        check) cmd_check ;;
        bar) cmd_bar "$@" ;;
        panel) cmd_panel "$@" ;;
        theme) cmd_theme "$@" ;;
        font) cmd_font "$@" ;;
        quiet) cmd_quiet "$@" ;;
        sbom) cmd_sbom "$@" ;;
        desktop) cmd_desktop "$@" ;;
        layout) cmd_layout "$@" ;;
        apps) REFUSE_AS=apps; cmd_apps_verb ;;
        status) cmd_status ;;
        --dry-run) MODE=dry; cmd_on ;;
        *) usage >&2; exit 2 ;;
    esac
}

main "$@"
