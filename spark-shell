usage() {
    sed -n '2,/^# The one interface/p' "$0" | sed '$d' | sed '$d' | sed 's/^# \{0,1\}//'   # the command list
}

main() {
    sub=${1:-status}
    shift 2>/dev/null || true
    # the flags out of the words, every other word kept byte-exact;
    # --windows and --rooms are older spellings of --desktop and --terminal
    n=$#
    while [ "$n" -gt 0 ]; do
        a=$1; shift; n=$((n - 1))
        case $a in
            --dry-run) MODE=dry ;; --yes) YES=1 ;; --verbose|-v) VERBOSE=1 ;;
            --desktop|--windows) LAYOUT_ON=desktop ;; --terminal|--rooms) LAYOUT_ON=terminal ;;
            *) set -- "$@" "$a" ;;
        esac
    done
    case ${1:-} in -h|--help) usage; return 0 ;; esac   # a verb's -h answers first
    runtime_adopt
    case $sub in
        -h|--help|help) usage ;;
        on) cmd_on "$@" ;;
        off) cmd_off "$@" ;;
        apply) cmd_on "$@" ;;
        follow) cmd_follow ;;
        check) cmd_check ;;
        update) cmd_update ;;
        bar) cmd_bar "$@" ;;
        panel) cmd_panel "$@" ;;
        dialog) cmd_dialog "$@" ;;
        want) cmd_want "$@" ;;
        provide) cmd_provide "$@" ;;
        semantic) cmd_semantic "$@" ;;
        theme) cmd_theme "$@" ;;
        font) cmd_font "$@" ;;
        quiet) cmd_quiet "$@" ;;
        sbom) cmd_sbom "$@" ;;
        desktop) cmd_desktop "$@" ;;
        login) cmd_login "$@" ;;
        layout) cmd_layout "$@" ;;
        apps) REFUSE_AS=apps; cmd_apps_verb ;;
        notes) cmd_notes "$@" ;;
        reminders) cmd_reminders "$@" ;;
        status) cmd_status ;;
        --dry-run) MODE=dry; cmd_on ;;
        *) usage >&2; exit 2 ;;
    esac
}

main "$@"
